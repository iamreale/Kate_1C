#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Настройки = КТ_ЗагрузкаKaitenСервер.ПрочитатьНастройки();

	АдресKaiten = Настройки.АдресKaiten;
	ВерсияAPI = Настройки.ВерсияAPI;
	РазмерСтраницы = Настройки.РазмерСтраницыAPI;
	КаталогАрхива = Настройки.КаталогАрхива;
	ЗагружатьКомментарии = Настройки.ЗагружатьКомментарии;
	ЗагружатьЧекЛисты = Настройки.ЗагружатьЧекЛисты;
	ЗагружатьИсторию = Настройки.ЗагружатьИсторию;
	ЗагружатьТрудозатраты = Настройки.ЗагружатьТрудозатраты;
	ЗагружатьПользовательскиеПоля = Настройки.ЗагружатьПользовательскиеПоля;
	ЗагружатьФайлы = Настройки.ЗагружатьФайлы;
	ПрогрессТекст = "Готово к запуску.";

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	ОтключитьОбработчикОжидания("ПроверитьХодЗагрузки");
	ОтключитьОбработчикОжидания("ПроверитьВосстановление");
	ОтключитьОбработчикОжидания("ПроверитьПересборку");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьПодключение(Команда)

	Если Не ПроверитьЗаполнениеРеквизитов() Тогда
		Возврат;
	КонецЕсли;

	ВыполнитьСамопроверкуНаСервере(ПараметрыЗагрузки());

КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьИзАрхива(Команда)

	Если Не ЗначениеЗаполнено(СеансЗагрузки) Тогда
		ПрогрессТекст = "Выберите сеанс загрузки: из его сырого архива будет восстановление.";
		Возврат;
	КонецЕсли;

	Если ЗаданиеАктивно(ИдентификаторЗадания) Тогда
		ПрогрессТекст = "Дождитесь завершения текущего фонового задания.";
		Возврат;
	КонецЕсли;

	Результат = ЗапуститьВосстановлениеФоном(ПараметрыЗагрузки(), СеансЗагрузки,
		ВидСущностиВосстановления);
	ИдентификаторЗадания = Результат.ИдентификаторЗадания;
	ПрогрессТекст = "Восстановление из сырого архива запущено в фоновом задании.";

	УстановитьДоступностьКоманд(Ложь);
	ПодключитьОбработчикОжидания("ПроверитьВосстановление", 3, Истина);

КонецПроцедуры

&НаКлиенте
Процедура НачатьПолнуюЗагрузку(Команда)

	Если ЗаданиеАктивно(ИдентификаторЗадания) Тогда
		ПрогрессТекст = "Дождитесь завершения текущего фонового задания.";
		Возврат;
	КонецЕсли;

	Если Не ПроверитьЗаполнениеРеквизитов() Тогда
		Возврат;
	КонецЕсли;

	Результат = ЗапуститьЗагрузкуФоном(ПараметрыЗагрузки(), Ложь, Неопределено);
	СеансЗагрузки = Результат.СеансЗагрузки;
	ИдентификаторЗадания = Результат.ИдентификаторЗадания;
	ПрогрессТекст = "Полная загрузка запущена в фоновом задании.";
	ПодключитьОбработчикОжидания("ПроверитьХодЗагрузки", 3, Истина);
	УстановитьДоступностьКоманд(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьЗагрузку(Команда)

	Если ЗаданиеАктивно(ИдентификаторЗадания) Тогда
		ПрогрессТекст = "Дождитесь завершения текущего фонового задания.";
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СеансЗагрузки) Тогда
		ПрогрессТекст = "Укажите сеанс загрузки.";
		Возврат;
	КонецЕсли;

	Если Не ПроверитьЗаполнениеРеквизитов() Тогда
		Возврат;
	КонецЕсли;

	Результат = ЗапуститьЗагрузкуФоном(ПараметрыЗагрузки(), Истина, СеансЗагрузки);
	ИдентификаторЗадания = Результат.ИдентификаторЗадания;
	ПрогрессТекст = "Загрузка продолжена в фоновом задании.";
	ПодключитьОбработчикОжидания("ПроверитьХодЗагрузки", 3, Истина);
	УстановитьДоступностьКоманд(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура Остановить(Команда)

	Если Не ЗначениеЗаполнено(СеансЗагрузки) Тогда
		ПрогрессТекст = "Укажите сеанс загрузки.";
		Возврат;
	КонецЕсли;

	ОстановитьЗагрузкуНаСервере(СеансЗагрузки);
	ПрогрессТекст = "Запрошена остановка. Текущее задание будет завершено, остальные останутся в очереди.";

КонецПроцедуры

&НаКлиенте
Процедура ПовторитьОшибки(Команда)

	Если Не ЗначениеЗаполнено(СеансЗагрузки) Тогда
		ПрогрессТекст = "Укажите сеанс загрузки.";
		Возврат;
	КонецЕсли;

	ПрогрессТекст = ПовторитьОшибкиНаСервере(СеансЗагрузки, ПараметрыЗагрузки());

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьОчередь(Команда)

	Оповещение = Новый ОписаниеОповещения("ОчиститьОчередьЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, "Удалить все записи очереди загрузки?",
		РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет, "Очистка очереди");

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПолноту(Команда)

	Если Не ЗначениеЗаполнено(СеансЗагрузки) Тогда
		ПрогрессТекст = "Укажите сеанс загрузки.";
		Возврат;
	КонецЕсли;

	ПрогрессТекст = ПроверитьПолнотуНаСервере(СеансЗагрузки, ПараметрыЗагрузки());

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСеанс(Команда)

	Если Не ЗначениеЗаполнено(СеансЗагрузки) Тогда
		ПрогрессТекст = "Укажите сеанс загрузки.";
		Возврат;
	КонецЕсли;

	ОткрытьСеансНаСервере(СеансЗагрузки);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПротокол(Команда)

	Если Не ЗначениеЗаполнено(СеансЗагрузки) Тогда
		ПрогрессТекст = "Укажите сеанс загрузки.";
		Возврат;
	КонецЕсли;

	ОткрытьПротоколНаСервере(СеансЗагрузки);

КонецПроцедуры

&НаКлиенте
Процедура ПересобратьHTMLКомментариев(Команда)

	Если ЗаданиеАктивно(ИдентификаторЗадания) Или ЗаданиеАктивно(ИдентификаторПересборки) Тогда
		ПрогрессТекст = "Дождитесь завершения текущего фонового задания.";
		Возврат;
	КонецЕсли;

	Осталось = ОсталосьПересобратьНаСервере();
	Если Осталось = 0 Тогда
		ПрогрессТекст = "Все комментарии уже пересобраны текущей версией разметки.";
		Возврат;
	КонецЕсли;

	ИдентификаторПересборки = ЗапуститьПересборкуФоном();
	ПрогрессТекст = "Пересборка HTML комментариев запущена, устаревших записей: " + Осталось + ".";

	УстановитьДоступностьКоманд(Ложь);
	ПодключитьОбработчикОжидания("ПроверитьПересборку", 3, Истина);

КонецПроцедуры

#КонецОбласти

&НаСервере
Функция КоличествоАктивныхЗаданий()

	Отбор = Новый Структура("Состояние", СостояниеФоновогоЗадания.Активно);
	Возврат ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор).Количество();

КонецФункции

#Область ОбработчикОжидания

&НаКлиенте
Процедура ПроверитьХодЗагрузки()

	Если Не ЗначениеЗаполнено(СеансЗагрузки) Тогда
		ОтключитьОбработчикОжидания("ПроверитьХодЗагрузки");
		УстановитьДоступностьКоманд(Истина);
		Возврат;
	КонецЕсли;

	Если ОстановитьЗагрузку Тогда
		ОстановитьЗагрузкуНаСервере(СеансЗагрузки);
		ОстановитьЗагрузку = Ложь;
	КонецЕсли;

	Результат = ХодЗагрузкиНаСервере(СеансЗагрузки, ИдентификаторЗадания);
	ПрогрессТекст = Результат.Текст + Символы.ПС + "Активных фоновых заданий: " + КоличествоАктивныхЗаданий();

	Если Результат.Активно Тогда
		УстановитьДоступностьКоманд(Ложь);
	Иначе
		ОтключитьОбработчикОжидания("ПроверитьХодЗагрузки");
		УстановитьДоступностьКоманд(Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьВосстановление()

	Результат = ХодВосстановленияНаСервере(СеансЗагрузки, ИдентификаторЗадания);
	ПрогрессТекст = Результат.Текст;

	Если Результат.Активно Тогда
		УстановитьДоступностьКоманд(Ложь);
	Иначе
		ОтключитьОбработчикОжидания("ПроверитьВосстановление");
		УстановитьДоступностьКоманд(Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПересборку()

	Результат = ХодПересборкиНаСервере(ИдентификаторПересборки);
	ПрогрессТекст = Результат.Текст;

	Если Результат.Активно Тогда
		УстановитьДоступностьКоманд(Ложь);
	Иначе
		ОтключитьОбработчикОжидания("ПроверитьПересборку");
		УстановитьДоступностьКоманд(Истина);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОчиститьОчередьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ПрогрессТекст = ОчиститьОчередьНаСервере();

КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеРеквизитов()

	Если Не ЗначениеЗаполнено(АдресKaiten) Тогда
		ПрогрессТекст = "Укажите адрес Kaiten.";
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаКлиенте
Функция ПараметрыЗагрузки()

	ЗначенияПараметров = Новый Структура;
	ЗначенияПараметров.Вставить("АдресKaiten", СокрЛП(АдресKaiten));
	ЗначенияПараметров.Вставить("Токен", СокрЛП(Токен));
	ЗначенияПараметров.Вставить("ВерсияAPI", СокрЛП(ВерсияAPI));
	ЗначенияПараметров.Вставить("РазмерСтраницы", РазмерСтраницы);
	ЗначенияПараметров.Вставить("КаталогАрхива", СокрЛП(КаталогАрхива));
	ЗначенияПараметров.Вставить("Пространство", Пространство);
	ЗначенияПараметров.Вставить("ЗагружатьКомментарии", ЗагружатьКомментарии);
	ЗначенияПараметров.Вставить("ЗагружатьЧекЛисты", ЗагружатьЧекЛисты);
	ЗначенияПараметров.Вставить("ЗагружатьИсторию", ЗагружатьИсторию);
	ЗначенияПараметров.Вставить("ЗагружатьТрудозатраты", ЗагружатьТрудозатраты);
	ЗначенияПараметров.Вставить("ЗагружатьПользовательскиеПоля", ЗагружатьПользовательскиеПоля);
	ЗначенияПараметров.Вставить("ЗагружатьФайлы", ЗагружатьФайлы);
	ЗначенияПараметров.Вставить("НеЗагружатьНСИ", НеЗагружатьНСИ);
	
	ЗначенияПараметров.Вставить("ЗагружатьКартинкиКомментариев", ЗагружатьКартинкиКомментариев);
	ЗначенияПараметров.Вставить("ЗагружатьФайлыКомментариев", ЗагружатьФайлыКомментариев);

	Возврат ЗначенияПараметров;

КонецФункции

&НаКлиенте
Процедура УстановитьДоступностьКоманд(Доступно)

	Элементы.КнопкаПроверитьПодключение.Доступность = Доступно;
	Элементы.КнопкаНачатьПолнуюЗагрузку.Доступность = Доступно;
	Элементы.КнопкаПродолжитьЗагрузку.Доступность = Доступно;
	Элементы.КнопкаПовторитьОшибки.Доступность = Доступно;
	Элементы.КнопкаПроверитьПолноту.Доступность = Доступно;
	Элементы.КнопкаВосстановитьИзАрхива.Доступность = Доступно;
	Элементы.КнопкаПересобратьHTML.Доступность = Доступно;
	Элементы.КнопкаОстановить.Доступность = Не Доступно;

КонецПроцедуры

&НаСервереБезКонтекста
Функция НастройкиЗагрузки(ПараметрыФормы)

	Настройки = КТ_ЗагрузкаKaitenСервер.ПрочитатьНастройки();

	Если ЗначениеЗаполнено(ПараметрыФормы.АдресKaiten) Тогда
		Настройки.Вставить("АдресKaiten", ПараметрыФормы.АдресKaiten);
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрыФормы.Токен) Тогда
		Настройки.Вставить("Токен", ПараметрыФормы.Токен);
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрыФормы.ВерсияAPI) Тогда
		Настройки.Вставить("ВерсияAPI", ПараметрыФормы.ВерсияAPI);
	КонецЕсли;
	Если ПараметрыФормы.РазмерСтраницы > 0 Тогда
		Настройки.Вставить("РазмерСтраницыAPI", ПараметрыФормы.РазмерСтраницы);
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрыФормы.КаталогАрхива) Тогда
		Настройки.Вставить("КаталогАрхива", ПараметрыФормы.КаталогАрхива);
	КонецЕсли;
	Настройки.Вставить("Пространство", ПараметрыФормы.Пространство);

	Настройки.Вставить("ЗагружатьКомментарии", ПараметрыФормы.ЗагружатьКомментарии);
	Настройки.Вставить("ЗагружатьЧекЛисты", ПараметрыФормы.ЗагружатьЧекЛисты);
	Настройки.Вставить("ЗагружатьИсторию", ПараметрыФормы.ЗагружатьИсторию);
	Настройки.Вставить("ЗагружатьТрудозатраты", ПараметрыФормы.ЗагружатьТрудозатраты);
	Настройки.Вставить("ЗагружатьПользовательскиеПоля", ПараметрыФормы.ЗагружатьПользовательскиеПоля);
	Настройки.Вставить("ЗагружатьФайлы", ПараметрыФормы.ЗагружатьФайлы);
	
	Настройки.Вставить("НеЗагружатьНСИ", ПараметрыФормы.НеЗагружатьНСИ);
	
	Настройки.Вставить("ЗагружатьФайлыКомментариев", ПараметрыФормы.ЗагружатьФайлыКомментариев);
	Настройки.Вставить("ЗагружатьКартинкиКомментариев", ПараметрыФормы.ЗагружатьКартинкиКомментариев);
	

	Возврат Настройки;

КонецФункции

&НаСервереБезКонтекста
Функция ЗапуститьЗагрузкуФоном(ПараметрыФормы, ЭтоПродолжение, СеансЗагрузки)

	Настройки = НастройкиЗагрузки(ПараметрыФормы);

	Сеанс = СеансЗагрузки;
	Если Не ЭтоПродолжение Или Не ЗначениеЗаполнено(Сеанс) Тогда
		Сеанс = КТ_ЗагрузкаKaitenСервер.СоздатьСеансЗагрузки(Настройки);
	КонецЕсли;

	ИмяМетода = "КТ_ЗагрузкаKaitenСервер.ПродолжитьЗагрузкуФоном";
	Если Не ЭтоПродолжение Тогда
		ИмяМетода = "КТ_ЗагрузкаKaitenСервер.ВыполнитьЗагрузкуФоном";
	КонецЕсли;

	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(Сеанс);
	ПараметрыЗадания.Добавить(Настройки);
	ПараметрыЗадания.Добавить(500);

	Задание = ФоновыеЗадания.Выполнить(ИмяМетода, ПараметрыЗадания, ,
		"Загрузка из Kaiten: " + Строка(Сеанс));

	Результат = Новый Структура;
	Результат.Вставить("СеансЗагрузки", Сеанс);
	Результат.Вставить("ИдентификаторЗадания", Строка(Задание.УникальныйИдентификатор));

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ЗапуститьВосстановлениеФоном(ПараметрыФормы, СеансЗагрузки, ВидСущности)

	Настройки = НастройкиЗагрузки(ПараметрыФормы);

	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(СеансЗагрузки);
	ПараметрыЗадания.Добавить(ВидСущности);
	ПараметрыЗадания.Добавить(Настройки);

	Задание = ФоновыеЗадания.Выполнить("КТ_ЗагрузкаKaitenСервер.ВосстановитьИзСырогоАрхиваФоном",
		ПараметрыЗадания, , "Восстановление из сырого архива: " + Строка(СеансЗагрузки));

	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторЗадания", Строка(Задание.УникальныйИдентификатор));

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ХодВосстановленияНаСервере(СеансЗагрузки, ИдентификаторЗадания)

	Результат = Новый Структура;
	Результат.Вставить("Активно", Ложь);
	Результат.Вставить("Текст", "Восстановление из архива не выполнялось.");

	Если ЗначениеЗаполнено(СеансЗагрузки) Тогда
		ОбъектСеанса = СеансЗагрузки.ПолучитьОбъект();
		Если ОбъектСеанса <> Неопределено И Не ПустаяСтрока(ОбъектСеанса.Комментарий) Тогда
			Результат.Текст = ОбъектСеанса.Комментарий;
		КонецЕсли;
	КонецЕсли;

	Результат.Активно = ЗаданиеАктивно(ИдентификаторЗадания);

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ЗапуститьПересборкуФоном()

	ПараметрыЗадания = Новый Массив;

	Задание = ФоновыеЗадания.Выполнить("КТ_РазметкаСервер.ПересобратьHTMLКомментариевФоном",
		ПараметрыЗадания, , "Пересборка HTML комментариев");

	Возврат Строка(Задание.УникальныйИдентификатор);

КонецФункции

&НаСервереБезКонтекста
Функция ХодПересборкиНаСервере(ИдентификаторПересборки)

	Активно = ЗаданиеАктивно(ИдентификаторПересборки);
	Осталось = КТ_РазметкаСервер.ОсталосьПересобрать();

	Результат = Новый Структура;
	Результат.Вставить("Активно", Активно);

	Если Активно Тогда
		Результат.Вставить("Текст", "Пересборка HTML комментариев: осталось " + Осталось + ".");
	ИначеЕсли Осталось = 0 Тогда
		Результат.Вставить("Текст", "Пересборка HTML комментариев завершена.");
	Иначе
		Результат.Вставить("Текст", "Пересборка завершена, осталось " + Осталось
			+ " записей — смотрите журнал регистрации (Кайтен.ПересборкаHTMLКомментариев).");
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ОсталосьПересобратьНаСервере()

	Возврат КТ_РазметкаСервер.ОсталосьПересобрать();

КонецФункции

&НаСервереБезКонтекста
Функция ЗаданиеАктивно(ИдентификаторЗадания)

	Если Не ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
		Возврат Ложь;
	КонецЕсли;

	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(
		Новый УникальныйИдентификатор(ИдентификаторЗадания));

	Возврат Задание <> Неопределено И Задание.Состояние = СостояниеФоновогоЗадания.Активно;

КонецФункции

&НаСервереБезКонтекста
Функция ХодЗагрузкиНаСервере(СеансЗагрузки, ИдентификаторЗадания)

	Ход = КТ_ЗагрузкаKaitenСервер.ХодЗагрузки(СеансЗагрузки);

	Результат = Новый Структура;
	Результат.Вставить("Активно", Ложь);
	Результат.Вставить("Текст", Ход.Текст);

	Если Не ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
		Возврат Результат;
	КонецЕсли;

	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(
		Новый УникальныйИдентификатор(ИдентификаторЗадания));
	Если Задание = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Активно = Задание.Состояние = СостояниеФоновогоЗадания.Активно;
	Если Не Результат.Активно И Задание.ИнформацияОбОшибке <> Неопределено Тогда
		Результат.Текст = Результат.Текст + " Задание завершено с ошибкой: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Процедура ОстановитьЗагрузкуНаСервере(СеансЗагрузки)

	КТ_ЗагрузкаKaitenСервер.ОстановитьЗагрузку(СеансЗагрузки);

КонецПроцедуры

&НаСервере
Процедура ВыполнитьСамопроверкуНаСервере(ПараметрыФормы)

	Настройки = НастройкиЗагрузки(ПараметрыФормы);
	Таблица = КТ_ЗагрузкаKaitenСервер.ВыполнитьСамопроверку(Настройки);

	Всего = Таблица.Количество();
	Успешных = 0;
	Для Каждого СтрокаПроверки Из Таблица Цикл
		Если СтрокаПроверки.Статус = "OK" Тогда
			Успешных = Успешных + 1;
		КонецЕсли;
	КонецЦикла;

	ТаблицаПроверок.Загрузить(Таблица);

	Если Успешных = Всего Тогда
		СтатусДиагностики = "Подключение работает: пройдено " + Успешных + " из " + Всего + ".";
	Иначе
		СтатусДиагностики = "Есть проблемы: пройдено " + Успешных + " из " + Всего + " проверок.";
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПовторитьОшибкиНаСервере(СеансЗагрузки, ПараметрыФормы)

	Попытка
		Настройки = НастройкиЗагрузки(ПараметрыФормы);
		Количество = КТ_ЗагрузкаKaitenСервер.ПовторитьОшибки(СеансЗагрузки, Настройки);
		Возврат "Задания с ошибками возвращены в очередь: " + Количество + ".";
	Исключение
		Возврат "Ошибка: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

&НаСервереБезКонтекста
Функция ОчиститьОчередьНаСервере()

	Попытка
		Количество = КТ_ОчередьЗагрузкиСервер.ОчиститьОчередь();
		Возврат "Очередь загрузки очищена: удалено записей "
			+ Формат(Количество, "ЧГ=0") + ".";
	Исключение
		Возврат "Ошибка: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьПолнотуНаСервере(СеансЗагрузки, ПараметрыФормы)

	Попытка
		Настройки = НастройкиЗагрузки(ПараметрыФормы);
		Результат = КТ_ЗагрузкаKaitenСервер.ПроверитьПолноту(СеансЗагрузки, Настройки);

		Текст = "Карточек: " + Результат.ВсегоКарточек
			+ ", загружено полностью: " + Результат.ЗагруженоПолностью
			+ ", с ошибками: " + Результат.СОшибками
			+ ", незагруженных файлов: " + Результат.НезагруженныхФайлов
			+ ", ошибок очереди: " + Результат.ОшибокОчереди
			+ ", трудозатраты (необязательный блок): карточек "
			+ Результат.КарточекСТрудозатратами
			+ ", записей " + Результат.ТрудозатратВсего
			+ ", минут " + Результат.ТрудозатратМинут + ".";
		Если Результат.Замечания.Количество() > 0 Тогда
			Текст = Текст + " Замечания: " + СтрСоединить(Результат.Замечания, "; ") + ".";
		КонецЕсли;

		Возврат Текст;
	Исключение
		Возврат "Ошибка: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

&НаКлиенте
Процедура ОткрытьСеансНаСервере(СеансЗагрузки)

	ПараметрыОткрытия = Новый Структура("Ключ", СеансЗагрузки);
	ОткрытьФорму("Справочник.КТ_СеансыЗагрузки.Форма.ФормаЭлемента", ПараметрыОткрытия);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПротоколНаСервере(СеансЗагрузки)

	ОткрытьФорму("РегистрСведений.КТ_ПротоколЗагрузки.Форма.ФормаСписка");

КонецПроцедуры

#КонецОбласти
