#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДействиеCOMMENTS = Истина;
	ДействиеCHECKLISTS = Истина;
	ДействиеCHILDREN = Истина;
	ДействиеLOCATION_HISTORY = Истина;
	ДействиеTIME_LOGS = Истина;
	ДействиеFILES = Истина;
	МаксимумЗаданий = 100;

	ОбновитьСостояниеОчереди();

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	ОтключитьОбработчикОжидания("ПроверитьХод");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗапуститьОбработку(Команда)

	Если Не ЗначениеЗаполнено(СеансЗагрузки) Тогда
		Состояние = "Укажите сеанс загрузки.";
		Возврат;
	КонецЕсли;

	Если ЗаданиеАктивно(ИдентификаторЗадания) Тогда
		Состояние = "Дождитесь завершения текущего фонового задания.";
		Возврат;
	КонецЕсли;

	Если Не ЕстьВыбранныеДействия() Тогда
		Состояние = "Отметьте хотя бы одно выполняемое действие.";
		Возврат;
	КонецЕсли;

	ИдентификаторЗадания = ЗапуститьОбработкуФоном();
	Состояние = "Обработка очереди запущена в фоновом задании.";

	ПодключитьОбработчикОжидания("ПроверитьХод", 3, Истина);

КонецПроцедуры

&НаКлиенте
Процедура Остановить(Команда)

	Если Не ЗначениеЗаполнено(СеансЗагрузки) Тогда
		Состояние = "Укажите сеанс загрузки.";
		Возврат;
	КонецЕсли;

	ОстановитьНаСервере(СеансЗагрузки);
	Состояние = "Запрошена остановка. Текущее задание будет завершено, остальные останутся в очереди.";

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОчередь(Команда)

	ОбновитьСостояниеОчереди();

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФорму(Команда)

	ОтключитьОбработчикОжидания("ПроверитьХод");
	Закрыть();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПроверитьХод()

	ОбновитьСостояниеОчереди();

	Если ЗаданиеАктивно(ИдентификаторЗадания) Тогда
		ПодключитьОбработчикОжидания("ПроверитьХод", 3, Истина);
	Иначе
		ОтключитьОбработчикОжидания("ПроверитьХод");
	КонецЕсли;

КонецПроцедуры

// Проверяет, отмечено ли хотя бы одно выполняемое действие.
//
// Возвращаемое значение:
//  Булево - Истина, если отмечено хотя бы одно действие.
//
&НаКлиенте
Функция ЕстьВыбранныеДействия()

	Возврат ДействиеCOMMENTS Или ДействиеCHECKLISTS Или ДействиеCHILDREN
		Или ДействиеLOCATION_HISTORY Или ДействиеTIME_LOGS Или ДействиеFILES;

КонецФункции

&НаСервере
Процедура ОбновитьСостояниеОчереди()

	Ход = ХодОчередиНаСервере(СеансЗагрузки, ВидОперации, ОтборДействий());

	ЗаполнитьОчередь(Ход.Сводка);
	Состояние = Ход.Текст;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОчередь(Сводка)

	Очередь.Очистить();

	Для Каждого СтрокаСводки Из Сводка Цикл
		НоваяСтрока = Очередь.Добавить();
		НоваяСтрока.Состояние = СтрокаСводки.Состояние;
		НоваяСтрока.Количество = СтрокаСводки.Количество;
	КонецЦикла;

КонецПроцедуры

// Возвращает выбранные выполняемые действия.
// Если отмечены все действия, возвращает Неопределено - фильтр по действию не применяется.
//
// Возвращаемое значение:
//  Массив из Строка, Неопределено - имена действий или Неопределено.
//
&НаСервере
Функция ОтборДействий()

	Действия = Новый Массив;

	Если ДействиеCOMMENTS Тогда
		Действия.Добавить("COMMENTS");
	КонецЕсли;
	Если ДействиеCHECKLISTS Тогда
		Действия.Добавить("CHECKLISTS");
	КонецЕсли;
	Если ДействиеCHILDREN Тогда
		Действия.Добавить("CHILDREN");
	КонецЕсли;
	Если ДействиеLOCATION_HISTORY Тогда
		Действия.Добавить("LOCATION_HISTORY");
	КонецЕсли;
	Если ДействиеTIME_LOGS Тогда
		Действия.Добавить("TIME_LOGS");
	КонецЕсли;
	Если ДействиеFILES Тогда
		Действия.Добавить("FILES");
	КонецЕсли;

	// Отмечены все действия - обрабатываются и задания карточек, и все дочерние данные.
	Если Действия.Количество() = 6 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Действия;

КонецФункции

&НаСервере
Функция ЗапуститьОбработкуФоном()

	Отбор = КТ_ОчередьЗагрузкиСервер.ОтборЗаданий(ВидОперации, ОтборДействий());

	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(СеансЗагрузки);
	ПараметрыЗадания.Добавить(Отбор);
	ПараметрыЗадания.Добавить(?(МаксимумЗаданий > 0, МаксимумЗаданий, 100));

	Задание = ФоновыеЗадания.Выполнить("КТ_ЗагрузкаKaitenСервер.ВыполнитьОчередьФоном",
		ПараметрыЗадания, , "Обработка очереди загрузки: " + Строка(СеансЗагрузки));

	Возврат Строка(Задание.УникальныйИдентификатор);

КонецФункции

&НаСервереБезКонтекста
Процедура ОстановитьНаСервере(СеансЗагрузки)

	КТ_ЗагрузкаKaitenСервер.ОстановитьЗагрузку(СеансЗагрузки);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ХодОчередиНаСервере(СеансЗагрузки, ВидОперации, Действия)

	Сводка = Новый Массив;
	Текст = "Выберите сеанс загрузки.";

	Если ЗначениеЗаполнено(СеансЗагрузки) Тогда

		Ход = КТ_ЗагрузкаKaitenСервер.ХодЗагрузки(СеансЗагрузки);

		ДобавитьСтрокуСводки(Сводка, Перечисления.КТ_СостояниеЗагрузки.Ожидает, Ход.Ожидает);
		ДобавитьСтрокуСводки(Сводка, Перечисления.КТ_СостояниеЗагрузки.Выполняется, Ход.Выполняется);
		ДобавитьСтрокуСводки(Сводка, Перечисления.КТ_СостояниеЗагрузки.Загружено, Ход.Загружено);
		ДобавитьСтрокуСводки(Сводка, Перечисления.КТ_СостояниеЗагрузки.Пропущено, Ход.Пропущено);
		ДобавитьСтрокуСводки(Сводка, Перечисления.КТ_СостояниеЗагрузки.Ошибка, Ход.Ошибка);

		Отбор = КТ_ОчередьЗагрузкиСервер.ОтборЗаданий(ВидОперации, Действия);
		Подходит = КТ_ОчередьЗагрузкиСервер.КоличествоЗаданийПоОтбору(СеансЗагрузки, Отбор);

		Текст = Ход.Текст + " Подходит под отбор: " + Подходит + "." + ОписаниеОтбора(Отбор);

	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Текст", Текст);
	Результат.Вставить("Сводка", Сводка);

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьСтрокуСводки(Сводка, Состояние, Количество)

	СтрокаСводки = Новый Структура("Состояние, Количество", Состояние, Количество);
	Сводка.Добавить(СтрокаСводки);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОписаниеОтбора(Отбор)

	Части = Новый Массив;

	Если Отбор.ВидОперации <> Неопределено Тогда
		Части.Добавить("вид операции: " + Строка(Отбор.ВидОперации));
	КонецЕсли;

	Если Отбор.Действия.Количество() > 0 Тогда
		Части.Добавить("действия: " + СтрСоединить(Отбор.Действия, ", "));
	КонецЕсли;

	Если Части.Количество() = 0 Тогда
		Возврат " Отбор не задан.";
	КонецЕсли;

	Возврат " Отбор: " + СтрСоединить(Части, "; ") + ".";

КонецФункции

&НаСервереБезКонтекста
Функция ЗаданиеАктивно(ИдентификаторЗадания)

	Если Не ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
		Возврат Ложь;
	КонецЕсли;

	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(
		Новый УникальныйИдентификатор(ИдентификаторЗадания));

	Возврат Задание <> Неопределено И Задание.Состояние = СостояниеФоновогоЗадания.Активно;

КонецФункции

#КонецОбласти
