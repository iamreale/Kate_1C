#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьСжатие(Команда)
	
	Результаты.Очистить();
	Состояние = "Получение списка объектов метаданных...";
	
	Источники = ИсточникиХранилищ();
	
	ВсегоЗаписей = 0;
	ВсегоПереупаковано = 0;
	ВсегоПропущено = 0;
	ВсегоОшибок = 0;
	
	Для Индекс = 0 По Источники.ВГраница() Цикл
		
		ОбработкаПрерыванияПользователя();
		
		Источник = Источники[Индекс];
		Состояние = СтрШаблон("%1 из %2: %3", Формат(Индекс + 1, "ЧГ=0"),
			Формат(Источники.Количество(), "ЧГ=0"), Источник.Представление);
		
		Результат = ОбработатьИсточникНаСервере(Источник, СжиматьДвоичныеДанные);
		
		ВсегоЗаписей = ВсегоЗаписей + Результат.Записей;
		ВсегоПереупаковано = ВсегоПереупаковано + Результат.Переупаковано;
		ВсегоПропущено = ВсегоПропущено + Результат.Пропущено;
		ВсегоОшибок = ВсегоОшибок + Результат.Ошибки.Количество();
		
	КонецЦикла;
	
	Состояние = СтрШаблон(
		"Готово. Записей с хранилищами: %1, переупаковано значений: %2, пропущено: %3, ошибок: %4.",
		Формат(ВсегоЗаписей, "ЧГ=0"), Формат(ВсегоПереупаковано, "ЧГ=0"),
		Формат(ВсегоПропущено, "ЧГ=0"), Формат(ВсегоОшибок, "ЧГ=0"));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФорму(Команда)
	
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ИсточникиХранилищ()
	
	Возврат КТ_СжатиеХранилищСервер.ИсточникиХранилищ();
	
КонецФункции

&НаСервере
Функция ОбработатьИсточникНаСервере(Источник, СжиматьДвоичныеДанные)
	
	Настройки = Новый Структура("СжиматьДвоичныеДанные", СжиматьДвоичныеДанные);
	Результат = КТ_СжатиеХранилищСервер.ОбработатьИсточник(Источник, Настройки);
	
	СтрокаРезультата = Результаты.Добавить();
	СтрокаРезультата.Источник = Источник.Представление;
	СтрокаРезультата.Записей = Результат.Записей;
	СтрокаРезультата.Переупаковано = Результат.Переупаковано;
	СтрокаРезультата.Пропущено = Результат.Пропущено;
	СтрокаРезультата.Ошибок = Результат.Ошибки.Количество();
	
	Для Каждого ТекстОшибки Из Результат.Ошибки Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстОшибки;
		Сообщение.Сообщить();
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
