

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьКомментарииКарточки();

КонецПроцедуры



#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыКомментарииКарточки

&НаКлиенте
Процедура КомментарииКарточкиПриАктивизацииСтроки(Элемент)

	Если Элемент.ТекущиеДанные = Неопределено Тогда
		HTMLКомментария = "";
		Возврат;
	КонецЕсли;

	HTMLКомментария = HTMLКомментарияНаСервере(Элемент.ТекущиеДанные.Ссылка);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПоказатьСыройJSON(Команда)
	
	ПоказатьСыройJSONНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьОписаниеИзAPI(Команда)
	
	ЗапроситьОписаниеИзAPIНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПоСырымДанным(Команда)

	ПроверитьПоСырымДаннымНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПоказатьСыройJSONНаСервере()
	
	СыройСыройJSON = "";
	Если Объект.СыройJSON <> Неопределено Тогда
		ПолученныйСыройJSON = Объект.СыройJSON.Получить();
		Если ТипЗнч(ПолученныйСыройJSON) = Тип("Строка") Тогда
			СыройСыройJSON = ПолученныйСыройJSON;
		Иначе
			Если ПолученныйСыройJSON <> Неопределено Тогда
				СыройСыройJSON = КТ_JSONСервер.ЗаписатьJSONВСтроку(ПолученныйСыройJSON);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	//Элементы.СыройСыройJSON.Высота = Макс(СтрЧислоСтрок(СыройСыройJSON), 1);
	Элементы.СыройСыройJSON.ТолькоПросмотр = Истина;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьОписаниеКарточкиИзAPI()
	
	Результат = Новый Структура;
	Результат.Вставить("КодHTTP", 0);
	Результат.Вставить("Описание", "");
	Результат.Вставить("ТелоОтвета", "");
	Результат.Вставить("Ошибка", "");
	
	// Маршрут карточки адресуется числовым идентификатором (id), а не UID.
	ИдентификаторКарточки = Объект.ИдентификаторKaiten;
	Если НЕ ЗначениеЗаполнено(ИдентификаторКарточки) Тогда
		Результат.Ошибка = "У карточки не заполнен идентификатор Kaiten.";
		Возврат Результат;
	КонецЕсли;
	
	Настройки = КТ_ЗагрузкаKaitenСервер.ПрочитатьНастройки();
	Путь = "/cards/" + Формат(ИдентификаторКарточки, "ЧГ=0");
	
	Попытка
		Ответ = КТ_HTTPКлиентСервер.ВыполнитьGET(Путь, Неопределено, Настройки);
	Исключение
		Результат.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;
	
	Результат.КодHTTP = Ответ.КодСостояния;
	Результат.ТелоОтвета = Ответ.ТелоКакСтрока;
	
	Если Ответ.КодСостояния <> 200 Тогда
		Результат.Ошибка = "HTTP " + Ответ.КодСостояния + ": "
			+ КТ_HTTPКлиентСервер.ПолучитьОписаниеHTTPОшибки(Ответ);
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		ДанныеКарточки = КТ_JSONСервер.ПрочитатьJSONИзСтроки(Ответ.ТелоКакСтрока);
	Исключение
		Результат.Ошибка = "Не удалось разобрать JSON: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;
	
	Результат.Описание = КТ_JSONСервер.ПолучитьСтроку(ДанныеКарточки, "description");
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗапроситьОписаниеИзAPIНаСервере()
	
	Результат = ПолучитьОписаниеКарточкиИзAPI();
	
	Если ПустаяСтрока(Результат.Ошибка) Тогда
		СыройСыройJSON = Результат.ТелоОтвета;
	Иначе
		СыройСыройJSON = "Ошибка: " + Результат.Ошибка;
	КонецЕсли;
	
	Элементы.СыройСыройJSON.ТолькоПросмотр = Истина;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКомментарииКарточки()

	КомментарииКарточки.Очистить();

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	Комментарии.Ссылка КАК Ссылка,
		|	Комментарии.Автор КАК Автор,
		|	Комментарии.ДатаСозданияKaiten КАК ДатаСоздания,
		|	Комментарии.Текст КАК Текст,
		|	Комментарии.ТекстHTML КАК HTML
		|ИЗ
		|	Справочник.КТ_Комментарии КАК Комментарии
		|ГДЕ
		|	Комментарии.Карточка = &Карточка
		|УПОРЯДОЧИТЬ ПО
		|	Комментарии.ДатаСозданияKaiten";
	Запрос.УстановитьПараметр("Карточка", Объект.Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаТаблицы = КомментарииКарточки.Добавить();
		СтрокаТаблицы.Ссылка = Выборка.Ссылка;
		СтрокаТаблицы.Автор = Выборка.Автор;
		СтрокаТаблицы.ДатаСоздания = Выборка.ДатаСоздания;
		СтрокаТаблицы.Текст = Выборка.Текст;
		СтрокаТаблицы.HTML = Выборка.HTML;
	КонецЦикла;

КонецПроцедуры

