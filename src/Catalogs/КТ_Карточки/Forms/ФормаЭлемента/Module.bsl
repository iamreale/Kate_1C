&НаСервере
Функция HTMLКомментарияНаСервере(КомментарийСсылка)

    Если НЕ ЗначениеЗаполнено(КомментарийСсылка) Тогда
        Возврат "";
    КонецЕсли;

    Возврат КТ_РазметкаСервер.HTMLКомментарияДляПросмотра(КомментарийСсылка);

КонецФункции

&НаСервере
Процедура ПроверитьПоСырымДаннымНаСервере()

	// Читаем объект из сохранённого ответа Kaiten: в базу при этом ничего не пишется.
	ОбъектИзСырья = КТ_СырыеДанныеСервер.ОбъектИзСырогоАрхива(Объект.Ссылка);

	ТекстСообщения = "Данные заполнены из сырого ответа. В базу ничего не записано.";
	Если ОбъектИзСырья = Неопределено Тогда
		ТекстСообщения = "В архиве сырых данных нет ответов по этому объекту.";
	Иначе
		ЗначениеВРеквизитФормы(ОбъектИзСырья, "Объект");
	КонецЕсли;

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Сообщить();

КонецПроцедуры

