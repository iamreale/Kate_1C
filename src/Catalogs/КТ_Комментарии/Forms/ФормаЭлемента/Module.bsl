&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
        ТекстHTMLПросмотра = КТ_РазметкаСервер.HTMLКомментарияДляПросмотра(Объект.Ссылка);
    Иначе
        ТекстHTMLПросмотра = Объект.ТекстHTML;
    КонецЕсли;

КонецПроцедуры


#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПостроитьHTML(Команда)

	ПостроитьHTMLНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПоСырымДанным(Команда)

	ПроверитьПоСырымДаннымНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПостроитьHTMLНаСервере()

	ТекстHTMLПросмотра = КТ_РазметкаСервер.HTMLКомментарияДляПросмотра(Объект.Ссылка);

КонецПроцедуры

&НаСервере
Процедура ПроверитьПоСырымДаннымНаСервере()

	// Читаем объект из сохранённого ответа Kaiten: в базу при этом ничего не пишется.
	ОбъектИзСырья = КТ_СырыеДанныеСервер.ОбъектИзСырогоАрхива(Объект.Ссылка);

	ТекстСообщения = "Данные заполнены из сырого ответа. В базу ничего не записано.";
	Если ОбъектИзСырья = Неопределено Тогда
		ТекстСообщения = "В архиве сырых данных нет ответов по этому объекту.";
	Иначе
		ЗначениеВРеквизитФормы(ОбъектИзСырья, "Объект");
	КонецЕсли;

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти
