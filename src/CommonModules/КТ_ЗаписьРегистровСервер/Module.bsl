#Область ПрограммныйИнтерфейс

// Замещает пункты чек-листа.
//
// Параметры:
//  ЧекЛист - СправочникСсылка.КТ_ЧекЛисты - чек-лист.
//  МассивJSON - Массив - массив пунктов из JSON.
//  Контекст - Структура - контекст загрузки.
//
Процедура ЗаписатьПунктыЧекЛиста(ЧекЛист, МассивJSON, Контекст) Экспорт

	Набор = РегистрыСведений.КТ_ПунктыЧекЛистов.СоздатьНаборЗаписей();
	Набор.Отбор.ЧекЛист.Установить(ЧекЛист);
	Набор.Прочитать();
	Набор.Очистить();

	Для Каждого ПунктJSON Из МассивJSON Цикл

		Запись = Набор.Добавить();
		Запись.ЧекЛист = ЧекЛист;
		Запись.ИдентификаторKaiten = КТ_JSONСервер.ПолучитьЧисло(ПунктJSON, "id");
		Запись.НаименованиеKaiten = Лев(КТ_JSONСервер.ПолучитьСтроку(ПунктJSON, "text"), 500);
		Запись.Описание = КТ_JSONСервер.ПолучитьСтроку(ПунктJSON, "description");
		Запись.Выполнен = КТ_JSONСервер.ПолучитьБулево(ПунктJSON, "checked");
		Если КТ_JSONСервер.ПолучитьБулево(ПунктJSON, "due_date_has_time") Тогда
			Запись.Срок = КТ_JSONСервер.ПолучитьДатуUTC(ПунктJSON, "due_date");
		Иначе
			Запись.Срок = КТ_JSONСервер.ПолучитьКалендарнуюДату(ПунктJSON, "due_date");
		КонецЕсли;
		Запись.Порядок = КТ_JSONСервер.ПолучитьЧисло(ПунктJSON, "sort_order");
		Запись.ДатаСозданияKaiten = КТ_JSONСервер.ПолучитьДатуUTC(ПунктJSON, "created");
		Запись.ДатаИзмененияKaiten = КТ_JSONСервер.ПолучитьДатуUTC(ПунктJSON, "updated");
		Запись.Ответственный = КТ_ЗаписьОбъектовСервер.РазрешитьПользователя(
			ПунктJSON, "responsible_id", Контекст);
		Запись.СыройJSON = Новый ХранилищеЗначения(ПунктJSON, Новый СжатиеДанных(9));

	КонецЦикла;

	Если НЕ КТ_СырыеДанныеСервер.ТолькоЗаполнение(Контекст) Тогда
		Набор.Записать();
	КонецЕсли;

КонецПроцедуры

// Замещает участников карточки.
//
// Параметры:
//  Карточка - СправочникСсылка.КТ_Карточки - карточка.
//  МассивJSON - Массив - массив участников из JSON.
//  Контекст - Структура - контекст загрузки.
//
Процедура ЗаписатьУчастников(Карточка, МассивJSON, Контекст) Экспорт

	Набор = РегистрыСведений.КТ_УчастникиКарточек.СоздатьНаборЗаписей();
	Набор.Отбор.Карточка.Установить(Карточка);
	Набор.Прочитать();
	Набор.Очистить();

	Компания = КомпанияИзКонтекста(Контекст);
	МоментЗагрузки = ТекущаяУниверсальнаяДата();

	Для Каждого УчастникJSON Из МассивJSON Цикл

		ИдентификаторПользователя = ИдентификаторЭлемента(УчастникJSON, "user_id");
		Если НЕ ЗначениеЗаполнено(ИдентификаторПользователя) Тогда
			Продолжить;
		КонецЕсли;

		Пользователь = КТ_ПоискОбъектовСервер.НайтиПользователя(
			Компания, "", ИдентификаторПользователя);
		Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
			Продолжить;
		КонецЕсли;

		Запись = Набор.Добавить();
		Запись.Карточка = Карточка;
		Запись.Пользователь = Пользователь;
		Запись.ДатаПоследнейЗагрузки = МоментЗагрузки;
		Запись.СеансЗагрузки = СеансИзКонтекста(Контекст);

	КонецЦикла;

	Если НЕ КТ_СырыеДанныеСервер.ТолькоЗаполнение(Контекст) Тогда
		Набор.Записать();
	КонецЕсли;

КонецПроцедуры

// Замещает теги карточки.
//
// Параметры:
//  Карточка - СправочникСсылка.КТ_Карточки - карточка.
//  МассивJSON - Массив - массив тегов из JSON.
//  Контекст - Структура - контекст загрузки.
//
Процедура ЗаписатьТеги(Карточка, МассивJSON, Контекст) Экспорт

	Набор = РегистрыСведений.КТ_ТегиКарточек.СоздатьНаборЗаписей();
	Набор.Отбор.Карточка.Установить(Карточка);
	Набор.Прочитать();
	Набор.Очистить();

	МоментЗагрузки = ТекущаяУниверсальнаяДата();
	ОбработанныеТеги = Новый Соответствие;

	Для Каждого ТегJSON Из МассивJSON Цикл

		Тег = КТ_ЗаписьОбъектовСервер.РазрешитьТег(ТегJSON, Контекст);
		Если НЕ ЗначениеЗаполнено(Тег) Тогда
			Продолжить;
		КонецЕсли;

		Если ОбработанныеТеги.Получить(Тег) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОбработанныеТеги.Вставить(Тег, Истина);

		Запись = Набор.Добавить();
		Запись.Карточка = Карточка;
		Запись.Тег = Тег;
		Запись.ДатаПоследнейЗагрузки = МоментЗагрузки;
		Запись.СеансЗагрузки = СеансИзКонтекста(Контекст);

	КонецЦикла;

	Если НЕ КТ_СырыеДанныеСервер.ТолькоЗаполнение(Контекст) Тогда
		Набор.Записать();
	КонецЕсли;

КонецПроцедуры

// Замещает связи карточки с дочерними карточками.
//
// Параметры:
//  Карточка - СправочникСсылка.КТ_Карточки - родительская карточка.
//  МассивJSON - Массив - массив дочерних карточек из JSON.
//  Контекст - Структура - контекст загрузки.
//
Процедура ЗаписатьСвязи(Карточка, МассивJSON, Контекст) Экспорт

	Набор = РегистрыСведений.КТ_СвязиКарточек.СоздатьНаборЗаписей();
	Набор.Отбор.Карточка.Установить(Карточка);
	Набор.Прочитать();
	Набор.Очистить();

	Компания = КомпанияИзКонтекста(Контекст);
	ОбработанныеСвязи = Новый Соответствие;

	Для Каждого ДочерняяJSON Из МассивJSON Цикл

		UIDДочерней = КТ_JSONСервер.ПолучитьСтроку(ДочерняяJSON, "uid");
		ИдентификаторДочерней = КТ_JSONСервер.ПолучитьЧисло(ДочерняяJSON, "id");

		ДочерняяКарточка = КТ_ПоискОбъектовСервер.НайтиКарточку(
			Компания, UIDДочерней, ИдентификаторДочерней);

		Если НЕ ЗначениеЗаполнено(ДочерняяКарточка) Тогда
			Если ЗначениеЗаполнено(ИдентификаторДочерней) Тогда
				КТ_ПротоколЗагрузкиСервер.ЗаписатьПредупреждение(
					Контекст,
					"Дочерняя карточка еще не загружена: " + Строка(ИдентификаторДочерней));
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если ОбработанныеСвязи.Получить(ДочерняяКарточка) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОбработанныеСвязи.Вставить(ДочерняяКарточка, Истина);

		Запись = Набор.Добавить();
		Запись.Карточка = Карточка;
		Запись.СвязаннаяКарточка = ДочерняяКарточка;
		Запись.ВидСвязи = Перечисления.КТ_ВидСвязиКарточек.Дочерняя;

	КонецЦикла;

	Если НЕ КТ_СырыеДанныеСервер.ТолькоЗаполнение(Контекст) Тогда
		Набор.Записать();
	КонецЕсли;

КонецПроцедуры

// Замещает значения пользовательских полей карточки.
//
// Kaiten отдает свойства карточки объектом вида {"id_1234": "Текст", "id_5678": [101, 102]}:
// ключ содержит идентификатор поля с префиксом "id_", значение - само значение поля
// (строка, число, булево, идентификатор или массив идентификаторов значений).
//
// Параметры:
//  Карточка - СправочникСсылка.КТ_Карточки - карточка.
//  ПоляJSON - Структура, Соответствие из КлючИЗначение, Неопределено - свойства карточки из JSON.
//  Контекст - Структура - контекст загрузки.
//
Процедура ЗаписатьПользовательскиеПоля(Карточка, ПоляJSON, Контекст) Экспорт

	Набор = РегистрыСведений.КТ_ЗначенияПользовательскихПолей.СоздатьНаборЗаписей();
	Набор.Отбор.Карточка.Установить(Карточка);
	Набор.Прочитать();
	Набор.Очистить();

	Если КТ_JSONСервер.ЭтоОбъектJSON(ПоляJSON) Тогда

		Компания = КомпанияИзКонтекста(Контекст);
		МоментЗагрузки = ТекущаяУниверсальнаяДата();

		Для Каждого КлючИЗначение Из ПоляJSON Цикл

			ИдентификаторПоля = ИдентификаторПоляИзКлюча(КлючИЗначение.Ключ);
			Если НЕ ЗначениеЗаполнено(ИдентификаторПоля) Тогда
				Продолжить;
			КонецЕсли;

			Поле = КТ_ПоискОбъектовСервер.НайтиПользовательскоеПоле(
				Компания, "", ИдентификаторПоля);
			Если НЕ ЗначениеЗаполнено(Поле) Тогда
				Продолжить;
			КонецЕсли;

			Запись = Набор.Добавить();
			Запись.Карточка = Карточка;
			Запись.Поле = Поле;
			Запись.ДатаПоследнейЗагрузки = МоментЗагрузки;
			Запись.СеансЗагрузки = СеансИзКонтекста(Контекст);
			Запись.СыройJSON = Новый ХранилищеЗначения(КлючИЗначение.Значение, Новый СжатиеДанных(9));

			ЗаполнитьЗначениеПоля(Запись, КлючИЗначение.Значение, Поле, Контекст);

		КонецЦикла;

	КонецЕсли;

	Если НЕ КТ_СырыеДанныеСервер.ТолькоЗаполнение(Контекст) Тогда
		Набор.Записать();
	КонецЕсли;

КонецПроцедуры

// Замещает историю перемещений карточки.
//
// Параметры:
//  Карточка - СправочникСсылка.КТ_Карточки - карточка.
//  МассивJSON - Массив - массив событий из JSON.
//  Контекст - Структура - контекст загрузки.
//
Процедура ЗаписатьИсториюПеремещений(Карточка, МассивJSON, Контекст) Экспорт

	Набор = РегистрыСведений.КТ_ИсторияПеремещенийКарточек.СоздатьНаборЗаписей();
	Набор.Отбор.Карточка.Установить(Карточка);
	Набор.Прочитать();
	Набор.Очистить();

	ОбработанныеСобытия = Новый Соответствие;

	Для Каждого СобытиеJSON Из МассивJSON Цикл

		ИдентификаторСобытия = КТ_JSONСервер.ПолучитьЧисло(СобытиеJSON, "id");
		Если НЕ ЗначениеЗаполнено(ИдентификаторСобытия) Тогда
			Продолжить;
		КонецЕсли;

		Если ОбработанныеСобытия.Получить(ИдентификаторСобытия) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОбработанныеСобытия.Вставить(ИдентификаторСобытия, Истина);

		Запись = Набор.Добавить();
		Запись.Карточка = Карточка;
		Запись.ИдентификаторСобытияKaiten = ИдентификаторСобытия;
		Запись.МоментСобытия = КТ_JSONСервер.ПолучитьДатуUTC(СобытиеJSON, "created");
		Запись.Автор = КТ_ЗаписьОбъектовСервер.РазрешитьПользователя(
			СобытиеJSON, "user_id", Контекст);
		Запись.Доска = КТ_ЗаписьОбъектовСервер.РазрешитьДоску(СобытиеJSON, Контекст);
		Запись.Колонка = КТ_ЗаписьОбъектовСервер.РазрешитьКолонку(СобытиеJSON, Контекст);
		Запись.Подколонка = КТ_ЗаписьОбъектовСервер.РазрешитьПодколонку(СобытиеJSON, Контекст);
		Запись.Дорожка = КТ_ЗаписьОбъектовСервер.РазрешитьДорожку(СобытиеJSON, Контекст);
		Запись.СыройJSON = Новый ХранилищеЗначения(СобытиеJSON, Новый СжатиеДанных(9));

	КонецЦикла;

	Если НЕ КТ_СырыеДанныеСервер.ТолькоЗаполнение(Контекст) Тогда
		Набор.Записать();
	КонецЕсли;

КонецПроцедуры

// Замещает трудозатраты карточки.
//
// Параметры:
//  Карточка - СправочникСсылка.КТ_Карточки - карточка.
//  МассивJSON - Массив - массив трудозатрат из JSON.
//  Контекст - Структура - контекст загрузки.
//
Процедура ЗаписатьТрудозатраты(Карточка, МассивJSON, Контекст) Экспорт

	Набор = РегистрыСведений.КТ_ТрудозатратыКарточек.СоздатьНаборЗаписей();
	Набор.Отбор.Карточка.Установить(Карточка);
	Набор.Прочитать();
	Набор.Очистить();

	ОбработанныеЗаписи = Новый Соответствие;

	Для Каждого ТрудозатратаJSON Из МассивJSON Цикл

		ИдентификаторЗаписи = КТ_JSONСервер.ПолучитьЧисло(ТрудозатратаJSON, "id");
		Если НЕ ЗначениеЗаполнено(ИдентификаторЗаписи) Тогда
			Продолжить;
		КонецЕсли;

		Если ОбработанныеЗаписи.Получить(ИдентификаторЗаписи) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОбработанныеЗаписи.Вставить(ИдентификаторЗаписи, Истина);

		Запись = Набор.Добавить();
		Запись.Карточка = Карточка;
		Запись.ИдентификаторKaiten = ИдентификаторЗаписи;
		Запись.Пользователь = КТ_ЗаписьОбъектовСервер.РазрешитьПользователя(
			ТрудозатратаJSON, "user_id", Контекст);
		// for_date - календарная дата трудозатрат (без времени, без сдвига на пояс),
		// created - момент создания записи.
		Запись.ДатаНачала = КТ_JSONСервер.ПолучитьКалендарнуюДату(ТрудозатратаJSON, "for_date");
		Запись.ДатаОкончания = КТ_JSONСервер.ПолучитьДатуUTC(ТрудозатратаJSON, "created");
		Запись.ДлительностьМинут = КТ_JSONСервер.ПолучитьЧисло(ТрудозатратаJSON, "time_spent");
		Запись.Комментарий = КТ_JSONСервер.ПолучитьСтроку(ТрудозатратаJSON, "comment");
		Запись.СыройJSON = Новый ХранилищеЗначения(ТрудозатратаJSON, Новый СжатиеДанных(9));

		Запись.Роль = КТ_ЗаписьОбъектовСервер.РазрешитьРольТрудозатрат(
			ТрудозатратаJSON, Контекст);

	КонецЦикла;

	Если НЕ КТ_СырыеДанныеСервер.ТолькоЗаполнение(Контекст) Тогда
		Набор.Записать();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет ресурсы записи значениями пользовательского поля.
//
// Параметры:
//  Запись - РегистрСведенийНаборЗаписей.КТ_ЗначенияПользовательскихПолей - запись набора.
//  Значение - Произвольный - значение поля из JSON (строка, число, булево, идентификатор
//             или массив идентификаторов).
//  Поле - СправочникСсылка.КТ_ПользовательскиеПоля - пользовательское поле.
//  Контекст - Структура - контекст загрузки.
//
Процедура ЗаполнитьЗначениеПоля(Запись, Значение, Поле, Контекст)

	ТипПоля = Поле.ТипЗначенияАрхива;

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		ЗаполнитьМножественноеЗначение(Запись, Значение, Поле, Контекст);
		Возврат;
	КонецЕсли;

	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТипПоля = Перечисления.КТ_ТипЗначенияПоля.Число Тогда
		Запись.ЗначениеЧисло = КТ_JSONСервер.ЧислоИзЗначения(Значение);
		Возврат;
	КонецЕсли;

	Если ТипПоля = Перечисления.КТ_ТипЗначенияПоля.Дата Тогда
		// Значение свойства - календарная дата: смещение пояса не вычитается,
		// иначе дата сдвигается на сутки назад.
		Запись.ЗначениеДата = КТ_JSONСервер.ПреобразоватьСтрокуВКалендарнуюДату(Значение);
		Возврат;
	КонецЕсли;

	Если ТипПоля = Перечисления.КТ_ТипЗначенияПоля.Булево Тогда
		Запись.ЗначениеБулево = КТ_JSONСервер.БулевоИзЗначения(Значение);
		Возврат;
	КонецЕсли;

	Если ТипПоля = Перечисления.КТ_ТипЗначенияПоля.Пользователь Тогда
		Запись.Пользователь = КТ_ПоискОбъектовСервер.НайтиПользователя(
			КомпанияИзКонтекста(Контекст), "", ИдентификаторЭлемента(Значение, "id"));
		Возврат;
	КонецЕсли;

	Если ТипПоля = Перечисления.КТ_ТипЗначенияПоля.Список
		Или ТипПоля = Перечисления.КТ_ТипЗначенияПоля.Каталог Тогда
		Запись.ЗначениеВариант = КТ_ПоискОбъектовСервер.НайтиВариантПоля(
			Поле, "", ИдентификаторЭлемента(Значение, "id"));
		Если НЕ ЗначениеЗаполнено(Запись.ЗначениеВариант) Тогда
			Запись.ЗначениеСтрока = ПредставлениеЗначения(Значение);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Запись.ЗначениеСтрока = ПредставлениеЗначения(Значение);

КонецПроцедуры

// Заполняет ресурсы записи для множественного значения поля.
//
// Параметры:
//  Запись - РегистрСведенийНаборЗаписей.КТ_ЗначенияПользовательскихПолей - запись набора.
//  Значения - Массив - массив значений.
//  Поле - СправочникСсылка.КТ_ПользовательскиеПоля - пользовательское поле.
//  Контекст - Структура - контекст загрузки.
//
Процедура ЗаполнитьМножественноеЗначение(Запись, Значения, Поле, Контекст)

	ТипПоля = Поле.ТипЗначенияАрхива;
	Представления = Новый Массив;

	Для Каждого Значение Из Значения Цикл

		Если ТипПоля = Перечисления.КТ_ТипЗначенияПоля.Пользователь Тогда
			Пользователь = КТ_ПоискОбъектовСервер.НайтиПользователя(
				КомпанияИзКонтекста(Контекст), "", ИдентификаторЭлемента(Значение, "id"));
			Если ЗначениеЗаполнено(Пользователь) Тогда
				Представления.Добавить(Строка(Пользователь));
				Если НЕ ЗначениеЗаполнено(Запись.Пользователь) Тогда
					Запись.Пользователь = Пользователь;
				КонецЕсли;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если ТипПоля = Перечисления.КТ_ТипЗначенияПоля.Список
			Или ТипПоля = Перечисления.КТ_ТипЗначенияПоля.Каталог Тогда
			Вариант = КТ_ПоискОбъектовСервер.НайтиВариантПоля(Поле, "",
				ИдентификаторЭлемента(Значение, "id"));
			Если ЗначениеЗаполнено(Вариант) Тогда
				Представления.Добавить(Строка(Вариант));
				Если НЕ ЗначениеЗаполнено(Запись.ЗначениеВариант) Тогда
					Запись.ЗначениеВариант = Вариант;
				КонецЕсли;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Представления.Добавить(ПредставлениеЗначения(Значение));

	КонецЦикла;

	Запись.ЗначениеСтрока = СтрСоединить(Представления, ", ");

КонецПроцедуры

// Возвращает идентификатор пользовательского поля из ключа свойства карточки.
//
// Ключ свойства имеет вид "id_1234", где 1234 - идентификатор поля Kaiten.
//
// Параметры:
//  Ключ - Строка, Число - ключ свойства карточки из JSON.
//
// Возвращаемое значение:
//  Число - идентификатор поля или 0, если ключ не распознан.
//
Функция ИдентификаторПоляИзКлюча(Ключ)

	КлючСтрокой = СокрЛП(Строка(Ключ));
	Префикс = "id_";

	Если СтрНачинаетсяС(НРег(КлючСтрокой), Префикс) Тогда
		КлючСтрокой = Сред(КлючСтрокой, СтрДлина(Префикс) + 1);
	КонецЕсли;

	Возврат КТ_JSONСервер.ЧислоИзЗначения(КлючСтрокой);

КонецФункции

// Возвращает идентификатор элемента JSON, который может быть числом или структурой.
//
// Параметры:
//  ЭлементJSON - Число, Строка, Структура - элемент JSON.
//  ИмяПоля - Строка - имя поля с идентификатором внутри структуры.
//
// Возвращаемое значение:
//  Число - идентификатор или 0.
//
Функция ИдентификаторЭлемента(ЭлементJSON, ИмяПоля)

	Если ТипЗнч(ЭлементJSON) = Тип("Число") Тогда
		Возврат ЭлементJSON;
	КонецЕсли;

	Если ТипЗнч(ЭлементJSON) = Тип("Строка") Тогда
		Возврат Число(ЭлементJSON);
	КонецЕсли;

	Если НЕ КТ_JSONСервер.ЭтоОбъектJSON(ЭлементJSON) Тогда
		Возврат 0;
	КонецЕсли;

	Значение = КТ_JSONСервер.ПолучитьЧисло(ЭлементJSON, ИмяПоля);
	Если ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	Значение = КТ_JSONСервер.ПолучитьЧисло(ЭлементJSON, "id");
	Если ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат КТ_JSONСервер.ПолучитьЧисло(ЭлементJSON, "user_id");

КонецФункции

// Возвращает строковое представление значения без вызова исключения.
//
// Параметры:
//  Значение - Произвольный - исходное значение.
//
// Возвращаемое значение:
//  Строка - представление значения или пустая строка.
//
Функция ПредставлениеЗначения(Значение)

	Попытка
		Возврат СокрЛП(Строка(Значение));
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Возвращает компанию из контекста загрузки.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_Компании - ссылка на компанию.
//
Функция КомпанияИзКонтекста(Контекст)

	Если Контекст <> Неопределено И Контекст.Свойство("Компания") Тогда
		Возврат Контекст.Компания;
	КонецЕсли;

	Возврат Справочники.КТ_Компании.ПустаяСсылка();

КонецФункции

// Возвращает сеанс загрузки из контекста.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_СеансыЗагрузки - ссылка на сеанс.
//
Функция СеансИзКонтекста(Контекст)

	Если Контекст <> Неопределено И Контекст.Свойство("СеансЗагрузки") Тогда
		Возврат Контекст.СеансЗагрузки;
	КонецЕсли;

	Возврат Справочники.КТ_СеансыЗагрузки.ПустаяСсылка();

КонецФункции

#КонецОбласти
