#Область ПрограммныйИнтерфейс

// Возвращает объект архива, заполненный из сохранённого ответа Kaiten, не записывая его в базу.
//
// Вызывается с формы элемента, чтобы сверить текущее состояние объекта с тем, что получилось бы
// при восстановлении из сырого ответа. Запись в базу подавляется режимом «только заполнение»:
// признак передаётся в контексте загрузки, а писатели вместо записи возвращают заполненный объект.
//
// Параметры:
//  Ссылка - СправочникСсылка - элемент архива.
//
// Возвращаемое значение:
//  СправочникОбъект, Неопределено - заполненный объект или Неопределено, если ответа в архиве нет.
//
Функция ОбъектИзСырогоАрхива(Ссылка) Экспорт

	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ВидСущности = ВидСущностиПоСсылке(Ссылка);
	Если ВидСущности = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЗаписьАрхива = ЗаписьСырогоАрхива(ВидСущности, Ссылка);
	Если ЗаписьАрхива = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Элемент = ЭлементСырогоОтвета(ЗаписьАрхива, Ссылка, ВидСущности);
	Если Элемент = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Контекст = КТ_ЗагрузкаKaitenСервер.КонтекстВосстановления(ЗаписьАрхива);
	Контекст.Вставить("ТолькоЗаполнение", Истина);
	Контекст.Вставить("ЗаполненныйОбъект", Неопределено);

	ЗаполнитьИзСырья(Элемент, ВидСущности, Ссылка, Контекст);

	Возврат Контекст.ЗаполненныйОбъект;

КонецФункции

// Возвращает признак режима «только заполнение»: писатели заполняют объекты, но не записывают их.
//
// Параметры:
//  Контекст - Структура, Неопределено - контекст загрузки.
//
// Возвращаемое значение:
//  Булево - Истина, если запись в базу подавляется.
//
Функция ТолькоЗаполнение(Контекст) Экспорт

	Если Контекст = Неопределено Или ТипЗнч(Контекст) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Контекст.Свойство("ТолькоЗаполнение") И Контекст.ТолькоЗаполнение = Истина;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет объект из элемента сырого ответа, не записывая его.
//
// Параметры:
//  Элемент - Структура - элемент ответа Kaiten.
//  ВидСущности - ПеречислениеСсылка.КТ_ВидСущностиKaiten - вид сущности.
//  Ссылка - СправочникСсылка - элемент архива.
//  Контекст - Структура - контекст восстановления.
//
Процедура ЗаполнитьИзСырья(Элемент, ВидСущности, Ссылка, Контекст)

	Если ВидСущности = Перечисления.КТ_ВидСущностиKaiten.Комментарий
		Или ВидСущности = Перечисления.КТ_ВидСущностиKaiten.ЧекЛист Тогда

		Карточка = ЗначениеРеквизита(Ссылка, "Карточка");
		Если НЕ ЗначениеЗаполнено(Карточка) Тогда
			Возврат;
		КонецЕсли;

		Элементы = Новый Массив;
		Элементы.Добавить(Элемент);
		КТ_ЗагрузкаKaitenСервер.ВосстановитьДочерниеДанные(Карточка, ВидСущности, Элементы, Контекст);
		Возврат;

	КонецЕсли;

	КТ_ЗагрузкаKaitenСервер.ВосстановитьСущность(Элемент, ВидСущности, Контекст);

КонецПроцедуры

// Возвращает вид сущности Kaiten по ссылке архива.
//
// Параметры:
//  Ссылка - СправочникСсылка - элемент архива.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.КТ_ВидСущностиKaiten, Неопределено - вид сущности.
//
Функция ВидСущностиПоСсылке(Ссылка)

	Соответствие = Новый Соответствие;
	Соответствие.Вставить("КТ_Компании", Перечисления.КТ_ВидСущностиKaiten.Компания);
	Соответствие.Вставить("КТ_Пользователи", Перечисления.КТ_ВидСущностиKaiten.Пользователь);
	Соответствие.Вставить("КТ_Пространства", Перечисления.КТ_ВидСущностиKaiten.Пространство);
	Соответствие.Вставить("КТ_Доски", Перечисления.КТ_ВидСущностиKaiten.Доска);
	Соответствие.Вставить("КТ_Колонки", Перечисления.КТ_ВидСущностиKaiten.Колонка);
	Соответствие.Вставить("КТ_Дорожки", Перечисления.КТ_ВидСущностиKaiten.Дорожка);
	Соответствие.Вставить("КТ_ТипыКарточек", Перечисления.КТ_ВидСущностиKaiten.ТипКарточки);
	Соответствие.Вставить("КТ_Теги", Перечисления.КТ_ВидСущностиKaiten.Тег);
	Соответствие.Вставить("КТ_РолиТрудозатрат", Перечисления.КТ_ВидСущностиKaiten.РольТрудозатрат);
	Соответствие.Вставить("КТ_ПользовательскиеПоля", Перечисления.КТ_ВидСущностиKaiten.ПользовательскоеПоле);
	Соответствие.Вставить("КТ_Карточки", Перечисления.КТ_ВидСущностиKaiten.Карточка);
	Соответствие.Вставить("КТ_Комментарии", Перечисления.КТ_ВидСущностиKaiten.Комментарий);
	Соответствие.Вставить("КТ_ЧекЛисты", Перечисления.КТ_ВидСущностиKaiten.ЧекЛист);
	Соответствие.Вставить("КТ_ВариантыПользовательскихПолей", Перечисления.КТ_ВидСущностиKaiten.ЗначениеСписка);

	Возврат Соответствие.Получить(Ссылка.Метаданные().Имя);

КонецФункции

// Находит последнюю успешную запись сырого архива по объекту.
//
// Параметры:
//  ВидСущности - ПеречислениеСсылка.КТ_ВидСущностиKaiten - вид сущности.
//  Ссылка - СправочникСсылка - элемент архива.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_СырыеОбъектыAPI, Неопределено - запись архива.
//
Функция ЗаписьСырогоАрхива(ВидСущности, Ссылка)

	Суффикс = СуффиксМаршрута(ВидСущности);
	Если НЕ ПустаяСтрока(Суффикс) Тогда
		Карточка = ЗначениеРеквизита(Ссылка, "Карточка");
		Если НЕ ЗначениеЗаполнено(Карточка) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат ЗаписьСырогоАрхиваПоПути(Карточка, Суффикс);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Записи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КТ_СырыеОбъектыAPI КАК Записи
	|ГДЕ
	|	Записи.ВидСущности = &ВидСущности
	|	И Записи.УспешноРазобран
	|	И Записи.КодHTTP = 200
	|	И (Записи.UIDKaiten = &UIDKaiten
	|		ИЛИ Записи.ИдентификаторKaiten = &ИдентификаторKaiten)
	|УПОРЯДОЧИТЬ ПО
	|	Записи.ДатаПолучения УБЫВ";

	Запрос.УстановитьПараметр("ВидСущности", ВидСущности);
	Запрос.УстановитьПараметр("UIDKaiten", НРег(Строка(ЗначениеРеквизита(Ссылка, "UIDKaiten"))));
	Запрос.УстановитьПараметр("ИдентификаторKaiten",
		ИдентификаторВСтроке(ЗначениеРеквизита(Ссылка, "ИдентификаторKaiten")));

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Находит запись сырого архива по маршруту карточки.
//
// Параметры:
//  Карточка - СправочникСсылка.КТ_Карточки - головная карточка.
//  Суффикс - Строка - суффикс маршрута, например "comments".
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_СырыеОбъектыAPI, Неопределено - запись архива.
//
Функция ЗаписьСырогоАрхиваПоПути(Карточка, Суффикс)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Записи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КТ_СырыеОбъектыAPI КАК Записи
	|ГДЕ
	|	Записи.ПутьЗапроса = &Путь
	|	И Записи.УспешноРазобран
	|	И Записи.КодHTTP = 200
	|УПОРЯДОЧИТЬ ПО
	|	Записи.ДатаПолучения УБЫВ";

	Запрос.УстановитьПараметр("Путь", "/cards/"
		+ ИдентификаторВСтроке(ЗначениеРеквизита(Карточка, "ИдентификаторKaiten"))
		+ "/" + Суффикс);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Возвращает элемент сырого ответа, относящийся к объекту.
//
// Параметры:
//  ЗаписьАрхива - СправочникСсылка.КТ_СырыеОбъектыAPI - запись архива.
//  Ссылка - СправочникСсылка - элемент архива.
//  ВидСущности - ПеречислениеСсылка.КТ_ВидСущностиKaiten - вид сущности.
//
// Возвращаемое значение:
//  Структура, Неопределено - элемент ответа Kaiten.
//
Функция ЭлементСырогоОтвета(ЗаписьАрхива, Ссылка, ВидСущности)

	Данные = Неопределено;
	Если ЗаписьАрхива <> Неопределено Тогда
		Данные = РазобратьСыройОтвет(ЗначениеРеквизита(ЗаписьАрхива, "JSON"));
	КонецЕсли;

	Если Данные = Неопределено Тогда
		Данные = РазобратьСыройОтвет(ЗначениеРеквизита(Ссылка, "СыройJSON"));
	КонецЕсли;

	Если Данные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ВидСущности = Перечисления.КТ_ВидСущностиKaiten.Комментарий
		Или ВидСущности = Перечисления.КТ_ВидСущностиKaiten.ЧекЛист Тогда
		Возврат НайтиЭлементВМассиве(Данные, Ссылка);
	КонецЕсли;

	// Ответы НСИ сохраняются постранично, поэтому в архиве лежит массив.
	Если ТипЗнч(Данные) = Тип("Массив") Тогда
		Возврат НайтиЭлементВМассиве(Данные, Ссылка);
	КонецЕсли;

	Возврат Данные;

КонецФункции

// Разбирает значение сырого архива в данные JSON.
//
// Параметры:
//  Значение - Строка, ХранилищеЗначения, Структура, Соответствие, Массив, Неопределено - значение архива.
//
// Возвращаемое значение:
//  Структура, Соответствие, Массив, Неопределено - разобранные данные.
//
Функция РазобратьСыройОтвет(Значение)

	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("ХранилищеЗначения") Тогда
		Значение = Значение.Получить();
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат КТ_JSONСервер.ПрочитатьJSONИзСтроки(Значение);
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Ищет элемент ответа Kaiten с идентификаторами объекта.
//
// Параметры:
//  Данные - Массив из Структура - разобранный ответ Kaiten.
//  Ссылка - СправочникСсылка - элемент архива.
//
// Возвращаемое значение:
//  Структура, Неопределено - элемент ответа Kaiten.
//
Функция НайтиЭлементВМассиве(Данные, Ссылка)

	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;

	UID = НРег(Строка(ЗначениеРеквизита(Ссылка, "UIDKaiten")));
	Идентификатор = ИдентификаторВСтроке(ЗначениеРеквизита(Ссылка, "ИдентификаторKaiten"));

	Для Каждого Элемент Из Данные Цикл

		Если НЕ КТ_JSONСервер.ЭтоОбъектJSON(Элемент) Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ ПустаяСтрока(UID)
			И НРег(КТ_JSONСервер.ПолучитьСтроку(Элемент, "uid")) = UID Тогда
			Возврат Элемент;
		КонецЕсли;

		Если НЕ ПустаяСтрока(Идентификатор)
			И ИдентификаторВСтроке(КТ_JSONСервер.ПолучитьЧисло(Элемент, "id")) = Идентификатор Тогда
			Возврат Элемент;
		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Возвращает суффикс маршрута Kaiten для дочерних данных карточки.
//
// Параметры:
//  ВидСущности - ПеречислениеСсылка.КТ_ВидСущностиKaiten - вид сущности.
//
// Возвращаемое значение:
//  Строка - суффикс маршрута или пустая строка.
//
Функция СуффиксМаршрута(ВидСущности)

	Если ВидСущности = Перечисления.КТ_ВидСущностиKaiten.Комментарий Тогда
		Возврат "comments";
	КонецЕсли;

	Если ВидСущности = Перечисления.КТ_ВидСущностиKaiten.ЧекЛист Тогда
		Возврат "checklists";
	КонецЕсли;

	Возврат "";

КонецФункции

// Возвращает значение реквизита объекта, если такой реквизит есть у справочника.
//
// Параметры:
//  Ссылка - СправочникСсылка - элемент архива.
//  Имя - Строка - имя реквизита.
//
// Возвращаемое значение:
//  Произвольный - значение реквизита или Неопределено.
//
Функция ЗначениеРеквизита(Ссылка, Имя)

	Если Ссылка.Метаданные().Реквизиты.Найти(Имя) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Ссылка[Имя];

КонецФункции

// Приводит идентификатор Kaiten к строке без разделителей разрядов.
//
// Параметры:
//  ИдентификаторKaiten - Число, Строка, Неопределено - внешний идентификатор.
//
// Возвращаемое значение:
//  Строка - идентификатор в виде строки.
//
Функция ИдентификаторВСтроке(ИдентификаторKaiten)

	Если ТипЗнч(ИдентификаторKaiten) = Тип("Число") Тогда
		Возврат Формат(ИдентификаторKaiten, "ЧГ=0");
	КонецЕсли;

	Возврат СокрЛП(Строка(ИдентификаторKaiten));

КонецФункции

#КонецОбласти
