#Область ПрограммныйИнтерфейс

// Выполняет финальную проверку полноты архива.
//
// Параметры:
//  СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки - сеанс загрузки.
//  Контекст - Структура, Неопределено - контекст загрузки для записи в протокол.
//
// Возвращаемое значение:
//  Структура - результаты проверки:
//   * ВсегоКарточек - Число - количество карточек в архиве;
//   * ЗагруженоПолностью - Число - количество карточек с признаком полной загрузки;
//   * СОшибками - Число - количество карточек с ошибками загрузки;
//   * НезагруженныхФайлов - Число - количество файлов без загруженного содержимого;
//   * ОшибокОчереди - Число - количество заданий очереди, завершившихся ошибкой;
//   * КарточекСТрудозатратами - Число - количество карточек, у которых есть трудозатраты;
//   * ТрудозатратВсего - Число - количество записей трудозатрат;
//   * ТрудозатратМинут - Число - суммарная длительность трудозатрат в минутах;
//   * ОшибокТрудозатрат - Число - количество заданий загрузки трудозатрат с ошибкой;
//   * Замечания - Массив из Строка - текстовые замечания по результатам проверки.
//
// Трудозатраты - необязательный блок карточки: их отсутствие замечанием не считается,
// замечание формируется только при ошибках загрузки трудозатрат.
//
Функция ПроверитьПолноту(СеансЗагрузки, Контекст = Неопределено) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("ВсегоКарточек", 0);
	Результат.Вставить("ЗагруженоПолностью", 0);
	Результат.Вставить("СОшибками", 0);
	Результат.Вставить("НезагруженныхФайлов", 0);
	Результат.Вставить("ОшибокОчереди", 0);
	Результат.Вставить("КарточекСТрудозатратами", 0);
	Результат.Вставить("ТрудозатратВсего", 0);
	Результат.Вставить("ТрудозатратМинут", 0);
	Результат.Вставить("ОшибокТрудозатрат", 0);
	Результат.Вставить("Замечания", Новый Массив);

	СтатистикаКарточек(Результат);
	СтатистикаФайлов(Результат);
	СтатистикаОчереди(СеансЗагрузки, Результат);
	СтатистикаТрудозатрат(СеансЗагрузки, Результат);

	СформироватьЗамечания(Результат);

	Если Контекст <> Неопределено Тогда
		ЗаписатьВПротокол(Контекст, Результат);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает количество трудозатрат, записанных по карточкам сеанса загрузки.
//
// Параметры:
//  СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки - сеанс загрузки.
//
// Возвращаемое значение:
//  Число - количество записей регистра КТ_ТрудозатратыКарточек.
//
Функция КоличествоТрудозатратСеанса(СеансЗагрузки) Экспорт

	Если НЕ ЗначениеЗаполнено(СеансЗагрузки) Тогда
		Возврат 0;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	РегистрСведений.КТ_ТрудозатратыКарточек КАК Трудозатраты
	|ГДЕ
	|	Трудозатраты.Карточка.СеансПоследнейЗагрузки = &Сеанс";

	Запрос.УстановитьПараметр("Сеанс", СеансЗагрузки);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;

	Возврат 0;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет статистику по карточкам архива.
//
// Параметры:
//  Результат - Структура - заполняемая структура результата.
//
Процедура СтатистикаКарточек(Результат)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Всего,
	|	ЕстьNull(СУММА(ВЫБОР
	|			КОГДА Карточки.ДанныеЗагруженыПолностью
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ),0) КАК ЗагруженоПолностью,
	|	ЕстьNull(СУММА(ВЫБОР
	|			КОГДА Карточки.ЕстьОшибкиЗагрузки
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ),0) КАК СОшибками
	|ИЗ
	|	Справочник.КТ_Карточки КАК Карточки";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.ВсегоКарточек = Выборка.Всего;
		Результат.ЗагруженоПолностью = Выборка.ЗагруженоПолностью;
		Результат.СОшибками = Выборка.СОшибками;
	КонецЕсли;

КонецПроцедуры

// Заполняет статистику по файлам архива.
//
// Параметры:
//  Результат - Структура - заполняемая структура результата.
//
Процедура СтатистикаФайлов(Результат)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	Справочник.КТ_Файлы КАК Файлы
	|ГДЕ
	|	НЕ Файлы.ФайлПроверен
	|	И Файлы.СпособХранения = &НеЗагружен";

	Запрос.УстановитьПараметр("НеЗагружен",
		Перечисления.КТ_СпособХраненияФайла.НеЗагружен);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.НезагруженныхФайлов = Выборка.Количество;
	КонецЕсли;

КонецПроцедуры

// Заполняет статистику по заданиям очереди сеанса.
//
// Параметры:
//  СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки - сеанс загрузки.
//  Результат - Структура - заполняемая структура результата.
//
Процедура СтатистикаОчереди(СеансЗагрузки, Результат)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	РегистрСведений.КТ_ОчередьЗагрузки КАК Очередь
	|ГДЕ
	|	Очередь.СеансЗагрузки = &Сеанс
	|	И Очередь.Состояние = &Ошибка";

	Запрос.УстановитьПараметр("Сеанс", СеансЗагрузки);
	Запрос.УстановитьПараметр("Ошибка", Перечисления.КТ_СостояниеЗагрузки.Ошибка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.ОшибокОчереди = Выборка.Количество;
	КонецЕсли;

КонецПроцедуры

// Заполняет статистику по трудозатратам.
//
// Параметры:
//  СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки - сеанс загрузки.
//  Результат - Структура - заполняемая структура результата.
//
Процедура СтатистикаТрудозатрат(СеансЗагрузки, Результат)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Трудозатраты.Карточка) КАК КарточекСТрудозатратами,
	|	КОЛИЧЕСТВО(*) КАК ТрудозатратВсего,
	|	ЕстьNull(СУММА(Трудозатраты.ДлительностьМинут), 0) КАК ТрудозатратМинут
	|ИЗ
	|	РегистрСведений.КТ_ТрудозатратыКарточек КАК Трудозатраты";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.КарточекСТрудозатратами = Выборка.КарточекСТрудозатратами;
		Результат.ТрудозатратВсего = Выборка.ТрудозатратВсего;
		Результат.ТрудозатратМинут = Выборка.ТрудозатратМинут;
	КонецЕсли;

	ЗапросОшибок = Новый Запрос;
	ЗапросОшибок.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	РегистрСведений.КТ_ОчередьЗагрузки КАК Очередь
	|ГДЕ
	|	Очередь.СеансЗагрузки = &Сеанс
	|	И Очередь.Состояние = &Ошибка
	|	И Очередь.КлючЗадания ПОДОБНО &МаскаТрудозатрат";

	ЗапросОшибок.УстановитьПараметр("Сеанс", СеансЗагрузки);
	ЗапросОшибок.УстановитьПараметр("Ошибка", Перечисления.КТ_СостояниеЗагрузки.Ошибка);
	ЗапросОшибок.УстановитьПараметр("МаскаТрудозатрат", "%:TIME_LOGS");

	ВыборкаОшибок = ЗапросОшибок.Выполнить().Выбрать();
	Если ВыборкаОшибок.Следующий() Тогда
		Результат.ОшибокТрудозатрат = ВыборкаОшибок.Количество;
	КонецЕсли;

КонецПроцедуры

// Формирует текстовые замечания по результатам проверки.
//
// Параметры:
//  Результат - Структура - заполненная структура результата.
//
Процедура СформироватьЗамечания(Результат)

	Незавершенных = Результат.ВсегоКарточек - Результат.ЗагруженоПолностью;
	Если Незавершенных > 0 Тогда
		Результат.Замечания.Добавить(
			"Карточек без признака полной загрузки: " + Незавершенных);
	КонецЕсли;

	Если Результат.СОшибками > 0 Тогда
		Результат.Замечания.Добавить(
			"Карточек с ошибками загрузки: " + Результат.СОшибками);
	КонецЕсли;

	Если Результат.НезагруженныхФайлов > 0 Тогда
		Результат.Замечания.Добавить(
			"Файлов без содержимого: " + Результат.НезагруженныхФайлов);
	КонецЕсли;

	Если Результат.ОшибокОчереди > 0 Тогда
		Результат.Замечания.Добавить(
			"Заданий очереди с ошибкой: " + Результат.ОшибокОчереди);
	КонецЕсли;

	// Трудозатраты - необязательный блок карточки: отсутствие данных замечанием не считается,
	// сообщаем только об ошибках их загрузки.
	Если Результат.ОшибокТрудозатрат > 0 Тогда
		Результат.Замечания.Добавить(
			"Заданий загрузки трудозатрат с ошибкой: " + Результат.ОшибокТрудозатрат);
	КонецЕсли;

КонецПроцедуры

// Записывает результаты проверки в протокол загрузки.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//  Результат - Структура - результаты проверки.
//
Процедура ЗаписатьВПротокол(Контекст, Результат)

	Текст = "Полнота архива: карточек " + Результат.ВсегоКарточек
		+ ", загружено полностью " + Результат.ЗагруженоПолностью
		+ ", файлов без содержимого " + Результат.НезагруженныхФайлов
		+ ", трудозатраты (необязательный блок): карточек "
		+ Результат.КарточекСТрудозатратами
		+ ", записей " + Результат.ТрудозатратВсего
		+ ", минут " + Результат.ТрудозатратМинут;

	Если Результат.Замечания.Количество() = 0 Тогда
		КТ_ПротоколЗагрузкиСервер.Информация(Контекст, Текст);
		Возврат;
	КонецЕсли;

	КТ_ПротоколЗагрузкиСервер.ЗаписатьПредупреждение(Контекст,
		Текст + ". Замечания: " + СтрСоединить(Результат.Замечания, "; "));

КонецПроцедуры

#КонецОбласти
