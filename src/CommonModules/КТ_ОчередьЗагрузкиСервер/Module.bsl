#Область ПрограммныйИнтерфейс

// Формирует детерминированный ключ задания для карточки.
//
// Параметры:
//  UIDКарточки - Строка - UID карточки Kaiten.
//
// Возвращаемое значение:
//  Строка - ключ задания.
//
Функция КлючКарточки(UIDКарточки) Экспорт

	Возврат "CARD:" + НРег(СокрЛП(UIDКарточки));

КонецФункции

// Формирует ключ задания для дочерних данных карточки.
//
// Параметры:
//  UIDКарточки - Строка - UID карточки Kaiten.
//  ВидДанных - Строка - вид дочерних данных: COMMENTS, CHECKLISTS, CHILDREN,
//              LOCATION_HISTORY, TIME_LOGS, FILES.
//
// Возвращаемое значение:
//  Строка - ключ задания.
//
Функция КлючДочернегоЗадания(UIDКарточки, ВидДанных) Экспорт

	Возврат КлючКарточки(UIDКарточки) + ":" + ВРег(СокрЛП(ВидДанных));

КонецФункции

// Формирует ключ задания для файла.
//
// Параметры:
//  КлючРодителя - Строка - ключ задания родителя.
//  UIDФайла - Строка - UID файла Kaiten.
//
// Возвращаемое значение:
//  Строка - ключ задания.
//
Функция КлючФайла(КлючРодителя, UIDФайла) Экспорт

	Возврат КлючРодителя + ":FILE:" + НРег(СокрЛП(UIDФайла));

КонецФункции

// Ставит задание в очередь. Повторная постановка того же ключа не создает дубль.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//  КлючЗадания - Строка - детерминированный ключ задания.
//  ВидОперации - ПеречислениеСсылка.КТ_ВидОперацииОчереди - вид операции.
//  ПараметрыЗадания - Структура - дополнительные параметры задания:
//   * ВидСущности - ПеречислениеСсылка.КТ_ВидСущностиKaiten - вид сущности Kaiten;
//   * ИдентификаторKaiten - Строка - идентификатор сущности Kaiten;
//   * UIDKaiten - Строка - UID сущности Kaiten;
//   * ПутьЗапроса - Строка - путь запроса задания;
//   * Приоритет - Число - приоритет, меньшее значение выполняется раньше.
//
// Возвращаемое значение:
//  Булево - Истина, если задание добавлено.
//
Функция ПоставитьЗадание(Контекст, КлючЗадания, ВидОперации, ПараметрыЗадания = Неопределено) Экспорт

	Ключ = Лев(СокрЛП(КлючЗадания), 250);
	Если ПустаяСтрока(Ключ) Тогда
		Возврат Ложь;
	КонецЕсли;

	Сеанс = СеансИзКонтекста(Контекст);

	Запись = РегистрыСведений.КТ_ОчередьЗагрузки.СоздатьМенеджерЗаписи();
	Запись.КлючЗадания = Ключ;
	Запись.Прочитать();

	// Ключ задания не содержит сеанса, поэтому задание из прошлого сеанса перепривязывается
	// к текущему и ставится заново. Иначе повторная загрузка не получит работу из очереди.
	Если Запись.Выбран()
		И (НЕ ЗначениеЗаполнено(Сеанс) Или Запись.СеансЗагрузки = Сеанс)
		И Запись.Состояние <> Перечисления.КТ_СостояниеЗагрузки.Ошибка Тогда
		Возврат Ложь;
	КонецЕсли;

	Запись.ВидОперации = ВидОперации;
	Запись.Приоритет = ЗначениеПараметра(ПараметрыЗадания, "Приоритет", 5);
	Запись.Состояние = Перечисления.КТ_СостояниеЗагрузки.Ожидает;
	Запись.ЧислоПопыток = 0;
	Запись.ДатаПостановки = ТекущаяУниверсальнаяДата();
	Запись.ДатаНачала = '00010101000000';
	Запись.ДатаОкончания = '00010101000000';
	Запись.НеРанее = '00010101000000';
	Запись.СеансЗагрузки = Сеанс;
	Запись.ТекстОшибки = "";
	Запись.ИдентификаторKaiten = Лев(СокрЛП(
		ЗначениеПараметра(ПараметрыЗадания, "ИдентификаторKaiten", "")), 100);
	Запись.UIDKaiten = Лев(НРег(СокрЛП(
		ЗначениеПараметра(ПараметрыЗадания, "UIDKaiten", ""))), 36);
	Запись.ПутьЗапроса = Лев(СокрЛП(
		ЗначениеПараметра(ПараметрыЗадания, "ПутьЗапроса", "")), 1000);

	ВидСущности = ЗначениеПараметра(ПараметрыЗадания, "ВидСущности", Неопределено);
	Если ВидСущности <> Неопределено Тогда
		Запись.ВидСущности = ВидСущности;
	КонецЕсли;

	// Прочитать() обнуляет измерения, если запись не найдена, поэтому ключ задается заново перед записью.
	Запись.КлючЗадания = Ключ;
	Запись.Записать();

	Возврат Истина;

КонецФункции

// Возвращает очередное задание сеанса.
//
// Параметры:
//  СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки - сеанс загрузки.
//
// Возвращаемое значение:
//  Структура - описание задания:
//   * КлючЗадания - Строка - ключ задания, пустая строка - если готовых заданий нет;
//   * ВидОперации - ПеречислениеСсылка.КТ_ВидОперацииОчереди - вид операции;
//   * ВидСущности - ПеречислениеСсылка.КТ_ВидСущностиKaiten - вид сущности Kaiten;
//   * UIDKaiten - Строка - UID сущности Kaiten;
//   * ИдентификаторKaiten - Строка - идентификатор сущности Kaiten;
//   * ПутьЗапроса - Строка - путь запроса задания.
//
Функция ПолучитьСледующееЗадание(СеансЗагрузки) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Очередь.КлючЗадания КАК КлючЗадания,
	|	Очередь.ВидОперации КАК ВидОперации,
	|	Очередь.ВидСущности КАК ВидСущности,
	|	Очередь.UIDKaiten КАК UIDKaiten,
	|	Очередь.ИдентификаторKaiten КАК ИдентификаторKaiten,
	|	Очередь.ПутьЗапроса КАК ПутьЗапроса
	|ИЗ
	|	РегистрСведений.КТ_ОчередьЗагрузки КАК Очередь
	|ГДЕ
	|	Очередь.СеансЗагрузки = &Сеанс
	|	И Очередь.Состояние = &Ожидает
	|	И Очередь.НеРанее <= &Сейчас
	|УПОРЯДОЧИТЬ ПО
	|	Очередь.Приоритет,
	|	Очередь.КлючЗадания";
	Запрос.УстановитьПараметр("Сеанс", СеансЗагрузки);
	Запрос.УстановитьПараметр("Ожидает", Перечисления.КТ_СостояниеЗагрузки.Ожидает);
	Запрос.УстановитьПараметр("Сейчас", ТекущаяУниверсальнаяДата());

	Задание = Новый Структура;
	Задание.Вставить("КлючЗадания", "");
	Задание.Вставить("ВидОперации", Перечисления.КТ_ВидОперацииОчереди.ПустаяСсылка());
	Задание.Вставить("ВидСущности", Перечисления.КТ_ВидСущностиKaiten.ПустаяСсылка());
	Задание.Вставить("UIDKaiten", "");
	Задание.Вставить("ИдентификаторKaiten", "");
	Задание.Вставить("ПутьЗапроса", "");

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Задание.КлючЗадания = Выборка.КлючЗадания;
		Задание.ВидОперации = Выборка.ВидОперации;
		Задание.ВидСущности = Выборка.ВидСущности;
		Задание.UIDKaiten = Выборка.UIDKaiten;
		Задание.ИдентификаторKaiten = Выборка.ИдентификаторKaiten;
		Задание.ПутьЗапроса = Выборка.ПутьЗапроса;
	КонецЕсли;

	Возврат Задание;

КонецФункции

// Переводит задание в состояние выполнения.
//
// Параметры:
//  КлючЗадания - Строка - ключ задания.
//
// Возвращаемое значение:
//  Булево - Истина, если задание захвачено этим вызовом; Ложь, если задание уже выполняет другое задание.
//
Функция НачатьВыполнение(КлючЗадания) Экспорт

	НачатьТранзакцию();
	Попытка

		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.КТ_ОчередьЗагрузки");
		ЭлементБлокировки.УстановитьЗначение("КлючЗадания", КлючЗадания);
		Блокировка.Заблокировать();

		Запись = ЗаписьОчереди(КлючЗадания);
		Если Запись = Неопределено Или Запись.Состояние <> Перечисления.КТ_СостояниеЗагрузки.Ожидает Тогда
			ЗафиксироватьТранзакцию();
			Возврат Ложь;
		КонецЕсли;

		Запись.Состояние = Перечисления.КТ_СостояниеЗагрузки.Выполняется;
		Запись.ДатаНачала = ТекущаяУниверсальнаяДата();
		Запись.Записать();

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Переводит задание в конечное состояние.
//
// Параметры:
//  КлючЗадания - Строка - ключ задания.
//  Состояние - ПеречислениеСсылка.КТ_СостояниеЗагрузки - итоговое состояние.
//  ТекстОшибки - Строка - описание ошибки.
//
Процедура ЗавершитьЗадание(КлючЗадания, Состояние, ТекстОшибки = "") Экспорт

	Запись = ЗаписьОчереди(КлючЗадания);
	Если Запись = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Запись.Состояние = Состояние;
	Запись.ДатаОкончания = ТекущаяУниверсальнаяДата();
	Запись.ТекстОшибки = СокрЛП(ТекстОшибки);
	Запись.Записать();

КонецПроцедуры

// Откладывает задание на повтор с увеличением счетчика попыток.
//
// Параметры:
//  КлючЗадания - Строка - ключ задания.
//  ТекстОшибки - Строка - описание ошибки.
//  ЗадержкаСекунд - Число - задержка до следующей попытки.
//
Процедура ОтложитьЗадание(КлючЗадания, ТекстОшибки, ЗадержкаСекунд) Экспорт

	Запись = ЗаписьОчереди(КлючЗадания);
	Если Запись = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Запись.Состояние = Перечисления.КТ_СостояниеЗагрузки.Ожидает;
	Запись.ЧислоПопыток = Запись.ЧислоПопыток + 1;
	Запись.НеРанее = ТекущаяУниверсальнаяДата() + ЗадержкаСекунд / 86400;
	Запись.ТекстОшибки = СокрЛП(ТекстОшибки);
	Запись.Записать();

КонецПроцедуры

// Возвращает количество попыток задания.
//
// Параметры:
//  КлючЗадания - Строка - ключ задания.
//
// Возвращаемое значение:
//  Число - количество выполненных попыток.
//
Функция КоличествоПопыток(КлючЗадания) Экспорт

	Запись = ЗаписьОчереди(КлючЗадания);
	Если Запись = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Запись.ЧислоПопыток;

КонецФункции

// Возвращает сводку состояний заданий сеанса.
//
// Параметры:
//  СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки - сеанс загрузки.
//
// Возвращаемое значение:
//  Структура - количество заданий по состояниям:
//   * Ожидает - Число - количество заданий в ожидании;
//   * Выполняется - Число - количество выполняемых заданий;
//   * Загружено - Число - количество успешно выполненных заданий;
//   * Пропущено - Число - количество пропущенных заданий;
//   * Ошибка - Число - количество заданий с ошибкой.
//
Функция СостояниеОчереди(СеансЗагрузки) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.Состояние КАК Состояние,
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	РегистрСведений.КТ_ОчередьЗагрузки КАК Очередь
	|ГДЕ
	|	Очередь.СеансЗагрузки = &Сеанс
	|СГРУППИРОВАТЬ ПО
	|	Очередь.Состояние";
	Запрос.УстановитьПараметр("Сеанс", СеансЗагрузки);

	Результат = Новый Структура;
	Результат.Вставить("Ожидает", 0);
	Результат.Вставить("Выполняется", 0);
	Результат.Вставить("Загружено", 0);
	Результат.Вставить("Пропущено", 0);
	Результат.Вставить("Ошибка", 0);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Состояние = Перечисления.КТ_СостояниеЗагрузки.Ожидает Тогда
			Результат.Ожидает = Выборка.Количество;
		ИначеЕсли Выборка.Состояние = Перечисления.КТ_СостояниеЗагрузки.Выполняется Тогда
			Результат.Выполняется = Выборка.Количество;
		ИначеЕсли Выборка.Состояние = Перечисления.КТ_СостояниеЗагрузки.Ошибка Тогда
			Результат.Ошибка = Выборка.Количество;
		ИначеЕсли Выборка.Состояние = Перечисления.КТ_СостояниеЗагрузки.Пропущено Тогда
			Результат.Пропущено = Выборка.Количество;
		Иначе
			Результат.Загружено = Выборка.Количество;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает зависшие задания в состояние ожидания.
//
// Параметры:
//  СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки - сеанс загрузки.
//  ТаймаутСекунд - Число - предельное время выполнения задания.
//
// Возвращаемое значение:
//  Число - количество возвращенных заданий.
//
Функция ВернутьЗависшиеЗадания(СеансЗагрузки, ТаймаутСекунд = 1800) Экспорт

	Граница = ТекущаяУниверсальнаяДата() - ТаймаутСекунд / 86400;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.КлючЗадания КАК КлючЗадания
	|ИЗ
	|	РегистрСведений.КТ_ОчередьЗагрузки КАК Очередь
	|ГДЕ
	|	Очередь.СеансЗагрузки = &Сеанс
	|	И Очередь.Состояние = &Выполняется
	|	И Очередь.ДатаНачала < &Граница";
	Запрос.УстановитьПараметр("Сеанс", СеансЗагрузки);
	Запрос.УстановитьПараметр("Выполняется", Перечисления.КТ_СостояниеЗагрузки.Выполняется);
	Запрос.УстановитьПараметр("Граница", Граница);

	Выборка = Запрос.Выполнить().Выбрать();
	Ключи = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Ключи.Добавить(Выборка.КлючЗадания);
	КонецЦикла;

	Для Каждого Ключ Из Ключи Цикл
		Запись = ЗаписьОчереди(Ключ);
		Если Запись = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Запись.Состояние = Перечисления.КТ_СостояниеЗагрузки.Ожидает;
		Запись.ТекстОшибки = "Задание возвращено после таймаута";
		Запись.Записать();
	КонецЦикла;

	Возврат Ключи.Количество();

КонецФункции

// Выполняет порцию заданий очереди.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//  МаксимумЗаданий - Число - предельное количество заданий в порции.
//  Отбор - Структура, Неопределено - отбор заданий, см. ОтборЗаданий(); Неопределено - без отбора.
//
// Возвращаемое значение:
//  Число - количество обработанных заданий.
//
Функция ВыполнитьПорцию(Контекст, МаксимумЗаданий = 20, Отбор = Неопределено) Экспорт

	Сеанс = СеансИзКонтекста(Контекст);
	Задания = ПолучитьЗадания(Сеанс, МаксимумЗаданий, Отбор);

	Обработано = 0;
	Для Каждого Задание Из Задания Цикл

		Если ПрерватьВыполнение(Контекст) Тогда
			Прервать;
		КонецЕсли;

		ВыполнитьЗадание(Задание, Контекст);
		Обработано = Обработано + 1;

	КонецЦикла;

	Возврат Обработано;

КонецФункции

// Обработчик регламентного задания: выполняет порцию заданий очереди активного сеанса загрузки.
//
Процедура ВыполнитьОчередьПоРасписанию() Экспорт

	СеансЗагрузки = АктивныйСеансЗагрузки();
	Если СеансЗагрузки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Контекст = КТ_ЗагрузкаKaitenСервер.НовыйКонтекст(КТ_ЗагрузкаKaitenСервер.ПрочитатьНастройки(), СеансЗагрузки);
	Контекст.Компания = КТ_ЗагрузкаKaitenСервер.КомпанияСеанса(Контекст);
	ВыполнитьПорцию(Контекст);

КонецПроцедуры

// Обработчик регламентного задания: возвращает зависшие задания активного сеанса загрузки.
//
Процедура ВернутьЗависшиеЗаданияПоРасписанию() Экспорт

	СеансЗагрузки = АктивныйСеансЗагрузки();
	Если СеансЗагрузки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ВернутьЗависшиеЗадания(СеансЗагрузки);

КонецПроцедуры

// Выполняет одно задание очереди.
//
// Параметры:
//  Задание - Структура - задание очереди.
//  Контекст - Структура - контекст загрузки.
//
Процедура ВыполнитьЗадание(Задание, Контекст) Экспорт

	Если НЕ НачатьВыполнение(Задание.КлючЗадания) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		КТ_ЗагрузкаKaitenСервер.ВыполнитьЗаданиеОчереди(Задание, Контекст);
		ЗавершитьЗадание(Задание.КлючЗадания, Перечисления.КТ_СостояниеЗагрузки.Загружено);
	Исключение
		ДанныеОшибки = ИнформацияОбОшибке();
		ЗафиксироватьОшибкуВЖурнале(ДанныеОшибки,
			"Задание очереди " + Задание.КлючЗадания + ": "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ДанныеОшибки));
		ОбработатьОшибкуЗадания(Задание, ДанныеОшибки, Контекст);
	КонецПопытки;

КонецПроцедуры

// Возвращает задания сеанса с ошибкой в состояние ожидания.
//
// Параметры:
//  СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки - сеанс загрузки.
//
// Возвращаемое значение:
//  Число - количество возвращенных в очередь заданий.
//
Функция СброситьОшибки(СеансЗагрузки) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Очередь.КлючЗадания КАК КлючЗадания
	|ИЗ
	|	РегистрСведений.КТ_ОчередьЗагрузки КАК Очередь
	|ГДЕ
	|	Очередь.СеансЗагрузки = &Сеанс
	|	И Очередь.Состояние = &Ошибка";
	Запрос.УстановитьПараметр("Сеанс", СеансЗагрузки);
	Запрос.УстановитьПараметр("Ошибка", Перечисления.КТ_СостояниеЗагрузки.Ошибка);

	Выборка = Запрос.Выполнить().Выбрать();
	Ключи = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Ключи.Добавить(Выборка.КлючЗадания);
	КонецЦикла;

	Для Каждого Ключ Из Ключи Цикл
		Запись = ЗаписьОчереди(Ключ);
		Если Запись = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Запись.Состояние = Перечисления.КТ_СостояниеЗагрузки.Ожидает;
		Запись.ЧислоПопыток = 0;
		Запись.НеРанее = '00010101000000';
		Запись.ТекстОшибки = "";
		Запись.Записать();
	КонецЦикла;

	Возврат Ключи.Количество();

КонецФункции

// Формирует отбор заданий очереди по виду операции и выполняемому действию.
//
// Параметры:
//  ВидОперации - ПеречислениеСсылка.КТ_ВидОперацииОчереди, Неопределено - вид операции;
//                незаполненное значение или Неопределено - все виды операций.
//  Действия - Массив из Строка, Неопределено - выполняемые действия: COMMENTS, CHECKLISTS,
//             CHILDREN, LOCATION_HISTORY, TIME_LOGS, FILES;
//             Неопределено или пустой массив - все действия.
//
// Возвращаемое значение:
//  Структура - отбор заданий:
//   * ВидОперации - ПеречислениеСсылка.КТ_ВидОперацииОчереди, Неопределено - вид операции;
//   * Маски - Массив из Строка - маски ключей заданий для отбора по действию;
//   * Действия - Массив из Строка - распознанные имена действий.
//
Функция ОтборЗаданий(ВидОперации, Действия) Экспорт

	Отбор = Новый Структура;
	Отбор.Вставить("ВидОперации", ?(ЗначениеЗаполнено(ВидОперации), ВидОперации, Неопределено));

	Маски = Новый Массив;
	ИменаДействий = Новый Массив;

	Если Действия <> Неопределено Тогда
		Для Каждого Действие Из Действия Цикл

			ИмяДействия = ВРег(СокрЛП(Действие));
			Маска = МаскаДействия(ИмяДействия);
			Если ПустаяСтрока(Маска) Тогда
				Продолжить;
			КонецЕсли;

			Если Маски.Найти(Маска) = Неопределено Тогда
				Маски.Добавить(Маска);
			КонецЕсли;
			Если ИменаДействий.Найти(ИмяДействия) = Неопределено Тогда
				ИменаДействий.Добавить(ИмяДействия);
			КонецЕсли;

		КонецЦикла;
	КонецЕсли;

	Отбор.Вставить("Маски", Маски);
	Отбор.Вставить("Действия", ИменаДействий);

	Возврат Отбор;

КонецФункции

// Возвращает количество готовых к выполнению заданий сеанса, подходящих под отбор.
//
// Параметры:
//  СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки - сеанс загрузки.
//  Отбор - Структура, Неопределено - отбор заданий, см. ОтборЗаданий().
//
// Возвращаемое значение:
//  Число - количество заданий.
//
Функция КоличествоЗаданийПоОтбору(СеансЗагрузки, Отбор) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	РегистрСведений.КТ_ОчередьЗагрузки КАК Очередь
	|ГДЕ
	|	Очередь.СеансЗагрузки = &Сеанс
	|	И Очередь.Состояние = &Ожидает
	|	И Очередь.НеРанее <= &Сейчас";
	Запрос.УстановитьПараметр("Сеанс", СеансЗагрузки);
	Запрос.УстановитьПараметр("Ожидает", Перечисления.КТ_СостояниеЗагрузки.Ожидает);
	Запрос.УстановитьПараметр("Сейчас", ТекущаяУниверсальнаяДата());

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Очередь.НеРанее <= &Сейчас",
		"И Очередь.НеРанее <= &Сейчас" + УсловиеОтбора(Отбор, Запрос));

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;

	Возврат 0;

КонецФункции

// Удаляет все записи очереди загрузки.
//
// Возвращаемое значение:
//  Число - количество удаленных записей.
//
Функция ОчиститьОчередь() Экспорт

	Набор = РегистрыСведений.КТ_ОчередьЗагрузки.СоздатьНаборЗаписей();
	Набор.Прочитать();

	Количество = Набор.Количество();

	Набор.Очистить();
	Набор.Записать();

	Возврат Количество;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Записывает ошибку в журнал регистрации с подробным представлением.
//
// Параметры:
//  ДанныеОшибки - ИнформацияОбОшибке - данные ошибки.
//  Комментарий - Строка - пояснение к событию.
//
Процедура ЗафиксироватьОшибкуВЖурнале(ДанныеОшибки, Комментарий = "") Экспорт

	ЗаписьЖурналаРегистрации("КТ_АрхивKaiten.ОшибкаЗагрузки",
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		Комментарий +" " + 
		ПодробноеПредставлениеОшибки(ДанныеОшибки));

КонецПроцедуры

// Возвращает последний сеанс загрузки, находящийся в состоянии «Выполняется».
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_СеансыЗагрузки, Неопределено - активный сеанс; Неопределено, если активных сеансов нет.
//
Функция АктивныйСеансЗагрузки()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Сеансы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КТ_СеансыЗагрузки КАК Сеансы
	|ГДЕ
	|	Сеансы.Состояние = &Выполняется
	|УПОРЯДОЧИТЬ ПО
	|	Сеансы.ДатаНачала УБЫВ";
	Запрос.УстановитьПараметр("Выполняется", Перечисления.КТ_СостояниеЗагрузки.Выполняется);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Возвращает список готовых к выполнению заданий сеанса.
//
// Параметры:
//  СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки - сеанс загрузки.
//  Максимум - Число - предельное количество заданий.
//  Отбор - Структура, Неопределено - отбор заданий, см. ОтборЗаданий(); Неопределено - без отбора.
//
// Возвращаемое значение:
//  Массив из Структура - описания заданий:
//   * КлючЗадания - Строка - ключ задания;
//   * ВидОперации - ПеречислениеСсылка.КТ_ВидОперацииОчереди - вид операции;
//   * ВидСущности - ПеречислениеСсылка.КТ_ВидСущностиKaiten - вид сущности Kaiten;
//   * UIDKaiten - Строка - UID сущности Kaiten;
//   * ИдентификаторKaiten - Строка - идентификатор сущности Kaiten;
//   * ПутьЗапроса - Строка - путь запроса задания.
//
Функция ПолучитьЗадания(СеансЗагрузки, Максимум, Отбор = Неопределено)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ //ПЕРВЫЕ &Максимум
	|	Очередь.КлючЗадания КАК КлючЗадания,
	|	Очередь.ВидОперации КАК ВидОперации,
	|	Очередь.ВидСущности КАК ВидСущности,
	|	Очередь.UIDKaiten КАК UIDKaiten,
	|	Очередь.ИдентификаторKaiten КАК ИдентификаторKaiten,
	|	Очередь.ПутьЗапроса КАК ПутьЗапроса
	|ИЗ
	|	РегистрСведений.КТ_ОчередьЗагрузки КАК Очередь
	|ГДЕ
	|	Очередь.СеансЗагрузки = &Сеанс
	|	И Очередь.Состояние = &Ожидает
	|	И Очередь.НеРанее <= &Сейчас
	|УПОРЯДОЧИТЬ ПО
	|	Очередь.Приоритет,
	|	Очередь.КлючЗадания";

	Запрос.УстановитьПараметр("Сеанс", СеансЗагрузки);
	Запрос.УстановитьПараметр("Максимум", Максимум); //нельзя! указывать первые - параметром!
	Запрос.УстановитьПараметр("Ожидает", Перечисления.КТ_СостояниеЗагрузки.Ожидает);
	Запрос.УстановитьПараметр("Сейчас", ТекущаяУниверсальнаяДата());
	
	//TODO
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "//ПЕРВЫЕ &Максимум", "ПЕРВЫЕ "+ Формат(Максимум,"ЧГ=0")) ;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Очередь.НеРанее <= &Сейчас",
		"И Очередь.НеРанее <= &Сейчас" + УсловиеОтбора(Отбор, Запрос)); 
	
	
	Задания = Новый Массив;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Задание = Новый Структура;
		Задание.Вставить("КлючЗадания", Выборка.КлючЗадания);
		Задание.Вставить("ВидОперации", Выборка.ВидОперации);
		Задание.Вставить("ВидСущности", Выборка.ВидСущности);
		Задание.Вставить("UIDKaiten", Выборка.UIDKaiten);
		Задание.Вставить("ИдентификаторKaiten", Выборка.ИдентификаторKaiten);
		Задание.Вставить("ПутьЗапроса", Выборка.ПутьЗапроса);
		Задания.Добавить(Задание);
	КонецЦикла;

	Возврат Задания;

КонецФункции

// Возвращает менеджер записи очереди по ключу задания.
//
// Параметры:
//  КлючЗадания - Строка - ключ задания.
//
// Возвращаемое значение:
//  РегистрСведенийМенеджерЗаписи.КТ_ОчередьЗагрузки, Неопределено - запись очереди.
//
Функция ЗаписьОчереди(КлючЗадания)

	Если ПустаяСтрока(КлючЗадания) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запись = РегистрыСведений.КТ_ОчередьЗагрузки.СоздатьМенеджерЗаписи();
	Запись.КлючЗадания = Лев(СокрЛП(КлючЗадания), 250);
	Запись.Прочитать();

	Если НЕ Запись.Выбран() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Запись;

КонецФункции

// Обрабатывает ошибку выполнения задания.
//
// Параметры:
//  Задание - Структура - задание очереди.
//  ДанныеОшибки - ИнформацияОбОшибке - перехваченная ошибка.
//  Контекст - Структура - контекст загрузки.
//
Процедура ОбработатьОшибкуЗадания(Задание, ДанныеОшибки, Контекст)

	Кратко = ОбработкаОшибок.КраткоеПредставлениеОшибки(ДанныеОшибки);

	КТ_ПротоколЗагрузкиСервер.Ошибка(Контекст,
		"Задание " + Задание.КлючЗадания + ": " + Кратко, ДанныеОшибки,
		Задание.ВидСущности, Задание.ИдентификаторKaiten);

	Код = КодОшибки(Кратко);

	Если Код = 403 Тогда
		ЗавершитьЗадание(Задание.КлючЗадания,
			Перечисления.КТ_СостояниеЗагрузки.НедоступноПоПравам, Кратко);
		Возврат;
	КонецЕсли;

	Если Код = 404 Тогда
		ЗавершитьЗадание(Задание.КлючЗадания,
			Перечисления.КТ_СостояниеЗагрузки.Пропущено, Кратко);
		Возврат;
	КонецЕсли;

	Попытки = КоличествоПопыток(Задание.КлючЗадания);
	Если Попытки >= МаксимумПопыток() Или Код = 400 Тогда
		ЗавершитьЗадание(Задание.КлючЗадания,
			Перечисления.КТ_СостояниеЗагрузки.Ошибка, Кратко);
		Возврат;
	КонецЕсли;

	ОтложитьЗадание(Задание.КлючЗадания, Кратко, ЗадержкаПовтора(Попытки));

КонецПроцедуры

// Извлекает код HTTP из текста ошибки.
//
// Параметры:
//  ТекстОшибки - Строка - текст ошибки.
//
// Возвращаемое значение:
//  Число - код HTTP или 0.
//
Функция КодОшибки(ТекстОшибки)

	Позиция = СтрНайти(ТекстОшибки, "HTTP ");
	Если Позиция = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Число(Сред(ТекстОшибки, Позиция + 5, 3));

КонецФункции

// Возвращает предельное количество попыток задания.
//
// Возвращаемое значение:
//  Число - количество попыток.
//
Функция МаксимумПопыток()

	Возврат 5;

КонецФункции

// Возвращает задержку перед повтором задания в секундах.
//
// Параметры:
//  НомерПопытки - Число - номер выполненной попытки.
//
// Возвращаемое значение:
//  Число - задержка в секундах.
//
Функция ЗадержкаПовтора(НомерПопытки)

	Задержки = Новый Массив;
	Задержки.Добавить(2);
	Задержки.Добавить(5);
	Задержки.Добавить(15);
	Задержки.Добавить(30);
	Задержки.Добавить(60);

	Индекс = НомерПопытки;
	Если Индекс < 0 Тогда
		Индекс = 0;
	КонецЕсли;
	Если Индекс >= Задержки.Количество() Тогда
		Индекс = Задержки.Количество() - 1;
	КонецЕсли;

	Возврат Задержки[Индекс];

КонецФункции

// Проверяет признак мягкой остановки загрузки.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//
// Возвращаемое значение:
//  Булево - Истина, если выполнение нужно прервать.
//
Функция ПрерватьВыполнение(Контекст)

	Если Контекст = Неопределено Или НЕ Контекст.Свойство("СеансЗагрузки") Тогда
		Возврат Ложь;
	КонецЕсли;

	ОбъектСеанса = Контекст.СеансЗагрузки.ПолучитьОбъект();
	Если ОбъектСеанса = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ОбъектСеанса.Состояние = Перечисления.КТ_СостояниеЗагрузки.Ожидает
		Или ОбъектСеанса.Состояние = Перечисления.КТ_СостояниеЗагрузки.Ошибка;

КонецФункции

// Возвращает значение параметра задания.
//
// Параметры:
//  ПараметрыЗадания - Структура, Неопределено - параметры задания.
//  Имя - Строка - имя параметра.
//  ЗначениеПоУмолчанию - Произвольный - значение, если параметр не задан.
//
// Возвращаемое значение:
//  Произвольный - значение параметра.
//
Функция ЗначениеПараметра(ПараметрыЗадания, Имя, ЗначениеПоУмолчанию)

	Если ПараметрыЗадания = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Если ПараметрыЗадания.Свойство(Имя) Тогда
		Возврат ПараметрыЗадания[Имя];
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

// Возвращает маску ключа задания для отбора по выполняемому действию.
//
// Параметры:
//  Действие - Строка - имя действия: COMMENTS, CHECKLISTS, CHILDREN, LOCATION_HISTORY,
//             TIME_LOGS, FILES.
//
// Возвращаемое значение:
//  Строка - маска для оператора ПОДОБНО; пустая строка - действие не поддерживается.
//
Функция МаскаДействия(Действие)

	Действие = ВРег(СокрЛП(Действие));

	Если Действие = "COMMENTS" Тогда
		Возврат "%:COMMENTS";
	ИначеЕсли Действие = "CHECKLISTS" Тогда
		Возврат "%:CHECKLISTS";
	ИначеЕсли Действие = "CHILDREN" Тогда
		Возврат "%:CHILDREN";
	ИначеЕсли Действие = "LOCATION_HISTORY" Тогда
		Возврат "%:LOCATION_HISTORY";
	ИначеЕсли Действие = "TIME_LOGS" Тогда
		Возврат "%:TIME_LOGS";
	ИначеЕсли Действие = "FILES" Тогда
		// Охватывает и список файлов карточки (:FILES), и скачивание содержимого файла (:FILE:<uid>).
		Возврат "%:FILE%";
	КонецЕсли;

	Возврат "";

КонецФункции

// Формирует текст условий отбора заданий очереди и устанавливает параметры запроса.
//
// Параметры:
//  Отбор - Структура, Неопределено - отбор заданий, см. ОтборЗаданий().
//  Запрос - Запрос - запрос, в который устанавливаются параметры отбора.
//
// Возвращаемое значение:
//  Строка - текст условий отбора; пустая строка - отбор не задан.
//
Функция УсловиеОтбора(Отбор, Запрос)

	Если Отбор = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Условия = "";

	ВидОперации = Неопределено;
	Если Отбор.Свойство("ВидОперации") Тогда
		ВидОперации = Отбор.ВидОперации;
	КонецЕсли;

	Если ВидОперации <> Неопределено И ЗначениеЗаполнено(ВидОперации) Тогда
		Запрос.УстановитьПараметр("ОтборВидОперации", ВидОперации);
		Условия = Условия + "
			|	И Очередь.ВидОперации = &ОтборВидОперации";
	КонецЕсли;

	Маски = Новый Массив;
	Если Отбор.Свойство("Маски") И Отбор.Маски <> Неопределено Тогда
		Маски = Отбор.Маски;
	КонецЕсли;

	Если Маски.Количество() > 0 Тогда
		УсловияМасок = Новый Массив;
		Для Индекс = 0 По Маски.ВГраница() Цикл
			ИмяПараметра = "ОтборМаска" + Формат(Индекс + 1, "ЧГ=0");
			Запрос.УстановитьПараметр(ИмяПараметра, Маски[Индекс]);
			УсловияМасок.Добавить("Очередь.КлючЗадания ПОДОБНО &" + ИмяПараметра);
		КонецЦикла;
		Условия = Условия + "
			|	И (" + СтрСоединить(УсловияМасок, " ИЛИ ") + ")";
	КонецЕсли;

	Возврат Условия;

КонецФункции

// Возвращает сеанс загрузки из контекста.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_СеансыЗагрузки - ссылка на сеанс.
//
Функция СеансИзКонтекста(Контекст)

	Если Контекст <> Неопределено И Контекст.Свойство("СеансЗагрузки") Тогда
		Возврат Контекст.СеансЗагрузки;
	КонецЕсли;

	Возврат Справочники.КТ_СеансыЗагрузки.ПустаяСсылка();

КонецФункции

#КонецОбласти
