Процедура СкачатьПоПодписанномуURL(ПодписанныйURL, ПолныйПутьФайла, ТаймаутСекунд = 300) Экспорт

	ОчищенныйURL = СтрЗаменить(СокрЛП(ПодписанныйURL), Символы.НПП, "");
	ОчищенныйURL = СтрЗаменить(ОчищенныйURL, " ", "%20");

	Если ПустаяСтрока(ОчищенныйURL) Тогда
		ВызватьИсключение "Не заполнена подписанная ссылка на файл";
	КонецЕсли;

	ТекущийАдрес = ОчищенныйURL;
	МаксимумПеренаправлений = 5;

	Для НомерПерехода = 0 По МаксимумПеренаправлений Цикл

		Хост = ПолучитьХостИзURL(ТекущийАдрес);
		Путь = ПолучитьПутьИзURL(ТекущийАдрес);

		Если ПустаяСтрока(Хост) Тогда
			ВызватьИсключение "Не удалось определить хост из ссылки файла: " + ТекущийАдрес;
		КонецЕсли;

		ЭтоHTTPS = СтрНачинаетсяС(НРег(ТекущийАдрес), "https://")
			Или НЕ СтрНачинаетсяС(НРег(ТекущийАдрес), "http://");

		Если ЭтоHTTPS Тогда
			ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
			Соединение = Новый HTTPСоединение(Хост, 443, , , , ТаймаутСекунд, ЗащищенноеСоединение);
		Иначе
			Соединение = Новый HTTPСоединение(Хост, 80, , , , ТаймаутСекунд);
		КонецЕсли;

		Запрос = Новый HTTPЗапрос(Путь);
		Ответ = Соединение.Получить(Запрос, ПолныйПутьФайла);

		Если Ответ.КодСостояния >= 200 И Ответ.КодСостояния < 300 Тогда
			Возврат;
		КонецЕсли;

		Если ЭтоПеренаправление(Ответ.КодСостояния) Тогда
			АдресПерехода = ПолучитьЗначениеЗаголовка(Ответ.Заголовки, "Location");
			Если ПустаяСтрока(АдресПерехода) Тогда
				ВызватьИсключение "Перенаправление без заголовка Location. HTTP "
					+ Ответ.КодСостояния;
			КонецЕсли;
			ТекущийАдрес = АбсолютныйАдрес(ТекущийАдрес, АдресПерехода);
			Продолжить;
		КонецЕсли;

		ВызватьИсключение "Не удалось скачать файл (" + ТекущийАдрес + "). HTTP " + Ответ.КодСостояния;

	КонецЦикла;

	ВызватьИсключение "Превышено число перенаправлений при скачивании файла: " + ТекущийАдрес;

КонецПроцедуры


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает значение настройки или значение по умолчанию.
//
// Параметры:
//  Настройки - Структура - параметры подключения.
//  Имя - Строка - имя настройки.
//  ЗначениеПоУмолчанию - Произвольный - значение по умолчанию.
//
// Возвращаемое значение:
//  Произвольный - значение настройки.
//
Функция ЗначениеНастройки(Настройки, Имя, ЗначениеПоУмолчанию)

	Если Настройки = Неопределено Или ТипЗнч(Настройки) <> Тип("Структура") Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Если Настройки.Свойство(Имя) Тогда
		Возврат Настройки[Имя];
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

// Выдерживает паузу между запросами к API.
//
// Параметры:
//  Настройки - Структура - параметры подключения.
//
Процедура ВыполнитьОграничениеЧастоты(Настройки)

	ПаузаМС = ЗначениеНастройки(Настройки, "ПаузаМеждуЗапросамиМС", 0);
	Если НЕ ЗначениеЗаполнено(ПаузаМС) Или ПаузаМС <= 0 Тогда
		Возврат;
	КонецЕсли;

	ВыполнитьЗадержку(ПаузаМС);

КонецПроцедуры

// Приостанавливает выполнение на заданное число миллисекунд.
//
// Параметры:
//  Миллисекунды - Число - длительность паузы.
//
Процедура ВыполнитьЗадержку(Миллисекунды)

	Если Миллисекунды <= 0 Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ВызватьПаузу(Миллисекунды);
	Исключение
		// В интерактивном серверном вызове пауза недоступна, задержка пропускается.
	КонецПопытки;

КонецПроцедуры

// Выдерживает задержку перед повтором запроса.
//
// Параметры:
//  НомерПопытки - Число - номер текущей попытки.
//  Ответ - Структура, Неопределено - ответ с заголовками.
//
Процедура ВыполнитьЗадержкуПовтора(НомерПопытки, Ответ)

	КодHTTP = 0;
	Если Ответ <> Неопределено Тогда
		КодHTTP = Ответ.КодСостояния;
	КонецЕсли;

	ВыполнитьЗадержку(ПолучитьЗадержкуПовтора(КодHTTP, Ответ, НомерПопытки));

КонецПроцедуры

// Преобразует HTTP-ответ платформы в структуру.
//
// Параметры:
//  ОтветHTTP - HTTPОтвет - ответ платформы.
//  ПолныйПуть - Строка - полный путь запроса без токена.
//
// Возвращаемое значение:
//  Структура - КодСостояния, ТелоКакСтрока, Заголовки, ПолныйПуть.
//
Функция ПреобразоватьHTTPОтвет(ОтветHTTP, ПолныйПуть)

	Результат = Новый Структура("КодСостояния, ТелоКакСтрока, Заголовки, ПолныйПуть");
	Результат.КодСостояния = ОтветHTTP.КодСостояния;
	Результат.Заголовки = ОтветHTTP.Заголовки;
	Результат.ПолныйПуть = ПолныйПуть;
	Результат.ТелоКакСтрока = "";

	Попытка
		Результат.ТелоКакСтрока = ОтветHTTP.ПолучитьТелоКакСтроку();
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		ЗаписьЖурналаРегистрации("Kaiten.HTTPОтвет", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;

	Возврат Результат;

КонецФункции


// Возвращает значение заголовка ответа без учета регистра имени.
//
// Параметры:
//  Заголовки - Соответствие - заголовки ответа.
//  Имя - Строка - имя заголовка.
//
// Возвращаемое значение:
//  Строка - значение заголовка или пустая строка.
//
Функция ПолучитьЗначениеЗаголовка(Заголовки, Имя)

	Если ТипЗнч(Заголовки) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	Значение = Заголовки.Получить(Имя);
	Если Значение <> Неопределено Тогда
		Возврат СокрЛП(Строка(Значение));
	КонецЕсли;

	ИскомоеИмя = НРег(Имя);
	Для Каждого КлючИЗначение Из Заголовки Цикл
		Если НРег(Строка(КлючИЗначение.Ключ)) = ИскомоеИмя Тогда
			Возврат СокрЛП(Строка(КлючИЗначение.Значение));
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Определяет, является ли код ответа перенаправлением.
//
// Параметры:
//  КодHTTP - Число - код состояния ответа.
//
// Возвращаемое значение:
//  Булево - Истина, если ответ перенаправляет на другой адрес.
//
Функция ЭтоПеренаправление(КодHTTP)

	Возврат КодHTTP = 301 Или КодHTTP = 302 Или КодHTTP = 303
		Или КодHTTP = 307 Или КодHTTP = 308;

КонецФункции

// Преобразует адрес перехода в абсолютный URL.
//
// Параметры:
//  БазовыйАдрес - Строка - адрес, из которого получено перенаправление.
//  АдресПерехода - Строка - значение заголовка Location.
//
// Возвращаемое значение:
//  Строка - абсолютный URL перехода.
//
Функция АбсолютныйАдрес(БазовыйАдрес, АдресПерехода)

	АдресПерехода = СокрЛП(АдресПерехода);

	Если СтрНайти(АдресПерехода, "://") > 0 Тогда
		Возврат АдресПерехода;
	КонецЕсли;

	Схема = "https";
	ПозицияСхемы = СтрНайти(БазовыйАдрес, "://");
	Если ПозицияСхемы > 0 Тогда
		Схема = Лев(БазовыйАдрес, ПозицияСхемы - 1);
	КонецЕсли;

	Если Лев(АдресПерехода, 2) = "//" Тогда
		Возврат Схема + ":" + АдресПерехода;
	КонецЕсли;

	Хост = ПолучитьХостИзURL(БазовыйАдрес);
	СхемаИХост = Схема + "://" + Хост;

	Если ПустаяСтрока(АдресПерехода) Тогда
		Возврат СхемаИХост;
	КонецЕсли;

	Если Лев(АдресПерехода, 1) = "/" Тогда
		Возврат СхемаИХост + АдресПерехода;
	КонецЕсли;

	// Относительный адрес без ведущего слеша присоединяется к каталогу текущего пути.
	Путь = ПолучитьПутьИзURL(БазовыйАдрес);
	ПозицияПоследнегоСлеша = СтрДлина(Путь);
	Пока ПозицияПоследнегоСлеша > 0
		И Сред(Путь, ПозицияПоследнегоСлеша, 1) <> "/" Цикл
		ПозицияПоследнегоСлеша = ПозицияПоследнегоСлеша - 1;
	КонецЦикла;

	Возврат СхемаИХост + Лев(Путь, ПозицияПоследнегоСлеша) + АдресПерехода;

КонецФункции

// Вычисляет задержку по заголовку X-RateLimit-Reset.
//
// Параметры:
//  Ответ - Структура, Неопределено - ответ с заголовками.
//
// Возвращаемое значение:
//  Число - задержка в миллисекундах; 0 если данные отсутствуют.
//
Функция ПолучитьЗадержкуИзЗаголовков(Ответ)

	Если Ответ = Неопределено Или ТипЗнч(Ответ) <> Тип("Структура") Тогда
		Возврат 0;
	КонецЕсли;

	Если НЕ Ответ.Свойство("Заголовки") Тогда
		Возврат 0;
	КонецЕсли;

	ЗначениеСброса = ПолучитьЗначениеЗаголовка(Ответ.Заголовки, "X-RateLimit-Reset");
	Если ПустаяСтрока(ЗначениеСброса) Тогда
		Возврат 0;
	КонецЕсли;

	МоментСброса = Число(ЗначениеСброса);
	Если МоментСброса <= 0 Тогда
		Возврат 0;
	КонецЕсли;

	// X-RateLimit-Reset может содержать как секунды Unix, так и число секунд до сброса.
	Если МоментСброса > 1000000000 Тогда
		СекундДоСброса = МоментСброса - Цел(ТекущаяУниверсальнаяДатаВМиллисекундах() / 1000);
	Иначе
		СекундДоСброса = МоментСброса;
	КонецЕсли;

	Если СекундДоСброса <= 0 Тогда
		Возврат 0;
	КонецЕсли;

	Если СекундДоСброса > 60 Тогда
		СекундДоСброса = 60;
	КонецЕсли;

	Возврат СекундДоСброса * 1000;

КонецФункции

// Заполняет переданную структуру заголовками ответа.
//
// Параметры:
//  Ответ - Структура - результат ВыполнитьGET.
//  ЗаголовкиОтвета - Структура, Неопределено - заполняемая структура.
//
Процедура ЗаполнитьЗаголовкиОтвета(Ответ, ЗаголовкиОтвета)

	Если ТипЗнч(ЗаголовкиОтвета) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого КлючИЗначение Из Ответ.Заголовки Цикл
		ЗаголовкиОтвета.Вставить(Строка(КлючИЗначение.Ключ), КлючИЗначение.Значение);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
