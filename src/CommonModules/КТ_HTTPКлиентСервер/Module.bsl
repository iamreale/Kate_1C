#Область ПрограммныйИнтерфейс

// Проверяет заполнение параметров подключения к Kaiten.
//
// Параметры:
//  Настройки - Структура - параметры подключения (АдресKaiten, Токен).
//
Процедура ПроверитьНастройки(Настройки) Экспорт

	АдресKaiten = ЗначениеНастройки(Настройки, "АдресKaiten", "");
	Токен = ЗначениеНастройки(Настройки, "Токен", "");

	Если ПустаяСтрока(АдресKaiten) Тогда
		ВызватьИсключение "Не заполнен адрес Kaiten";
	КонецЕсли;

	Если ПустаяСтрока(Токен) Тогда
		ВызватьИсключение "Не заполнен токен доступа Kaiten";
	КонецЕсли;

	Если СтрНайти(НРег(АдресKaiten), "https://") = 0 Тогда
		ВызватьИсключение "Адрес Kaiten должен начинаться с https://";
	КонецЕсли;

КонецПроцедуры

// Формирует базовый путь REST API Kaiten.
//
// Параметры:
//  Настройки - Структура - параметры подключения (АдресKaiten, ВерсияAPI).
//
// Возвращаемое значение:
//  Строка - базовый путь, например https://company.kaiten.ru/api/v1.
//
Функция ПолучитьБазовыйПутьAPI(Настройки) Экспорт

	Адрес = СокрЛП(ЗначениеНастройки(Настройки, "АдресKaiten", ""));

	Пока Прав(Адрес, 1) = "/" Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;

	Версия = ЗначениеНастройки(Настройки, "ВерсияAPI", "");
	Если ПустаяСтрока(Версия) Тогда
		Версия = "v1";
	КонецЕсли;

	Возврат Адрес + "/api/" + Версия;

КонецФункции

// Выделяет имя хоста из полного URL.
//
// Параметры:
//  Адрес - Строка - URL вида https://company.kaiten.ru/api/v1.
//
// Возвращаемое значение:
//  Строка - имя хоста без схемы и порта.
//
Функция ПолучитьХостИзURL(Адрес) Экспорт

	Результат = СокрЛП(Адрес);

	ПозицияСхемы = СтрНайти(Результат, "://");
	Если ПозицияСхемы > 0 Тогда
		Результат = Сред(Результат, ПозицияСхемы + 3);
	КонецЕсли;

	ПозицияРазделителя = СтрНайти(Результат, "/");
	Если ПозицияРазделителя > 0 Тогда
		Результат = Лев(Результат, ПозицияРазделителя - 1);
	КонецЕсли;

	ПозицияПорта = СтрНайти(Результат, ":");
	Если ПозицияПорта > 0 Тогда
		Результат = Лев(Результат, ПозицияПорта - 1);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Выделяет путь из полного URL.
//
// Параметры:
//  Адрес - Строка - полный URL.
//
// Возвращаемое значение:
//  Строка - путь с параметрами; "/" если путь отсутствует.
//
Функция ПолучитьПутьИзURL(Адрес) Экспорт

	Результат = СокрЛП(Адрес);

	ПозицияСхемы = СтрНайти(Результат, "://");
	Если ПозицияСхемы > 0 Тогда
		Результат = Сред(Результат, ПозицияСхемы + 3);
	КонецЕсли;

	ПозицияРазделителя = СтрНайти(Результат, "/");
	Если ПозицияРазделителя > 0 Тогда
		Возврат Сред(Результат, ПозицияРазделителя);
	КонецЕсли;

	Возврат "/";

КонецФункции

// Создает HTTP-соединение с сервером Kaiten.
//
// Параметры:
//  Настройки - Структура - параметры подключения.
//
// Возвращаемое значение:
//  HTTPСоединение - соединение по HTTPS.
//
Функция СоздатьСоединение(Настройки) Экспорт

	Хост = ПолучитьХостИзURL(ЗначениеНастройки(Настройки, "АдресKaiten", ""));
	Если ПустаяСтрока(Хост) Тогда
		ВызватьИсключение "Не удалось определить хост Kaiten из адреса";
	КонецЕсли;

	Таймаут = ЗначениеНастройки(Настройки, "ТаймаутСекунд", 30);
	Если НЕ ЗначениеЗаполнено(Таймаут) Или Таймаут <= 0 Тогда
		Таймаут = 30;
	КонецЕсли;

	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;

	Возврат Новый HTTPСоединение(Хост, 443, , , , Таймаут, ЗащищенноеСоединение);

КонецФункции

// Создает HTTP-соединение с сервером Kaiten.
//
// Параметры:
//  Настройки - Структура - параметры подключения.
//
// Возвращаемое значение:
//  HTTPСоединение - соединение по HTTPS.
//
Функция СформироватьHTTPСоединение(Настройки) Экспорт

	Возврат СоздатьСоединение(Настройки);

КонецФункции

// Формирует строку параметров запроса.
//
// Параметры:
//  ПараметрыЗапроса - Структура, Соответствие, Неопределено - параметры запроса.
//
// Возвращаемое значение:
//  Строка - строка вида ?limit=100&offset=0 или пустая строка.
//
Функция СформироватьСтрокуПараметров(ПараметрыЗапроса) Экспорт

	Если ПараметрыЗапроса = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Части = Новый Массив;

	Для Каждого Параметр Из ПараметрыЗапроса Цикл
		Если Параметр.Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Имя = КодироватьСтроку(
			Строка(Параметр.Ключ),
			СпособКодированияСтроки.КодировкаURL);

		Значение = КодироватьСтроку(
			ЗначениеПараметраВСтроку(Параметр.Значение),
			СпособКодированияСтроки.КодировкаURL);

		Части.Добавить(Имя + "=" + Значение);
	КонецЦикла;

	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат "?" + СтрСоединить(Части, "&");

КонецФункции



// Возвращает строковое представление значения параметра запроса,
// не зависящее от региональных установок (без разделителей разрядов).
//
// Параметры:
//  Значение - Произвольный - значение параметра.
//
// Возвращаемое значение:
//  Строка - строковое представление значения.
//
Функция ЗначениеПараметраВСтроку(Значение) Экспорт
	
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0");
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат ?(Значение, "true", "false");
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции


// Выполняет GET-запрос к API Kaiten с повторами временных ошибок.
//
// Параметры:
//  Путь - Строка - путь API относительно базового, например /users.
//  ПараметрыЗапроса - Структура, Соответствие, Неопределено - параметры строки запроса.
//  Настройки - Структура - параметры подключения.
//  ЗаголовкиОтвета - Структура, Неопределено - заполняется заголовками ответа.
//
// Возвращаемое значение:
//  Структура - КодСостояния, ТелоКакСтрока, Заголовки, ПолныйПуть.
//
Функция ВыполнитьGET(Путь, ПараметрыЗапроса, Настройки, ЗаголовкиОтвета = Неопределено) Экспорт

	ПроверитьНастройки(Настройки);

	СтрокаПараметров = СформироватьСтрокуПараметров(ПараметрыЗапроса);
	Версия = ЗначениеНастройки(Настройки, "ВерсияAPI", "");
	Если ПустаяСтрока(Версия) Тогда
		Версия = "v1";
	КонецЕсли;

	ПутьЗапроса = "/api/" + Версия + Путь + СтрокаПараметров;
	ПолныйПуть = ПолучитьБазовыйПутьAPI(Настройки) + Путь + СтрокаПараметров;

	КоличествоПовторов = ЗначениеНастройки(Настройки, "КоличествоПовторов", 3);
	Если КоличествоПовторов < 1 Тогда
		КоличествоПовторов = 1;
	КонецЕсли;

	Для НомерПопытки = 1 По КоличествоПовторов Цикл

		ВыполнитьОграничениеЧастоты(Настройки);

		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Authorization", "Bearer " + ЗначениеНастройки(Настройки, "Токен", ""));
		Заголовки.Вставить("Accept", "application/json");
		Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

		ЗапросHTTP = Новый HTTPЗапрос(ПутьЗапроса, Заголовки);

		Попытка
			Соединение = СоздатьСоединение(Настройки);
			ОтветHTTP = Соединение.Получить(ЗапросHTTP);
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			Если НомерПопытки = КоличествоПовторов Тогда
				ВызватьИсключение "Не удалось выполнить запрос Kaiten " + ПолныйПуть
					+ ": " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
			КонецЕсли;
			ВыполнитьЗадержкуПовтора(НомерПопытки, Неопределено);
			Продолжить;
		КонецПопытки;

		Ответ = ПреобразоватьHTTPОтвет(ОтветHTTP, ПолныйПуть);

		Если Ответ.КодСостояния >= 200 И Ответ.КодСостояния < 300 Тогда
			ЗаполнитьЗаголовкиОтвета(Ответ, ЗаголовкиОтвета);
			Возврат Ответ;
		КонецЕсли;

		Если ТребуетсяПовтор(Ответ.КодСостояния, НомерПопытки)
			И НомерПопытки < КоличествоПовторов Тогда
			ВыполнитьЗадержкуПовтора(НомерПопытки, Ответ);
			Продолжить;
		КонецЕсли;

		ЗаполнитьЗаголовкиОтвета(Ответ, ЗаголовкиОтвета);
		Возврат Ответ;

	КонецЦикла;

	ВызватьИсключение "Не удалось выполнить запрос Kaiten: " + ПолныйПуть;

КонецФункции

// Определяет необходимость повтора запроса по коду ответа.
//
// Параметры:
//  КодHTTP - Число - код ответа.
//  НомерПопытки - Число - номер текущей попытки.
//
// Возвращаемое значение:
//  Булево - Истина, если запрос имеет смысл повторить.
//
Функция ТребуетсяПовтор(КодHTTP, НомерПопытки) Экспорт

	Если КодHTTP = 429 Тогда
		Возврат Истина;
	КонецЕсли;

	Если КодHTTP = 500 Или КодHTTP = 502 Или КодHTTP = 503 Или КодHTTP = 504 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Возвращает значение заголовка ответа HTTP.
//
// Параметры:
//  Ответ - Структура - ответ HTTP.
//  ИмяЗаголовка - Строка - имя заголовка.
//
// Возвращаемое значение:
//  Строка - значение заголовка или пустая строка.
//
Функция ЗначениеЗаголовкаОтвета(Ответ, ИмяЗаголовка) Экспорт

	Если Ответ = Неопределено Или НЕ Ответ.Свойство("Заголовки") Тогда
		Возврат "";
	КонецЕсли;

	Возврат ПолучитьЗначениеЗаголовка(Ответ.Заголовки, ИмяЗаголовка);

КонецФункции

// Возвращает задержку перед повтором запроса в миллисекундах.
//
// Параметры:
//  КодHTTP - Число - код ответа.
//  ЗаголовкиОтвета - Структура, Неопределено - ответ с заголовками.
//  НомерПопытки - Число - номер текущей попытки.
//
// Возвращаемое значение:
//  Число - задержка в миллисекундах.
//
Функция ПолучитьЗадержкуПовтора(КодHTTP, ЗаголовкиОтвета, НомерПопытки) Экспорт

	Если КодHTTP = 429 Тогда
		ЗадержкаСервера = ПолучитьЗадержкуИзЗаголовков(ЗаголовкиОтвета);
		Если ЗадержкаСервера > 0 Тогда
			Возврат ЗадержкаСервера;
		КонецЕсли;
	КонецЕсли;

	БазовыеЗадержки = Новый Массив;
	БазовыеЗадержки.Добавить(2000);
	БазовыеЗадержки.Добавить(5000);
	БазовыеЗадержки.Добавить(15000);
	БазовыеЗадержки.Добавить(30000);
	БазовыеЗадержки.Добавить(60000);

	Индекс = НомерПопытки - 1;
	Если Индекс < 0 Тогда
		Индекс = 0;
	КонецЕсли;
	Если Индекс >= БазовыеЗадержки.Количество() Тогда
		Индекс = БазовыеЗадержки.Количество() - 1;
	КонецЕсли;

	БазоваяЗадержка = БазовыеЗадержки[Индекс];
	СлучайныйРазброс = Цел(БазоваяЗадержка * 0.2);

	ГенераторСлучайныхЧисел = Новый ГенераторСлучайныхЧисел;
	Разброс = 0;
	Если СлучайныйРазброс > 0 Тогда
		Разброс = ГенераторСлучайныхЧисел.СлучайноеЧисло(0, СлучайныйРазброс);
	КонецЕсли;

	Возврат БазоваяЗадержка + Разброс;

КонецФункции

// Возвращает текст ошибки HTTP-ответа без токена авторизации.
//
// Параметры:
//  Ответ - Структура - результат ВыполнитьGET.
//
// Возвращаемое значение:
//  Строка - описание ошибки.
//
Функция ПолучитьОписаниеHTTPОшибки(Ответ) Экспорт

	Текст = "Ошибка запроса Kaiten. HTTP " + Ответ.КодСостояния;

	Если НЕ ПустаяСтрока(Ответ.ПолныйПуть) Тогда
		Текст = Текст + " (" + Ответ.ПолныйПуть + ")";
	КонецЕсли;

	Если НЕ ПустаяСтрока(Ответ.ТелоКакСтрока) Тогда
		Тело = СокрЛП(Ответ.ТелоКакСтрока);
		Если СтрДлина(Тело) > 500 Тогда
			Тело = Лев(Тело, 500) + "...";
		КонецЕсли;
		Текст = Текст + ": " + Тело;
	КонецЕсли;

	Возврат Текст;

КонецФункции

