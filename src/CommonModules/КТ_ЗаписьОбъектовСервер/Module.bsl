		Перечисления.КТ_ВидСущностиKaiten.ЧекЛист, Идентификатор, Контекст);

КонецФункции

// Разрешает ссылку пространства по данным JSON.
//
// Параметры:
//  JSON - Структура - объект JSON с полем space_id.
//  Контекст - Структура - контекст загрузки.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_Пространства - ссылка или пустая ссылка.
//
Функция РазрешитьПространство(JSON, Контекст) Экспорт

	Пространство = РазрешитьСущность(JSON, "space_id",
		Перечисления.КТ_ВидСущностиKaiten.Пространство, Контекст);
	Если ЗначениеЗаполнено(Пространство) Тогда
		Возврат Пространство;
	КонецЕсли;

	// В ответе карточки space_id может отсутствовать: тогда пространство определяется
	// по доске, которой принадлежит карточка.
	Доска = РазрешитьДоску(JSON, Контекст);
	Если ЗначениеЗаполнено(Доска) Тогда
		Возврат Доска.Пространство;
	КонецЕсли;

	Возврат Пространство;

КонецФункции

