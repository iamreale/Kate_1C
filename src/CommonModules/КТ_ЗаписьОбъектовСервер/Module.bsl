#Область ПрограммныйИнтерфейс

// Записывает компанию Kaiten.
//
// Параметры:
//  JSON - Структура - объект JSON компании.
//  Контекст - Структура - контекст загрузки.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_Компании - ссылка на записанный элемент.
//
Функция ЗаписатьКомпанию(JSON, Контекст) Экспорт

	UID = КТ_JSONСервер.ПолучитьСтроку(JSON, "uid");
	Идентификатор = КТ_JSONСервер.ПолучитьЧисло(JSON, "id");
	Домен = КТ_JSONСервер.ПолучитьСтроку(JSON, "domain");

	Ссылка = КТ_ПоискОбъектовСервер.НайтиКомпанию(Домен, UID, Идентификатор);
	Объект = ОбъектИлиНовый("КТ_Компании", Ссылка);

	Наименование = КТ_JSONСервер.ПолучитьСтроку(JSON, "name");
	УстановитьЗначение(Объект, "Наименование", Лев(Наименование, 150));
	УстановитьЗначение(Объект, "Домен", КТ_JSONСервер.ПолучитьСтроку(JSON, "domain"));

	ЗаполнитьОбщиеПоля(Объект, JSON);

	Возврат ЗаписатьИЗарегистрировать(Объект,
		Перечисления.КТ_ВидСущностиKaiten.Компания, Идентификатор, Контекст);

КонецФункции

// Записывает пользователя компании.
//
// Параметры:
//  JSON - Структура - объект JSON пользователя.
//  Контекст - Структура - контекст загрузки.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_Пользователи - ссылка на записанный элемент.
//
Функция ЗаписатьПользователя(JSON, Контекст) Экспорт

	Компания = КомпанияИзКонтекста(Контекст);
	UID = КТ_JSONСервер.ПолучитьСтроку(JSON, "uid");
	Идентификатор = КТ_JSONСервер.ПолучитьЧисло(JSON, "id");

	Ссылка = КТ_ПоискОбъектовСервер.НайтиПользователя(Компания, UID, Идентификатор);
	Объект = ОбъектИлиНовый("КТ_Пользователи", Ссылка);

	ПолноеИмя = КТ_JSONСервер.ПолучитьСтроку(JSON, "full_name");
	УстановитьЗначение(Объект, "Наименование", Лев(ПолноеИмя, 150));
	УстановитьЗначение(Объект, "Компания", Компания);
	УстановитьЗначение(Объект, "ПолноеИмя", Лев(ПолноеИмя, 250));
	УстановитьЗначение(Объект, "Email", КТ_JSONСервер.ПолучитьСтроку(JSON, "email"));
	УстановитьЗначение(Объект, "ИмяПользователя", КТ_JSONСервер.ПолучитьСтроку(JSON, "username"));
	УстановитьЗначение(Объект, "Инициалы", КТ_JSONСервер.ПолучитьСтроку(JSON, "initials"));
	УстановитьЗначение(Объект, "Язык", КТ_JSONСервер.ПолучитьСтроку(JSON, "language"));
	УстановитьЗначение(Объект, "ЧасовойПояс", КТ_JSONСервер.ПолучитьСтроку(JSON, "timezone"));
	УстановитьЗначение(Объект, "Активирован", КТ_JSONСервер.ПолучитьБулево(JSON, "activated"));
	УстановитьЗначение(Объект, "Виртуальный", КТ_JSONСервер.ПолучитьБулево(JSON, "virtual"));
	УстановитьЗначение(Объект, "EmailЗаблокирован", КТ_JSONСервер.ПолучитьБулево(JSON, "email_blocked"));
	УстановитьЗначение(Объект, "URLАватара", КТ_JSONСервер.ПолучитьСтроку(JSON, "avatar_url"));
	УстановитьЗначение(Объект, "ДатаЗапросаУдаления",
		КТ_JSONСервер.ПолучитьДатуUTC(JSON, "delete_request_date"));

	ЗаполнитьОбщиеПоля(Объект, JSON);

	Возврат ЗаписатьИЗарегистрировать(Объект,
		Перечисления.КТ_ВидСущностиKaiten.Пользователь, Идентификатор, Контекст);

КонецФункции

// Записывает пространство компании.
//
// Параметры:
//  JSON - Структура - объект JSON пространства.
//  Контекст - Структура - контекст загрузки.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_Пространства - ссылка на записанный элемент.
//
Функция ЗаписатьПространство(JSON, Контекст) Экспорт

	Компания = КомпанияИзКонтекста(Контекст);
	UID = КТ_JSONСервер.ПолучитьСтроку(JSON, "uid");
	Идентификатор = КТ_JSONСервер.ПолучитьЧисло(JSON, "id");

	Ссылка = КТ_ПоискОбъектовСервер.НайтиПространство(Компания, UID, Идентификатор);
	Объект = ОбъектИлиНовый("КТ_Пространства", Ссылка);

	Заголовок = КТ_JSONСервер.ПолучитьСтроку(JSON, "title");
	УстановитьЗначение(Объект, "Наименование", Лев(Заголовок, 150));
	УстановитьЗначение(Объект, "Компания", Компания);
	УстановитьЗначение(Объект, "Заголовок", Лев(Заголовок, 250));
	УстановитьЗначение(Объект, "Архивировано", КТ_JSONСервер.ПолучитьБулево(JSON, "archived"));
	УстановитьЗначение(Объект, "ВидДоступа", КТ_JSONСервер.ПолучитьСтроку(JSON, "access_type"));
	УстановитьЗначение(Объект, "РольОбщегоДоступа", КТ_JSONСервер.ПолучитьСтроку(JSON, "access_role"));
	УстановитьЗначение(Объект, "ТипСущности", КТ_JSONСервер.ПолучитьСтроку(JSON, "entity_type"));
	УстановитьЗначение(Объект, "Путь", КТ_JSONСервер.ПолучитьСтроку(JSON, "path"));
	УстановитьЗначение(Объект, "Порядок", КТ_JSONСервер.ПолучитьЧисло(JSON, "sort_order"));
	УстановитьЗначение(Объект, "ВнешнийИдентификатор", КТ_JSONСервер.ПолучитьСтроку(JSON, "external_id"));

	UIDРодителя = КТ_JSONСервер.ПолучитьСтроку(JSON, "parent_uid");
	ИдентификаторРодителя = КТ_JSONСервер.ПолучитьЧисло(JSON, "parent_id");
	УстановитьЗначение(Объект, "РодительскийUIDKaiten", НРег(UIDРодителя));

	Если ЗначениеЗаполнено(ИдентификаторРодителя) Тогда
		Родитель = КТ_ПоискОбъектовСервер.НайтиПространство(
			Компания, UIDРодителя, ИдентификаторРодителя);
		УстановитьСсылку(Объект, "РодительскоеПространство", Родитель);
	КонецЕсли;

	ЗаполнитьОбщиеПоля(Объект, JSON);

	Возврат ЗаписатьИЗарегистрировать(Объект,
		Перечисления.КТ_ВидСущностиKaiten.Пространство, Идентификатор, Контекст);

КонецФункции

// Записывает доску пространства.
//
// Параметры:
//  JSON - Структура - объект JSON доски.
//  Пространство - СправочникСсылка.КТ_Пространства - пространство доски.
//  Контекст - Структура - контекст загрузки.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_Доски - ссылка на записанный элемент.
//
Функция ЗаписатьДоску(JSON, Пространство, Контекст) Экспорт

	Компания = КомпанияИзКонтекста(Контекст);
	UID = КТ_JSONСервер.ПолучитьСтроку(JSON, "uid");
	Идентификатор = КТ_JSONСервер.ПолучитьЧисло(JSON, "id");

	Ссылка = КТ_ПоискОбъектовСервер.НайтиДоску(Пространство, UID, Идентификатор);
	Объект = ОбъектИлиНовый("КТ_Доски", Ссылка);

	Заголовок = КТ_JSONСервер.ПолучитьСтроку(JSON, "title");
	УстановитьЗначение(Объект, "Наименование", Лев(Заголовок, 150));
	УстановитьЗначение(Объект, "Пространство", Пространство);
	УстановитьЗначение(Объект, "Заголовок", Лев(Заголовок, 250));
	УстановитьЗначение(Объект, "Описание", КТ_JSONСервер.ПолучитьСтроку(JSON, "description"));
	УстановитьЗначение(Объект, "ВнешнийИдентификатор", КТ_JSONСервер.ПолучитьСтроку(JSON, "external_id"));
	УстановитьЗначение(Объект, "Архивирована", КТ_JSONСервер.ПолучитьБулево(JSON, "archived"));
	УстановитьЗначение(Объект, "АвтоНазначение", КТ_JSONСервер.ПолучитьБулево(JSON, "auto_assign"));
	УстановитьЗначение(Объект, "ПеремещатьРодителейВГотово",
		КТ_JSONСервер.ПолучитьБулево(JSON, "move_parents_to_done"));

	ИдентификаторТипа = КТ_JSONСервер.ПолучитьЧисло(JSON, "default_card_type_id");
	Если ЗначениеЗаполнено(ИдентификаторТипа) Тогда
		ТипКарточки = КТ_ПоискОбъектовСервер.НайтиТипКарточки(Компания, "", ИдентификаторТипа);
		УстановитьСсылку(Объект, "ТипКарточкиПоУмолчанию", ТипКарточки);
	КонецЕсли;

	ЗаполнитьОбщиеПоля(Объект, JSON);

	Возврат ЗаписатьИЗарегистрировать(Объект,
		Перечисления.КТ_ВидСущностиKaiten.Доска, Идентификатор, Контекст);

КонецФункции

// Записывает колонку доски.
//
// Параметры:
//  JSON - Структура - объект JSON колонки.
//  Доска - СправочникСсылка.КТ_Доски - доска колонки.
//  РодительскаяКолонка - СправочникСсылка.КТ_Колонки, Неопределено - родительская колонка.
//  Контекст - Структура - контекст загрузки.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_Колонки - ссылка на записанный элемент.
//
Функция ЗаписатьКолонку(JSON, Доска, РодительскаяКолонка, Контекст) Экспорт

	UID = КТ_JSONСервер.ПолучитьСтроку(JSON, "uid");
	Идентификатор = КТ_JSONСервер.ПолучитьЧисло(JSON, "id");

	Ссылка = КТ_ПоискОбъектовСервер.НайтиКолонку(Доска, UID, Идентификатор);
	Объект = ОбъектИлиНовый("КТ_Колонки", Ссылка);

	Заголовок = КТ_JSONСервер.ПолучитьСтроку(JSON, "title");
	УстановитьЗначение(Объект, "Наименование", Лев(Заголовок, 150));
	УстановитьЗначение(Объект, "Доска", Доска);
	УстановитьЗначение(Объект, "Заголовок", Лев(Заголовок, 250));
	УстановитьЗначение(Объект, "Порядок", КТ_JSONСервер.ПолучитьЧисло(JSON, "sort_order"));
	УстановитьЗначение(Объект, "ТипКолонки", КТ_JSONСервер.ПолучитьСтроку(JSON, "type"));
