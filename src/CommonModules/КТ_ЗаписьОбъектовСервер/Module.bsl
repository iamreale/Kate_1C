// Записывает роль трудозатрат компании.
//
// Параметры:
//  JSON - Структура - объект JSON роли.
//  Контекст - Структура - контекст загрузки.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_РолиТрудозатрат - ссылка на записанный элемент.
//
Функция ЗаписатьРольТрудозатрат(JSON, Контекст) Экспорт

	Компания = КомпанияИзКонтекста(Контекст);
	UID = КТ_JSONСервер.ПолучитьСтроку(JSON, "uid");
	Идентификатор = КТ_JSONСервер.ПолучитьЧисло(JSON, "id");

	Ссылка = КТ_ПоискОбъектовСервер.НайтиРольТрудозатрат(Компания, UID, Идентификатор);
	Объект = ОбъектИлиНовый("КТ_РолиТрудозатрат", Ссылка);

	НаименованиеKaiten = КТ_JSONСервер.ПолучитьСтроку(JSON, "name");
	Если ПустаяСтрока(НаименованиеKaiten) Тогда
		Если Идентификатор = -1 Тогда
			НаименованиеKaiten = "Employee";
		Иначе
			НаименованиеKaiten = "Роль Kaiten " + Строка(Идентификатор);
		КонецЕсли;
	КонецЕсли;
	НаименованиеKaiten = Лев(НаименованиеKaiten, 150);

	УстановитьЗначение(Объект, "Наименование", НаименованиеKaiten);
	УстановитьЗначение(Объект, "Компания", Компания);
	УстановитьЗначение(Объект, "НаименованиеKaiten", НаименованиеKaiten);

	ЗаполнитьОбщиеПоля(Объект, JSON);

	Возврат ЗаписатьИЗарегистрировать(Объект,
		Перечисления.КТ_ВидСущностиKaiten.РольТрудозатрат, Идентификатор, Контекст);

КонецФункции

// Возвращает роль трудозатрат, создавая ее при необходимости.
//
// Параметры:
//  ТрудозатратаJSON - Структура - объект JSON трудозатраты.
//  Контекст - Структура - контекст загрузки.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_РолиТрудозатрат - ссылка на роль или пустая ссылка.
//
Функция РазрешитьРольТрудозатрат(ТрудозатратаJSON, Контекст) Экспорт

	ИдентификаторРоли = КТ_JSONСервер.ПолучитьЧисло(ТрудозатратаJSON, "role_id", Неопределено);
	Если ИдентификаторРоли = Неопределено Тогда
		Возврат Справочники.КТ_РолиТрудозатрат.ПустаяСсылка();
	КонецЕсли;

	РольJSON = КТ_JSONСервер.ПолучитьЗначениеПоля(ТрудозатратаJSON, "role");
	Если НЕ КТ_JSONСервер.ЭтоОбъектJSON(РольJSON) Тогда
		РольJSON = Неопределено;
	КонецЕсли;

	UIDРоли = "";
	Если РольJSON <> Неопределено Тогда
		UIDРоли = КТ_JSONСервер.ПолучитьСтроку(РольJSON, "uid");
	КонецЕсли;

	Роль = КТ_ПоискОбъектовСервер.НайтиРольТрудозатрат(
		КомпанияИзКонтекста(Контекст), UIDРоли, ИдентификаторРоли);
	Если ЗначениеЗаполнено(Роль) Тогда
		Возврат Роль;
	КонецЕсли;

	Если РольJSON <> Неопределено Тогда
		Если КТ_JSONСервер.ПолучитьЗначениеПоля(РольJSON, "id") = Неопределено Тогда
			РольJSON.Вставить("id", ИдентификаторРоли);
		КонецЕсли;
		Возврат ЗаписатьРольТрудозатрат(РольJSON, Контекст);
	КонецЕсли;

	СинтетическаяРоль = Новый Структура;
	СинтетическаяРоль.Вставить("id", ИдентификаторРоли);
	СинтетическаяРоль.Вставить("uid", "");
	Если ИдентификаторРоли = -1 Тогда
		СинтетическаяРоль.Вставить("name", "Employee");
	Иначе
		СинтетическаяРоль.Вставить("name", "Роль Kaiten " + Строка(ИдентификаторРоли));
	КонецЕсли;

	Возврат ЗаписатьРольТрудозатрат(СинтетическаяРоль, Контекст);

КонецФункции

// Записывает пользовательское поле компании.
//
// Параметры:
//  JSON - Структура - объект JSON пользовательского поля.
//  Контекст - Структура - контекст загрузки.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_ПользовательскиеПоля - ссылка на записанный элемент.
//
Функция ЗаписатьПользовательскоеПоле(JSON, Контекст) Экспорт

	Компания = КомпанияИзКонтекста(Контекст);
	UID = КТ_JSONСервер.ПолучитьСтроку(JSON, "uid");
	Идентификатор = КТ_JSONСервер.ПолучитьЧисло(JSON, "id");

	Ссылка = КТ_ПоискОбъектовСервер.НайтиПользовательскоеПоле(Компания, UID, Идентификатор);
	Объект = ОбъектИлиНовый("КТ_ПользовательскиеПоля", Ссылка);

	НаименованиеKaiten = КТ_JSONСервер.ПолучитьСтроку(JSON, "name");
	ТипKaiten = НРег(КТ_JSONСервер.ПолучитьСтроку(JSON, "type"));

	УстановитьЗначение(Объект, "Наименование", Лев(НаименованиеKaiten, 150));
	УстановитьЗначение(Объект, "Компания", Компания);
	УстановитьЗначение(Объект, "НаименованиеKaiten", Лев(НаименованиеKaiten, 250));
	УстановитьЗначение(Объект, "ТипKaiten", Лев(ТипKaiten, 80));
	УстановитьЗначение(Объект, "ТипЗначенияАрхива", ТипЗначенияПоля(ТипKaiten));
	УстановитьЗначение(Объект, "Многострочное", КТ_JSONСервер.ПолучитьБулево(JSON, "multi_line"));
	УстановитьЗначение(Объект, "МножественныйВыбор", КТ_JSONСервер.ПолучитьБулево(JSON, "multi_select"));
	УстановитьЗначение(Объект, "ОтображатьНаКарточке", КТ_JSONСервер.ПолучитьБулево(JSON, "show_on_card"));
	УстановитьЗначение(Объект, "Защищенное", КТ_JSONСервер.ПолучитьБулево(JSON, "protected"));
	УстановитьЗначение(Объект, "ПользователиМогутСоздаватьЗначения",
		КТ_JSONСервер.ПолучитьБулево(JSON, "users_can_create_values"));
	УстановитьЗначение(Объект, "УсловиеKaiten", КТ_JSONСервер.ПолучитьСтроку(JSON, "condition"));
	УстановитьЗначение(Объект, "ВнешнийИдентификатор", КТ_JSONСервер.ПолучитьСтроку(JSON, "external_id"));

	ЗаполнитьОбщиеПоля(Объект, JSON);

	Возврат ЗаписатьИЗарегистрировать(Объект,
		Перечисления.КТ_ВидСущностиKaiten.ПользовательскоеПоле, Идентификатор, Контекст);

КонецФункции

// Записывает вариант значения пользовательского поля.
//
// Параметры:
//  JSON - Структура - объект JSON варианта.
//  Контекст - Структура - контекст загрузки.
//  ДопПараметры - Структура - содержит Поле и ВидВарианта.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_ВариантыПользовательскихПолей - ссылка на записанный элемент.
//
Функция ЗаписатьВариантПоля(JSON, Контекст, ДопПараметры) Экспорт

	Поле = Неопределено;
	ВидВарианта = "";
	Если ТипЗнч(ДопПараметры) = Тип("Структура") Тогда
		Если ДопПараметры.Свойство("Поле") Тогда
			Поле = ДопПараметры.Поле;
		КонецЕсли;
		Если ДопПараметры.Свойство("ВидВарианта") Тогда
			ВидВарианта = ДопПараметры.ВидВарианта;
		КонецЕсли;
	КонецЕсли;

	UID = КТ_JSONСервер.ПолучитьСтроку(JSON, "uid");
	Идентификатор = КТ_JSONСервер.ПолучитьЧисло(JSON, "id");

	Ссылка = КТ_ПоискОбъектовСервер.НайтиВариантПоля(Поле, UID, Идентификатор);
	Объект = ОбъектИлиНовый("КТ_ВариантыПользовательскихПолей", Ссылка);

	НаименованиеKaiten = КТ_JSONСервер.ПолучитьСтроку(JSON, "name");
	Если ПустаяСтрока(НаименованиеKaiten) Тогда
		НаименованиеKaiten = КТ_JSONСервер.ПолучитьСтроку(JSON, "title");
	КонецЕсли;
	Если ПустаяСтрока(НаименованиеKaiten) Тогда
		НаименованиеKaiten = КТ_JSONСервер.ПолучитьСтроку(JSON, "value");
	КонецЕсли;

	УстановитьЗначение(Объект, "Наименование", Лев(НаименованиеKaiten, 150));
	УстановитьСсылку(Объект, "Поле", Поле);
	УстановитьЗначение(Объект, "НаименованиеKaiten", Лев(НаименованиеKaiten, 500));
	УстановитьЗначение(Объект, "ЗначениеKaiten", КТ_JSONСервер.ПолучитьСтроку(JSON, "value"));
	УстановитьЗначение(Объект, "ВидВарианта", ВидВарианта);
	УстановитьЗначение(Объект, "Цвет", КТ_JSONСервер.ПолучитьЧисло(JSON, "color"));
	УстановитьЗначение(Объект, "Порядок", КТ_JSONСервер.ПолучитьЧисло(JSON, "sort_order"));
	УстановитьЗначение(Объект, "СостояниеKaiten", КТ_JSONСервер.ПолучитьСтроку(JSON, "condition"));
	УстановитьЗначение(Объект, "Архивирован", КТ_JSONСервер.ПолучитьБулево(JSON, "archived"));
	УстановитьЗначение(Объект, "ВнешнийИдентификатор", КТ_JSONСервер.ПолучитьСтроку(JSON, "external_id"));

	ЗаполнитьОбщиеПоля(Объект, JSON);

	Возврат ЗаписатьИЗарегистрировать(Объект,
		Перечисления.КТ_ВидСущностиKaiten.ЗначениеСписка, Идентификатор, Контекст);

КонецФункции

// Записывает карточку.
//
// Параметры:
//  JSON - Структура - объект JSON карточки.
//  Контекст - Структура - контекст загрузки.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_Карточки - ссылка на записанную карточку.
//
Функция ЗаписатьКарточку(JSON, Контекст) Экспорт

	Компания = КомпанияИзКонтекста(Контекст);
	UID = КТ_JSONСервер.ПолучитьСтроку(JSON, "uid");
	Идентификатор = КТ_JSONСервер.ПолучитьЧисло(JSON, "id");

	Ссылка = КТ_ПоискОбъектовСервер.НайтиКарточку(Компания, UID, Идентификатор);
	Объект = ОбъектИлиНовый("КТ_Карточки", Ссылка);

	Заголовок = КТ_JSONСервер.ПолучитьСтроку(JSON, "title");
	УстановитьЗначение(Объект, "Наименование", Лев(Заголовок, 150));
	УстановитьЗначение(Объект, "Компания", Компания);
	УстановитьЗначение(Объект, "Заголовок", Заголовок);
	УстановитьЗначение(Объект, "Описание", КТ_JSONСервер.ПолучитьСтроку(JSON, "description"));
	УстановитьЗначение(Объект, "НомерКарточки", КТ_JSONСервер.ПолучитьЧисло(JSON, "number"));
	УстановитьЗначение(Объект, "ВнешнийИдентификатор", КТ_JSONСервер.ПолучитьСтроку(JSON, "external_id"));
	УстановитьЗначение(Объект, "Архивирована", КТ_JSONСервер.ПолучитьБулево(JSON, "archived"));
	УстановитьЗначение(Объект, "Заблокирована", КТ_JSONСервер.ПолучитьБулево(JSON, "blocked"));
	УстановитьЗначение(Объект, "Блокирующая", КТ_JSONСервер.ПолучитьБулево(JSON, "blocking"));
	УстановитьЗначение(Объект, "ПричинаБлокировки", КТ_JSONСервер.ПолучитьСтроку(JSON, "block_reason"));
	УстановитьЗначение(Объект, "ASAP", КТ_JSONСервер.ПолучитьБулево(JSON, "asap"));
	УстановитьЗначение(Объект, "Приоритет", КТ_JSONСервер.ПолучитьЧисло(JSON, "priority"));
	УстановитьЗначение(Объект, "Позиция", КТ_JSONСервер.ПолучитьЧисло(JSON, "sort_order"));
	УстановитьЗначение(Объект, "ИтерацияID", КТ_JSONСервер.ПолучитьЧисло(JSON, "iteration_id"));
	УстановитьЗначение(Объект, "ДатаНачала", КТ_JSONСервер.ПолучитьДатуUTC(JSON, "start"));
	УстановитьЗначение(Объект, "ДатаОкончания", КТ_JSONСервер.ПолучитьДатуUTC(JSON, "finish"));
	КрайнийСрокСодержитВремя = КТ_JSONСервер.ПолучитьБулево(JSON, "due_date_has_time");
	Если КрайнийСрокСодержитВремя Тогда
		УстановитьЗначение(Объект, "КрайнийСрок", КТ_JSONСервер.ПолучитьДатуUTC(JSON, "due_date"));
	Иначе
		// Дата без времени: сдвиг на часовой пояс недопустим, иначе срок смещается на сутки.
		УстановитьЗначение(Объект, "КрайнийСрок", КТ_JSONСервер.ПолучитьКалендарнуюДату(JSON, "due_date"));
	КонецЕсли;
	УстановитьЗначение(Объект, "КрайнийСрокСодержитВремя", КрайнийСрокСодержитВремя);
	УстановитьЗначение(Объект, "ПервыйПереходВРаботу",
		КТ_JSONСервер.ПолучитьДатуUTC(JSON, "first_moved_to_in_progress_at"));
	УстановитьЗначение(Объект, "ПоследнийПереходВГотово",
		КТ_JSONСервер.ПолучитьДатуUTC(JSON, "last_moved_to_done_at"));
	УстановитьЗначение(Объект, "КоличествоКомментариевAPI",
		КТ_JSONСервер.ПолучитьЧисло(JSON, "comments_total"));
	УстановитьЗначение(Объект, "ДатаПоследнегоКомментария",
		КТ_JSONСервер.ПолучитьДатуUTC(JSON, "last_commented_at"));

	Размер = КТ_JSONСервер.ПолучитьЗначениеПоля(JSON, "size");
	Если КТ_JSONСервер.ЭтоОбъектJSON(Размер) Тогда
		УстановитьЗначение(Объект, "РазмерЧисло", КТ_JSONСервер.ПолучитьЧисло(Размер, "size"));
		УстановитьЗначение(Объект, "РазмерЕдиница", КТ_JSONСервер.ПолучитьСтроку(Размер, "unit"));
		УстановитьЗначение(Объект, "РазмерПредставление", КТ_JSONСервер.ПолучитьСтроку(Размер, "text"));
	КонецЕсли;

	УстановитьСсылку(Объект, "ТипКарточки", РазрешитьТипКарточки(JSON, Контекст));
	УстановитьСсылку(Объект, "Автор", РазрешитьПользователя(JSON, "owner_id", Контекст));
	УстановитьСсылку(Объект, "ВладелецКарточки", РазрешитьПользователя(JSON, "responsible_id", Контекст));
	УстановитьСсылку(Объект, "Пространство", РазрешитьПространство(JSON, Контекст));
	УстановитьСсылку(Объект, "Доска", РазрешитьДоску(JSON, Контекст));
	УстановитьСсылку(Объект, "Колонка", РазрешитьКолонку(JSON, Контекст));
	УстановитьСсылку(Объект, "Подколонка", РазрешитьПодколонку(JSON, Контекст));
	УстановитьСсылку(Объект, "Дорожка", РазрешитьДорожку(JSON, Контекст));

	УстановитьЗначение(Объект, "ДатаПоследнейЗагрузки", ТекущаяУниверсальнаяДата());
	УстановитьЗначение(Объект, "СеансПоследнейЗагрузки", СеансИзКонтекста(Контекст));
	УстановитьЗначение(Объект, "ЕстьОшибкиЗагрузки", Ложь);
	УстановитьЗначение(Объект, "ХешПоследнегоJSON", КТ_JSONСервер.ВычислитьХешJSON(JSON));
	УстановитьЗначение(Объект, "СыройJSON", Новый ХранилищеЗначения(JSON, Новый СжатиеДанных(9)));
	ЗаполнитьОбщиеПоля(Объект, JSON);

	Возврат ЗаписатьИЗарегистрировать(Объект,
		Перечисления.КТ_ВидСущностиKaiten.Карточка, Идентификатор, Контекст);

КонецФункции

// Записывает комментарий карточки.
//
// Параметры:
//  Карточка - СправочникСсылка.КТ_Карточки - карточка комментария.
//  JSON - Структура - объект JSON комментария.
//  Контекст - Структура - контекст загрузки.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_Комментарии - ссылка на записанный комментарий.
//
Функция ЗаписатьКомментарий(Карточка, JSON, Контекст) Экспорт

	UID = КТ_JSONСервер.ПолучитьСтроку(JSON, "uid");
	Идентификатор = КТ_JSONСервер.ПолучитьЧисло(JSON, "id");

	Ссылка = КТ_ПоискОбъектовСервер.НайтиКомментарий(Карточка, UID, Идентификатор);
	Объект = ОбъектИлиНовый("КТ_Комментарии", Ссылка);

	Текст = КТ_JSONСервер.ПолучитьСтроку(JSON, "text");
	УстановитьЗначение(Объект, "Наименование", Лев(ОднаСтрока(Текст), 150));
	УстановитьСсылку(Объект, "Карточка", Карточка);
	УстановитьЗначение(Объект, "Автор", РазрешитьПользователя(JSON, "author_id", Контекст));
	УстановитьЗначение(Объект, "Текст", Текст);
	УстановитьЗначение(Объект, "ТекстБезРазметки", КТ_РазметкаСервер.РазметкаВТекст(Текст));
	УстановитьЗначение(Объект, "ТекстHTML",
		КТ_РазметкаСервер.HTMLКомментария(Текст, КТ_JSONСервер.ПолучитьМассив(JSON, "files")));
	УстановитьЗначение(Объект, "ВерсияHTML", КТ_РазметкаСервер.ВерсияРазметки());
	УстановитьЗначение(Объект, "ТипТекста", ТипТекста(КТ_JSONСервер.ПолучитьЗначениеПоля(JSON, "type")));
	УстановитьЗначение(Объект, "Отредактирован", КТ_JSONСервер.ПолучитьБулево(JSON, "edited"));
	УстановитьЗначение(Объект, "Внутренний", КТ_JSONСервер.ПолучитьБулево(JSON, "internal"));
	УстановитьЗначение(Объект, "УдаленВKaiten", КТ_JSONСервер.ПолучитьБулево(JSON, "deleted"));
	УстановитьЗначение(Объект, "ОписаниеServiceDesk",
		КТ_JSONСервер.ПолучитьБулево(JSON, "sd_description"));
	УстановитьЗначение(Объект, "АдресатыEmail",
		КТ_JSONСервер.ПолучитьСтроку(JSON, "email_recipients"));
	УстановитьЗначение(Объект, "КопияАдресатовEmail",
		КТ_JSONСервер.ПолучитьСтроку(JSON, "email_copy_recipients"));
	УстановитьЗначение(Объект, "ДатаОтправкиУведомления",
		КТ_JSONСервер.ПолучитьДатуUTC(JSON, "email_notification_date"));

	ЗаполнитьОбщиеПоля(Объект, JSON);

	Возврат ЗаписатьИЗарегистрировать(Объект,
		Перечисления.КТ_ВидСущностиKaiten.Комментарий, Идентификатор, Контекст);

КонецФункции

