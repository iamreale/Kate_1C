// Возвращаемое значение:
//  СправочникСсылка.КТ_Теги - ссылка или пустая ссылка.
//
Функция РазрешитьТег(JSON, Контекст) Экспорт

	Компания = КомпанияИзКонтекста(Контекст);
	UID = КТ_JSONСервер.ПолучитьСтроку(JSON, "uid");
	Идентификатор = КТ_JSONСервер.ПолучитьЧисло(JSON, "id");

	Если ПустаяСтрока(UID) И НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат Справочники.КТ_Теги.ПустаяСсылка();
	КонецЕсли;

	Возврат КТ_ПоискОбъектовСервер.НайтиТег(Компания, UID, Идентификатор);

КонецФункции

// Регистрирует сопоставление внешнего идентификатора и ссылки архива.
//
// Параметры:
//  ВидСущности - ПеречислениеСсылка.КТ_ВидСущностиKaiten - вид сущности Kaiten.
//  ИдентификаторKaiten - Строка - внешний идентификатор.
//  Ссылка - Произвольный - ссылка архива.
//  Источник - Строка - источник сопоставления.
//
Процедура ЗарегистрироватьСопоставление(ВидСущности, ИдентификаторKaiten, Ссылка,
	Источник = "") Экспорт

	Если ВидСущности = Неопределено Или НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;

	КлючСопоставления = СокрЛП(ИдентификаторKaiten);
	Если ПустаяСтрока(КлючСопоставления) Тогда
		Возврат;
	КонецЕсли;

	Запись = РегистрыСведений.КТ_СопоставлениеВнешнихИдентификаторов.СоздатьМенеджерЗаписи();
	Запись.ВидСущности = ВидСущности;
	Запись.ИдентификаторKaiten = КлючСопоставления;
	Запись.СсылкаАрхива = Ссылка;
	Запись.ДатаСопоставления = ТекущаяУниверсальнаяДата();
	Запись.Источник = Источник;
	Запись.Записать();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает объект справочника по ссылке или создает новый элемент.
//
// Параметры:
//  ИмяСправочника - Строка - имя справочника метаданных.
//  Ссылка - СправочникСсылка - найденная ссылка или пустая ссылка.
//
// Возвращаемое значение:
//  СправочникОбъект - объект для заполнения.
//
Функция ОбъектИлиНовый(ИмяСправочника, Ссылка)

	Если ЗначениеЗаполнено(Ссылка) Тогда
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект <> Неопределено Тогда
			Возврат Объект;
		КонецЕсли;
	КонецЕсли;

	Возврат Справочники[ИмяСправочника].СоздатьЭлемент();

КонецФункции

// Приводит внешний идентификатор Kaiten к строке без разделителей разрядов.
//
// Параметры:
//  ИдентификаторKaiten - Число, Строка - внешний идентификатор.
//
// Возвращаемое значение:
//  Строка - идентификатор в виде строки.
//
Функция ИдентификаторВСтроке(ИдентификаторKaiten)

	Если ТипЗнч(ИдентификаторKaiten) = Тип("Число") Тогда
		Возврат Формат(ИдентификаторKaiten, "ЧГ=0");
	КонецЕсли;

	Возврат СокрЛП(ИдентификаторKaiten);

КонецФункции

// Заполняет общие для всех справочников технические реквизиты.
//
// Параметры:
//  Объект - СправочникОбъект - заполняемый объект.
//  JSON - Структура - объект JSON.
//
Процедура ЗаполнитьОбщиеПоля(Объект, JSON)

	УстановитьЗначение(Объект, "ИдентификаторKaiten", КТ_JSONСервер.ПолучитьЧисло(JSON, "id"));
	УстановитьЗначение(Объект, "UIDKaiten", НРег(КТ_JSONСервер.ПолучитьСтроку(JSON, "uid")));
	УстановитьЗначение(Объект, "ДатаСозданияKaiten", КТ_JSONСервер.ПолучитьДатуUTC(JSON, "created"));
	УстановитьЗначение(Объект, "ДатаИзмененияKaiten", КТ_JSONСервер.ПолучитьДатуUTC(JSON, "updated"));
	УстановитьЗначение(Объект, "ДатаПоследнейЗагрузки", ТекущаяУниверсальнаяДата());
	УстановитьЗначение(Объект, "ХешПоследнегоJSON", КТ_JSONСервер.ВычислитьХешJSON(JSON));
	УстановитьЗначение(Объект, "СыройJSON", Новый ХранилищеЗначения(JSON, Новый СжатиеДанных(9)));

КонецПроцедуры

// Записывает объект и регистрирует сопоставление внешнего идентификатора.
//
// Параметры:
//  Объект - СправочникОбъект - записываемый объект.
//  ВидСущности - ПеречислениеСсылка.КТ_ВидСущностиKaiten - вид сущности Kaiten.
//  ИдентификаторKaiten - Число, Строка - внешний идентификатор.
//  Контекст - Структура - контекст загрузки.
//
// Возвращаемое значение:
//  СправочникСсылка - ссылка на записанный элемент.
//
Функция ЗаписатьИЗарегистрировать(Объект, ВидСущности, ИдентификаторKaiten, Контекст)

	УстановитьКодНовогоЭлемента(Объект);
	Объект.ОбменДанными.Загрузка = Истина;

	Если КТ_СырыеДанныеСервер.ТолькоЗаполнение(Контекст) Тогда
		// Проверка по сырым данным: объект только заполняется, в базу ничего не пишется.
		Контекст.Вставить("ЗаполненныйОбъект", Объект);
		Возврат Объект.Ссылка;
	КонецЕсли;

	Объект.Записать();

	Если ЗначениеЗаполнено(ИдентификаторKaiten) Тогда
		ЗарегистрироватьСопоставление(ВидСущности, ИдентификаторВСтроке(ИдентификаторKaiten),
			Объект.Ссылка, "ЗагрузкаKaiten");
	КонецЕсли;

	Возврат Объект.Ссылка;

КонецФункции

// Устанавливает код нового элемента справочника, если у справочника есть стандартный реквизит Код.
// Признак ОбменДанными.Загрузка = Истина отключает автонумерацию при записи, поэтому код назначается
// явно. У существующих элементов код не меняется.
//
// Параметры:
//  Объект - СправочникОбъект - записываемый объект.
//
Процедура УстановитьКодНовогоЭлемента(Объект)

	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	МетаданныеОбъекта = Объект.Метаданные();
	ЕстьКод = Ложь;
	Для Каждого СтандартныйРеквизит Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
		Если СтандартныйРеквизит.Имя = "Код" Тогда
			ЕстьКод = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ЕстьКод Тогда
		Объект.УстановитьНовыйКод();
	КонецЕсли;

КонецПроцедуры

// Устанавливает значение реквизита, если такой реквизит есть у объекта.
//
// Параметры:
//  Объект - СправочникОбъект - заполняемый объект.
//  ИмяРеквизита - Строка - имя реквизита.
//  Значение - Произвольный - значение реквизита.
//
Процедура УстановитьЗначение(Объект, ИмяРеквизита, Значение)

	МетаданныеОбъекта = Объект.Метаданные();

	Если МетаданныеОбъекта.Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
		
		//И МетаданныеОбъекта.СтандартныеРеквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
		ИмяНайдено = Ложь;
		Для Каждого ЭлемРеквизит Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
			Если ЭлемРеквизит.Имя = ИмяРеквизита Тогда
				ИмяНайдено = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не ИмяНайдено Тогда
			Возврат; // TODO МетаданныеОбъекта.СтандартныеРеквизиты.найти("Наименование")
		КонецЕсли;
	КонецЕсли;

	Объект[ИмяРеквизита] = Значение;

КонецПроцедуры

// Устанавливает ссылочное значение, очищая реквизит, если ссылки в Kaiten нет.
//
// Пустое значение (null в JSON) означает, что ссылку нужно очистить. Если просто пропустить
// запись, в объекте останется устаревшая ссылка от предыдущей загрузки.
//
// Параметры:
//  Объект - СправочникОбъект - заполняемый объект.
//  ИмяРеквизита - Строка - имя реквизита.
//  Значение - Произвольный - ссылка или Неопределено, если ссылки в Kaiten нет.
//
Процедура УстановитьСсылку(Объект, ИмяРеквизита, Значение)

	Если ЗначениеЗаполнено(Значение) Тогда
		УстановитьЗначение(Объект, ИмяРеквизита, Значение);
		Возврат;
	КонецЕсли;

	Реквизит = Объект.Метаданные().Реквизиты.Найти(ИмяРеквизита);
	Если Реквизит = Неопределено Тогда
		Возврат;
	КонецЕсли;

	УстановитьЗначение(Объект, ИмяРеквизита, Реквизит.Тип.ПривестиЗначение());

КонецПроцедуры

// Разрешает ссылку сущности по числовому идентификатору из JSON.
//
// Параметры:
//  JSON - Структура - объект JSON.
//  ИмяПоля - Строка - имя поля с идентификатором.
//  ВидСущности - ПеречислениеСсылка.КТ_ВидСущностиKaiten - вид сущности.
//  Контекст - Структура - контекст загрузки.
//
// Возвращаемое значение:
//  Произвольный - ссылка или Неопределено.
//
Функция РазрешитьСущность(JSON, ИмяПоля, ВидСущности, Контекст)

	Идентификатор = КТ_JSONСервер.ПолучитьЧисло(JSON, ИмяПоля);
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Ссылка = КТ_ПоискОбъектовСервер.НайтиПоСопоставлению(ВидСущности,
		ИдентификаторВСтроке(Идентификатор));
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;

	Компания = КомпанияИзКонтекста(Контекст);

	Если ВидСущности = Перечисления.КТ_ВидСущностиKaiten.Пользователь Тогда
		Возврат КТ_ПоискОбъектовСервер.НайтиПользователя(Компания, "", Идентификатор);
	КонецЕсли;

	Если ВидСущности = Перечисления.КТ_ВидСущностиKaiten.Пространство Тогда
		Возврат КТ_ПоискОбъектовСервер.НайтиПространство(Компания, "", Идентификатор);
	КонецЕсли;

	Если ВидСущности = Перечисления.КТ_ВидСущностиKaiten.Доска Тогда
		Возврат КТ_ПоискОбъектовСервер.НайтиСсылку("КТ_Доски", Новый Структура, "",
			Идентификатор);
	КонецЕсли;

	Если ВидСущности = Перечисления.КТ_ВидСущностиKaiten.Колонка Тогда
		Возврат КТ_ПоискОбъектовСервер.НайтиСсылку("КТ_Колонки", Новый Структура, "",
			Идентификатор);
	КонецЕсли;

	Если ВидСущности = Перечисления.КТ_ВидСущностиKaiten.Дорожка Тогда
		Возврат КТ_ПоискОбъектовСервер.НайтиСсылку("КТ_Дорожки", Новый Структура, "",
			Идентификатор);
	КонецЕсли;

	Если ВидСущности = Перечисления.КТ_ВидСущностиKaiten.ТипКарточки Тогда
		Возврат КТ_ПоискОбъектовСервер.НайтиТипКарточки(Компания, "", Идентификатор);
	КонецЕсли;

	Если ВидСущности = Перечисления.КТ_ВидСущностиKaiten.Тег Тогда
		Возврат КТ_ПоискОбъектовСервер.НайтиТег(Компания, "", Идентификатор);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Возвращает компанию из контекста загрузки.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_Компании - ссылка на компанию.
//
Функция КомпанияИзКонтекста(Контекст)

	Если Контекст <> Неопределено И Контекст.Свойство("Компания") Тогда
		Возврат Контекст.Компания;
	КонецЕсли;

	Возврат Справочники.КТ_Компании.ПустаяСсылка();

КонецФункции

// Возвращает сеанс загрузки из контекста.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_СеансыЗагрузки - ссылка на сеанс.
//
Функция СеансИзКонтекста(Контекст)

	Если Контекст <> Неопределено И Контекст.Свойство("СеансЗагрузки") Тогда
		Возврат Контекст.СеансЗагрузки;
	КонецЕсли;

	Возврат Справочники.КТ_СеансыЗагрузки.ПустаяСсылка();

КонецФункции

// Определяет тип значения архива по типу поля Kaiten.
//
// Параметры:
//  ТипKaiten - Строка - тип поля в Kaiten.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.КТ_ТипЗначенияПоля - тип значения архива.
//
Функция ТипЗначенияПоля(ТипKaiten)

	Тип = НРег(СокрЛП(ТипKaiten));

	Если Тип = "string" Или Тип = "text" Тогда
		Возврат Перечисления.КТ_ТипЗначенияПоля.Строка;
	ИначеЕсли Тип = "multiline" Или Тип = "multiline_text" Тогда
		Возврат Перечисления.КТ_ТипЗначенияПоля.МногострочнаяСтрока;
	ИначеЕсли Тип = "number" Или Тип = "integer" Или Тип = "float" Тогда
		Возврат Перечисления.КТ_ТипЗначенияПоля.Число;
	ИначеЕсли Тип = "date" Или Тип = "datetime" Тогда
		Возврат Перечисления.КТ_ТипЗначенияПоля.Дата;
	ИначеЕсли Тип = "checkbox" Или Тип = "boolean" Или Тип = "bool" Тогда
		Возврат Перечисления.КТ_ТипЗначенияПоля.Булево;
	ИначеЕсли Тип = "user" Или Тип = "select-user" Или Тип = "users" Тогда
		Возврат Перечисления.КТ_ТипЗначенияПоля.Пользователь;
	ИначеЕсли Тип = "card" Или Тип = "select-card" Тогда
		Возврат Перечисления.КТ_ТипЗначенияПоля.Карточка;
	ИначеЕсли Тип = "select" Тогда
		Возврат Перечисления.КТ_ТипЗначенияПоля.Список;
	ИначеЕсли Тип = "catalog" Тогда
		Возврат Перечисления.КТ_ТипЗначенияПоля.Каталог;
	ИначеЕсли Тип = "file" Или Тип = "attachment" Тогда
		Возврат Перечисления.КТ_ТипЗначенияПоля.Файл;
	КонецЕсли;

	Возврат Перечисления.КТ_ТипЗначенияПоля.Неизвестный;

КонецФункции

// Определяет тип текста комментария.
//
// Параметры:
//  Значение - Строка - тип текста из Kaiten.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.КТ_ТипТекста - тип текста архива.
//
Функция ТипТекста(Значение)

	// API Kaiten отдаёт тип комментария числом: 1 - комментарий с разметкой markdown.
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Если Значение = 1 Тогда
			Возврат Перечисления.КТ_ТипТекста.Markdown;
		КонецЕсли;
		Возврат Перечисления.КТ_ТипТекста.ОбычныйТекст;
	КонецЕсли;

	Тип = НРег(СокрЛП(Строка(Значение)));

	Если Тип = "markdown" Тогда
		Возврат Перечисления.КТ_ТипТекста.Markdown;
	ИначеЕсли Тип = "html" Тогда
		Возврат Перечисления.КТ_ТипТекста.HTML;
	ИначеЕсли Тип = "json" Тогда
		Возврат Перечисления.КТ_ТипТекста.JSON;
	КонецЕсли;

	Возврат Перечисления.КТ_ТипТекста.ОбычныйТекст;

КонецФункции

// Заменяет переводы строк на пробелы.
//
// Параметры:
//  Значение - Строка - исходный текст.
//
// Возвращаемое значение:
//  Строка - текст в одну строку.
//
Функция ОднаСтрока(Значение)

	Результат = СтрЗаменить(СокрЛП(Значение), Символы.ПС, " ");
	Результат = СтрЗаменить(Результат, Символы.ВК, " ");

	Возврат СокрЛП(Результат);

КонецФункции

#КонецОбласти
