	УстановитьЗначение(Объект, "WIPЛимит", КТ_JSONСервер.ПолучитьЧисло(JSON, "wip_limit"));
	УстановитьСсылку(Объект, "РодительскаяКолонка", РодительскаяКолонка);

	ЗаполнитьОбщиеПоля(Объект, JSON);

	Возврат ЗаписатьИЗарегистрировать(Объект,
		Перечисления.КТ_ВидСущностиKaiten.Колонка, Идентификатор, Контекст);

