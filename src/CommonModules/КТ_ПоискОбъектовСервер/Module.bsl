#Область ПрограммныйИнтерфейс

// Находит элемент справочника по составному отбору, UID или идентификатору Kaiten.
//
// Параметры:
//  ИмяСправочника - Строка - имя справочника метаданных.
//  Отбор - Структура - дополнительные условия отбора (поле - значение).
//  UID - Строка - UID сущности Kaiten (хранится в нижнем регистре).
//  Идентификатор - Число, Строка - идентификатор сущности Kaiten.
//  ИмяПоляИдентификатора - Строка - имя реквизита идентификатора в справочнике.
//
// Возвращаемое значение:
//  СправочникСсылка - найденная ссылка или пустая ссылка.
//
Функция НайтиСсылку(ИмяСправочника, Отбор, UID, Идентификатор,
	ИмяПоляИдентификатора = "ИдентификаторKaiten") Экспорт

	Если НЕ ПустаяСтрока(UID) Тогда
		Ссылка = ВыполнитьПоиск(ИмяСправочника, Отбор, "UIDKaiten", НРег(СокрЛП(UID)));
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(Идентификатор) Тогда
		Ссылка = ВыполнитьПоиск(ИмяСправочника, Отбор, ИмяПоляИдентификатора, Идентификатор);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;
	КонецЕсли;

	Возврат Справочники[ИмяСправочника].ПустаяСсылка();

КонецФункции

// Находит компанию по домену, UID или идентификатору.
//
// Параметры:
//  Домен - Строка - домен компании Kaiten.
//  UID - Строка - UID компании.
//  Идентификатор - Число - идентификатор компании.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_Компании - найденная ссылка или пустая ссылка.
//
Функция НайтиКомпанию(Домен, UID, Идентификатор) Экспорт

	Домен = СокрЛП(Домен);
	Если Не ПустаяСтрока(Домен) Тогда
		Ссылка = ВыполнитьПоиск("КТ_Компании", Новый Структура, "Домен", Домен);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;
	КонецЕсли;

	Возврат НайтиСсылку("КТ_Компании", Новый Структура, UID, Идентификатор);

КонецФункции

