// Находит ссылку архива по сопоставлению внешнего идентификатора.
//
// Параметры:
//  ВидСущности - ПеречислениеСсылка.КТ_ВидСущностиKaiten - вид сущности Kaiten.
//  ИдентификаторKaiten - Строка - внешний идентификатор сущности.
//
// Возвращаемое значение:
//  Произвольный - ссылка архива или Неопределено.
//
Функция НайтиПоСопоставлению(ВидСущности, ИдентификаторKaiten) Экспорт

	Если ВидСущности = Неопределено Или ПустаяСтрока(ИдентификаторKaiten) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Сопоставление.СсылкаАрхива КАК СсылкаАрхива
	|ИЗ
	|	РегистрСведений.КТ_СопоставлениеВнешнихИдентификаторов КАК Сопоставление
	|ГДЕ
	|	Сопоставление.ВидСущности = &ВидСущности
	|	И Сопоставление.ИдентификаторKaiten = &ИдентификаторKaiten";
	Запрос.УстановитьПараметр("ВидСущности", ВидСущности);
	Запрос.УстановитьПараметр("ИдентификаторKaiten", СокрЛП(ИдентификаторKaiten));

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СсылкаАрхива;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

