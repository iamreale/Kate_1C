#Область СлужебныеПроцедурыИФункции

// Формирует отбор по компании.
//
// Параметры:
//  Компания - СправочникСсылка.КТ_Компании - компания.
//
// Возвращаемое значение:
//  Структура - отбор с полем Компания.
//
Функция ОтборПоКомпании(Компания)

	Отбор = Новый Структура;
	Отбор.Вставить("Компания", Компания);

	Возврат Отбор;

КонецФункции

// Выполняет динамический поиск ссылки справочника по одному реквизиту.
//
// Параметры:
//  ИмяСправочника - Строка - имя справочника метаданных.
//  Отбор - Структура - дополнительные условия отбора.
//  ИмяПоля - Строка - имя реквизита поиска.
//  Значение - Произвольный - значение реквизита поиска.
//
// Возвращаемое значение:
//  СправочникСсылка - найденная ссылка или пустая ссылка.
//
Функция ВыполнитьПоиск(ИмяСправочника, Отбор, ИмяПоля, Значение)

	Запрос = Новый Запрос;
	Условия = Новый Массив;
	НомерУсловия = 0;

	Если ТипЗнч(Отбор) = Тип("Структура") Тогда
		Для Каждого КлючИЗначение Из Отбор Цикл
			Если КлючИЗначение.Значение = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			НомерУсловия = НомерУсловия + 1;
			ИмяПараметра = "Условие" + Формат(НомерУсловия, "ЧГ=0");
			Условия.Добавить("Т." + КлючИЗначение.Ключ + " = &" + ИмяПараметра);
			Запрос.УстановитьПараметр(ИмяПараметра, КлючИЗначение.Значение);
		КонецЦикла;
	КонецЕсли;

	Условия.Добавить("Т." + ИмяПоля + " = &ЗначениеПоиска");
	Запрос.УстановитьПараметр("ЗначениеПоиска", Значение);

	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник." + ИмяСправочника
		+ " КАК Т ГДЕ " + СтрСоединить(Условия, " И ");

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники[ИмяСправочника].ПустаяСсылка();

КонецФункции

#КонецОбласти
