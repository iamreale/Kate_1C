#Область ПрограммныйИнтерфейс

// Возвращает список объектов метаданных, содержащих реквизиты (ресурсы) типа ХранилищеЗначения.
// Обрабатываются собственные реквизиты справочников и документов и ресурсы регистров сведений.
// Реквизиты табличных частей не обрабатываются.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Вид - Строка - "Справочник", "Документ" или "РегистрСведений".
//   * Имя - Строка - имя объекта метаданных.
//   * Представление - Строка - полное имя объекта метаданных, например "Справочник.КТ_Карточки".
//   * Реквизиты - Массив из Строка - имена реквизитов (ресурсов) типа ХранилищеЗначения.
//
Функция ИсточникиХранилищ() Экспорт
	
	Источники = Новый Массив;
	
	Для Каждого МетаданноеОбъекта Из Метаданные.Справочники Цикл
		ДобавитьИсточник(Источники, "Справочник", МетаданноеОбъекта, МетаданноеОбъекта.Реквизиты);
	КонецЦикла;
	
	Для Каждого МетаданноеОбъекта Из Метаданные.Документы Цикл
		ДобавитьИсточник(Источники, "Документ", МетаданноеОбъекта, МетаданноеОбъекта.Реквизиты);
	КонецЦикла;
	
	Для Каждого МетаданноеОбъекта Из Метаданные.РегистрыСведений Цикл
		ДобавитьИсточник(Источники, "РегистрСведений", МетаданноеОбъекта, МетаданноеОбъекта.Ресурсы);
	КонецЦикла;
	
	Возврат Источники;
	
КонецФункции

// Переупаковывает значения типа ХранилищеЗначения одного источника с максимальной степенью сжатия.
//
// Параметры:
//  Источник - Структура - элемент списка, см. ИсточникиХранилищ().
//  Настройки - Структура - параметры обработки:
//   * СжиматьДвоичныеДанные - Булево - обрабатывать значения типа ДвоичныеДанные (содержимое файлов).
//
// Возвращаемое значение:
//  Структура:
//   * Записей - Число - количество записей (объектов), в которых были заполнены хранилища.
//   * Переупаковано - Число - количество переупакованных значений.
//   * Пропущено - Число - количество значений, пропущенных по настройкам.
//   * Ошибки - Массив из Строка - описания ошибок.
//
Функция ОбработатьИсточник(Источник, Настройки) Экспорт
	
	Результат = Новый Структура("Записей, Переупаковано, Пропущено", 0, 0, 0);
	Результат.Вставить("Ошибки", Новый Массив);
	
	Если Источник.Вид = "РегистрСведений" Тогда
		ОбработатьРегистрСведений(Источник, Настройки, Результат);
	Иначе
		ОбработатьОбъекты(Источник, Настройки, Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Добавляет в список источник, если у объекта метаданных есть реквизиты типа ХранилищеЗначения.
//
// Параметры:
//  Источники - Массив из Структура - список источников, см. ИсточникиХранилищ().
//  Вид - Строка - вид объекта метаданных для текста запроса.
//  МетаданноеОбъекта - ОбъектМетаданных - объект метаданных.
//  КоллекцияРеквизитов - КоллекцияОбъектовМетаданных - реквизиты или ресурсы объекта.
//
Процедура ДобавитьИсточник(Источники, Вид, МетаданноеОбъекта, КоллекцияРеквизитов)
	
	Реквизиты = Новый Массив;
	
	Для Каждого Реквизит Из КоллекцияРеквизитов Цикл
		Если Реквизит.Тип.СодержитТип(Тип("ХранилищеЗначения")) Тогда
			Реквизиты.Добавить(Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Если Реквизиты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Источник = Новый Структура("Вид, Имя, Представление", Вид, МетаданноеОбъекта.Имя,
		Вид + "." + МетаданноеОбъекта.Имя);
	Источник.Вставить("Реквизиты", Реквизиты);
	
	Источники.Добавить(Источник);
	
КонецПроцедуры

// Переупаковывает хранилища всех объектов (элементов справочников, документов) источника.
//
// Параметры:
//  Источник - Структура - см. ИсточникиХранилищ().
//  Настройки - Структура - см. ОбработатьИсточник().
//  Результат - Структура - счетчики обработки, см. ОбработатьИсточник().
//
Процедура ОбработатьОбъекты(Источник, Настройки, Результат)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Ссылка ИЗ " + Источник.Представление;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			ОбработатьОбъект(Выборка.Ссылка, Источник, Настройки, Результат);
		Исключение
			Результат.Ошибки.Добавить(СтрШаблон("%1: %2", Строка(Выборка.Ссылка),
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

// Переупаковывает хранилища одного объекта и записывает его, если что-то изменилось.
//
// Параметры:
//  Ссылка - СправочникСсылка, ДокументСсылка - ссылка на объект.
//  Источник - Структура - см. ИсточникиХранилищ().
//  Настройки - Структура - см. ОбработатьИсточник().
//  Результат - Структура - счетчики обработки, см. ОбработатьИсточник().
//
Процедура ОбработатьОбъект(Ссылка, Источник, Настройки, Результат)
	
	Объект = Ссылка.ПолучитьОбъект();
	
	Если Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьХранилища = Ложь;
	Изменено = Ложь;
	
	Для Каждого ИмяРеквизита Из Источник.Реквизиты Цикл
		
		Хранилище = Объект[ИмяРеквизита];
		
		Если ТипЗнч(Хранилище) <> Тип("ХранилищеЗначения") Тогда
			Продолжить;
		КонецЕсли;
		
		ЕстьХранилища = Истина;
		Сжатое = ПереупаковатьЗначение(Хранилище, Настройки, Результат);
		
		Если Сжатое <> Неопределено Тогда
			Объект[ИмяРеквизита] = Сжатое;
			Изменено = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЕстьХранилища Тогда
		Результат.Записей = Результат.Записей + 1;
	КонецЕсли;
	
	Если НЕ Изменено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	
КонецПроцедуры

// Переупаковывает хранилища записей регистра сведений источника.
// Записи обходятся потоковой выборкой и обрабатываются по одной через менеджер записи: регистр
// не выгружается в память целиком, а перезаписываются только те записи, в которых хранилища
// действительно изменились.
//
// Параметры:
//  Источник - Структура - см. ИсточникиХранилищ().
//  Настройки - Структура - см. ОбработатьИсточник().
//  Результат - Структура - счетчики обработки, см. ОбработатьИсточник().
//
Процедура ОбработатьРегистрСведений(Источник, Настройки, Результат)
	
	Выборка = РегистрыСведений[Источник.Имя].Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			ОбработатьЗаписьРегистра(Выборка, Источник, Настройки, Результат);
		Исключение
			Результат.Ошибки.Добавить(СтрШаблон("%1: %2", Источник.Представление,
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

// Переупаковывает хранилища одной записи регистра сведений и записывает ее, если что-то изменилось.
// Ключ записи (измерения, период, регистратор) заполняется платформой по текущей позиции выборки.
//
// Параметры:
//  Выборка - Произвольный - выборка регистра сведений (РегистрСведенийВыборка), спозиционированная
//   на обрабатываемой записи.
//  Источник - Структура - см. ИсточникиХранилищ().
//  Настройки - Структура - см. ОбработатьИсточник().
//  Результат - Структура - счетчики обработки, см. ОбработатьИсточник().
//
Процедура ОбработатьЗаписьРегистра(Выборка, Источник, Настройки, Результат)
	
	МенеджерЗаписи = Выборка.ПолучитьМенеджерЗаписи();
	МенеджерЗаписи.Прочитать();
	
	Если НЕ МенеджерЗаписи.Выбран() Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьХранилища = Ложь;
	Изменено = Ложь;
	
	Для Каждого ИмяРесурса Из Источник.Реквизиты Цикл
		
		Хранилище = МенеджерЗаписи[ИмяРесурса];
		
		Если ТипЗнч(Хранилище) <> Тип("ХранилищеЗначения") Тогда
			Продолжить;
		КонецЕсли;
		
		ЕстьХранилища = Истина;
		Сжатое = ПереупаковатьЗначение(Хранилище, Настройки, Результат);
		
		Если Сжатое <> Неопределено Тогда
			МенеджерЗаписи[ИмяРесурса] = Сжатое;
			Изменено = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЕстьХранилища Тогда
		Результат.Записей = Результат.Записей + 1;
	КонецЕсли;
	
	Если НЕ Изменено Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

// Переупаковывает значение хранилища с максимальной степенью сжатия.
// Пустые хранилища и хранилища со значением Неопределено не изменяются, чтобы не искажать
// результат проверки заполнения реквизита.
//
// Параметры:
//  Хранилище - ХранилищеЗначения - исходное значение реквизита (ресурса).
//  Настройки - Структура - см. ОбработатьИсточник().
//  Результат - Структура - счетчики обработки, см. ОбработатьИсточник().
//
// Возвращаемое значение:
//  ХранилищеЗначения, Неопределено - сжатое значение или Неопределено,
//  если значение переупаковывать не нужно.
//
Функция ПереупаковатьЗначение(Хранилище, Настройки, Результат)
	
	Если НЕ ЗначениеЗаполнено(Хранилище) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Значение = Хранилище.Получить();
	
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("ДвоичныеДанные") И НЕ Настройки.СжиматьДвоичныеДанные Тогда
		Результат.Пропущено = Результат.Пропущено + 1;
		Возврат Неопределено;
	КонецЕсли;
	
	Результат.Переупаковано = Результат.Переупаковано + 1;
	
	Возврат Новый ХранилищеЗначения(Значение, Новый СжатиеДанных(9));
	
КонецФункции

#КонецОбласти
