#Область ПрограммныйИнтерфейс

// Читает значение из строки JSON.
//
// Параметры:
//  СтрокаJSON - Строка - текст в формате JSON.
//
// Возвращаемое значение:
//  Структура, Массив из Произвольный, Число, Строка, Булево, Неопределено - результат разбора.
//
Функция ПрочитатьJSONИзСтроки(СтрокаJSON) Экспорт

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);

	Попытка
		// Разбор выполняется в режиме Соответствие: ключи объектов Kaiten не всегда являются
		// допустимыми именами свойств 1С (например, числовые ключи в properties карточки),
		// при разборе в Структуру такой JSON не читается.
		// Признак объекта JSON для потребителей - КТ_JSONСервер.ЭтоОбъектJSON.
		Результат = ПрочитатьJSON(ЧтениеJSON, Истина);
	Исключение
		ЧтениеJSON.Закрыть();
		ВызватьИсключение "Не удалось разобрать JSON: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЧтениеJSON.Закрыть();

	Возврат Результат;

КонецФункции

// Читает массив из строки JSON.
//
// Параметры:
//  СтрокаJSON - Строка - текст в формате JSON.
//
// Возвращаемое значение:
//  Массив из Произвольный - разобранный массив; пустой массив, если JSON не является массивом.
//
Функция ПрочитатьМассив(СтрокаJSON) Экспорт

	Результат = ПрочитатьJSONИзСтроки(СтрокаJSON);

	Если ТипЗнч(Результат) = Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Возврат Новый Массив;

КонецФункции

// Проверяет, является ли значение объектом JSON.
//
// Разбор JSON выполняется в режиме Соответствие (см. ПрочитатьJSONИзСтроки), поэтому объектом
// JSON считается и Структура, и Соответствие. Проверять напрямую Тип("Структура") нельзя:
// при разборе в Соответствие такая проверка отбрасывает все вложенные объекты.
//
// Параметры:
//  Значение - Произвольный - проверяемое значение.
//
// Возвращаемое значение:
//  Булево - Истина, если значение является объектом JSON.
//
Функция ЭтоОбъектJSON(Значение) Экспорт

	ТипЗначения = ТипЗнч(Значение);

	Возврат ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("Соответствие");

КонецФункции

// Возвращает значение поля объекта без преобразования типа.
//
// Параметры:
//  Объект - Структура, Соответствие из КлючИЗначение, Неопределено - разобранный JSON.
//  ИмяПоля - Строка - имя поля.
//
// Возвращаемое значение:
//  Произвольный - значение поля или Неопределено, если поле отсутствует.
//
Функция ПолучитьЗначениеПоля(Объект, ИмяПоля) Экспорт

	Если Объект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТипОбъекта = ТипЗнч(Объект);

	Если ТипОбъекта = Тип("Структура") Тогда
		Если Объект.Свойство(ИмяПоля) Тогда
			Возврат Объект[ИмяПоля];
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;

	Если ТипОбъекта = Тип("Соответствие") Тогда
		Возврат Объект.Получить(ИмяПоля);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Возвращает строковое значение поля.
//
// Параметры:
//  Объект - Структура, Соответствие из КлючИЗначение, Неопределено - разобранный JSON.
//  ИмяПоля - Строка - имя поля.
//  ЗначениеПоУмолчанию - Строка - значение, если поле отсутствует или имеет другой тип.
//
// Возвращаемое значение:
//  Строка - значение поля.
//
Функция ПолучитьСтроку(Объект, ИмяПоля, ЗначениеПоУмолчанию = "") Экспорт

	Значение = ПолучитьЗначениеПоля(Объект, ИмяПоля);

	Если Значение = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;

	Если ТипЗначения = Тип("Число") Тогда
		// Формат(..., "ЧГ=0") не вставляет разделители разрядов, которые Строка()
		// добавляет как неразрывный пробел (например, "35 878").
		Возврат Формат(Значение, "ЧГ=0");
	КонецЕсли;

	Если ТипЗначения = Тип("Булево") Тогда
		Возврат Строка(Значение);
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

// Возвращает числовое значение поля.
//
// Параметры:
//  Объект - Структура, Соответствие из КлючИЗначение, Неопределено - разобранный JSON.
//  ИмяПоля - Строка - имя поля.
//  ЗначениеПоУмолчанию - Число - значение, если поле отсутствует или не преобразуется к числу.
//
// Возвращаемое значение:
//  Число - значение поля.
//
Функция ПолучитьЧисло(Объект, ИмяПоля, ЗначениеПоУмолчанию = 0) Экспорт

	Возврат ЧислоИзЗначения(ПолучитьЗначениеПоля(Объект, ИмяПоля), ЗначениеПоУмолчанию);

КонецФункции

// Преобразует значение к числу.
//
// Параметры:
//  Значение - Произвольный - исходное значение.
//  ЗначениеПоУмолчанию - Число - значение, если исходное не преобразуется к числу.
//
// Возвращаемое значение:
//  Число - полученное число.
//
Функция ЧислоИзЗначения(Значение, ЗначениеПоУмолчанию = 0) Экспорт

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Строка") И НЕ ПустаяСтрока(Значение) Тогда
		Попытка
			Возврат Число(СокрЛП(Значение));
		Исключение
			Возврат ЗначениеПоУмолчанию;
		КонецПопытки;
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

// Возвращает булево значение поля.
//
// Параметры:
//  Объект - Структура, Соответствие из КлючИЗначение, Неопределено - разобранный JSON.
//  ИмяПоля - Строка - имя поля.
//  ЗначениеПоУмолчанию - Булево - значение, если поле отсутствует или имеет другой тип.
//
// Возвращаемое значение:
//  Булево - значение поля.
//
Функция ПолучитьБулево(Объект, ИмяПоля, ЗначениеПоУмолчанию = Ложь) Экспорт

	Возврат БулевоИзЗначения(ПолучитьЗначениеПоля(Объект, ИмяПоля), ЗначениеПоУмолчанию);

КонецФункции

// Преобразует значение к булеву.
//
// Параметры:
//  Значение - Произвольный - исходное значение.
//  ЗначениеПоУмолчанию - Булево - значение, если исходное не преобразуется к булеву.
//
// Возвращаемое значение:
//  Булево - полученное значение.
//
Функция БулевоИзЗначения(Значение, ЗначениеПоУмолчанию = Ложь) Экспорт

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение <> 0;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Нормализованное = НРег(СокрЛП(Значение));
		Если Нормализованное = "true" Или Нормализованное = "1" Тогда
			Возврат Истина;
		КонецЕсли;
		Если Нормализованное = "false" Или Нормализованное = "0" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

// Возвращает массив поля.
//
// Параметры:
//  Объект - Структура, Соответствие из КлючИЗначение, Неопределено - разобранный JSON.
//  ИмяПоля - Строка - имя поля.
//
// Возвращаемое значение:
//  Массив из Произвольный - значение поля; пустой массив, если поле отсутствует или не является массивом.
//
Функция ПолучитьМассив(Объект, ИмяПоля) Экспорт

	Значение = ПолучитьЗначениеПоля(Объект, ИмяПоля);

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат Новый Массив;

КонецФункции

// Возвращает дату поля, разбирая строку в формате ISO 8601.
//
// Параметры:
//  Объект - Структура, Соответствие из КлючИЗначение, Неопределено - разобранный JSON.
//  ИмяПоля - Строка - имя поля.
//
// Возвращаемое значение:
//  Дата - значение поля; пустая дата, если поле отсутствует или не разбирается.
//
Функция ПолучитьДатуUTC(Объект, ИмяПоля) Экспорт

	Возврат ПреобразоватьСтрокуВДату(ПолучитьЗначениеПоля(Объект, ИмяПоля));

КонецФункции

// Преобразует строку ISO 8601 в дату, приведенную к UTC.
//
// Смещение часового пояса из строки ("Z", "+03:00", "-05:00") учитывается: результат
// приводится к единому времени UTC, чтобы архив не зависел от пояса компьютера пользователя.
//
// Параметры:
//  Значение - Строка, Дата, Число, Неопределено - исходное значение.
//
// Возвращаемое значение:
//  Дата - разобранная дата в UTC; пустая дата при неудаче.
//
Функция ПреобразоватьСтрокуВДату(Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат '00010101000000';
	КонецЕсли;

	СтрокаДаты = СокрЛП(Строка(Значение));
	СтрокаДаты = СтрЗаменить(СтрокаДаты, "T", " ");
	СтрокаДаты = СтрЗаменить(СтрокаДаты, "t", " ");

	ДлинаСтроки = СтрДлина(СтрокаДаты);
	Если ДлинаСтроки < 10 Тогда
		Возврат '00010101000000';
	КонецЕсли;

	Год = Число(Сред(СтрокаДаты, 1, 4));
	Месяц = Число(Сред(СтрокаДаты, 6, 2));
	День = Число(Сред(СтрокаДаты, 9, 2));

	Если Год < 1 Или Месяц < 1 Или Месяц > 12 Или День < 1 Или День > 31 Тогда
		Возврат '00010101000000';
	КонецЕсли;

	Час = 0;
	Минута = 0;
	Секунда = 0;

	Если ДлинаСтроки >= 16 Тогда
		Час = Число(Сред(СтрокаДаты, 12, 2));
		Минута = Число(Сред(СтрокаДаты, 15, 2));
	КонецЕсли;

	Если ДлинаСтроки >= 19 Тогда
		Секунда = Число(Сред(СтрокаДаты, 18, 2));
	КонецЕсли;

	Если Час > 23 Тогда
		Час = 0;
	КонецЕсли;
	Если Минута > 59 Тогда
		Минута = 0;
	КонецЕсли;
	Если Секунда > 59 Тогда
		Секунда = 0;
	КонецЕсли;

	Результат = Дата(Год, Месяц, День, Час, Минута, Секунда);

	// Приводим к UTC: в строке ISO 8601 время записано со смещением пояса.
	Хвост = "";
	Если ДлинаСтроки > 19 Тогда
		Хвост = Сред(СтрокаДаты, 20);
	КонецЕсли;

	Возврат Результат - СмещениеПоясаМинут(Хвост) * 60;

КонецФункции

// Возвращает календарную дату поля: только год, месяц и день, без времени и без сдвига на UTC.
//
// Применяется для полей, которые в API являются датой без времени ("2024-05-17").
// Сдвиг на часовой пояс для них недопустим: дата смещается на сутки.
//
// Параметры:
//  Объект - Структура, Соответствие из КлючИЗначение, Неопределено - разобранный JSON.
//  ИмяПоля - Строка - имя поля.
//
// Возвращаемое значение:
//  Дата - календарная дата; пустая дата, если поле отсутствует или не разбирается.
//
Функция ПолучитьКалендарнуюДату(Объект, ИмяПоля) Экспорт

	Возврат ПреобразоватьСтрокуВКалендарнуюДату(ПолучитьЗначениеПоля(Объект, ИмяПоля));

КонецФункции

// Преобразует строку с датой без времени в дату без сдвига на часовой пояс.
//
// Параметры:
//  Значение - Строка, Дата, Неопределено - исходное значение.
//
// Возвращаемое значение:
//  Дата - дата с нулевым временем; пустая дата при неудаче.
//
Функция ПреобразоватьСтрокуВКалендарнуюДату(Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Дата(Год(Значение), Месяц(Значение), День(Значение));
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат '00010101000000';
	КонецЕсли;

	СтрокаДаты = СокрЛП(Строка(Значение));
	Если СтрДлина(СтрокаДаты) < 10 Тогда
		Возврат '00010101000000';
	КонецЕсли;

	ГодЗначения = Число(Сред(СтрокаДаты, 1, 4));
	МесяцЗначения = Число(Сред(СтрокаДаты, 6, 2));
	ДеньЗначения = Число(Сред(СтрокаДаты, 9, 2));

	Если ГодЗначения < 1 Или МесяцЗначения < 1 Или МесяцЗначения > 12
		Или ДеньЗначения < 1 Или ДеньЗначения > 31 Тогда
		Возврат '00010101000000';
	КонецЕсли;

	Возврат Дата(ГодЗначения, МесяцЗначения, ДеньЗначения);

КонецФункции

// Вычисляет контрольную сумму SHA-256 в шестнадцатеричном виде.
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные, Строка - данные для хеширования.
//
// Возвращаемое значение:
//  Строка - хеш в нижнем регистре.
//
Функция ВычислитьSHA256(ДвоичныеДанные) Экспорт

	Если ТипЗнч(ДвоичныеДанные) = Тип("Строка") Тогда
		ДанныеДляХеша = ПолучитьДвоичныеДанныеИзСтроки(ДвоичныеДанные);
	Иначе
		ДанныеДляХеша = ДвоичныеДанные;
	КонецЕсли;

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ДанныеДляХеша);

	Возврат НРег(Строка(Хеширование.ХешСумма));

КонецФункции

// Вычисляет хеш нормализованного представления разобранного JSON.
//
// Параметры:
//  Значение - Произвольный - разобранный JSON.
//
// Возвращаемое значение:
//  Строка - хеш SHA-256 в нижнем регистре.
//
Функция ВычислитьХешJSON(Значение) Экспорт

	ЗаписьJSON = Новый ЗаписьJSON;
	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);

	ЗаписатьJSON(ЗаписьJSON, Значение);
	СтрокаJSON = ЗаписьJSON.Закрыть();

	Возврат ВычислитьSHA256(СтрокаJSON);

КонецФункции

// Записывает значение в строку JSON.
//
// Параметры:
//  Значение - Произвольный - значение для сериализации.
//
// Возвращаемое значение:
//  Строка - JSON-строка.
//
Функция ЗаписатьJSONВСтроку(Значение) Экспорт

	ЗаписьJSON = Новый ЗаписьJSON;
	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);

	ЗаписатьJSON(ЗаписьJSON, Значение);
	Возврат ЗаписьJSON.Закрыть();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает смещение часового пояса из строки ISO 8601 в минутах.
//
// Поддерживаются форматы "+03:00", "-0500", "+03" и "Z".
//
// Параметры:
//  Хвост - Строка - часть строки даты после секунд, например "+03:00", "-0500", "+03", "Z".
//
// Возвращаемое значение:
//  Число - смещение в минутах; 0, если смещение не распознано (в том числе для "Z").
//
Функция СмещениеПоясаМинут(Хвост)

	Хвост = ВРег(СокрЛП(Хвост));
	ПозицияЗнака = СтрНайти(Хвост, "+");
	Если ПозицияЗнака = 0 Тогда
		ПозицияЗнака = СтрНайти(Хвост, "-");
	КонецЕсли;

	Если ПозицияЗнака = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Знак = ?(Сред(Хвост, ПозицияЗнака, 1) = "-", -1, 1);

	// После знака смещение записывается как "ЧЧ:ММ", "ЧЧММ" или "ЧЧ".
	Смещение = СтрЗаменить(Сред(Хвост, ПозицияЗнака + 1), ":", "");
	Если СтрДлина(Смещение) < 2 Тогда
		Возврат 0;
	КонецЕсли;

	Часы = 0;
	Минуты = 0;

	Попытка
		Часы = Число(Лев(Смещение, 2));
		Если СтрДлина(Смещение) >= 4 Тогда
			Минуты = Число(Сред(Смещение, 3, 2));
		КонецЕсли;
	Исключение
		Возврат 0;
	КонецПопытки;

	Возврат Знак * (Часы * 60 + Минуты);

КонецФункции

#КонецОбласти
