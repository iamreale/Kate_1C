#Область ПрограммныйИнтерфейс

// Записывает произвольную запись в технический протокол загрузки.
//
// Параметры:
//  Контекст - Структура, Неопределено - контекст загрузки (СеансЗагрузки, Этап).
//  Уровень - Строка - Информация, Предупреждение или Ошибка.
//  Сообщение - Строка - текст сообщения.
//  ВидСущности - ПеречислениеСсылка.КТ_ВидСущностиKaiten, Неопределено - вид сущности Kaiten.
//  ИдентификаторСущности - Строка - идентификатор сущности Kaiten.
//  Детали - Произвольный, Неопределено - дополнительные данные записи.
//
Процедура Записать(Контекст, Уровень, Сообщение, ВидСущности = Неопределено,
	ИдентификаторСущности = "", Детали = Неопределено) Экспорт

	Сеанс = СеансИзКонтекста(Контекст);
	Если НЕ ЗначениеЗаполнено(Сеанс) Тогда
		Возврат;
	КонецЕсли;

	Запись = РегистрыСведений.КТ_ПротоколЗагрузки.СоздатьМенеджерЗаписи();
	Запись.СеансЗагрузки = Сеанс;
	Запись.ИдентификаторKaiten = СформироватьКлючЗаписи(ИдентификаторСущности);
	Запись.Уровень = Уровень;
	Запись.Этап = ЭтапИзКонтекста(Контекст);
	Запись.Сообщение = СокрЛП(Сообщение);
	Запись.ДатаСобытия = ТекущаяУниверсальнаяДата();
	Запись.Детали = УпаковатьДетали(ИдентификаторСущности, Детали);

	Если ВидСущности <> Неопределено Тогда
		Запись.ВидСущности = ВидСущности;
	КонецЕсли;

	Запись.Записать();

КонецПроцедуры

// Записывает информационное сообщение.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//  Сообщение - Строка - текст сообщения.
//  ВидСущности - ПеречислениеСсылка.КТ_ВидСущностиKaiten, Неопределено - вид сущности Kaiten.
//  ИдентификаторСущности - Строка - идентификатор сущности Kaiten.
//
Процедура Информация(Контекст, Сообщение, ВидСущности = Неопределено,
	ИдентификаторСущности = "") Экспорт

	Записать(Контекст, "Информация", Сообщение, ВидСущности, ИдентификаторСущности);

КонецПроцедуры

// Записывает предупреждение.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//  Сообщение - Строка - текст сообщения.
//  ВидСущности - ПеречислениеСсылка.КТ_ВидСущностиKaiten, Неопределено - вид сущности Kaiten.
//  ИдентификаторСущности - Строка - идентификатор сущности Kaiten.
//
Процедура ЗаписатьПредупреждение(Контекст, Сообщение, ВидСущности = Неопределено,
	ИдентификаторСущности = "") Экспорт

	Записать(Контекст, "Предупреждение", Сообщение, ВидСущности, ИдентификаторСущности);
	УвеличитьСчётчик(Контекст, "Предупреждения");

КонецПроцедуры

// Записывает ошибку с кратким и подробным представлением.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//  Сообщение - Строка - текст сообщения.
//  ДанныеОшибки - ИнформацияОбОшибке, Неопределено - перехваченная ошибка.
//  ВидСущности - ПеречислениеСсылка.КТ_ВидСущностиKaiten, Неопределено - вид сущности Kaiten.
//  ИдентификаторСущности - Строка - идентификатор сущности Kaiten.
//
Процедура Ошибка(Контекст, Сообщение, ДанныеОшибки = Неопределено,
	ВидСущности = Неопределено, ИдентификаторСущности = "") Экспорт

	Детали = Неопределено;

	Если ДанныеОшибки <> Неопределено Тогда
		Детали = Новый Структура;
		Детали.Вставить("Кратко", ОбработкаОшибок.КраткоеПредставлениеОшибки(ДанныеОшибки));
		Детали.Вставить("Подробно", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ДанныеОшибки));
	КонецЕсли;

	Записать(Контекст, "Ошибка", Сообщение, ВидСущности, ИдентификаторСущности, Детали);
	УвеличитьСчётчик(Контекст, "Ошибки");

КонецПроцедуры

// Возвращает накопленные в контексте счётчики сообщений.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//
// Возвращаемое значение:
//  Структура - счётчики сообщений:
//   * Ошибки - Число - количество ошибок.
//   * Предупреждения - Число - количество предупреждений.
//
Функция Счётчики(Контекст) Экспорт

	Результат = Новый Структура("Ошибки,Предупреждения", 0, 0);

	Если Контекст = Неопределено Или ТипЗнч(Контекст) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;

	Если Контекст.Свойство("Счётчики") И ТипЗнч(Контекст.Счётчики) = Тип("Структура") Тогда
		Результат = Контекст.Счётчики;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Записывает итоговые счётчики в сеанс загрузки.
//
// Параметры:
//  СеансСсылка - СправочникСсылка.КТ_СеансыЗагрузки - сеанс загрузки.
//  Значения - Структура - счётчики: КоличествоЗапросов, КоличествоОшибок,
//             КоличествоКарточек, КоличествоКомментариев, КоличествоФайлов,
//             КоличествоТрудозатрат, РазмерФайловБайт.
//
Процедура ЗафиксироватьСчётчики(СеансСсылка, Значения) Экспорт

	Если НЕ ЗначениеЗаполнено(СеансСсылка) Или ТипЗнч(Значения) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Объект = СеансСсылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	УстановитьЧислоЕслиЕсть(Значения, "КоличествоЗапросов", Объект, "КоличествоЗапросов");
	УстановитьЧислоЕслиЕсть(Значения, "КоличествоОшибок", Объект, "КоличествоОшибок");
	УстановитьЧислоЕслиЕсть(Значения, "КоличествоКарточек", Объект, "КоличествоКарточек");
	УстановитьЧислоЕслиЕсть(Значения, "КоличествоКомментариев", Объект, "КоличествоКомментариев");
	УстановитьЧислоЕслиЕсть(Значения, "КоличествоФайлов", Объект, "КоличествоФайлов");
	УстановитьЧислоЕслиЕсть(Значения, "КоличествоТрудозатрат", Объект, "КоличествоТрудозатрат");
	УстановитьЧислоЕслиЕсть(Значения, "РазмерФайловБайт", Объект, "РазмерФайловБайт");

	Объект.Записать();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает сеанс загрузки из контекста.
//
// Параметры:
//  Контекст - Структура, Неопределено - контекст загрузки.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_СеансыЗагрузки - сеанс или пустая ссылка.
//
Функция СеансИзКонтекста(Контекст)

	Если Контекст = Неопределено Или ТипЗнч(Контекст) <> Тип("Структура") Тогда
		Возврат Справочники.КТ_СеансыЗагрузки.ПустаяСсылка();
	КонецЕсли;

	Если НЕ Контекст.Свойство("СеансЗагрузки") Тогда
		Возврат Справочники.КТ_СеансыЗагрузки.ПустаяСсылка();
	КонецЕсли;

	Возврат Контекст.СеансЗагрузки;

КонецФункции

// Возвращает имя текущего этапа из контекста.
//
// Параметры:
//  Контекст - Структура, Неопределено - контекст загрузки.
//
// Возвращаемое значение:
//  Строка - имя этапа или пустая строка.
//
Функция ЭтапИзКонтекста(Контекст)

	Если Контекст = Неопределено Или ТипЗнч(Контекст) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;

	Если НЕ Контекст.Свойство("Этап") Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(Контекст.Этап);

КонецФункции

// Формирует уникальный ключ записи протокола.
//
// Параметры:
//  ИдентификаторСущности - Строка - идентификатор сущности Kaiten.
//
// Возвращаемое значение:
//  Строка - ключ записи, уникальный в пределах сеанса.
//
Функция СформироватьКлючЗаписи(ИдентификаторСущности)

	УникальныйСуффикс = СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	Префикс = ?(ПустаяСтрока(ИдентификаторСущности), "LOG", Лев(СокрЛП(ИдентификаторСущности), 60));

	Возврат Префикс + ":" + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0")
		+ ":" + Лев(УникальныйСуффикс, 8);

КонецФункции

// Упаковывает дополнительные данные записи протокола.
//
// Параметры:
//  ИдентификаторСущности - Строка - идентификатор сущности Kaiten.
//  Детали - Произвольный, Неопределено - дополнительные данные.
//
// Возвращаемое значение:
//  ХранилищеЗначения - упакованные данные.
//
Функция УпаковатьДетали(ИдентификаторСущности, Детали)

	Содержимое = Новый Структура;
	Содержимое.Вставить("ИдентификаторСущности", СокрЛП(ИдентификаторСущности));
	Если Детали <> Неопределено Тогда
		Содержимое.Вставить("Данные", Детали);
	КонецЕсли;

	Попытка
		Возврат Новый ХранилищеЗначения(Содержимое, Новый СжатиеДанных(9));
	Исключение
		Текст = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Новый ХранилищеЗначения(Текст, Новый СжатиеДанных(9));
	КонецПопытки;

КонецФункции

// Увеличивает счётчик сообщений в контексте.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//  ИмяСчётчика - Строка - имя счётчика (Ошибки, Предупреждения).
//
Процедура УвеличитьСчётчик(Контекст, ИмяСчётчика)

	Если Контекст = Неопределено Или ТипЗнч(Контекст) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Если НЕ Контекст.Свойство("Счётчики") Или ТипЗнч(Контекст.Счётчики) <> Тип("Структура") Тогда
		Контекст.Вставить("Счётчики", Новый Структура("Ошибки,Предупреждения", 0, 0));
	КонецЕсли;

	Если НЕ Контекст.Счётчики.Свойство(ИмяСчётчика) Тогда
		Контекст.Счётчики.Вставить(ИмяСчётчика, 0);
	КонецЕсли;

	Контекст.Счётчики[ИмяСчётчика] = Контекст.Счётчики[ИмяСчётчика] + 1;

КонецПроцедуры

// Записывает числовое значение в реквизит объекта, если оно передано.
//
// Параметры:
//  Значения - Структура - источник значений.
//  ИмяВИсточнике - Строка - имя поля источника.
//  Объект - СправочникОбъект - записываемый объект.
//  ИмяВОбъекте - Строка - имя реквизита объекта.
//
Процедура УстановитьЧислоЕслиЕсть(Значения, ИмяВИсточнике, Объект, ИмяВОбъекте)

	Если НЕ Значения.Свойство(ИмяВИсточнике) Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Значения[ИмяВИсточнике]) Тогда
		Возврат;
	КонецЕсли;

	Объект[ИмяВОбъекте] = Значения[ИмяВИсточнике];

КонецПроцедуры

#КонецОбласти
