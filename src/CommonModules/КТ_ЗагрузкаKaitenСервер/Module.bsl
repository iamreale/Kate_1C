#Область ПрограммныйИнтерфейс

// Возвращает настройки загрузки из констант конфигурации.
//
// Возвращаемое значение:
//  Структура - настройки загрузки:
//   * АдресKaiten - Строка - адрес сервера Kaiten без завершающего слэша;
//   * Токен - Строка - токен доступа к API;
//   * ВерсияAPI - Строка - версия API;
//   * РазмерСтраницыAPI - Число - размер страницы пагинации;
//   * ТаймаутСекунд - Число - таймаут HTTP-запроса в секундах;
//   * ТаймаутФайлаСекунд - Число - таймаут скачивания файла в секундах;
//   * КоличествоПовторов - Число - количество попыток HTTP-запроса;
//   * ПаузаМеждуЗапросамиМС - Число - пауза между запросами в миллисекундах;
//   * ХранитьФайлыВИБ - Булево - признак хранения файлов в информационной базе;
//   * КаталогАрхива - Строка - корневой каталог архива файлов;
//   * ЧасовойПоясАрхива - Строка - часовой пояс архива;
//   * РежимТолькоЧтение - Булево - запрет изменения данных;
//   * ЗагружатьКомментарии - Булево - признак загрузки комментариев;
//   * ЗагружатьЧекЛисты - Булево - признак загрузки чек-листов;
//   * ЗагружатьИсторию - Булево - признак загрузки истории перемещений;
//   * ЗагружатьТрудозатраты - Булево - признак загрузки трудозатрат;
//   * ЗагружатьПользовательскиеПоля - Булево - признак загрузки значений полей;
//   * ЗагружатьФайлы - Булево - признак скачивания файлов;
//   * НеЗагружатьНСИ - Булево - признак отказа от загрузки НСИ.
//
Функция ПрочитатьНастройки() Экспорт

	ВерсияAPI = СокрЛП(Константы.КТ_ВерсияAPI.Получить());
	ВерсияAPI = ?(ПустаяСтрока(ВерсияAPI), "v1", ВерсияAPI);

	РазмерСтраницы = Число(Константы.КТ_РазмерСтраницыAPI.Получить());
	РазмерСтраницы = ?(РазмерСтраницы > 0, РазмерСтраницы, 100);
	РазмерСтраницы = ?(РазмерСтраницы > 100, 100, РазмерСтраницы);

	Таймаут = Число(Константы.КТ_ТаймаутHTTPСекунд.Получить());
	Таймаут = ?(Таймаут > 0, Таймаут, 30);

	Повторы = Число(Константы.КТ_КоличествоПовторовHTTP.Получить());
	Повторы = ?(Повторы > 0, Повторы, 3);

	Настройки = Новый Структура;
	Настройки.Вставить("АдресKaiten", СокрЛП(Константы.КТ_АдресKaiten.Получить()));
	Настройки.Вставить("Токен", СокрЛП(Константы.КТ_ТокенKaiten.Получить()));
	Настройки.Вставить("ВерсияAPI", ВерсияAPI);
	Настройки.Вставить("РазмерСтраницыAPI", РазмерСтраницы);
	Настройки.Вставить("ТаймаутСекунд", Таймаут);
	Настройки.Вставить("ТаймаутФайлаСекунд", Таймаут * 10);
	Настройки.Вставить("КоличествоПовторов", Повторы);
	Настройки.Вставить("ПаузаМеждуЗапросамиМС",
		Число(Константы.КТ_ПаузаМеждуЗапросамиМС.Получить()));
	Настройки.Вставить("ХранитьФайлыВИБ", Константы.КТ_ХранитьФайлыВИБ.Получить() = Истина);
	Настройки.Вставить("КаталогАрхива", СокрЛП(Константы.КТ_КаталогАрхива.Получить()));
	Настройки.Вставить("ЧасовойПоясАрхива", СокрЛП(Константы.КТ_ЧасовойПоясАрхива.Получить()));
	Настройки.Вставить("РежимТолькоЧтение", Константы.КТ_РежимТолькоЧтение.Получить() = Истина);
	Настройки.Вставить("ЗагружатьКомментарии", Истина);
	Настройки.Вставить("ЗагружатьЧекЛисты", Истина);
	Настройки.Вставить("ЗагружатьИсторию", Истина);
	Настройки.Вставить("ЗагружатьТрудозатраты", Истина);
	Настройки.Вставить("ЗагружатьПользовательскиеПоля", Истина);
	Настройки.Вставить("ЗагружатьФайлы", Истина);
	Настройки.Вставить("НеЗагружатьНСИ", Ложь);
	
	Настройки.Вставить("ЗагружатьФайлыКомментариев", Ложь);
	Настройки.Вставить("ЗагружатьКартинкиКомментариев", Истина);

	Возврат Настройки;

КонецФункции

// Проверяет подключение к API Kaiten.
//
// Параметры:
//  Настройки - Структура - настройки загрузки.
//
// Возвращаемое значение:
//  Структура - результат проверки:
//   * Успешно - Булево - признак успешной проверки;
//   * ИмяПользователя - Строка - описание доступного пользователя;
//   * КодHTTP - Число - код ответа HTTP.
//
Функция ПроверитьПодключение(Настройки) Экспорт

	КТ_HTTPКлиентСервер.ПроверитьНастройки(Настройки);

	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("limit", 1);
	ПараметрыЗапроса.Вставить("offset", 0);

	Ответ = КТ_HTTPКлиентСервер.ВыполнитьGET("/users", ПараметрыЗапроса, Настройки);

	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение КТ_HTTPКлиентСервер.ПолучитьОписаниеHTTPОшибки(Ответ);
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Успешно", Истина);
	Результат.Вставить("КодHTTP", Число(Ответ.КодСостояния));
	Результат.Вставить("ИмяПользователя", "Доступ подтвержден");

	Пользователи = КТ_JSONСервер.ПрочитатьМассив(Ответ.ТелоКакСтрока);
	Если Пользователи.Количество() > 0 Тогда
		Результат.ИмяПользователя = ЗначениеИли(
			КТ_JSONСервер.ПолучитьСтроку(Пользователи[0], "full_name", ""),
			"Доступ подтвержден");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Выполняет самопроверку: настройки, соединение с Kaiten, разбор и сериализация JSON,
// доступ к архиву. Проверки только читающие, данные не изменяются.
//
// Параметры:
//  Настройки - Структура, Неопределено - настройки загрузки; если не переданы, читаются из констант.
//
// Возвращаемое значение:
//  ТаблицаЗначений - результаты проверок, колонки:
//   * Проверка - Строка - название проверки.
//   * Статус - Строка - OK или Ошибка.
//   * ВремяМС - Число - длительность проверки в миллисекундах.
//   * Детали - Строка - пояснение результата.
//
Функция ВыполнитьСамопроверку(Настройки = Неопределено) Экспорт

	Если Настройки = Неопределено Тогда
		Настройки = ПрочитатьНастройки();
	КонецЕсли;

	Таблица = НоваяТаблицаПроверок();
	Ответ = Неопределено;

	// 1. Настройки подключения.
	НачалоМС = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		КТ_HTTPКлиентСервер.ПроверитьНастройки(Настройки);
		ДобавитьСтрокуПроверки(Таблица, "Настройки подключения", Истина, НачалоМС,
			"Адрес: " + Настройки.АдресKaiten + ", версия API: " + Настройки.ВерсияAPI);
	Исключение
		ДобавитьСтрокуПроверки(Таблица, "Настройки подключения", Ложь, НачалоМС,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// 2. Соединение с Kaiten и токен.
	НачалоМС = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		ПараметрыЗапроса = Новый Структура;
		ПараметрыЗапроса.Вставить("limit", 1);
		ПараметрыЗапроса.Вставить("offset", 0);

		Ответ = КТ_HTTPКлиентСервер.ВыполнитьGET("/users", ПараметрыЗапроса, Настройки);
		Если Ответ.КодСостояния <> 200 Тогда
			ВызватьИсключение КТ_HTTPКлиентСервер.ПолучитьОписаниеHTTPОшибки(Ответ);
		КонецЕсли;

		ИмяПользователя = "доступ подтвержден";
		Пользователи = КТ_JSONСервер.ПрочитатьМассив(Ответ.ТелоКакСтрока);
		Если Пользователи.Количество() > 0 Тогда
			ИмяПользователя = ЗначениеИли(
				КТ_JSONСервер.ПолучитьСтроку(Пользователи[0], "full_name", ""),
				ИмяПользователя);
		КонецЕсли;

		ДобавитьСтрокуПроверки(Таблица, "Соединение с Kaiten и токен", Истина, НачалоМС,
			"HTTP " + Ответ.КодСостояния + ", пользователь: " + ИмяПользователя);
	Исключение
		ДобавитьСтрокуПроверки(Таблица, "Соединение с Kaiten и токен", Ложь, НачалоМС,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// 3. Разбор JSON.
	НачалоМС = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Если Ответ = Неопределено Тогда
			ВызватьИсключение "Нет ответа API для разбора.";
		КонецЕсли;

		Значение = КТ_JSONСервер.ПрочитатьJSONИзСтроки(Ответ.ТелоКакСтрока);
		ДобавитьСтрокуПроверки(Таблица, "Разбор JSON", Истина, НачалоМС,
			"Тип результата: " + Строка(ТипЗнч(Значение)));
	Исключение
		ДобавитьСтрокуПроверки(Таблица, "Разбор JSON", Ложь, НачалоМС,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// 4. Сериализация и хеширование JSON.
	НачалоМС = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Проба = Новый Структура("Проверка, Значение", "Самопроверка", 123);
		СтрокаJSON = КТ_JSONСервер.ЗаписатьJSONВСтроку(Проба);
		Хеш = КТ_JSONСервер.ВычислитьХешJSON(Проба);
		ДобавитьСтрокуПроверки(Таблица, "Сериализация и хеш JSON", Истина, НачалоМС,
			"Длина: " + СтрДлина(СтрокаJSON) + ", SHA-256: " + Лев(Хеш, 16) + "...");
	Исключение
		ДобавитьСтрокуПроверки(Таблица, "Сериализация и хеш JSON", Ложь, НачалоМС,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// 5. Доступ к архиву.
	НачалоМС = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ Справочник.КТ_СырыеОбъектыAPI");
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		ДобавитьСтрокуПроверки(Таблица, "Доступ к архиву", Истина, НачалоМС,
			"Записей в КТ_СырыеОбъектыAPI: " + Формат(Выборка.Всего, "ЧГ=0"));
	Исключение
		ДобавитьСтрокуПроверки(Таблица, "Доступ к архиву", Ложь, НачалоМС,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Таблица;

КонецФункции

// Создает новый сеанс загрузки.
//
// Параметры:
//  Настройки - Структура - настройки загрузки.
//  РежимЗагрузки - Строка - режим загрузки.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_СеансыЗагрузки - созданный сеанс.
//
Функция СоздатьСеансЗагрузки(Настройки, РежимЗагрузки = "Полная") Экспорт

	ОбъектСеанса = Справочники.КТ_СеансыЗагрузки.СоздатьЭлемент();
	ОбъектСеанса.УстановитьНовыйКод();
	ОбъектСеанса.Наименование = "Сеанс загрузки " + Формат(ТекущаяУниверсальнаяДата(), "ДФ=yyyy-MM-dd HH:mm:ss");
	ОбъектСеанса.ДатаНачала = ТекущаяУниверсальнаяДата();
	ОбъектСеанса.МоментОтсечения = ТекущаяУниверсальнаяДата();
	ОбъектСеанса.Состояние = Перечисления.КТ_СостояниеЗагрузки.Выполняется;
	ОбъектСеанса.АдресKaiten = Настройки.АдресKaiten;
	ОбъектСеанса.ВерсияAPI = Настройки.ВерсияAPI;
	ОбъектСеанса.ЧасовойПояс = Настройки.ЧасовойПоясАрхива;
	ОбъектСеанса.РежимЗагрузки = РежимЗагрузки;
	ОбъектСеанса.КаталогСырогоАрхива = Настройки.КаталогАрхива;
	Если Настройки.Свойство("Пространство") И ЗначениеЗаполнено(Настройки.Пространство) Тогда
		ОбъектСеанса.Пространство = Настройки.Пространство;
	КонецЕсли;
	ОбъектСеанса.Записать();

	Возврат ОбъектСеанса.Ссылка;

КонецФункции

// Помечает сеанс загрузки остановленным пользователем.
//
// Параметры:
//  СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки - сеанс загрузки.
//
Процедура ОстановитьЗагрузку(СеансЗагрузки) Экспорт

	УстановитьСостояниеСеанса(СеансЗагрузки, Перечисления.КТ_СостояниеЗагрузки.Ожидает,
		"Остановлено пользователем");

КонецПроцедуры

// Выполняет полную загрузку в фоновом задании.
//
// Параметры:
//  СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки - сеанс загрузки.
//  Настройки - Структура - настройки загрузки.
//  МаксимумЗаданий - Число - предельное количество заданий очереди за итерацию.
//
Процедура ВыполнитьЗагрузкуФоном(СеансЗагрузки, Настройки, МаксимумЗаданий = 500) Экспорт

	УстановитьСостояниеСеанса(СеансЗагрузки, Перечисления.КТ_СостояниеЗагрузки.Выполняется, "");

	Контекст = НовыйКонтекст(Настройки, СеансЗагрузки);
	Контекст.Компания = КомпанияСеанса(Контекст);

	Попытка
		ЗагрузитьНСИ(Контекст);
		ЗагрузитьКарточки(Контекст);
		Обработано = КТ_ОчередьЗагрузкиСервер.ВыполнитьПорцию(Контекст, МаксимумЗаданий);
		Пока Обработано > 0 Цикл
			Обработано = КТ_ОчередьЗагрузкиСервер.ВыполнитьПорцию(Контекст, МаксимумЗаданий);
		КонецЦикла;
		ЗавершитьСеанс(Контекст);
	Исключение
		ОбработатьПрерываниеЗагрузки(Контекст);
	КонецПопытки;

КонецПроцедуры

// Продолжает загрузку в фоновом задании.
//
// Параметры:
//  СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки - сеанс загрузки.
//  Настройки - Структура - настройки загрузки.
//  МаксимумЗаданий - Число - предельное количество заданий очереди за итерацию.
//
Процедура ПродолжитьЗагрузкуФоном(СеансЗагрузки, Настройки, МаксимумЗаданий = 500) Экспорт

	УстановитьСостояниеСеанса(СеансЗагрузки, Перечисления.КТ_СостояниеЗагрузки.Выполняется, "");

	Контекст = НовыйКонтекст(Настройки, СеансЗагрузки);
	Контекст.Компания = КомпанияСеанса(Контекст);

	Попытка
		Обработано = КТ_ОчередьЗагрузкиСервер.ВыполнитьПорцию(Контекст, МаксимумЗаданий);
		Пока Обработано > 0 Цикл
			Обработано = КТ_ОчередьЗагрузкиСервер.ВыполнитьПорцию(Контекст, МаксимумЗаданий);
		КонецЦикла;
		ЗавершитьСеанс(Контекст);
	Исключение
		ОбработатьПрерываниеЗагрузки(Контекст);
	КонецПопытки;

КонецПроцедуры

// Обрабатывает очередь заданий выбранных видов в фоновом задании.
// Задания отбираются по виду операции и выполняемому действию, настройки подключения читаются
// из констант. Состояние сеанса ведется так же, как при обычной загрузке.
//
// Параметры:
//  СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки - сеанс загрузки.
//  Отбор - Структура, Неопределено - отбор заданий, см. КТ_ОчередьЗагрузкиСервер.ОтборЗаданий().
//  МаксимумЗаданий - Число - предельное количество заданий очереди за итерацию.
//
Процедура ВыполнитьОчередьФоном(СеансЗагрузки, Отбор, МаксимумЗаданий = 100) Экспорт

	УстановитьСостояниеСеанса(СеансЗагрузки, Перечисления.КТ_СостояниеЗагрузки.Выполняется, "");

	Контекст = НовыйКонтекст(ПрочитатьНастройки(), СеансЗагрузки);
	Контекст.Компания = КомпанияСеанса(Контекст);

	Попытка
		Обработано = КТ_ОчередьЗагрузкиСервер.ВыполнитьПорцию(Контекст, МаксимумЗаданий, Отбор);
		Пока Обработано > 0 Цикл
			Обработано = КТ_ОчередьЗагрузкиСервер.ВыполнитьПорцию(Контекст, МаксимумЗаданий, Отбор);
		КонецЦикла;

		// Обрабатывается только часть очереди (задания отбираются по виду операции и действию),
		// поэтому сеанс закрывается лишь тогда, когда готовых заданий в очереди не осталось.
		Если КТ_ОчередьЗагрузкиСервер.СостояниеОчереди(СеансЗагрузки).Ожидает = 0 Тогда
			ЗавершитьСеанс(Контекст);
		Иначе
			УстановитьСостояниеСеанса(СеансЗагрузки, Перечисления.КТ_СостояниеЗагрузки.Ожидает,
				"Обработана порция очереди, в очереди остались задания");
		КонецЕсли;
	Исключение
		ОбработатьПрерываниеЗагрузки(Контекст);
	КонецПопытки;

КонецПроцедуры

// Возвращает ход загрузки сеанса.
//
// Параметры:
//  СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки - сеанс загрузки.
//
// Возвращаемое значение:
//  Структура - ход загрузки:
//   * Состояние - ПеречислениеСсылка.КТ_СостояниеЗагрузки - состояние сеанса;
//   * Ожидает - Число - количество заданий в очереди;
//   * Выполняется - Число - количество выполняемых заданий;
//   * Загружено - Число - количество выполненных заданий;
//   * Пропущено - Число - количество пропущенных заданий;
//   * Ошибка - Число - количество заданий с ошибкой;
//   * Всего - Число - общее количество заданий;
//   * Процент - Число - доля обработанных заданий в процентах;
//   * Текст - Строка - текстовая сводка о ходе загрузки.
//
Функция ХодЗагрузки(СеансЗагрузки) Экспорт

	Очередь = КТ_ОчередьЗагрузкиСервер.СостояниеОчереди(СеансЗагрузки);

	Всего = Очередь.Ожидает + Очередь.Выполняется + Очередь.Загружено
		+ Очередь.Пропущено + Очередь.Ошибка;
	Обработано = Очередь.Загружено + Очередь.Пропущено;
	Процент = 0;
	Если Всего > 0 Тогда
		Процент = Окр(Обработано * 100 / Всего);
	КонецЕсли;

	ОбъектСеанса = СеансЗагрузки.ПолучитьОбъект();
	Состояние = Перечисления.КТ_СостояниеЗагрузки.Ожидает;
	Если ОбъектСеанса <> Неопределено Тогда
		Состояние = ОбъектСеанса.Состояние;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Состояние", Состояние);
	Результат.Вставить("Ожидает", Число(Очередь.Ожидает));
	Результат.Вставить("Выполняется", Число(Очередь.Выполняется));
	Результат.Вставить("Загружено", Число(Очередь.Загружено));
	Результат.Вставить("Пропущено", Число(Очередь.Пропущено));
	Результат.Вставить("Ошибка", Число(Очередь.Ошибка));
	Результат.Вставить("Всего", Число(Всего));
	Результат.Вставить("Процент", Процент);
	Результат.Вставить("Текст", "Состояние: " + Строка(Состояние)
		+ ". Обработано " + Обработано + " из " + Всего
		+ " заданий (" + Процент + "%), в очереди: " + Очередь.Ожидает
		+ ", ошибок: " + Очередь.Ошибка + ".");

	Возврат Результат;

КонецФункции

// Создает контекст загрузки.
//
// Параметры:
//  Настройки - Структура - настройки загрузки.
//  СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки, Неопределено - сеанс загрузки.
//
// Возвращаемое значение:
//  Структура - контекст загрузки:
//   * Настройки - Структура, Неопределено - настройки загрузки;
//   * СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки, Неопределено - сеанс загрузки;
//   * Компания - СправочникСсылка.КТ_Компании - компания архива;
//   * Этап - Строка - наименование текущего этапа;
//   * Счётчики - Структура - счетчики ошибок и предупреждений.
//
Функция НовыйКонтекст(Настройки, СеансЗагрузки = Неопределено) Экспорт

	Счётчики = Новый Структура;
	Счётчики.Вставить("Ошибки", 0);
	Счётчики.Вставить("Предупреждения", 0);

	Контекст = Новый Структура;
	Контекст.Вставить("Настройки", Настройки);
	Контекст.Вставить("СеансЗагрузки", СеансЗагрузки);
	Контекст.Вставить("Компания", Справочники.КТ_Компании.ПустаяСсылка());
	Контекст.Вставить("Этап", "");
	Контекст.Вставить("Счётчики", Счётчики);

	Если Настройки <> Неопределено Тогда
		Контекст.Компания = КомпанияСеанса(Контекст);
	КонецЕсли;

	Возврат Контекст;

КонецФункции

// Отмечает карточки сеанса загруженными полностью.
//
// Параметры:
//  СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки - завершённый сеанс загрузки.
//  Компания - СправочникСсылка.КТ_Компании - компания архива.
//
Процедура ОтметитьКарточкиЗагруженными(СеансЗагрузки, Компания) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Очередь.UIDKaiten КАК UIDKaiten,
	|	Очередь.ИдентификаторKaiten КАК ИдентификаторKaiten
	|ИЗ
	|	РегистрСведений.КТ_ОчередьЗагрузки КАК Очередь
	|ГДЕ
	|	Очередь.СеансЗагрузки = &Сеанс
	|	И Очередь.ВидСущности = &Карточка";
	Запрос.УстановитьПараметр("Сеанс", СеансЗагрузки);
	Запрос.УстановитьПараметр("Карточка", Перечисления.КТ_ВидСущностиKaiten.Карточка);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Карточка = КТ_ПоискОбъектовСервер.НайтиКарточку(Компания,
			Выборка.UIDKaiten, Выборка.ИдентификаторKaiten);
		Если НЕ ЗначениеЗаполнено(Карточка) Тогда
			Продолжить;
		КонецЕсли;

		ОбъектКарточки = Карточка.ПолучитьОбъект();
		Если ОбъектКарточки = Неопределено Или ОбъектКарточки.ДанныеЗагруженыПолностью Тогда
			Продолжить;
		КонецЕсли;

		ОбъектКарточки.ДанныеЗагруженыПолностью = Истина;
		ОбъектКарточки.Записать();

	КонецЦикла;

КонецПроцедуры

// Выполняет полную загрузку в рамках сеанса.
//
// Параметры:
//  СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки - сеанс загрузки.
//  Настройки - Структура - настройки загрузки.
//  МаксимумЗаданий - Число - предельное количество заданий очереди в этой итерации.
//
// Возвращаемое значение:
//  Структура - итоги сеанса загрузки:
//   * Состояние - ПеречислениеСсылка.КТ_СостояниеЗагрузки - состояние сеанса;
//   * ЗагруженоКарточек - Число - количество загруженных карточек;
//   * ОшибокОчереди - Число - количество заданий очереди с ошибкой;
//   * ОжидаетЗаданий - Число - количество заданий, ожидающих выполнения.
//
Функция ВыполнитьЗагрузку(СеансЗагрузки, Настройки, МаксимумЗаданий = 500) Экспорт

	Контекст = НовыйКонтекст(Настройки, СеансЗагрузки);
	Контекст.Компания = КомпанияСеанса(Контекст);

	Попытка
		ЗагрузитьНСИ(Контекст);
		ЗагрузитьКарточки(Контекст);
		Обработано = КТ_ОчередьЗагрузкиСервер.ВыполнитьПорцию(Контекст, МаксимумЗаданий);
		Пока Обработано > 0 Цикл
			Обработано = КТ_ОчередьЗагрузкиСервер.ВыполнитьПорцию(Контекст, МаксимумЗаданий);
		КонецЦикла;
		ЗавершитьСеанс(Контекст);
	Исключение
		ДанныеОшибки = ИнформацияОбОшибке();
		КТ_ОчередьЗагрузкиСервер.ЗафиксироватьОшибкуВЖурнале(ДанныеОшибки,
			"Полная загрузка: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ДанныеОшибки));
		Кратко = ОбработкаОшибок.КраткоеПредставлениеОшибки(ДанныеОшибки);
		КТ_ПротоколЗагрузкиСервер.Ошибка(Контекст, "Загрузка прервана: " + Кратко, ДанныеОшибки);
		ОбъектСеанса = СеансЗагрузки.ПолучитьОбъект();
		Если ОбъектСеанса <> Неопределено Тогда
			ОбъектСеанса.Состояние = Перечисления.КТ_СостояниеЗагрузки.Ошибка;
			ОбъектСеанса.Комментарий = Кратко;
			ОбъектСеанса.Записать();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Возврат ИтогиСеанса(СеансЗагрузки);

КонецФункции

// Продолжает загрузку сеанса, не выполняя повторно загрузку НСИ и карточек.
//
// Параметры:
//  СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки - сеанс загрузки.
//  Настройки - Структура - настройки загрузки.
//  МаксимумЗаданий - Число - предельное количество заданий очереди в этой итерации.
//
// Возвращаемое значение:
//  Структура - итоги сеанса загрузки:
//   * Состояние - ПеречислениеСсылка.КТ_СостояниеЗагрузки - состояние сеанса;
//   * ЗагруженоКарточек - Число - количество загруженных карточек;
//   * ОшибокОчереди - Число - количество заданий очереди с ошибкой;
//   * ОжидаетЗаданий - Число - количество заданий, ожидающих выполнения.
//
Функция ПродолжитьЗагрузку(СеансЗагрузки, Настройки, МаксимумЗаданий = 500) Экспорт

	Контекст = НовыйКонтекст(Настройки, СеансЗагрузки);
	Контекст.Компания = КомпанияСеанса(Контекст);

	Обработано = КТ_ОчередьЗагрузкиСервер.ВыполнитьПорцию(Контекст, МаксимумЗаданий);
	Пока Обработано > 0 Цикл
		Обработано = КТ_ОчередьЗагрузкиСервер.ВыполнитьПорцию(Контекст, МаксимумЗаданий);
	КонецЦикла;

	Возврат ИтогиСеанса(СеансЗагрузки);

КонецФункции

// Возвращает задания сеанса с ошибкой в очередь на повтор.
//
// Параметры:
//  СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки - сеанс загрузки.
//  Настройки - Структура - настройки загрузки.
//
// Возвращаемое значение:
//  Число - количество возвращенных в очередь заданий.
//
Функция ПовторитьОшибки(СеансЗагрузки, Настройки) Экспорт

	Контекст = НовыйКонтекст(Настройки, СеансЗагрузки);
	Контекст.Компания = КомпанияСеанса(Контекст);

	Возврат КТ_ОчередьЗагрузкиСервер.СброситьОшибки(СеансЗагрузки);

КонецФункции

// Выполняет финальную проверку полноты архива сеанса.
//
// Параметры:
//  СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки - сеанс загрузки.
//  Настройки - Структура, Неопределено - настройки загрузки.
//
// Возвращаемое значение:
//  Структура - результаты проверки полноты:
//   * ВсегоКарточек - Число - количество карточек в архиве;
//   * ЗагруженоПолностью - Число - количество карточек с признаком полной загрузки;
//   * СОшибками - Число - количество карточек с ошибками загрузки;
//   * НезагруженныхФайлов - Число - количество файлов без загруженного содержимого;
//   * ОшибокОчереди - Число - количество заданий очереди, завершившихся ошибкой;
//   * КарточекСТрудозатратами - Число - количество карточек, у которых есть трудозатраты;
//   * ТрудозатратВсего - Число - количество записей трудозатрат;
//   * ТрудозатратМинут - Число - суммарная длительность трудозатрат в минутах;
//   * ОшибокТрудозатрат - Число - количество заданий загрузки трудозатрат с ошибкой;
//   * Замечания - Массив из Строка - текстовые замечания по результатам проверки.
//
// Трудозатраты - необязательный блок карточки: их отсутствие замечанием не считается,
// замечание формируется только при ошибках загрузки трудозатрат.
//
Функция ПроверитьПолноту(СеансЗагрузки, Настройки = Неопределено) Экспорт

	Контекст = Неопределено;
	Если Настройки <> Неопределено Тогда
		Контекст = НовыйКонтекст(Настройки, СеансЗагрузки);
	КонецЕсли;

	Результат = КТ_КонтрольПолнотыСервер.ПроверитьПолноту(СеансЗагрузки, Контекст);

	Возврат Результат;

КонецФункции

// Возвращает итоги сеанса загрузки.
//
// Параметры:
//  СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки - сеанс загрузки.
//
// Возвращаемое значение:
//  Структура - итоги сеанса:
//   * Состояние - ПеречислениеСсылка.КТ_СостояниеЗагрузки - состояние сеанса;
//   * ЗагруженоКарточек - Число - количество загруженных карточек;
//   * ОшибокОчереди - Число - количество заданий очереди с ошибкой;
//   * ОжидаетЗаданий - Число - количество заданий, ожидающих выполнения.
//
Функция ИтогиСеанса(СеансЗагрузки) Экспорт

	Очередь = КТ_ОчередьЗагрузкиСервер.СостояниеОчереди(СеансЗагрузки);

	Результат = Новый Структура;
	Результат.Вставить("Состояние", Перечисления.КТ_СостояниеЗагрузки.Ожидает);
	Результат.Вставить("ЗагруженоКарточек", Число(Очередь.Загружено));
	Результат.Вставить("ОшибокОчереди", Число(Очередь.Ошибка));
	Результат.Вставить("ОжидаетЗаданий", Число(Очередь.Ожидает));

	ОбъектСеанса = СеансЗагрузки.ПолучитьОбъект();
	Если ОбъектСеанса <> Неопределено Тогда
		Результат.Состояние = ОбъектСеанса.Состояние;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Загружает нормативно-справочную информацию.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//
Процедура ЗагрузитьНСИ(Контекст) Экспорт

	Если Контекст.Настройки.НеЗагружатьНСИ = Истина Тогда
		КТ_ПротоколЗагрузкиСервер.Информация(Контекст,
			"Загрузка НСИ пропущена: установлен флаг НеЗагружатьНСИ");
		Возврат;
	КонецЕсли;

	Контекст.Этап = "НСИ";
	КТ_ПротоколЗагрузкиСервер.Информация(Контекст, "Начата загрузка НСИ");

	ЗагрузитьКомпанию(Контекст);
	ЗагрузитьПользователей(Контекст);
	ЗагрузитьРолиТрудозатрат(Контекст);
	ЗагрузитьПространства(Контекст);
	ЗагрузитьТипыКарточек(Контекст);
	ЗагрузитьТеги(Контекст);
	ЗагрузитьПользовательскиеПоля(Контекст);

	КТ_ПротоколЗагрузкиСервер.Информация(Контекст, "Загрузка НСИ завершена");

КонецПроцедуры

// Ставит в очередь задания по карточкам списка.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//
Процедура ЗагрузитьКарточки(Контекст) Экспорт

	Контекст.Этап = "Карточки";
	КТ_ПротоколЗагрузкиСервер.Информация(Контекст, "Чтение списка карточек");

	Карточки = ПолучитьСтраницы("/cards", Контекст,
		Перечисления.КТ_ВидСущностиKaiten.Карточка);

	ПространствоСеанса = ПространствоФильтраКарточек(Контекст);
	
	//какой то тупой отбор по пространству карточек уже после того как их получили... 
	//Если ПространствоСеанса <> Неопределено Тогда
	//	Карточки = ОтобратьКарточкиПоПространству(Карточки, ПространствоСеанса.ИдентификаторKaiten);
	//	КТ_ПротоколЗагрузкиСервер.Информация(Контекст,
	//		"Отбор по пространству " + Строка(ПространствоСеанса)
	//		+ ": карточек " + Карточки.Количество());
	//КонецЕсли;

	КТ_ПротоколЗагрузкиСервер.Информация(Контекст,
		"Получено карточек в списке: " + Карточки.Количество());

	Для Каждого ЭлементКарточки Из Карточки Цикл
		ПоставитьЗаданияПоКарточке(Контекст, ЭлементКарточки);
	КонецЦикла;

КонецПроцедуры

// Выполняет одно задание очереди загрузки.
//
// Параметры:
//  Задание - Структура - задание очереди.
//  Контекст - Структура - контекст загрузки.
//
Процедура ВыполнитьЗаданиеОчереди(Задание, Контекст) Экспорт

	Ключ = Задание.КлючЗадания;

	Если СтрНайти(Ключ, ":FILE:") > 0 Тогда
		ВыполнитьФайловоеЗадание(Задание, Контекст);
		Возврат;
	КонецЕсли;

	Если СтрЧислоВхождений(Ключ, ":") = 1 Тогда
		ВыполнитьЗагрузкуКарточки(Задание, Контекст);
		Возврат;
	КонецЕсли;

	ВыполнитьДочернееЗадание(Задание, Контекст);

КонецПроцедуры

// Сохраняет сырой ответ API в архив.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//  Путь - Строка - путь маршрута API.
//  ПараметрыЗапроса - Структура, Соответствие из КлючИЗначение, Неопределено - параметры запроса.
//  Ответ - Структура - ответ HTTP.
//  ВидСущности - ПеречислениеСсылка.КТ_ВидСущностиKaiten, Неопределено - вид сущности.
//  ВидОперацииAPI - Строка - назначение запроса.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_СырыеОбъектыAPI - ссылка на сохраненный объект.
//
Функция СохранитьСыройОтвет(Контекст, Путь, ПараметрыЗапроса, Ответ, ВидСущности = Неопределено,
	ВидОперацииAPI = "") Экспорт

	Если Контекст = Неопределено Или НЕ Контекст.Свойство("СеансЗагрузки") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Контекст.СеансЗагрузки) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Тело = Ответ.ТелоКакСтрока;
	Если Тело = Неопределено Тогда
		Тело = "";
	КонецЕсли;

	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(Тело, КодировкаТекста.UTF8, Ложь);
	ПараметрыВСтроке = ПараметрыЗапросаВСтроку(ПараметрыЗапроса);

	Объект = Справочники.КТ_СырыеОбъектыAPI.СоздатьЭлемент();
	Объект.УстановитьНовыйКод();
	Объект.Наименование = Лев(Путь + ПараметрыВСтроке, 150);
	Объект.СеансЗагрузки = Контекст.СеансЗагрузки;
	Объект.ВидСущности = ?(ВидСущности = Неопределено,
		Перечисления.КТ_ВидСущностиKaiten.Прочее, ВидСущности);
	Объект.HTTPМетод = "GET";
	Объект.ПутьЗапроса = Лев(Путь, 1000);
	Объект.ПараметрыЗапроса = ПараметрыВСтроке;
	Объект.ВидОперацииAPI = Лев(ВидОперацииAPI, 100);
	Объект.КодHTTP = Ответ.КодСостояния;
	Объект.ДатаПолучения = ТекущаяУниверсальнаяДата();
	Объект.ContentType = КТ_HTTPКлиентСервер.ЗначениеЗаголовкаОтвета(Ответ, "Content-Type");
	Объект.РазмерОтвета = ДвоичныеДанные.Размер();
	Объект.SHA256 = КТ_JSONСервер.ВычислитьSHA256(ДвоичныеДанные);
	Объект.JSON = Новый ХранилищеЗначения(Тело, Новый СжатиеДанных(9));
	Объект.ОтносительныйПуть = Лев(Путь + ПараметрыВСтроке, 500);

	РазобранноеЗначение = Неопределено;

	Если Ответ.КодСостояния = 200 Тогда
		Попытка
			РазобранноеЗначение = КТ_JSONСервер.ПрочитатьJSONИзСтроки(Тело);
			Объект.УспешноРазобран = Истина;
			Объект.ТекстОшибкиРазбора = "";
		Исключение
			РазобранноеЗначение = Неопределено;
			Объект.УспешноРазобран = Ложь;
			Объект.ТекстОшибкиРазбора =
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	Иначе
		Объект.УспешноРазобран = Ложь;
		Объект.ТекстОшибкиРазбора = "HTTP " + Ответ.КодСостояния;
	КонецЕсли;

	ЗаполнитьИдентификаторыАрхива(Объект, Путь, РазобранноеЗначение);

	Объект.Записать();

	Возврат Объект.Ссылка;

КонецФункции

// Читает все страницы спискового маршрута API.
//
// Параметры:
//  Путь - Строка - путь маршрута API.
//  Контекст - Структура - контекст загрузки.
//  ВидСущности - ПеречислениеСсылка.КТ_ВидСущностиKaiten, Неопределено - вид сущности для архива.
//  БезПагинации - Булево - Истина, если маршрут отдает данные одним ответом без limit и offset.
//
// Возвращаемое значение:
//  Массив из Структура - элементы всех страниц.
//
Функция ПолучитьСтраницы(Путь, Контекст, ВидСущности = Неопределено, БезПагинации = Ложь) Экспорт

	Настройки = Контекст.Настройки;
	Размер = Настройки.РазмерСтраницыAPI;
	Результат = Новый Массив;
	Смещение = 0;
	ХешПредыдущейСтраницы = "";
	
	space_id = Неопределено;
	ДобавлятьФлагОписания = Ложь;
	Если Путь = "/cards" Тогда //фильтруем карточки через пространство. чтобы не грузить все если мы хотим только одно пространство
		Если Настройки.Свойство("Пространство") и ЗначениеЗаполнено(Настройки.Пространство) Тогда
			space_id = Настройки.Пространство.ИдентификаторKaiten;
		КонецЕсли;
		ДобавлятьФлагОписания = Истина;
	КонецЕсли;
	
	//additional_card_fields=description - необходимо для получения описания карточки
	
	Пока Истина Цикл

		ПараметрыЗапроса = Новый Структура;
		
		Если space_id <> Неопределено Тогда
			ПараметрыЗапроса.Вставить("space_id", space_id);
		КонецЕсли;
		
		
		Если НЕ БезПагинации Тогда
			ПараметрыЗапроса.Вставить("limit", Размер);
			ПараметрыЗапроса.Вставить("offset", Смещение);
		КонецЕсли;
		
		Если ДобавлятьФлагОписания Тогда
			ПараметрыЗапроса.Вставить("additional_card_fields", "description");
		КонецЕсли;

		Ответ = КТ_HTTPКлиентСервер.ВыполнитьGET(Путь, ПараметрыЗапроса, Настройки);
		СохранитьСыройОтвет(Контекст, Путь, ПараметрыЗапроса, Ответ, ВидСущности,
			"ПолучениеСпискаМаршрута");
		Страница = СтраницаИзОтвета(Ответ, Контекст, Путь);

		Если Страница.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;

		// Защита от зацикливания: маршрут, который игнорирует offset, вернет ту же страницу.
		ХешСтраницы = КТ_JSONСервер.ВычислитьХешJSON(Страница);
		Если ХешСтраницы = ХешПредыдущейСтраницы Тогда
			КТ_ПротоколЗагрузкиСервер.Информация(Контекст,
				"Маршрут " + Путь + " игнорирует offset: загрузка списка прервана, получено "
				+ Результат.Количество() + " элементов");
			Прервать;
		КонецЕсли;
		ХешПредыдущейСтраницы = ХешСтраницы;

		Для Каждого Элемент Из Страница Цикл
			Результат.Добавить(Элемент);
		КонецЦикла;

		Если БезПагинации Или Страница.Количество() < Размер Тогда
			Прервать;
		КонецЕсли;

		Смещение = Смещение + Размер;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Восстанавливает сущности архива из сохранённых ответов API.
//
// Параметры:
//  СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки, Неопределено - сеанс, чей сырой архив восстанавливается.
//  ВидСущности - ПеречислениеСсылка.КТ_ВидСущностиKaiten, Неопределено - вид сущности (Неопределено - все виды).
//  Настройки - Структура - настройки загрузки.
//
// Возвращаемое значение:
//  Структура - итоги восстановления:
//   * Записей - Число - обработано записей сырого архива;
//   * Восстановлено - Число - записано сущностей;
//   * Ошибок - Число - записей, завершившихся ошибкой;
//   * Отложено - Число - записей, отложенных из-за отсутствия головной сущности;
//   * Текст - Строка - текстовая сводка.
//
Функция ВосстановитьИзСырогоАрхива(СеансЗагрузки, ВидСущности, Настройки) Экспорт

	Контекст = НовыйКонтекст(Настройки, СеансЗагрузки);
	Контекст.Этап = "Восстановление из архива";
	Если ЗначениеЗаполнено(СеансЗагрузки) Тогда
		Контекст.Компания = КомпанияСеанса(Контекст);
	КонецЕсли;

	Виды = ВидыВосстановленияПоПорядку(ВидСущности);

	Итог = Новый Структура;
	Итог.Вставить("Записей", 0);
	Итог.Вставить("Восстановлено", 0);
	Итог.Вставить("Ошибок", 0);
	Итог.Вставить("Отложено", 0);

	// Виды сущностей обрабатываются по порядку зависимостей: НСИ, затем карточки, затем их дочерние данные.
	Отложенные = Новый Массив;

	ЗаписиПоВидам = Новый Соответствие;
	Для Каждого Вид Из Виды Цикл
		ЗаписиПоВидам.Вставить(Вид, Новый Массив);
	КонецЦикла;

	Для Каждого ЗаписьАрхива Из ЗаписиСырогоАрхива(СеансЗагрузки, Виды) Цикл
		ЗаписиВида = ЗаписиПоВидам.Получить(ЗаписьАрхива.ВидСущности);
		Если ЗаписиВида <> Неопределено Тогда
			ЗаписиВида.Добавить(ЗаписьАрхива);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Вид Из Виды Цикл

		Записи = ЗаписиПоВидам.Получить(Вид);

		КТ_ПротоколЗагрузкиСервер.Информация(Контекст,
			"Восстановление " + Строка(Вид) + ": записей " + Записи.Количество());

		ВосстановитьЗаписи(Записи, Контекст, Итог, Отложенные, Истина);

	КонецЦикла;

	// Записи без головной сущности повторяются: к этому моменту головные сущности уже записаны.
	Если Отложенные.Количество() > 0 Тогда
		КТ_ПротоколЗагрузкиСервер.Информация(Контекст,
			"Повторный проход по отложенным записям: " + Отложенные.Количество());
		ВосстановитьЗаписи(Отложенные, Контекст, Итог, Неопределено, Ложь);
	КонецЕсли;

	Итог.Вставить("Текст", "Восстановление завершено: записей " + Итог.Записей
		+ ", сущностей " + Итог.Восстановлено + ", ошибок " + Итог.Ошибок + ".");
	ОбновитьХодВосстановления(СеансЗагрузки, Итог);

	Возврат Итог;

КонецФункции

// Восстанавливает сущности архива из сохранённых ответов API в фоновом задании.
//
// Параметры:
//  СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки, Неопределено - сеанс восстановления.
//  ВидСущности - ПеречислениеСсылка.КТ_ВидСущностиKaiten, Неопределено - вид сущности.
//  Настройки - Структура - настройки загрузки.
//
Процедура ВосстановитьИзСырогоАрхиваФоном(СеансЗагрузки, ВидСущности, Настройки) Экспорт

	Попытка
		ВосстановитьИзСырогоАрхива(СеансЗагрузки, ВидСущности, Настройки);
	Исключение
		ДанныеОшибки = ИнформацияОбОшибке();
		ОбновитьКомментарийСеанса(СеансЗагрузки, "Восстановление прервано: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ДанныеОшибки));
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Возвращает контекст восстановления по записи сырого архива.
//
// Параметры:
//  ЗаписьАрхива - СправочникСсылка.КТ_СырыеОбъектыAPI - запись архива.
//
// Возвращаемое значение:
//  Структура - контекст восстановления:
//   * Настройки - Структура, Неопределено - настройки загрузки;
//   * СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки, Неопределено - сеанс архива;
//   * Компания - СправочникСсылка.КТ_Компании - компания архива;
//   * Этап - Строка - название этапа для протокола;
//   * Счётчики - Структура - счётчики протокола.
//
Функция КонтекстВосстановления(ЗаписьАрхива) Экспорт

	СеансЗагрузки = ЗаписьАрхива.СеансЗагрузки;
	Контекст = НовыйКонтекст(ПрочитатьНастройки(), СеансЗагрузки);
	Контекст.Этап = "Проверка по сырым данным";
	Если ЗначениеЗаполнено(СеансЗагрузки) Тогда
		Контекст.Компания = КомпанияСеанса(Контекст);
	КонецЕсли;

	Возврат Контекст;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает записи сырого архива для восстановления.
//
// Параметры:
//  СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки, Неопределено - сеанс архива.
//  Виды - Массив из ПеречислениеСсылка.КТ_ВидСущностиKaiten - виды сущностей.
//
// Возвращаемое значение:
//  Массив из Структура - записи архива в порядке получения.
//
Функция ЗаписиСырогоАрхива(СеансЗагрузки, Виды)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	Архив.Ссылка КАК Ссылка,
		|	Архив.Наименование КАК Наименование,
		|	Архив.ВидСущности КАК ВидСущности,
		|	Архив.ВидОперацииAPI КАК ВидОперацииAPI,
		|	Архив.ПутьЗапроса КАК ПутьЗапроса,
		|	Архив.JSON КАК JSON
		|ИЗ
		|	Справочник.КТ_СырыеОбъектыAPI КАК Архив
		|ГДЕ
		|	Архив.УспешноРазобран
		|	И Архив.КодHTTP = 200
		|	И НЕ Архив.ПометкаУдаления
		|	И Архив.ВидСущности В (&Виды)";

	Запрос.УстановитьПараметр("Виды", Виды);

	Если ЗначениеЗаполнено(СеансЗагрузки) Тогда
		Запрос.Текст = Запрос.Текст + "
			|	И Архив.СеансЗагрузки = &Сеанс";
		Запрос.УстановитьПараметр("Сеанс", СеансЗагрузки);
	КонецЕсли;

	Запрос.Текст = Запрос.Текст + "
		|УПОРЯДОЧИТЬ ПО
		|	Архив.ДатаПолучения,
		|	Архив.Ссылка";

	Результат = Новый Массив;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = Новый Структура;
		Запись.Вставить("Ссылка", Выборка.Ссылка);
		Запись.Вставить("Наименование", Выборка.Наименование);
		Запись.Вставить("ВидСущности", Выборка.ВидСущности);
		Запись.Вставить("ВидОперацииAPI", Выборка.ВидОперацииAPI);
		Запись.Вставить("ПутьЗапроса", Выборка.ПутьЗапроса);
		Запись.Вставить("JSON", Выборка.JSON);
		Результат.Добавить(Запись);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Восстанавливает сущности из одной записи сырого архива.
//
// Параметры:
//  ЗаписьАрхива - Структура - запись сырого архива.
//  Контекст - Структура - контекст загрузки.
//
// Возвращаемое значение:
//  Число - количество записанных сущностей; -1 - запись отложена, головная сущность не найдена.
//
Функция ВосстановитьЗаписьАрхива(ЗаписьАрхива, Контекст)

	Тело = ЗаписьАрхива.JSON.Получить();
	Если НЕ ЗначениеЗаполнено(Тело) Тогда
		Возврат 0;
	КонецЕсли;

	Значение = КТ_JSONСервер.ПрочитатьJSONИзСтроки(Тело);
	ВидОперации = ЗаписьАрхива.ВидОперацииAPI;

	Если ВидОперации = "ПолучениеОбъектаКарточки" Тогда
		ВосстановитьСущность(Значение, Перечисления.КТ_ВидСущностиKaiten.Карточка, Контекст);
		Возврат 1;
	КонецЕсли;

	Если ВидОперации <> "ПолучениеСпискаМаршрута"
		И ВидОперации <> "ПолучениеРолейТрудозатрат" Тогда
		Возврат 0;
	КонецЕсли;

	Элементы = Значение;
	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		Элементы = МассивПоля(Значение, "items");
		Если Элементы.Количество() = 0 Тогда
			Элементы = МассивПоля(Значение, "data");
		КонецЕсли;
	КонецЕсли;

	ВидСущности = ЗаписьАрхива.ВидСущности;

	// Дочерние данные карточки: пока головная карточка не восстановлена, записывать их некуда.
	Если ВидСущности = Перечисления.КТ_ВидСущностиKaiten.Комментарий
		Или ВидСущности = Перечисления.КТ_ВидСущностиKaiten.ЧекЛист
		Или ВидСущности = Перечисления.КТ_ВидСущностиKaiten.Перемещение
		Или ВидСущности = Перечисления.КТ_ВидСущностиKaiten.Трудозатрата Тогда

		Карточка = КарточкаИзПутиЗаписи(ЗаписьАрхива.ПутьЗапроса, Контекст);
		Если НЕ ЗначениеЗаполнено(Карточка) Тогда
			Возврат -1;
		КонецЕсли;

		ВосстановитьДочерниеДанные(Карточка, ВидСущности, Элементы, Контекст);
		Возврат Элементы.Количество();
	КонецЕсли;

	// Связи карточек: ответ маршрута /cards/{id}/children описывает дочерние карточки,
	// поэтому восстанавливается как связи, а не как список карточек.
	Если ВидСущности = Перечисления.КТ_ВидСущностиKaiten.Карточка
		И СтрЗаканчиваетсяНа(ЗаписьАрхива.ПутьЗапроса, "/children") Тогда

		Карточка = КарточкаИзПутиЗаписи(ЗаписьАрхива.ПутьЗапроса, Контекст);
		Если НЕ ЗначениеЗаполнено(Карточка) Тогда
			Возврат -1;
		КонецЕсли;

		КТ_ЗаписьРегистровСервер.ЗаписатьСвязи(Карточка, Элементы, Контекст);
		Возврат Элементы.Количество();
	КонецЕсли;

	Для Каждого Элемент Из Элементы Цикл

		// Списковой ответ /cards содержит урезанный JSON карточки: если карточка уже
		// восстановлена (в том числе из полного ответа /cards/{id}), он её не перезаписывает.
		Если ВидСущности = Перечисления.КТ_ВидСущностиKaiten.Карточка Тогда
			КарточкаСуществует = КТ_ПоискОбъектовСервер.НайтиКарточку(Контекст.Компания, "",
				КТ_JSONСервер.ПолучитьЧисло(Элемент, "id"));
			Если ЗначениеЗаполнено(КарточкаСуществует) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		ВосстановитьСущность(Элемент, ВидСущности, Контекст);
	КонецЦикла;

	Возврат Элементы.Количество();

КонецФункции

// Записывает одну сущность архива.
//
// Параметры:
//  Элемент - Структура - объект JSON сущности.
//  ВидСущности - ПеречислениеСсылка.КТ_ВидСущностиKaiten - вид сущности.
//  Контекст - Структура - контекст загрузки.
//
Процедура ВосстановитьСущность(Элемент, ВидСущности, Контекст) Экспорт

	Если ВидСущности = Перечисления.КТ_ВидСущностиKaiten.Компания Тогда
		КТ_ЗаписьОбъектовСервер.ЗаписатьКомпанию(Элемент, Контекст);
	ИначеЕсли ВидСущности = Перечисления.КТ_ВидСущностиKaiten.Пользователь Тогда
		КТ_ЗаписьОбъектовСервер.ЗаписатьПользователя(Элемент, Контекст);
	ИначеЕсли ВидСущности = Перечисления.КТ_ВидСущностиKaiten.Пространство Тогда
		КТ_ЗаписьОбъектовСервер.ЗаписатьПространство(Элемент, Контекст);
	ИначеЕсли ВидСущности = Перечисления.КТ_ВидСущностиKaiten.Доска Тогда
		КТ_ЗаписьОбъектовСервер.ЗаписатьДоску(Элемент,
			КТ_ЗаписьОбъектовСервер.РазрешитьПространство(Элемент, Контекст), Контекст);
	ИначеЕсли ВидСущности = Перечисления.КТ_ВидСущностиKaiten.Колонка Тогда
		КТ_ЗаписьОбъектовСервер.ЗаписатьКолонку(Элемент,
			КТ_ЗаписьОбъектовСервер.РазрешитьДоску(Элемент, Контекст), Неопределено, Контекст);
	ИначеЕсли ВидСущности = Перечисления.КТ_ВидСущностиKaiten.Дорожка Тогда
		КТ_ЗаписьОбъектовСервер.ЗаписатьДорожку(Элемент,
			КТ_ЗаписьОбъектовСервер.РазрешитьДоску(Элемент, Контекст), Контекст);
	ИначеЕсли ВидСущности = Перечисления.КТ_ВидСущностиKaiten.ТипКарточки Тогда
		КТ_ЗаписьОбъектовСервер.ЗаписатьТипКарточки(Элемент, Контекст);
	ИначеЕсли ВидСущности = Перечисления.КТ_ВидСущностиKaiten.Тег Тогда
		КТ_ЗаписьОбъектовСервер.ЗаписатьТег(Элемент, Контекст);
	ИначеЕсли ВидСущности = Перечисления.КТ_ВидСущностиKaiten.РольТрудозатрат Тогда
		КТ_ЗаписьОбъектовСервер.ЗаписатьРольТрудозатрат(Элемент, Контекст);
	ИначеЕсли ВидСущности = Перечисления.КТ_ВидСущностиKaiten.ПользовательскоеПоле Тогда
		КТ_ЗаписьОбъектовСервер.ЗаписатьПользовательскоеПоле(Элемент, Контекст);
	ИначеЕсли ВидСущности = Перечисления.КТ_ВидСущностиKaiten.Карточка Тогда
		Карточка = КТ_ЗаписьОбъектовСервер.ЗаписатьКарточку(Элемент, Контекст);
		Если ЗначениеЗаполнено(Карточка) Тогда
			КТ_ЗаписьРегистровСервер.ЗаписатьУчастников(Карточка,
				МассивПоля(Элемент, "members"), Контекст);
			КТ_ЗаписьРегистровСервер.ЗаписатьТеги(Карточка,
				МассивПоля(Элемент, "tags"), Контекст);
			КТ_ЗаписьРегистровСервер.ЗаписатьПользовательскиеПоля(Карточка,
				КТ_JSONСервер.ПолучитьЗначениеПоля(Элемент, "properties"), Контекст);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Восстанавливает дочерние данные карточки.
//
// Параметры:
//  Карточка - СправочникСсылка.КТ_Карточки - головная карточка.
//  ВидСущности - ПеречислениеСсылка.КТ_ВидСущностиKaiten - вид дочерних данных.
//  Элементы - Массив из Структура - объекты JSON дочерних данных.
//  Контекст - Структура - контекст загрузки.
//
Процедура ВосстановитьДочерниеДанные(Карточка, ВидСущности, Элементы, Контекст) Экспорт

	Если ВидСущности = Перечисления.КТ_ВидСущностиKaiten.Комментарий Тогда
		Для Каждого Элемент Из Элементы Цикл
			КТ_ЗаписьОбъектовСервер.ЗаписатьКомментарий(Карточка, Элемент, Контекст);
		КонецЦикла;
	ИначеЕсли ВидСущности = Перечисления.КТ_ВидСущностиKaiten.ЧекЛист Тогда
		Для Каждого Элемент Из Элементы Цикл
			ВосстановитьЧекЛист(Карточка, Элемент, Контекст);
		КонецЦикла;
	ИначеЕсли ВидСущности = Перечисления.КТ_ВидСущностиKaiten.Перемещение Тогда
		КТ_ЗаписьРегистровСервер.ЗаписатьИсториюПеремещений(Карточка, Элементы, Контекст);
	Иначе
		КТ_ЗаписьРегистровСервер.ЗаписатьТрудозатраты(Карточка, Элементы, Контекст);
	КонецЕсли;

КонецПроцедуры

// Восстанавливает чек-лист карточки вместе с пунктами.
//
// Параметры:
//  Карточка - СправочникСсылка.КТ_Карточки - головная карточка.
//  Элемент - Структура - объект JSON чек-листа.
//  Контекст - Структура - контекст загрузки.
//
Процедура ВосстановитьЧекЛист(Карточка, Элемент, Контекст)

	ЧекЛист = КТ_ЗаписьОбъектовСервер.ЗаписатьЧекЛист(Карточка, Элемент, Контекст);

	Если ЗначениеЗаполнено(ЧекЛист) Тогда
		КТ_ЗаписьРегистровСервер.ЗаписатьПунктыЧекЛиста(ЧекЛист,
			МассивПоля(Элемент, "items"), Контекст);
	КонецЕсли;

КонецПроцедуры

// Возвращает карточку архива по пути запроса вида /cards/{id}/...
//
// Параметры:
//  ПутьЗапроса - Строка - путь запроса к API.
//  Контекст - Структура - контекст загрузки.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_Карточки - карточка или пустая ссылка.
//
Функция КарточкаИзПутиЗаписи(ПутьЗапроса, Контекст)

	// Путь запроса всегда начинается с "/", поэтому пустые части сохраняются:
	// Части[1] - "cards", Части[2] - идентификатор карточки.
	Части = СтрРазделить(ПутьЗапроса, "/", Истина);
	Если Части.Количество() < 3 Или НРег(Части[1]) <> "cards" Тогда
		Возврат Справочники.КТ_Карточки.ПустаяСсылка();
	КонецЕсли;

	// В пути запроса - числовой идентификатор карточки (id).
	Карточка = КТ_ПоискОбъектовСервер.НайтиКарточку(Контекст.Компания, "",
		Число(Части[2]));

	Если НЕ ЗначениеЗаполнено(Карточка) Тогда
		Карточка = КТ_ПоискОбъектовСервер.НайтиПоСопоставлению(
			Перечисления.КТ_ВидСущностиKaiten.Карточка, Части[2]);
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Карточка) Тогда
		// Головная карточка ещё не восстановлена - поднимаем её запись из архива.
		Карточка = ВосстановитьКарточкуИзАрхива(Части[2], Контекст);
	КонецЕсли;

	Возврат Карточка;

КонецФункции

// Восстанавливает карточку из её записи в сыром архиве.
//
// Параметры:
//  UIDКарточки - Строка - UID карточки в Kaiten.
//  Контекст - Структура - контекст загрузки.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_Карточки - карточка или пустая ссылка.
//
Функция ВосстановитьКарточкуИзАрхива(ИдентификаторКарточки, Контекст)

	ЗаписьАрхива = ЗаписьСырогоАрхиваПоУИД(Контекст.СеансЗагрузки, ИдентификаторКарточки,
		Перечисления.КТ_ВидСущностиKaiten.Карточка);
	Если ЗаписьАрхива = Неопределено Тогда
		Возврат Справочники.КТ_Карточки.ПустаяСсылка();
	КонецЕсли;

	Тело = ЗаписьАрхива.JSON.Получить();
	Если НЕ ЗначениеЗаполнено(Тело) Тогда
		Возврат Справочники.КТ_Карточки.ПустаяСсылка();
	КонецЕсли;

	Возврат КТ_ЗаписьОбъектовСервер.ЗаписатьКарточку(
		КТ_JSONСервер.ПрочитатьJSONИзСтроки(Тело), Контекст);

КонецФункции

// Возвращает последнюю запись сырого архива по идентификатору сущности.
//
// Параметры:
//  СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки, Неопределено - сеанс архива.
//  ИдентификаторСущности - Строка - UID сущности в Kaiten или её числовой идентификатор.
//  ВидСущности - ПеречислениеСсылка.КТ_ВидСущностиKaiten - вид сущности.
//
// Возвращаемое значение:
//  Структура, Неопределено - запись архива с полями Ссылка, ПутьЗапроса, JSON.
//
Функция ЗаписьСырогоАрхиваПоУИД(СеансЗагрузки, ИдентификаторСущности, ВидСущности)

	Если ПустаяСтрока(ИдентификаторСущности) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	Архив.Ссылка КАК Ссылка,
		|	Архив.ПутьЗапроса КАК ПутьЗапроса,
		|	Архив.JSON КАК JSON
		|ИЗ
		|	Справочник.КТ_СырыеОбъектыAPI КАК Архив
		|ГДЕ
		|	Архив.УспешноРазобран
		|	И Архив.КодHTTP = 200
		|	И (Архив.UIDKaiten = &ИдентификаторСущности
		|		ИЛИ Архив.ИдентификаторKaiten = &ИдентификаторСущности)
		|	И Архив.ВидСущности = &ВидСущности";

	Запрос.УстановитьПараметр("ИдентификаторСущности", НРег(СокрЛП(ИдентификаторСущности)));
	Запрос.УстановитьПараметр("ВидСущности", ВидСущности);

	Если ЗначениеЗаполнено(СеансЗагрузки) Тогда
		Запрос.Текст = Запрос.Текст + "
			|	И Архив.СеансЗагрузки = &Сеанс";
		Запрос.УстановитьПараметр("Сеанс", СеансЗагрузки);
	КонецЕсли;

	Запрос.Текст = Запрос.Текст + "
		|УПОРЯДОЧИТЬ ПО
		|	Архив.ДатаПолучения УБЫВ";

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Ссылка", Выборка.Ссылка);
	Результат.Вставить("ПутьЗапроса", Выборка.ПутьЗапроса);
	Результат.Вставить("JSON", Выборка.JSON);

	Возврат Результат;

КонецФункции

// Восстанавливает пачку записей сырого архива.
//
// Параметры:
//  Записи - Массив из Структура - записи сырого архива.
//  Контекст - Структура - контекст загрузки.
//  Итог - Структура - итоги восстановления, изменяется.
//  Отложенные - Массив из Структура, Неопределено - сюда попадают записи без головной сущности.
//  ЭтоПервыйПроход - Булево - Истина для основного прохода по видам сущностей.
//
Процедура ВосстановитьЗаписи(Записи, Контекст, Итог, Отложенные, ЭтоПервыйПроход)

	Для Каждого ЗаписьАрхива Из Записи Цикл

		Если ЭтоПервыйПроход Тогда
			Итог.Записей = Итог.Записей + 1;
		КонецЕсли;

		РезультатВосстановления = 0;
		ТекстОшибки = "";

		Попытка
			РезультатВосстановления = ВосстановитьЗаписьАрхива(ЗаписьАрхива, Контекст);
		Исключение
			ДанныеОшибки = ИнформацияОбОшибке();
			ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ДанныеОшибки);
			КТ_ПротоколЗагрузкиСервер.Ошибка(Контекст,
				"Восстановление " + ЗаписьАрхива.Наименование + ": " + ТекстОшибки,
				ДанныеОшибки, ЗаписьАрхива.ВидСущности, "");
		КонецПопытки;

		Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
			Итог.Ошибок = Итог.Ошибок + 1;
		ИначеЕсли РезультатВосстановления < 0 Тогда
			Итог.Отложено = Итог.Отложено + 1;
			Если Отложенные <> Неопределено Тогда
				Отложенные.Добавить(ЗаписьАрхива);
			Иначе
				Итог.Ошибок = Итог.Ошибок + 1;
				КТ_ПротоколЗагрузкиСервер.Ошибка(Контекст,
					"Не найдена головная сущность для " + ЗаписьАрхива.Наименование
						+ " - сначала восстановите вид " + Строка(ЗаписьАрхива.ВидСущности) + ".",
					Неопределено, ЗаписьАрхива.ВидСущности, "");
			КонецЕсли;
		Иначе
			Итог.Восстановлено = Итог.Восстановлено + РезультатВосстановления;
		КонецЕсли;

		Если Итог.Записей % 25 = 0 Тогда
			ОбновитьХодВосстановления(Контекст.СеансЗагрузки, Итог);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Возвращает виды сущностей в порядке восстановления - от головных к дочерним.
//
// Параметры:
//  ВидСущности - ПеречислениеСсылка.КТ_ВидСущностиKaiten, Неопределено - конкретный вид или все виды.
//
// Возвращаемое значение:
//  Массив из ПеречислениеСсылка.КТ_ВидСущностиKaiten - виды сущностей.
//
Функция ВидыВосстановленияПоПорядку(ВидСущности)

	Порядок = Новый Массив;
	Порядок.Добавить(Перечисления.КТ_ВидСущностиKaiten.Компания);
	Порядок.Добавить(Перечисления.КТ_ВидСущностиKaiten.РольТрудозатрат);
	Порядок.Добавить(Перечисления.КТ_ВидСущностиKaiten.Пользователь);
	Порядок.Добавить(Перечисления.КТ_ВидСущностиKaiten.Пространство);
	Порядок.Добавить(Перечисления.КТ_ВидСущностиKaiten.ТипКарточки);
	Порядок.Добавить(Перечисления.КТ_ВидСущностиKaiten.Тег);
	Порядок.Добавить(Перечисления.КТ_ВидСущностиKaiten.ПользовательскоеПоле);
	Порядок.Добавить(Перечисления.КТ_ВидСущностиKaiten.Доска);
	Порядок.Добавить(Перечисления.КТ_ВидСущностиKaiten.Колонка);
	Порядок.Добавить(Перечисления.КТ_ВидСущностиKaiten.Дорожка);
	Порядок.Добавить(Перечисления.КТ_ВидСущностиKaiten.Карточка);
	Порядок.Добавить(Перечисления.КТ_ВидСущностиKaiten.Комментарий);
	Порядок.Добавить(Перечисления.КТ_ВидСущностиKaiten.ЧекЛист);
	Порядок.Добавить(Перечисления.КТ_ВидСущностиKaiten.Перемещение);
	Порядок.Добавить(Перечисления.КТ_ВидСущностиKaiten.Трудозатрата);

	Если НЕ ЗначениеЗаполнено(ВидСущности) Тогда
		Возврат Порядок;
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого Вид Из Порядок Цикл
		Если Вид = ВидСущности Тогда
			Результат.Добавить(Вид);
		КонецЕсли;
	КонецЦикла;

	Если Результат.Количество() = 0 Тогда
		Результат.Добавить(ВидСущности);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Заполняет идентификаторы Kaiten в записи сырого архива.
//
// Параметры:
//  Объект - СправочникОбъект.КТ_СырыеОбъектыAPI - запись архива.
//  Путь - Строка - путь запроса к API.
//  Значение - Структура, Массив из Структура, Неопределено - разобранный ответ API.
//
Процедура ЗаполнитьИдентификаторыАрхива(Объект, Путь, Значение)

	UIDKaiten = "";
	Идентификатор = 0;

	// UID и id есть только у одиночных ответов: списковый ответ - это страница, а не сущность.
	Если КТ_JSONСервер.ЭтоОбъектJSON(Значение) Тогда
		UIDKaiten = НРег(КТ_JSONСервер.ПолучитьСтроку(Значение, "uid", ""));
		Идентификатор = КТ_JSONСервер.ПолучитьЧисло(Значение, "id", 0);
	КонецЕсли;

	Если ПустаяСтрока(UIDKaiten) Тогда
		UIDKaiten = UIDИзПутиЗапроса(Путь);
	КонецЕсли;

	Объект.UIDKaiten = Лев(UIDKaiten, 36);
	Объект.ИдентификаторKaiten = ?(Идентификатор = 0, "",
		Лев(Формат(Идентификатор, "ЧГ=0"), 100));

КонецПроцедуры

// Возвращает UID сущности из пути запроса к API.
//
// Параметры:
//  Путь - Строка - путь запроса к API.
//
// Возвращаемое значение:
//  Строка - UID сущности или пустая строка.
//
Функция UIDИзПутиЗапроса(Путь)

	// UID Kaiten - это UUID вида 0e6b5e6e-4b0c-4f7a-9f4e-1c8c2a7d1234.
	// Для маршрутов вида /cards/{uid}/comments возвращается UID головной карточки.
	Для Каждого Часть Из СтрРазделить(Путь, "/", Ложь) Цикл
		Часть = СокрЛП(Часть);
		Если СтрДлина(Часть) = 36 И СтрЧислоВхождений(Часть, "-") = 4 Тогда
			Возврат НРег(Часть);
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Обновляет комментарий сеанса ходом восстановления.
//
// Параметры:
//  СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки, Неопределено - сеанс.
//  Итог - Структура - итоги восстановления.
//
Процедура ОбновитьХодВосстановления(СеансЗагрузки, Итог)

	ОбновитьКомментарийСеанса(СеансЗагрузки, "Восстановление из архива: записей "
		+ Итог.Записей + ", сущностей " + Итог.Восстановлено
		+ ", ошибок " + Итог.Ошибок + ", отложено " + Итог.Отложено + ".");

КонецПроцедуры

// Записывает комментарий сеанса загрузки.
//
// Параметры:
//  СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки, Неопределено - сеанс.
//  Комментарий - Строка - текст комментария.
//
Процедура ОбновитьКомментарийСеанса(СеансЗагрузки, Комментарий)

	Если НЕ ЗначениеЗаполнено(СеансЗагрузки) Тогда
		Возврат;
	КонецЕсли;

	ОбъектСеанса = СеансЗагрузки.ПолучитьОбъект();
	Если ОбъектСеанса = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОбъектСеанса.Комментарий = Комментарий;
	ОбъектСеанса.Записать();

КонецПроцедуры

// Загружает запись компании архива.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//
Процедура ЗагрузитьКомпанию(Контекст)

	Домен = КТ_HTTPКлиентСервер.ПолучитьХостИзURL(Контекст.Настройки.АдресKaiten);

	Данные = Новый Структура;
	Данные.Вставить("domain", Домен);
	Данные.Вставить("id", 0);
	Данные.Вставить("uid", "");

	Контекст.Компания = КТ_ЗаписьОбъектовСервер.ЗаписатьКомпанию(Данные, Контекст);

КонецПроцедуры

// Загружает пользователей Kaiten.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//
Процедура ЗагрузитьПользователей(Контекст)

	Пользователи = ПолучитьСтраницы("/users", Контекст,
		Перечисления.КТ_ВидСущностиKaiten.Пользователь);
	Для Каждого Элемент Из Пользователи Цикл
		КТ_ЗаписьОбъектовСервер.ЗаписатьПользователя(Элемент, Контекст);
	КонецЦикла;

КонецПроцедуры

// Загружает пространства, их доски, колонки и дорожки.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//
Процедура ЗагрузитьПространства(Контекст)

	Пространства = ПолучитьСтраницы("/spaces", Контекст,
		Перечисления.КТ_ВидСущностиKaiten.Пространство);
	Для Каждого Элемент Из Пространства Цикл
		Пространство = КТ_ЗаписьОбъектовСервер.ЗаписатьПространство(Элемент, Контекст);
		ЗагрузитьДоскиПространства(Элемент, Пространство, Контекст);
	КонецЦикла;

	// Иерархия пространств приходит в произвольном порядке: дочернее пространство может
	// стоять в списке раньше родительского, и тогда ссылка на родителя не разрешается.
	// Повторный проход связывает их после того, как записаны все пространства.
	Для Каждого Элемент Из Пространства Цикл
		КТ_ЗаписьОбъектовСервер.ЗаписатьПространство(Элемент, Контекст);
	КонецЦикла;

КонецПроцедуры

// Загружает доски пространства вместе с колонками и дорожками.
//
// Параметры:
//  Элемент - Структура - JSON пространства.
//  Пространство - СправочникСсылка.КТ_Пространства - пространство архива.
//  Контекст - Структура - контекст загрузки.
//
Процедура ЗагрузитьДоскиПространства(Элемент, Пространство, Контекст)

	Идентификатор = КТ_JSONСервер.ПолучитьЧисло(Элемент, "id");
	Путь = "/spaces/" + Формат(Идентификатор, "ЧГ=0") + "/boards";
	Доски = ПолучитьСтраницы(Путь, Контекст,
		Перечисления.КТ_ВидСущностиKaiten.Доска);

	Для Каждого ЭлементДоски Из Доски Цикл
		Доска = КТ_ЗаписьОбъектовСервер.ЗаписатьДоску(ЭлементДоски, Пространство, Контекст);
		ЗагрузитьКолонкиДоски(ЭлементДоски, Доска, Контекст);
		ЗагрузитьДорожкиДоски(ЭлементДоски, Доска, Контекст);
	КонецЦикла;

КонецПроцедуры

// Загружает колонки и подколонки доски.
//
// Параметры:
//  Элемент - Структура - JSON доски.
//  Доска - СправочникСсылка.КТ_Доски - доска архива.
//  Контекст - Структура - контекст загрузки.
//
Процедура ЗагрузитьКолонкиДоски(Элемент, Доска, Контекст)

	Идентификатор = КТ_JSONСервер.ПолучитьЧисло(Элемент, "id");
	Путь = "/boards/" + Формат(Идентификатор, "ЧГ=0") + "/columns";
	Колонки = ПолучитьСтраницы(Путь, Контекст,
		Перечисления.КТ_ВидСущностиKaiten.Колонка);

	Для Каждого ЭлементКолонки Из Колонки Цикл

		Колонка = КТ_ЗаписьОбъектовСервер.ЗаписатьКолонку(
			ЭлементКолонки, Доска, Справочники.КТ_Колонки.ПустаяСсылка(), Контекст);

		Подколонки = МассивПоля(ЭлементКолонки, "subcolumns");
		Для Каждого ЭлементПодколонки Из Подколонки Цикл
			КТ_ЗаписьОбъектовСервер.ЗаписатьКолонку(ЭлементПодколонки, Доска, Колонка, Контекст);
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Загружает дорожки доски.
//
// Параметры:
//  Элемент - Структура - JSON доски.
//  Доска - СправочникСсылка.КТ_Доски - доска архива.
//  Контекст - Структура - контекст загрузки.
//
Процедура ЗагрузитьДорожкиДоски(Элемент, Доска, Контекст)

	Идентификатор = КТ_JSONСервер.ПолучитьЧисло(Элемент, "id");
	Путь = "/boards/" + Формат(Идентификатор, "ЧГ=0") + "/lanes";
	Дорожки = ПолучитьСтраницы(Путь, Контекст,
		Перечисления.КТ_ВидСущностиKaiten.Дорожка);

	Для Каждого ЭлементДорожки Из Дорожки Цикл
		КТ_ЗаписьОбъектовСервер.ЗаписатьДорожку(ЭлементДорожки, Доска, Контекст);
	КонецЦикла;

КонецПроцедуры

// Загружает типы карточек.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//
Процедура ЗагрузитьТипыКарточек(Контекст)

	Типы = ПолучитьСтраницы("/card-types", Контекст,
		Перечисления.КТ_ВидСущностиKaiten.ТипКарточки);
	Для Каждого Элемент Из Типы Цикл
		КТ_ЗаписьОбъектовСервер.ЗаписатьТипКарточки(Элемент, Контекст);
	КонецЦикла;

КонецПроцедуры

// Загружает роли трудозатрат компании.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//
Процедура ЗагрузитьРолиТрудозатрат(Контекст)

	Путь = "/user-roles";

	Попытка

		Ответ = КТ_HTTPКлиентСервер.ВыполнитьGET(Путь, Новый Структура, Контекст.Настройки);
		СохранитьСыройОтвет(Контекст, Путь, Новый Структура, Ответ,
			Перечисления.КТ_ВидСущностиKaiten.РольТрудозатрат, "ПолучениеРолейТрудозатрат");

		Если Ответ.КодСостояния = 403 Или Ответ.КодСостояния = 404 Тогда
			КТ_ПротоколЗагрузкиСервер.ЗаписатьПредупреждение(Контекст,
				"Нет доступа к " + Путь + ". Роли будут создаваться из трудозатрат.");
			Возврат;
		КонецЕсли;

		Если Ответ.КодСостояния <> 200 Тогда
			КТ_ПротоколЗагрузкиСервер.ЗаписатьПредупреждение(Контекст,
				"Роли трудозатрат не загружены: " + Путь + " - "
				+ КТ_HTTPКлиентСервер.ПолучитьОписаниеHTTPОшибки(Ответ));
			Возврат;
		КонецЕсли;

		МассивРолей = КТ_JSONСервер.ПрочитатьМассив(Ответ.ТелоКакСтрока);

		Для Каждого РольJSON Из МассивРолей Цикл
			КТ_ЗаписьОбъектовСервер.ЗаписатьРольТрудозатрат(РольJSON, Контекст);
		КонецЦикла;

		КТ_ПротоколЗагрузкиСервер.Информация(Контекст,
			"Загружены роли трудозатрат: " + Формат(МассивРолей.Количество(), "ЧГ=0"));

	Исключение

		КТ_ПротоколЗагрузкиСервер.ЗаписатьПредупреждение(Контекст,
			"Роли трудозатрат не загружены: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));

	КонецПопытки;

КонецПроцедуры

// Загружает теги компании.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//
Процедура ЗагрузитьТеги(Контекст)

	Теги = ПолучитьСтраницы("/tags", Контекст,
		Перечисления.КТ_ВидСущностиKaiten.Тег);
	Для Каждого Элемент Из Теги Цикл
		КТ_ЗаписьОбъектовСервер.ЗаписатьТег(Элемент, Контекст);
	КонецЦикла;

КонецПроцедуры

// Загружает пользовательские поля компании и их варианты.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//
Процедура ЗагрузитьПользовательскиеПоля(Контекст)

	Поля = ПолучитьСтраницы("/company/custom-properties", Контекст,
		Перечисления.КТ_ВидСущностиKaiten.ПользовательскоеПоле);

	Для Каждого Элемент Из Поля Цикл

		Поле = КТ_ЗаписьОбъектовСервер.ЗаписатьПользовательскоеПоле(Элемент, Контекст);
		Если НЕ ЗначениеЗаполнено(Поле) Тогда
			Продолжить;
		КонецЕсли;

		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("Поле", Поле);
		ДопПараметры.Вставить("ВидВарианта", "Список");

		Варианты = МассивПоля(Элемент, "select_values");
		Если Варианты.Количество() = 0 Тогда
			Варианты = МассивПоля(Элемент, "values");
		КонецЕсли;

		Для Каждого ЭлементВарианта Из Варианты Цикл
			КТ_ЗаписьОбъектовСервер.ЗаписатьВариантПоля(ЭлементВарианта, Контекст, ДопПараметры);
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Возвращает пространство, по которому сеанс ограничивает загрузку карточек.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_Пространства, Неопределено - отбор по пространству не задан.
//
Функция ПространствоФильтраКарточек(Контекст)

	СеансЗагрузки = Контекст.СеансЗагрузки;
	Если Не ЗначениеЗаполнено(СеансЗагрузки) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Пространство = СеансЗагрузки.Пространство;
	Если Не ЗначениеЗаполнено(Пространство) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Пространство;

КонецФункции

// Отбирает карточки, относящиеся к пространству с заданным идентификатором Kaiten.
//
// Параметры:
//  Карточки - Массив из Структура - карточки из списка API.
//  ИдентификаторПространства - Число - идентификатор Kaiten пространства.
//
// Возвращаемое значение:
//  Массив из Структура
//
Функция ОтобратьКарточкиПоПространству(Карточки, ИдентификаторПространства)

	Результат = Новый Массив;
	Для Каждого ЭлементКарточки Из Карточки Цикл
		//ИдентификаторПространстваКарточки = КТ_JSONСервер.ПолучитьЧисло(ЭлементКарточки, "space_id");
		ИдентификаторПространстваКарточки = КТ_JSONСервер.ПолучитьЧисло(ЭлементКарточки, "type_id");
		
		Если ИдентификаторПространстваКарточки = ИдентификаторПространства Тогда
			Результат.Добавить(ЭлементКарточки);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Ставит в очередь задания по карточке списка.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//  ЭлементКарточки - Структура - JSON карточки из списка.
//
Процедура ПоставитьЗаданияПоКарточке(Контекст, ЭлементКарточки)

	// Маршруты Kaiten адресуются числовым идентификатором карточки (id), а не UID.
	Идентификатор = КТ_JSONСервер.ПолучитьЧисло(ЭлементКарточки, "id");
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат;
	КонецЕсли;

	ИдентификаторКарточки = Формат(Идентификатор, "ЧГ=0");
	UIDКарточки = КТ_JSONСервер.ПолучитьСтроку(ЭлементКарточки, "uid");

	Параметры = Новый Структура;
	Параметры.Вставить("ВидСущности", Перечисления.КТ_ВидСущностиKaiten.Карточка);
	Параметры.Вставить("ИдентификаторKaiten", ИдентификаторКарточки);
	Параметры.Вставить("UIDKaiten", UIDКарточки);
	Параметры.Вставить("ПутьЗапроса", "/cards/" + ИдентификаторКарточки);
	Параметры.Вставить("Приоритет", 5);

	КТ_ОчередьЗагрузкиСервер.ПоставитьЗадание(Контекст,
		КТ_ОчередьЗагрузкиСервер.КлючКарточки(ИдентификаторКарточки),
		Перечисления.КТ_ВидОперацииОчереди.ПолучитьОбъект, Параметры);

	Настройки = Контекст.Настройки;

	Если Настройки.ЗагружатьКомментарии Тогда
		ПоставитьДочернееЗадание(Контекст, ИдентификаторКарточки, UIDКарточки, "COMMENTS");
	КонецЕсли;
	Если Настройки.ЗагружатьЧекЛисты Тогда
		ПоставитьДочернееЗадание(Контекст, ИдентификаторКарточки, UIDКарточки, "CHECKLISTS");
	КонецЕсли;
	Если Настройки.ЗагружатьИсторию Тогда
		ПоставитьДочернееЗадание(Контекст, ИдентификаторКарточки, UIDКарточки, "LOCATION_HISTORY");
	КонецЕсли;
	Если Настройки.ЗагружатьТрудозатраты Тогда
		ПоставитьДочернееЗадание(Контекст, ИдентификаторКарточки, UIDКарточки, "TIME_LOGS");
	КонецЕсли;
	Если Настройки.ЗагружатьФайлы Тогда
		ПоставитьДочернееЗадание(Контекст, ИдентификаторКарточки, UIDКарточки, "FILES");
	КонецЕсли;

	ПоставитьДочернееЗадание(Контекст, ИдентификаторКарточки, UIDКарточки, "CHILDREN");

КонецПроцедуры

// Ставит в очередь задание на загрузку дочерних данных карточки.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//  ИдентификаторКарточки - Строка - числовой идентификатор карточки Kaiten (id).
//  UIDКарточки - Строка - UID карточки Kaiten.
//  ВидДанных - Строка - вид дочерних данных.
//
Процедура ПоставитьДочернееЗадание(Контекст, ИдентификаторКарточки, UIDКарточки, ВидДанных)

	Параметры = Новый Структура;
	Параметры.Вставить("ВидСущности", Перечисления.КТ_ВидСущностиKaiten.Карточка);
	Параметры.Вставить("UIDKaiten", UIDКарточки);
	Параметры.Вставить("ПутьЗапроса",
		"/cards/" + ИдентификаторКарточки + "/" + СуффиксМаршрута(ВидДанных));
	Параметры.Вставить("Приоритет", 10);

	КТ_ОчередьЗагрузкиСервер.ПоставитьЗадание(Контекст,
		КТ_ОчередьЗагрузкиСервер.КлючДочернегоЗадания(ИдентификаторКарточки, ВидДанных),
		Перечисления.КТ_ВидОперацииОчереди.ПолучитьДочерниеДанные, Параметры);

КонецПроцедуры

// Загружает карточку и ставит задания по ее дочерним данным.
//
// Параметры:
//  Задание - Структура - задание очереди.
//  Контекст - Структура - контекст загрузки.
//
Процедура ВыполнитьЗагрузкуКарточки(Задание, Контекст)

	ИдентификаторКарточки = Задание.ИдентификаторKaiten;
	Если ПустаяСтрока(ИдентификаторКарточки) Тогда
		ВызватьИсключение "В задании не указан идентификатор карточки: " + Задание.КлючЗадания;
	КонецЕсли;

	Путь = "/cards/" + ИдентификаторКарточки;

	Ответ = КТ_HTTPКлиентСервер.ВыполнитьGET(Путь, Неопределено, Контекст.Настройки);
	СохранитьСыройОтвет(Контекст, Путь, Неопределено, Ответ,
		Перечисления.КТ_ВидСущностиKaiten.Карточка, "ПолучениеОбъектаКарточки");
	Данные = ДанныеИзОтвета(Ответ, Контекст, Путь);

	Карточка = КТ_ЗаписьОбъектовСервер.ЗаписатьКарточку(Данные, Контекст);
	Если НЕ ЗначениеЗаполнено(Карточка) Тогда
		Возврат;
	КонецЕсли;

	Настройки = Контекст.Настройки;

	КТ_ЗаписьРегистровСервер.ЗаписатьУчастников(Карточка,
		МассивПоля(Данные, "members"), Контекст);
	КТ_ЗаписьРегистровСервер.ЗаписатьТеги(Карточка,
		МассивПоля(Данные, "tags"), Контекст);
	// Связи здесь не пишутся: на этом этапе дочерние карточки еще не загружены,
	// их пишет отдельное задание CARD:{id}:CHILDREN с приоритетом 10.

	Если Настройки.ЗагружатьПользовательскиеПоля Тогда
		КТ_ЗаписьРегистровСервер.ЗаписатьПользовательскиеПоля(Карточка,
			КТ_JSONСервер.ПолучитьЗначениеПоля(Данные, "properties"), Контекст);
	КонецЕсли;

КонецПроцедуры

// Загружает дочерние данные карточки.
//
// Параметры:
//  Задание - Структура - задание очереди.
//  Контекст - Структура - контекст загрузки.
//
Процедура ВыполнитьДочернееЗадание(Задание, Контекст)

	Части = СтрРазделить(Задание.КлючЗадания, ":", Ложь);
	ИдентификаторКарточки = ?(Части.Количество() > 1, Части[1], "");
	ВидДанных = ?(Части.Количество() > 2, ВРег(Части[2]), "");

	Если ПустаяСтрока(ИдентификаторКарточки) Тогда
		Возврат;
	КонецЕсли;

	Карточка = КТ_ПоискОбъектовСервер.НайтиКарточку(Контекст.Компания, "",
		Число(ИдентификаторКарточки));

	Если НЕ ЗначениеЗаполнено(Карточка) Тогда
		ВызватьИсключение "Карточка не найдена в архиве: " + ИдентификаторКарточки;
	КонецЕсли;

	Путь = "/cards/" + ИдентификаторКарточки + "/" + СуффиксМаршрута(ВидДанных);
	// Все дочерние маршруты Kaiten (комментарии, чек-листы, связи, история перемещений,
	// трудозатраты, файлы) отдают список одним ответом и игнорируют limit и offset.
	Массив = ПолучитьСтраницы(Путь, Контекст, ВидСущностиДочернихДанных(ВидДанных), Истина);

	Если ВидДанных = "COMMENTS" Тогда
		ЗаписатьКомментарии(Карточка, Массив, Задание, Контекст);
	ИначеЕсли ВидДанных = "CHECKLISTS" Тогда
		ЗаписатьЧекЛисты(Карточка, Массив, Контекст);
	ИначеЕсли ВидДанных = "CHILDREN" Тогда
		КТ_ЗаписьРегистровСервер.ЗаписатьСвязи(Карточка, Массив, Контекст);
	ИначеЕсли ВидДанных = "LOCATION_HISTORY" Тогда
		КТ_ЗаписьРегистровСервер.ЗаписатьИсториюПеремещений(Карточка, Массив, Контекст);
	ИначеЕсли ВидДанных = "TIME_LOGS" Тогда
		КТ_ЗаписьРегистровСервер.ЗаписатьТрудозатраты(Карточка, Массив, Контекст);
	ИначеЕсли ВидДанных = "FILES" Тогда
		ЗаписатьФайлыКарточки(Карточка, Массив, Задание, Контекст);
	КонецЕсли;

КонецПроцедуры

// Записывает комментарии карточки.
//
// Параметры:
//  Карточка - СправочникСсылка.КТ_Карточки - карточка архива.
//  Массив - Массив из Структура - JSON комментариев.
//  Задание - Структура - задание очереди.
//  Контекст - Структура - контекст загрузки.
//

//старый
//Процедура ЗаписатьКомментарии(Карточка, Массив, Задание, Контекст)
//
//	Для Каждого Элемент Из Массив Цикл
//
//		Комментарий = КТ_ЗаписьОбъектовСервер.ЗаписатьКомментарий(Карточка, Элемент, Контекст);
//		Если НЕ ЗначениеЗаполнено(Комментарий) Тогда
//			Продолжить;
//		КонецЕсли;
//
//		Если НЕ Контекст.Настройки.ЗагружатьФайлы Тогда
//			Продолжить;
//		КонецЕсли;
//
//		Файлы = МассивПоля(Элемент, "files");
//		Для Каждого ЭлементФайла Из Файлы Цикл
//			ФайлСсылка = КТ_ФайлыСервер.ЗарегистрироватьФайлКомментария(
//				Карточка, Комментарий, ЭлементФайла, Контекст);
//			ПоставитьЗаданиеФайла(Контекст, Задание.КлючЗадания,
//				КТ_JSONСервер.ПолучитьСтроку(ЭлементФайла, "uid"), ФайлСсылка);
//		КонецЦикла;
//
//	КонецЦикла;
//
//КонецПроцедуры

//Исправлено !
// Записывает комментарии карточки, регистрирует в КТ_Файлы как вложения из поля "files",
// так и картинки ![...](url) из текста комментария, и ставит их в очередь на скачивание.
//
Процедура ЗаписатьКомментарии(Карточка, Массив, Задание, Контекст)

	Для Каждого Элемент Из Массив Цикл

		Комментарий = КТ_ЗаписьОбъектовСервер.ЗаписатьКомментарий(Карточка, Элемент, Контекст);
		Если НЕ ЗначениеЗаполнено(Комментарий) Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ Контекст.Настройки.ЗагружатьФайлы Тогда
			Продолжить;
		КонецЕсли;

		// 1. Файлы из массива files комментария (если API вернул их внутри комментария)
		Файлы = МассивПоля(Элемент, "files");
		Для Каждого ЭлементФайла Из Файлы Цикл
			ФайлСсылка = КТ_ФайлыСервер.ЗарегистрироватьФайлКомментария(
				Карточка, Комментарий, ЭлементФайла, Контекст);
			ПоставитьЗаданиеФайла(Контекст, Задание.КлючЗадания,
				КТ_JSONСервер.ПолучитьСтроку(ЭлементФайла, "uid"), ФайлСсылка);
		КонецЦикла;

		// 2. Картинки, вставленные прямо в Markdown-текст комментария: ![alt](https://...)
		ТекстКомментария = КТ_JSONСервер.ПолучитьСтроку(Элемент, "text");
		АдресаКартинок = КТ_РазметкаСервер.АдресаКартинокИзРазметки(ТекстКомментария);
		Для Каждого АдресКартинки Из АдресаКартинок Цикл
			JSONКартинки = Новый Структура;
			JSONКартинки.Вставить("url", АдресКартинки);
			JSONКартинки.Вставить("uid", КТ_ФайлыСервер.UIDИзАдреса(АдресКартинки));
			ФайлСсылка = КТ_ФайлыСервер.ЗарегистрироватьФайлКомментария(
				Карточка, Комментарий, JSONКартинки, Контекст);
			ПоставитьЗаданиеФайла(Контекст, Задание.КлючЗадания, "", ФайлСсылка);
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Ставит задание на скачивание содержимого файла (даже если в JSON не было поля uid).
//
Процедура ПоставитьЗаданиеФайла(Контекст, КлючРодителя, UIDФайла, ФайлСсылка)

	Если НЕ ЗначениеЗаполнено(ФайлСсылка) Тогда
		Возврат;
	КонецЕсли;

	КлючUID = СокрЛП(UIDФайла);
	Если ПустаяСтрока(КлючUID) Тогда
		КлючUID = СокрЛП(ФайлСсылка.UIDKaiten);
	КонецЕсли;
	Если ПустаяСтрока(КлючUID) Тогда
		КлючUID = СокрЛП(ФайлСсылка.ИдентификаторKaitenСтрокой);
	КонецЕсли;
	Если ПустаяСтрока(КлючUID) Тогда
		Возврат;
	КонецЕсли;

	Параметры = Новый Структура;
	Параметры.Вставить("ВидСущности", Перечисления.КТ_ВидСущностиKaiten.Файл);
	Параметры.Вставить("UIDKaiten", СокрЛП(ФайлСсылка.UIDKaiten));
	Параметры.Вставить("ИдентификаторKaiten", СокрЛП(ФайлСсылка.ИдентификаторKaitenСтрокой));
	Параметры.Вставить("ПутьЗапроса", "");
	Параметры.Вставить("Приоритет", 20);

	КТ_ОчередьЗагрузкиСервер.ПоставитьЗадание(Контекст,
		КТ_ОчередьЗагрузкиСервер.КлючФайла(БазовыйКлючКарточки(КлючРодителя), КлючUID),
		Перечисления.КТ_ВидОперацииОчереди.СкачатьФайл, Параметры);

КонецПроцедуры

// Скачивает содержимое файла архива (ищет файл и по UID, и по строковому ID).
//
Процедура ВыполнитьФайловоеЗадание(Задание, Контекст)

	ФайлСсылка = КТ_ПоискОбъектовСервер.НайтиФайл(Задание.UIDKaiten, Задание.ИдентификаторKaiten);

	Если НЕ ЗначениеЗаполнено(ФайлСсылка) Тогда
		ВызватьИсключение "Файл не найден в архиве: "
			+ ?(ПустаяСтрока(Задание.UIDKaiten), Задание.ИдентификаторKaiten, Задание.UIDKaiten);
	КонецЕсли;

	КТ_ФайлыСервер.СкачатьФайл(ФайлСсылка, Контекст);

КонецПроцедуры



// Записывает чек-листы карточки вместе с пунктами.
//
// Параметры:
//  Карточка - СправочникСсылка.КТ_Карточки - карточка архива.
//  Массив - Массив из Структура - JSON чек-листов.
//  Контекст - Структура - контекст загрузки.
//
Процедура ЗаписатьЧекЛисты(Карточка, Массив, Контекст)

	Для Каждого Элемент Из Массив Цикл

		ЧекЛист = КТ_ЗаписьОбъектовСервер.ЗаписатьЧекЛист(Карточка, Элемент, Контекст);
		Если НЕ ЗначениеЗаполнено(ЧекЛист) Тогда
			Продолжить;
		КонецЕсли;

		КТ_ЗаписьРегистровСервер.ЗаписатьПунктыЧекЛиста(ЧекЛист,
			МассивПоля(Элемент, "items"), Контекст);

	КонецЦикла;

КонецПроцедуры

// Записывает файлы карточки и ставит задания на их скачивание.
//
// Параметры:
//  Карточка - СправочникСсылка.КТ_Карточки - карточка архива.
//  Массив - Массив из Структура - JSON файлов.
//  Задание - Структура - задание очереди.
//  Контекст - Структура - контекст загрузки.
//
Процедура ЗаписатьФайлыКарточки(Карточка, Массив, Задание, Контекст)

	Для Каждого Элемент Из Массив Цикл

		ФайлСсылка = КТ_ФайлыСервер.ЗарегистрироватьФайлКарточки(Карточка, Элемент, Контекст);
		ПоставитьЗаданиеФайла(Контекст, Задание.КлючЗадания,
			КТ_JSONСервер.ПолучитьСтроку(Элемент, "uid"), ФайлСсылка);

	КонецЦикла;

КонецПроцедуры

//// Ставит задание на скачивание содержимого файла.
////
//// Ключ задания строится от базового ключа карточки (CARD:{card_id}:FILE:{file_uid}),
//// а не от ключа конкретного дочернего маршрута: одно и то же вложение комментария
//// приходит и в /comments, и в /cards/{id}/files, и не должно вставать в очередь дважды.
////
//// Параметры:
////  Контекст - Структура - контекст загрузки.
////  КлючРодителя - Строка - ключ задания родителя.
////  UIDФайла - Строка - UID файла Kaiten.
////  ФайлСсылка - СправочникСсылка.КТ_Файлы - файл архива.
////
