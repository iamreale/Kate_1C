//		Перечисления.КТ_ВидОперацииОчереди.СкачатьФайл, Параметры);

//КонецПроцедуры

// Возвращает базовый ключ карточки из ключа задания.
//
// Параметры:
//  КлючЗадания - Строка - ключ задания вида CARD:{card_id}[:...].
//
// Возвращаемое значение:
//  Строка - базовый ключ карточки вида CARD:{card_id}.
//
Функция БазовыйКлючКарточки(КлючЗадания)

	Части = СтрРазделить(КлючЗадания, ":", Ложь);
	Если Части.Количество() >= 2 Тогда
		Возврат Части[0] + ":" + Части[1];
	КонецЕсли;

	Возврат КлючЗадания;

КонецФункции

//// Скачивает содержимое файла архива.
////
//// Параметры:
////  Задание - Структура - задание очереди.
////  Контекст - Структура - контекст загрузки.
