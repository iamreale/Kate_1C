// Завершает сеанс загрузки.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//
Процедура ЗавершитьСеанс(Контекст)

	Очередь = КТ_ОчередьЗагрузкиСервер.СостояниеОчереди(Контекст.СеансЗагрузки);
	Счётчики = КТ_ПротоколЗагрузкиСервер.Счётчики(Контекст);

	Если Очередь.Ожидает > 0 Или Очередь.Выполняется > 0 Тогда
		Состояние = Перечисления.КТ_СостояниеЗагрузки.Ожидает;
	ИначеЕсли Очередь.Ошибка > 0 Тогда
		Состояние = Перечисления.КТ_СостояниеЗагрузки.Ошибка;
	ИначеЕсли Счётчики.Предупреждения > 0 Тогда
		Состояние = Перечисления.КТ_СостояниеЗагрузки.ЗагруженоСПредупреждениями;
	Иначе
		Состояние = Перечисления.КТ_СостояниеЗагрузки.Загружено;
	КонецЕсли;

	ОбъектСеанса = Контекст.СеансЗагрузки.ПолучитьОбъект();
	Если ОбъектСеанса <> Неопределено Тогда
		Если Состояние = Перечисления.КТ_СостояниеЗагрузки.Ожидает Тогда
			ОбъектСеанса.ДатаОкончания = '00010101000000';
		Иначе
			ОбъектСеанса.ДатаОкончания = ТекущаяУниверсальнаяДата();
		КонецЕсли;
		ОбъектСеанса.Состояние = Состояние;
		ОбъектСеанса.Комментарий = "Осталось заданий: " + Очередь.Ожидает
			+ ", ошибок: " + Очередь.Ошибка;
		ОбъектСеанса.Записать();
	КонецЕсли;

	Если Состояние = Перечисления.КТ_СостояниеЗагрузки.Загружено
		Или Состояние = Перечисления.КТ_СостояниеЗагрузки.ЗагруженоСПредупреждениями Тогда
		ОтметитьКарточкиЗагруженными(Контекст.СеансЗагрузки, Контекст.Компания);
	КонецЕсли;

	СчётчикиСеанса = Новый Структура;
	СчётчикиСеанса.Вставить("КоличествоТрудозатрат",
		КТ_КонтрольПолнотыСервер.КоличествоТрудозатратСеанса(Контекст.СеансЗагрузки));
	КТ_ПротоколЗагрузкиСервер.ЗафиксироватьСчётчики(Контекст.СеансЗагрузки, СчётчикиСеанса);

	Если Состояние <> Перечисления.КТ_СостояниеЗагрузки.Ожидает Тогда
		КТ_КонтрольПолнотыСервер.ПроверитьПолноту(Контекст.СеансЗагрузки, Контекст);
	КонецЕсли;

КонецПроцедуры

// Устанавливает состояние сеанса загрузки.
//
// Параметры:
//  СеансЗагрузки - СправочникСсылка.КТ_СеансыЗагрузки - сеанс загрузки.
//  Состояние - ПеречислениеСсылка.КТ_СостояниеЗагрузки - новое состояние сеанса.
//  Комментарий - Строка - комментарий сеанса.
//
Процедура УстановитьСостояниеСеанса(СеансЗагрузки, Состояние, Комментарий)

	ОбъектСеанса = СеансЗагрузки.ПолучитьОбъект();
	Если ОбъектСеанса = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОбъектСеанса.Состояние = Состояние;
	ОбъектСеанса.Комментарий = Комментарий;
	ОбъектСеанса.Записать();

КонецПроцедуры

// Обрабатывает аварийное завершение загрузки.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//
Процедура ОбработатьПрерываниеЗагрузки(Контекст)

	ДанныеОшибки = ИнформацияОбОшибке();
	Кратко = ОбработкаОшибок.КраткоеПредставлениеОшибки(ДанныеОшибки);

	КТ_ПротоколЗагрузкиСервер.Ошибка(Контекст, "Загрузка прервана: " + Кратко, ДанныеОшибки);
	УстановитьСостояниеСеанса(Контекст.СеансЗагрузки,
		Перечисления.КТ_СостояниеЗагрузки.Ошибка, Кратко);

КонецПроцедуры

// Возвращает компанию сеанса загрузки.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_Компании - компания архива.
//
Функция КомпанияСеанса(Контекст) Экспорт

	Домен = КТ_HTTPКлиентСервер.ПолучитьХостИзURL(Контекст.Настройки.АдресKaiten);
	Компания = КТ_ПоискОбъектовСервер.НайтиКомпанию(Домен, "", 0);

	Если ЗначениеЗаполнено(Компания) Тогда
		Возврат Компания;
	КонецЕсли;

	ЗагрузитьКомпанию(Контекст);

	Возврат Контекст.Компания;

КонецФункции

// Возвращает суффикс маршрута API по виду дочерних данных.
//
// Параметры:
//  ВидДанных - Строка - вид дочерних данных.
//
// Возвращаемое значение:
//  Строка - суффикс маршрута.
//
Функция СуффиксМаршрута(ВидДанных)

	Если ВидДанных = "COMMENTS" Тогда
		Возврат "comments";
	ИначеЕсли ВидДанных = "CHECKLISTS" Тогда
		Возврат "checklists";
	ИначеЕсли ВидДанных = "CHILDREN" Тогда
		Возврат "children";
	ИначеЕсли ВидДанных = "LOCATION_HISTORY" Тогда
		Возврат "location-history";
	ИначеЕсли ВидДанных = "TIME_LOGS" Тогда
		Возврат "time-logs";
	ИначеЕсли ВидДанных = "FILES" Тогда
		Возврат "files";
	КонецЕсли;

	Возврат "";

КонецФункции

// Возвращает разобранное значение ответа HTTP.
//
// Параметры:
//  Ответ - Структура - ответ HTTP.
//  Контекст - Структура - контекст загрузки.
//  Путь - Строка - путь запроса.
//
// Возвращаемое значение:
//  Структура, Массив из Структура - разобранный JSON.
//
Функция ДанныеИзОтвета(Ответ, Контекст, Путь)

	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение "HTTP " + Ответ.КодСостояния + " (" + Путь + "): "
			+ КТ_HTTPКлиентСервер.ПолучитьОписаниеHTTPОшибки(Ответ);
	КонецЕсли;

	Возврат КТ_JSONСервер.ПрочитатьJSONИзСтроки(Ответ.ТелоКакСтрока);

КонецФункции

// Возвращает массив элементов страницы ответа HTTP.
//
// Параметры:
//  Ответ - Структура - ответ HTTP.
//  Контекст - Структура - контекст загрузки.
//  Путь - Строка - путь запроса.
//
// Возвращаемое значение:
//  Массив из Структура - элементы страницы.
//
Функция СтраницаИзОтвета(Ответ, Контекст, Путь)

	Значение = ДанныеИзОтвета(Ответ, Контекст, Путь);

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат Значение;
	КонецЕсли;

	Если КТ_JSONСервер.ЭтоОбъектJSON(Значение) Тогда
		Элементы = МассивПоля(Значение, "items");
		Если Элементы.Количество() = 0 Тогда
			Элементы = МассивПоля(Значение, "data");
		КонецЕсли;
		Возврат Элементы;
	КонецЕсли;

	Возврат Новый Массив;

КонецФункции

// Возвращает массив из поля JSON-объекта.
//
// Параметры:
//  Объект - Структура, Соответствие из КлючИЗначение, Неопределено - JSON-объект.
//  ИмяПоля - Строка - имя поля.
//
// Возвращаемое значение:
//  Массив из Произвольный - значение поля или пустой массив.
//
Функция МассивПоля(Объект, ИмяПоля)

	Пустой = Новый Массив;

	Если НЕ КТ_JSONСервер.ЭтоОбъектJSON(Объект) Тогда
		Возврат Пустой;
	КонецЕсли;

	Значение = КТ_JSONСервер.ПолучитьЗначениеПоля(Объект, ИмяПоля);
	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		Возврат Пустой;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Возвращает строку параметров запроса для архива.
//
// Параметры:
//  ПараметрыЗапроса - Структура, Соответствие из КлючИЗначение, Неопределено - параметры запроса.
//
// Возвращаемое значение:
//  Строка - строка параметров вида "?limit=100&offset=0".
//
Функция ПараметрыЗапросаВСтроку(ПараметрыЗапроса)

	Если ПараметрыЗапроса = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ТипПараметров = ТипЗнч(ПараметрыЗапроса);
	Если ТипПараметров <> Тип("Структура") 
		И ТипПараметров <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	Части = Новый Массив;
	Для Каждого КлючИЗначение Из ПараметрыЗапроса Цикл
		Ключ = КодироватьСтроку(Строка(КлючИЗначение.Ключ), СпособКодированияСтроки.КодировкаURL);
		Значение = КодироватьСтроку( КТ_HTTPКлиентСервер.ЗначениеПараметраВСтроку(КлючИЗначение.Значение),
			СпособКодированияСтроки.КодировкаURL);
		Части.Добавить(Ключ + "=" + Значение);
	КонецЦикла;

	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат "?" + СтрСоединить(Части, "&");

КонецФункции


// Возвращает вид сущности Kaiten по виду дочерних данных карточки.
//
// Параметры:
//  ВидДанных - Строка - вид дочерних данных.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.КТ_ВидСущностиKaiten - вид сущности.
//
Функция ВидСущностиДочернихДанных(ВидДанных)

	Если ВидДанных = "COMMENTS" Тогда
		Возврат Перечисления.КТ_ВидСущностиKaiten.Комментарий;
	ИначеЕсли ВидДанных = "CHECKLISTS" Тогда
		Возврат Перечисления.КТ_ВидСущностиKaiten.ЧекЛист;
	ИначеЕсли ВидДанных = "LOCATION_HISTORY" Тогда
		Возврат Перечисления.КТ_ВидСущностиKaiten.Перемещение;
	ИначеЕсли ВидДанных = "TIME_LOGS" Тогда
		Возврат Перечисления.КТ_ВидСущностиKaiten.Трудозатрата;
	ИначеЕсли ВидДанных = "FILES" Тогда
		Возврат Перечисления.КТ_ВидСущностиKaiten.Файл;
	КонецЕсли;

	Возврат Перечисления.КТ_ВидСущностиKaiten.Карточка;

КонецФункции

// Возвращает значение или значение по умолчанию для пустой строки.
//
// Параметры:
//  Значение - Строка - проверяемое значение.
//  ЗначениеПоУмолчанию - Строка - значение по умолчанию.
//
// Возвращаемое значение:
//  Строка - результат.
//
Функция ЗначениеИли(Значение, ЗначениеПоУмолчанию)

	Если ПустаяСтрока(Значение) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Создает таблицу результатов самопроверки.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Проверка, Статус, ВремяМС, Детали.
//
Функция НоваяТаблицаПроверок()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Проверка", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ВремяМС", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Детали", Новый ОписаниеТипов("Строка"));

	Возврат Таблица;

КонецФункции

// Добавляет строку в таблицу результатов самопроверки.
//
// Параметры:
//  Таблица - ТаблицаЗначений - таблица результатов.
//  ИмяПроверки - Строка - название проверки.
//  Успешно - Булево - признак успеха.
//  НачалоМС - Число - момент старта проверки в миллисекундах.
//  Детали - Строка - пояснение результата.
//
Процедура ДобавитьСтрокуПроверки(Таблица, ИмяПроверки, Успешно, НачалоМС, Детали)

	Строка = Таблица.Добавить();
	Строка.Проверка = ИмяПроверки;
	Строка.Статус = ?(Успешно, "OK", "Ошибка");
	Строка.ВремяМС = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМС;
	Строка.Детали = Детали;

КонецПроцедуры

#КонецОбласти
