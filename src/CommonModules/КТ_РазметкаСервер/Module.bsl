//Исправлено
Функция HTMLКомментарияДляПросмотра(КомментарийСсылка) Экспорт

	Если НЕ ЗначениеЗаполнено(КомментарийСсылка) Тогда
		Возврат "";
	КонецЕсли;

	Объект = КомментарийСсылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Настройки = КТ_ЗагрузкаKaitenСервер.ПрочитатьНастройки();
	Текст = Объект.Текст;
	ФайлыJSON = Неопределено;

	СырыеДанные = СырыеДанныеКомментария(Объект);
	Если СырыеДанные <> Неопределено Тогда
		Текст = КТ_JSONСервер.ПолучитьСтроку(СырыеДанные, "text");
		ФайлыJSON = КТ_JSONСервер.ПолучитьМассив(СырыеДанные, "files");
	КонецЕсли;

	Документ = РазметкаВHTML(Текст)
		+ КартинкиВложенийКомментария(КомментарийСсылка, Текст)
		+ БлокВложений(ФайлыJSON);

	Возврат АдресаКартинокВАрхиве(Документ, Настройки, Истина);

КонецФункции


// Добавляет теги <img> для картинок комментария из КТ_Файлы, если они были приложены файлом, а не в тексте.
//
Функция КартинкиВложенийКомментария(КомментарийСсылка, Текст)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Файлы.ИсходныйURL КАК ИсходныйURL,
	|	Файлы.UIDKaiten КАК UIDKaiten,
	|	Файлы.ИмяФайла КАК ИмяФайла
	|ИЗ
	|	Справочник.КТ_Файлы КАК Файлы
	|ГДЕ
	|	НЕ Файлы.ПометкаУдаления
	|	И Файлы.Комментарий = &Комментарий
	|	И Файлы.ФайлПроверен";
	Запрос.УстановитьПараметр("Комментарий", КомментарийСсылка);

	Части = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		//Если НЕ ПустаяСтрока(Выборка.UIDKaiten)
		//	И СтрНайти(НРег(Текст), НРег(Выборка.UIDKaiten)) > 0 Тогда
		//	Продолжить; // Уже есть внутри текста комментария
		//КонецЕсли;
		
		Если (НЕ ПустаяСтрока(Выборка.UIDKaiten) И СтрНайти(НРег(Текст), НРег(Выборка.UIDKaiten)) > 0)
			Или (НЕ ПустаяСтрока(Выборка.ИсходныйURL) И СтрНайти(НРег(Текст), НРег(Выборка.ИсходныйURL)) > 0) Тогда
			Продолжить; // Картинка уже есть внутри текста комментария
		КонецЕсли;
		
		
		Адрес = ?(НЕ ПустаяСтрока(Выборка.ИсходныйURL), Выборка.ИсходныйURL,
			"https://kaiten.local/" + Выборка.UIDKaiten);
		Части.Добавить("<div style=""margin-top:8px""><img src=""" + ЭкранироватьHTML(Адрес)
			+ """ alt=""" + ЭкранироватьHTML(Выборка.ИмяФайла)
			+ """ style=""max-width:100%""></div>");
	КонецЦикла;

	Возврат СтрСоединить(Части, "");

КонецФункции



// Возвращает версию правил преобразования разметки.
//
// Версия увеличивается при изменении правил форматирования. Массовая пересборка
// обрабатывает только те комментарии, у которых сохранённая версия отличается от текущей.
//
// Возвращаемое значение:
//  Число - текущая версия правил.
//
Функция ВерсияРазметки() Экспорт

	Возврат 2;

КонецФункции

// Пересобирает текстовые представления комментария из сохранённого ответа Kaiten.
//
// Исходные данные берутся из реквизита СыройJSON, обращения к серверу Kaiten не происходит.
// Вызывается при загрузке комментария, при скачивании его вложений и при массовой пересборке.
//
// Параметры:
//  КомментарийСсылка - СправочникСсылка.КТ_Комментарии - комментарий архива.
//
Процедура ОбновитьHTMLКомментария(КомментарийСсылка) Экспорт

	Объект = КомментарийСсылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Текст = Объект.Текст;
	ФайлыJSON = Неопределено;

	СырыеДанные = СырыеДанныеКомментария(Объект);
	Если СырыеДанные <> Неопределено Тогда
		Текст = КТ_JSONСервер.ПолучитьСтроку(СырыеДанные, "text");
		ФайлыJSON = КТ_JSONСервер.ПолучитьМассив(СырыеДанные, "files");
	КонецЕсли;

	Объект.Текст = Текст;
	Объект.ТекстБезРазметки = РазметкаВТекст(Текст);
	Объект.ТекстHTML = HTMLКомментария(Текст, ФайлыJSON);
	Объект.ВерсияHTML = ВерсияРазметки();
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();

КонецПроцедуры

// Пересобирает HTML всех комментариев, у которых версия разметки устарела.
//
// Данные берутся из сырого архива, сервер Kaiten не опрашивается. Сбой на одной записи
// не прерывает проход: ошибка попадает в журнал регистрации, запись остаётся устаревшей
// и будет обработана при следующем запуске.
//
// Параметры:
//  Максимум - Число - ограничение числа обрабатываемых записей, 0 - без ограничения.
//
// Возвращаемое значение:
//  Структура - итоги пересборки:
//   * Обработано - Число - пересобрано комментариев;
//   * Ошибок - Число - записей, на которых произошёл сбой;
//   * Осталось - Число - комментариев с устаревшей версией после прохода.
//
Функция ПересобратьHTMLКомментариев(Максимум = 0) Экспорт

	Ссылки = КомментарииКПересборке();

	Обработано = 0;
	Ошибок = 0;

	Для Каждого КомментарийСсылка Из Ссылки Цикл

		Попытка
			ОбновитьHTMLКомментария(КомментарийСсылка);
			Обработано = Обработано + 1;
		Исключение
			Ошибок = Ошибок + 1;
			ЗаписьЖурналаРегистрации("Кайтен.ПересборкаHTMLКомментариев",
				УровеньЖурналаРегистрации.Ошибка, , КомментарийСсылка,
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

		Если Максимум > 0 И Обработано + Ошибок >= Максимум Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Обработано", Обработано);
	Результат.Вставить("Ошибок", Ошибок);
	Результат.Вставить("Осталось", ОсталосьПересобрать());

	Возврат Результат;

КонецФункции

// Пересобирает HTML всех устаревших комментариев в фоновом задании.
//
Процедура ПересобратьHTMLКомментариевФоном() Экспорт

	ПересобратьHTMLКомментариев();

КонецПроцедуры

// Возвращает количество комментариев с устаревшей версией разметки.
//
// Возвращаемое значение:
//  Число - количество комментариев.
//
Функция ОсталосьПересобрать() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	Справочник.КТ_Комментарии КАК Комментарии
		|ГДЕ
		|	НЕ Комментарии.ПометкаУдаления
		|	И ЕСТЬNULL(Комментарии.ВерсияHTML, 0) <> &Версия";
	Запрос.УстановитьПараметр("Версия", ВерсияРазметки());

	Выборка = Запрос.Выполнить().Выбрать();

	Возврат ?(Выборка.Следующий(), Выборка.Количество, 0);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заменяет адреса картинок в готовом HTML на относительные адреса файлов архива.
//
// Разбор выполняется по объектной модели документа: находятся все теги img,
// у каждого читается атрибут src и, если файл уже загружен в архив, адрес заменяется
// на относительный адрес файла. Ссылки a не изменяются.
//
// Параметры:
//  HTML - Строка - HTML-документ.
//  Настройки - Структура - параметры подключения.
//  ВстроитьВСтроку - Булево - Истина: картинки встраиваются в документ как data-URI
//                   (для просмотра без веб-сервера); Ложь: подставляется относительный адрес файла архива.
//
// Возвращаемое значение:
//  Строка - HTML-документ с подставленными картинками.
//
Функция АдресаКартинокВАрхиве(HTML, Настройки, ВстроитьВСтроку = Ложь)

	Попытка

		ЧтениеHTML = Новый ЧтениеHTML;
		ЧтениеHTML.УстановитьСтроку(HTML);

		Построитель = Новый ПостроительDOM;
		Документ = Построитель.Прочитать(ЧтениеHTML);
		ЧтениеHTML.Закрыть();

		Если Документ = Неопределено Тогда
			Возврат HTML;
		КонецЕсли;

		Для Каждого Картинка Из Документ.ПолучитьЭлементыПоИмени("img") Цикл

			Адрес = Картинка.ПолучитьАтрибут("src");
			Если Адрес = Неопределено Или ПустаяСтрока(Адрес) Тогда
				Продолжить;
			КонецЕсли;

			Если ВстроитьВСтроку Тогда
				ЛокальныйАдрес = КТ_ФайлыСервер.ИсточникКартинки(Адрес, Настройки);
			Иначе
				ЛокальныйАдрес = КТ_ФайлыСервер.ОтносительныйАдресФайла(Адрес, Настройки);
			КонецЕсли;

			Если ЛокальныйАдрес <> Адрес Тогда
				Картинка.УстановитьАтрибут("src", ЛокальныйАдрес);
			КонецЕсли;

		КонецЦикла;

		ЗаписьHTML = Новый ЗаписьHTML;
		ЗаписьHTML.УстановитьСтроку();

		ЗаписьDOM = Новый ЗаписьDOM;
		ЗаписьDOM.Записать(Документ, ЗаписьHTML);

		Возврат ЗаписьHTML.Закрыть();

	Исключение
		// Разметка комментария может не быть корректным HTML - возвращаем документ как есть.
		Возврат HTML;
	КонецПопытки;

КонецФункции

// Возвращает разобранный ответ Kaiten, сохранённый вместе с комментарием.
//
// Параметры:
//  Объект - СправочникОбъект.КТ_Комментарии - комментарий архива.
//
// Возвращаемое значение:
//  Структура, Неопределено - разобранный JSON комментария.
//
Функция СырыеДанныеКомментария(Объект)

	Хранилище = Объект.СыройJSON;
	Если Хранилище = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Данные = Хранилище.Получить();

	Если КТ_JSONСервер.ЭтоОбъектJSON(Данные) Тогда
		Возврат Данные;
	КонецЕсли;

	Если ТипЗнч(Данные) = Тип("Строка") И НЕ ПустаяСтрока(Данные) Тогда
		Попытка
			Возврат КТ_JSONСервер.ПрочитатьJSONИзСтроки(Данные);
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Возвращает комментарии, у которых версия разметки отличается от текущей.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.КТ_Комментарии - комментарии к пересборке.
//
Функция КомментарииКПересборке()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	Комментарии.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КТ_Комментарии КАК Комментарии
		|ГДЕ
		|	НЕ Комментарии.ПометкаУдаления
		|	И ЕСТЬNULL(Комментарии.ВерсияHTML, 0) <> &Версия
		|УПОРЯДОЧИТЬ ПО
		|	Комментарии.Ссылка";
	Запрос.УстановитьПараметр("Версия", ВерсияРазметки());

	Результат = Новый Массив;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает строки разметки с нормализованными переводами строк.
//
// Параметры:
//  Текст - Строка - исходная разметка.
//
// Возвращаемое значение:
//  Массив из Строка - строки разметки.
//
Функция СтрокиРазметки(Текст)

	Если ТипЗнч(Текст) <> Тип("Строка") Или ПустаяСтрока(Текст) Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Нормализованный = СтрЗаменить(Текст, Символы.ВК, "");
	Нормализованный = СтрЗаменить(Нормализованный, Символы.Таб, "    ");

	Возврат СтрРазделить(Нормализованный, Символы.ПС, Ложь);

КонецФункции

// Экранирует специальные символы HTML.
//
// Параметры:
//  Значение - Строка - исходный текст.
//
// Возвращаемое значение:
//  Строка - экранированный текст.
//
Функция ЭкранироватьHTML(Значение)

	Результат = СтрЗаменить(Строка(Значение), "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");

	Возврат Результат;

КонецФункции

// Обрабатывает разметку внутри одной строки: ссылки, картинки, выделение.
//
// Параметры:
//  Текст - Строка - строка разметки.
//  ЗаменыСсылок - Соответствие из КлючИЗначение, Неопределено - подмена адресов.
//
// Возвращаемое значение:
//  Строка - фрагмент HTML.
//
//Старый
//Функция Инлайн(Текст, ЗаменыСсылок)
//
//	Результат = ЭкранироватьHTML(Текст);
//	Результат = ЗаменитьСсылки(Результат, ЗаменыСсылок);
//	Результат = ЗаменитьПарные(Результат, "`", "<code>", "</code>");
//	Результат = ЗаменитьПарные(Результат, "**", "<b>", "</b>");
//	Результат = ЗаменитьПарные(Результат, "~~", "<s>", "</s>");
//	Результат = ЗаменитьПарные(Результат, "*", "<i>", "</i>");
//	Результат = ЗаменитьПарные(Результат, "_", "<i>", "</i>");
//
//	Возврат Результат;
//
//КонецФункции

//
//Испавлено!
Функция Инлайн(Текст, ЗаменыСсылок)

	Результат = ЭкранироватьHTML(Текст);
	Результат = ЗаменитьПарные(Результат, "`", "<code>", "</code>");
	Результат = ЗаменитьПарные(Результат, "**", "<b>", "</b>");
	Результат = ЗаменитьПарные(Результат, "~~", "<s>", "</s>");
	Результат = ЗаменитьПарные(Результат, "*", "<i>", "</i>");
	// ЗаменитьСсылки вызывается ПОСЛЕ ЗаменитьПарные, чтобы подчеркивания и звездочки
	// внутри URL картинки не превращались в теги <i>!
	Результат = ЗаменитьСсылки(Результат, ЗаменыСсылок);

	Возврат Результат;

КонецФункции


// Заменяет пары одинаковых маркеров разметки на открывающий и закрывающий теги.
//
// Параметры:
//  Текст - Строка - текст с маркерами.
//  Маркер - Строка - маркер разметки.
//  Открывающий - Строка - открывающий тег.
//  Закрывающий - Строка - закрывающий тег.
//
// Возвращаемое значение:
//  Строка - текст с тегами.
//
Функция ЗаменитьПарные(Текст, Маркер, Открывающий, Закрывающий)

	Позиция = СтрНайти(Текст, Маркер);
	Если Позиция = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	Хвост = Сред(Текст, Позиция + СтрДлина(Маркер));
	Закрытие = СтрНайти(Хвост, Маркер);
	Если Закрытие = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	Возврат Лев(Текст, Позиция - 1) + Открывающий
		+ ЗаменитьПарные(Лев(Хвост, Закрытие - 1), Маркер, Открывающий, Закрывающий)
		+ Закрывающий
		+ ЗаменитьПарные(Сред(Хвост, Закрытие + СтрДлина(Маркер)), Маркер, Открывающий, Закрывающий);

КонецФункции

// Заменяет ссылки и картинки разметки на HTML-теги.
//
// Параметры:
//  Текст - Строка - текст с разметкой ссылок.
//  ЗаменыСсылок - Соответствие из КлючИЗначение, Неопределено - подмена адресов.
//
// Возвращаемое значение:
//  Строка - фрагмент HTML.
//
Функция ЗаменитьСсылки(Текст, ЗаменыСсылок)

	Результат = "";
	Остаток = Текст;

	Пока Истина Цикл

		ПозицияКартинки = СтрНайти(Остаток, "![");
		ПозицияСсылки = СтрНайти(Остаток, "[");

		Если ПозицияКартинки = 0 И ПозицияСсылки = 0 Тогда
			Возврат Результат + Остаток;
		КонецЕсли;

		ЭтоКартинка = ПозицияКартинки > 0
			И (ПозицияСсылки = 0 Или ПозицияКартинки <= ПозицияСсылки);
		Позиция = ?(ЭтоКартинка, ПозицияКартинки, ПозицияСсылки);
		Сдвиг = ?(ЭтоКартинка, 2, 1);

		Хвост = Сред(Остаток, Позиция + Сдвиг);
		ЗакрытиеПодписи = СтрНайти(Хвост, "](");

		Если ЗакрытиеПодписи = 0 Тогда
			Результат = Результат + Лев(Остаток, Позиция + Сдвиг - 1);
			Остаток = Хвост;
			Продолжить;
		КонецЕсли;

		Подпись = Лев(Хвост, ЗакрытиеПодписи - 1);
		ПослеПодписи = Сред(Хвост, ЗакрытиеПодписи + 2);
		КонецАдреса = СтрНайти(ПослеПодписи, ")");

		Если КонецАдреса = 0 Тогда
			Результат = Результат + Лев(Остаток, Позиция + Сдвиг - 1);
			Остаток = Хвост;
			Продолжить;
		КонецЕсли;

		Адрес = Лев(ПослеПодписи, КонецАдреса - 1);

		Результат = Результат + Лев(Остаток, Позиция - 1);

		Если ЭтоКартинка Тогда
			Результат = Результат + "<img src=""" + ИсточникСсылки(Адрес, ЗаменыСсылок)
				+ """ alt=""" + Подпись + """ style=""max-width:100%"">";
		Иначе
			Результат = Результат + "<a href=""" + Адрес + """ target=""_blank"">"
				+ Подпись + "</a>";
		КонецЕсли;

		Остаток = Сред(ПослеПодписи, КонецАдреса + 1);

	КонецЦикла;

КонецФункции

// Возвращает адрес для вывода ссылки с учетом подмены.
//
// Параметры:
//  Адрес - Строка - адрес из разметки.
//  ЗаменыСсылок - Соответствие из КлючИЗначение, Неопределено - подмена адресов.
//
// Возвращаемое значение:
//  Строка - адрес для вывода.
//
Функция ИсточникСсылки(Адрес, ЗаменыСсылок)

	Если ЗаменыСсылок = Неопределено Тогда
		Возврат Адрес;
	КонецЕсли;

	Источник = ЗаменыСсылок.Получить(Адрес);

	Возврат ?(Источник = Неопределено, Адрес, Источник);

КонецФункции

// Возвращает адрес вложения комментария.
//
// Параметры:
//  ФайлJSON - Произвольный - элемент массива вложений из JSON API.
//
// Возвращаемое значение:
//  Строка - адрес вложения или пустая строка.
//
Функция АдресВложения(ФайлJSON)

	Если НЕ КТ_JSONСервер.ЭтоОбъектJSON(ФайлJSON) Тогда
		Возврат "";
	КонецЕсли;

	Возврат КТ_JSONСервер.ПолучитьСтроку(ФайлJSON, "url");

КонецФункции

// Формирует HTML-блок вложений комментария.
//
// Параметры:
//  ФайлыJSON - Массив из Структура, Неопределено - вложения комментария.
//
// Возвращаемое значение:
//  Строка - HTML-блок вложений или пустая строка.
//
Функция БлокВложений(ФайлыJSON)

	Если ТипЗнч(ФайлыJSON) <> Тип("Массив") Или ФайлыJSON.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Части = Новый Массив;
	Части.Добавить("<div style=""margin-top:8px;border-top:1px solid #ddd;padding-top:6px"">");
	Части.Добавить("<div style=""color:#777"">Вложения:</div>");

	Для Каждого ФайлJSON Из ФайлыJSON Цикл

		Если НЕ КТ_JSONСервер.ЭтоОбъектJSON(ФайлJSON) Тогда
			Продолжить;
		КонецЕсли;

		ИмяФайла = КТ_JSONСервер.ПолучитьСтроку(ФайлJSON, "name");
		Если ПустаяСтрока(ИмяФайла) Тогда
			ИмяФайла = КТ_JSONСервер.ПолучитьСтроку(ФайлJSON, "name_original");
		КонецЕсли;
		Если ПустаяСтрока(ИмяФайла) Тогда
			ИмяФайла = "файл";
		КонецЕсли;

		Адрес = АдресВложения(ФайлJSON);

		Если ПустаяСтрока(Адрес) Тогда
			Представление = ЭкранироватьHTML(ИмяФайла);
		Иначе
			Представление = "<a href=""" + Адрес + """ target=""_blank"">"
				+ ЭкранироватьHTML(ИмяФайла) + "</a>";
		КонецЕсли;

		Части.Добавить("<div>" + Представление + ЛокальнаяКопия(ФайлJSON) + "</div>");

	КонецЦикла;

	Части.Добавить("</div>");

	Возврат СтрСоединить(Части, "");

КонецФункции

// Возвращает пометку о локальной копии файла в архиве.
//
// Параметры:
//  ФайлJSON - Структура - вложение комментария.
//
// Возвращаемое значение:
//  Строка - HTML-пометка или пустая строка.
//
Функция ЛокальнаяКопия(ФайлJSON)

	Путь = КТ_JSONСервер.ПолучитьСтроку(ФайлJSON, "ОтносительныйПуть");
	Если ПустаяСтрока(Путь) Тогда
		Возврат "";
	КонецЕсли;

	Возврат " <span style=""color:#999"">(в архиве: " + ЭкранироватьHTML(Путь) + ")</span>";

КонецФункции

// Возвращает строку без разметки.
//
// Параметры:
//  СтрокаТекста - Строка - строка разметки.
//
// Возвращаемое значение:
//  Строка - строка без разметки.
//
Функция СтрокаБезРазметки(СтрокаТекста)

	Результат = СокрП(СтрокаТекста);

	Пока СтрНачинаетсяС(Результат, "#") Цикл
		Результат = СокрЛ(Сред(Результат, 2));
	КонецЦикла;

	Если СтрНачинаетсяС(Результат, "> ") Тогда
		Результат = СокрЛ(Сред(Результат, 3));
	КонецЕсли;

	Если СтрНачинаетсяС(Результат, "- ") Или СтрНачинаетсяС(Результат, "* ")
		Или СтрНачинаетсяС(Результат, "+ ") Тогда
		Результат = "• " + СокрЛ(Сред(Результат, 3));
	КонецЕсли;

	Результат = СсылкиВТекст(Результат);
	Результат = СтрЗаменить(Результат, "**", "");
	Результат = СтрЗаменить(Результат, "~~", "");
	Результат = СтрЗаменить(Результат, "`", "");

	Возврат Результат;

КонецФункции

// Заменяет ссылки и картинки разметки на обычный текст.
//
// Параметры:
//  Текст - Строка - текст с разметкой ссылок.
//
// Возвращаемое значение:
//  Строка - текст без разметки ссылок.
//
Функция СсылкиВТекст(Текст)

	Результат = "";
	Остаток = Текст;

	Пока Истина Цикл

		ПозицияКартинки = СтрНайти(Остаток, "![");
		ПозицияСсылки = СтрНайти(Остаток, "[");

		Если ПозицияКартинки = 0 И ПозицияСсылки = 0 Тогда
			Возврат Результат + Остаток;
		КонецЕсли;

		ЭтоКартинка = ПозицияКартинки > 0
			И (ПозицияСсылки = 0 Или ПозицияКартинки <= ПозицияСсылки);
		Позиция = ?(ЭтоКартинка, ПозицияКартинки, ПозицияСсылки);
		Сдвиг = ?(ЭтоКартинка, 2, 1);

		Хвост = Сред(Остаток, Позиция + Сдвиг);
		ЗакрытиеПодписи = СтрНайти(Хвост, "](");

		Если ЗакрытиеПодписи = 0 Тогда
			Результат = Результат + Лев(Остаток, Позиция + Сдвиг - 1);
			Остаток = Хвост;
			Продолжить;
		КонецЕсли;

		Подпись = Лев(Хвост, ЗакрытиеПодписи - 1);
		ПослеПодписи = Сред(Хвост, ЗакрытиеПодписи + 2);
		КонецАдреса = СтрНайти(ПослеПодписи, ")");

		Если КонецАдреса = 0 Тогда
			Результат = Результат + Лев(Остаток, Позиция + Сдвиг - 1);
			Остаток = Хвост;
			Продолжить;
		КонецЕсли;

		Адрес = Лев(ПослеПодписи, КонецАдреса - 1);

		Результат = Результат + Лев(Остаток, Позиция - 1);

		Если ЭтоКартинка Тогда
			Результат = Результат + "[Картинка: " + ?(ПустаяСтрока(Подпись), Адрес, Подпись) + "]";
		Иначе
			Результат = Результат + Подпись + " (" + Адрес + ")";
		КонецЕсли;

		Остаток = Сред(ПослеПодписи, КонецАдреса + 1);

	КонецЦикла;

КонецФункции

// Закрывает текущий список, если он открыт.
//
// Параметры:
//  Части - Массив из Строка - собираемый HTML-документ, изменяется.
//  ОткрытСписок - Строка - вид открытого списка.
//
// Возвращаемое значение:
//  Строка - пустая строка (список закрыт).
//
Функция ЗакрытьСписок(Части, ОткрытСписок)

	Если НЕ ПустаяСтрока(ОткрытСписок) Тогда
		Части.Добавить("</" + ОткрытСписок + ">");
	КонецЕсли;

	Возврат "";

КонецФункции

// Возвращает уровень заголовка строки разметки.
//
// Параметры:
//  СтрокаТекста - Строка - строка разметки без ведущих пробелов.
//
// Возвращаемое значение:
//  Число - уровень заголовка или 0.
//
Функция УровеньЗаголовка(СтрокаТекста)

	Уровень = 0;
	Пока Уровень < 6 И Сред(СтрокаТекста, Уровень + 1, 1) = "#" Цикл
		Уровень = Уровень + 1;
	КонецЦикла;

	Если Уровень = 0 Или Сред(СтрокаТекста, Уровень + 1, 1) <> " " Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Уровень;

КонецФункции

// Проверяет, является ли строка горизонтальной линией.
//
// Параметры:
//  СтрокаТекста - Строка - строка разметки без ведущих пробелов.
//
// Возвращаемое значение:
//  Булево - Истина, если строка является горизонтальной линией.
//
Функция ЭтоГоризонтальнаяЛиния(СтрокаТекста)

	Если СтрДлина(СтрокаТекста) < 3 Тогда
		Возврат Ложь;
	КонецЕсли;

	ПервыйСимвол = Сред(СтрокаТекста, 1, 1);
	Если ПервыйСимвол <> "-" И ПервыйСимвол <> "*" И ПервыйСимвол <> "_" Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Индекс = 1 По СтрДлина(СтрокаТекста) Цикл
		Если Сред(СтрокаТекста, Индекс, 1) <> ПервыйСимвол Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Возвращает вид списка, элементом которого является строка.
//
// Параметры:
//  СтрокаТекста - Строка - строка разметки без ведущих пробелов.
//
// Возвращаемое значение:
//  Строка - "ul", "ol" или пустая строка.
//
Функция ВидЭлементаСписка(СтрокаТекста)

	Если СтрНачинаетсяС(СтрокаТекста, "- ") Или СтрНачинаетсяС(СтрокаТекста, "* ")
		Или СтрНачинаетсяС(СтрокаТекста, "+ ") Тогда
		Возврат "ul";
	КонецЕсли;

	Точка = СтрНайти(СтрокаТекста, ". ");
	Если Точка > 1 И Точка <= 4 И ЭтоНомерСписка(Лев(СтрокаТекста, Точка - 1)) Тогда
		Возврат "ol";
	КонецЕсли;

	Возврат "";

КонецФункции

// Возвращает текст элемента списка без маркера.
//
// Параметры:
//  СтрокаТекста - Строка - строка разметки без ведущих пробелов.
//
// Возвращаемое значение:
//  Строка - текст элемента списка.
//
Функция ТекстЭлементаСписка(СтрокаТекста)

	ВидСписка = ВидЭлементаСписка(СтрокаТекста);

	Если ВидСписка = "ul" Тогда
		Возврат СокрЛ(Сред(СтрокаТекста, 3));
	КонецЕсли;

	Если ВидСписка = "ol" Тогда
		Возврат СокрЛ(Сред(СтрокаТекста, СтрНайти(СтрокаТекста, ". ") + 1));
	КонецЕсли;

	Возврат СтрокаТекста;

КонецФункции

// Проверяет, что значение состоит только из цифр.
//
// Параметры:
//  Значение - Строка - проверяемое значение.
//
// Возвращаемое значение:
//  Булево - Истина, если значение состоит только из цифр.
//
Функция ЭтоНомерСписка(Значение)

	Если ПустаяСтрока(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Индекс = 1 По СтрДлина(Значение) Цикл
		КодСимволаЗначения = КодСимвола(Значение, Индекс);
		Если КодСимволаЗначения < 48 Или КодСимволаЗначения > 57 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

#КонецОбласти
