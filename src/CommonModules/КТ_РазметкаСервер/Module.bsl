//КонецФункции


// Извлекает все URL картинок из текста комментария:
// и из Markdown-разметки ![подпись](адрес), и из HTML-тегов <img ... src="адрес">.
//
// Параметры:
//  Текст - Строка - исходный текст комментария (Markdown или HTML).
//
// Возвращаемое значение:
//  Массив из Строка - уникальные HTTP/HTTPS адреса картинок.
//
Функция АдресаКартинокИзРазметки(Текст) Экспорт

	Результат = Новый Массив;
	Если ТипЗнч(Текст) <> Тип("Строка") Или ПустаяСтрока(Текст) Тогда
		Возврат Результат;
	КонецЕсли;

	// 1. Поиск картинок в Markdown-разметке: ![alt](url)
	Остаток = Текст;
	Пока Истина Цикл
		Позиция = СтрНайти(Остаток, "![");
		Если Позиция = 0 Тогда
			Прервать;
		КонецЕсли;

		Хвост = Сред(Остаток, Позиция + 2);
		ЗакрытиеПодписи = СтрНайти(Хвост, "](");
		Если ЗакрытиеПодписи = 0 Тогда
			Остаток = Хвост;
			Продолжить;
		КонецЕсли;

		ПослеПодписи = Сред(Хвост, ЗакрытиеПодписи + 2);
		КонецАдреса = СтрНайти(ПослеПодписи, ")");
		Если КонецАдреса = 0 Тогда
			Остаток = Хвост;
			Продолжить;
		КонецЕсли;

		ДобавитьАдресКартинки(Результат, Лев(ПослеПодписи, КонецАдреса - 1));
		Остаток = Сред(ПослеПодписи, КонецАдреса + 1);
	КонецЦикла;

	// 2. Поиск картинок в HTML-разметке: <img ... src="url" ...>
	Остаток = Текст;
	Пока Истина Цикл
		ПозицияТега = СтрНайти(НРег(Остаток), "<img");
		Если ПозицияТега = 0 Тогда
			Прервать;
		КонецЕсли;

		ХвостТега = Сред(Остаток, ПозицияТега + 4);
		КонецТега = СтрНайти(ХвостТега, ">");
		Если КонецТега = 0 Тогда
			Прервать;
		КонецЕсли;

		ТелоТега = Лев(ХвостТега, КонецТега - 1);
		АдресИзImg = ИзвлечьАтрибутSrc(ТелоТега);
		ДобавитьАдресКартинки(Результат, АдресИзImg);

		Остаток = Сред(ХвостТега, КонецТега + 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Извлекает значение атрибута src из внутренней части тега <img ...>.
//
Функция ИзвлечьАтрибутSrc(ТелоТега)

	Нижний = НРег(ТелоТега);
	ПозицияSrc = СтрНайти(Нижний, "src");
	Пока ПозицияSrc > 0 Цикл
		Хвост = СокрЛ(Сред(ТелоТега, ПозицияSrc + 3));
		Если Лев(Хвост, 1) = "=" Тогда
			ПослеРавно = СокрЛ(Сред(Хвост, 2));
			Кавычка = Лев(ПослеРавно, 1);
			Если Кавычка = """" Или Кавычка = "'" Тогда
				ОстатокЗначения = Сред(ПослеРавно, 2);
				КонецКавычки = СтрНайти(ОстатокЗначения, Кавычка);
				Если КонецКавычки > 0 Тогда
					Возврат Лев(ОстатокЗначения, КонецКавычки - 1);
				КонецЕсли;
			Иначе
				// src без кавычек до первого пробела
				ПозПробела = СтрНайти(ПослеРавно, " ");
				Возврат ?(ПозПробела > 0, Лев(ПослеРавно, ПозПробела - 1), ПослеРавно);
			КонецЕсли;
		КонецЕсли;

		СледующийСдвиг = СтрНайти(Сред(Нижний, ПозицияSrc + 3), "src");
		ПозицияSrc = ?(СледующийСдвиг > 0, ПозицияSrc + 2 + СледующийСдвиг, 0);
	КонецЦикла;

	Возврат "";

КонецФункции

// Добавляет очищенный HTTP/HTTPS адрес в массив без дублей.
//
Процедура ДобавитьАдресКартинки(МассивАдресов, СыройАдрес)

	Адрес = СокрЛП(СыройАдрес);
	Адрес = СтрЗаменить(Адрес, "&amp;", "&");

	Если ПустаяСтрока(Адрес) Тогда
		Возврат;
	КонецЕсли;

	Нижний = НРег(Адрес);
	Если НЕ СтрНачинаетсяС(Нижний, "http://") И НЕ СтрНачинаетсяС(Нижний, "https://") Тогда
		Возврат;
	КонецЕсли;

	Если МассивАдресов.Найти(Адрес) = Неопределено Тогда
		МассивАдресов.Добавить(Адрес);
	КонецЕсли;

КонецПроцедуры


// Проверяет, содержит ли текст комментария готовую HTML-разметку (например, из email-replies).
//
Функция ЭтоHTMLРазметка(Текст) Экспорт

	Если ТипЗнч(Текст) <> Тип("Строка") Или ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;

	Нижний = НРег(Текст);
	Возврат СтрНайти(Нижний, "<div") > 0
		Или СтрНайти(Нижний, "<img") > 0
		Или СтрНайти(Нижний, "<p>") > 0
		Или СтрНайти(Нижний, "<p ") > 0
		Или СтрНайти(Нижний, "<br") > 0
		Или СтрНайти(Нижний, "<table") > 0
		Или СтрНайти(Нижний, "<span") > 0;

КонецФункции


// Преобразует разметку комментария Kaiten (markdown) в HTML-документ.
//
// Параметры:
//  Текст - Строка - исходная разметка.
//  ЗаменыСсылок - Соответствие из КлючИЗначение, Неопределено - подмена адресов: адрес из разметки -> адрес для вывода
//                (например, встроенные данные картинки из архива).
//
// Возвращаемое значение:
//  Строка - HTML-документ.
//

Функция РазметкаВHTML(Текст, ЗаменыСсылок = Неопределено) Экспорт

	ШапкаHTML = "<html><head><meta charset=""utf-8"">"
		+ "<style>img { max-width: 100%; height: auto; }</style></head>"
		+ "<body style=""font-family:'Segoe UI',Arial,sans-serif;font-size:13px;margin:8px"">";
	ПодвалHTML = "</body></html>";

	// Если комментарий уже пришел из Kaiten в формате HTML (ServiceDesk / email-replies),
	// не экранируем его теги через ЭкранироватьHTML, иначе <div> и <img> превратятся в текст!
	Если ЭтоHTMLРазметка(Текст) Тогда
		Возврат ШапкаHTML + Текст + ПодвалHTML;
	КонецЕсли;

	Части = Новый Массив;
	Части.Добавить(ШапкаHTML);

	// ... далее существующий цикл по СтрокиРазметки(Текст) без изменений ...	
	
	Части = Новый Массив;
	Части.Добавить("<html><head><meta charset=""utf-8""></head><body"
		+ " style=""font-family:'Segoe UI',Arial,sans-serif;font-size:13px;margin:8px"">");

	ОткрытСписок = "";
	ВКоде = Ложь;

	Для Каждого СтрокаТекста Из СтрокиРазметки(Текст) Цикл

		БезПробелов = СокрЛП(СтрокаТекста);

		Если СтрНачинаетсяС(БезПробелов, "```") Тогда
			Если ВКоде Тогда
				Части.Добавить("</pre>");
				ВКоде = Ложь;
			Иначе
				ОткрытСписок = ЗакрытьСписок(Части, ОткрытСписок);
				Части.Добавить("<pre style=""background:#f5f5f5;padding:6px;"
					+ "white-space:pre-wrap;font-family:Consolas,monospace"">");
				ВКоде = Истина;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если ВКоде Тогда
			Части.Добавить(ЭкранироватьHTML(СтрокаТекста) + Символы.ПС);
			Продолжить;
		КонецЕсли;

		Если ПустаяСтрока(БезПробелов) Тогда
			ОткрытСписок = ЗакрытьСписок(Части, ОткрытСписок);
			Части.Добавить("<div style=""height:6px""></div>");
			Продолжить;
		КонецЕсли;

		Уровень = УровеньЗаголовка(БезПробелов);
		Если Уровень > 0 Тогда
			ОткрытСписок = ЗакрытьСписок(Части, ОткрытСписок);
			Тег = "h" + Формат(Уровень, "ЧГ=0");
			Части.Добавить("<" + Тег + ">" + Инлайн(СокрЛ(Сред(БезПробелов, Уровень + 1)),
				ЗаменыСсылок) + "</" + Тег + ">");
			Продолжить;
		КонецЕсли;

		Если ЭтоГоризонтальнаяЛиния(БезПробелов) Тогда
			ОткрытСписок = ЗакрытьСписок(Части, ОткрытСписок);
			Части.Добавить("<hr>");
			Продолжить;
		КонецЕсли;

		ВидСписка = ВидЭлементаСписка(БезПробелов);
		Если НЕ ПустаяСтрока(ВидСписка) Тогда
			Если ОткрытСписок <> ВидСписка Тогда
				ОткрытСписок = ЗакрытьСписок(Части, ОткрытСписок);
				Части.Добавить("<" + ВидСписка + ">");
				ОткрытСписок = ВидСписка;
			КонецЕсли;
			Части.Добавить("<li>" + Инлайн(ТекстЭлементаСписка(БезПробелов), ЗаменыСсылок) + "</li>");
			Продолжить;
		КонецЕсли;

		ОткрытСписок = ЗакрытьСписок(Части, ОткрытСписок);

		Если СтрНачинаетсяС(БезПробелов, "> ") Тогда
			Части.Добавить("<blockquote style=""border-left:3px solid #ccc;"
				+ "margin:4px 0;padding-left:8px;color:#555"">"
				+ Инлайн(СокрЛ(Сред(БезПробелов, 3)), ЗаменыСсылок) + "</blockquote>");
			Продолжить;
		КонецЕсли;

		Части.Добавить("<div>" + Инлайн(СтрокаТекста, ЗаменыСсылок) + "</div>");

	КонецЦикла;

	Если ВКоде Тогда
		Части.Добавить("</pre>");
	КонецЕсли;

	ОткрытСписок = ЗакрытьСписок(Части, ОткрытСписок);

	Части.Добавить("</body></html>");

	Возврат СтрСоединить(Части, "");

КонецФункции

// Преобразует разметку комментария Kaiten (markdown) в обычный текст без разметки.
//
// Параметры:
//  Текст - Строка - исходная разметка.
//
// Возвращаемое значение:
//  Строка - текст без разметки.
//
//Старая
//Функция РазметкаВТекст(Текст) Экспорт

//	Части = Новый Массив;

//	Для Каждого СтрокаТекста Из СтрокиРазметки(Текст) Цикл
//		Части.Добавить(СтрокаБезРазметки(СтрокаТекста));
//	КонецЦикла;

//	Возврат СтрСоединить(Части, Символы.ПС);

//КонецФункции

Функция РазметкаВТекст(Текст) Экспорт

	ИсходныйТекст = Строка(Текст);
	Если ЭтоHTMLРазметка(ИсходныйТекст) Тогда
		ИсходныйТекст = УдалитьHTMLТеги(ИсходныйТекст);
	КонецЕсли;

	Части = Новый Массив;
	Для Каждого СтрокаТекста Из СтрокиРазметки(ИсходныйТекст) Цикл
		Части.Добавить(СтрокаБезРазметки(СтрокаТекста));
	КонецЦикла;

	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

// Очищает строку от HTML-тегов для текстового представления комментария.
//
Функция УдалитьHTMLТеги(HTMLТекст)

	ТекстРабочий = СтрЗаменить(HTMLТекст, "<br>", Символы.ПС);
	ТекстРабочий = СтрЗаменить(ТекстРабочий, "<br/>", Символы.ПС);
	ТекстРабочий = СтрЗаменить(ТекстРабочий, "<br />", Символы.ПС);
	ТекстРабочий = СтрЗаменить(ТекстРабочий, "</div>", Символы.ПС);
	ТекстРабочий = СтрЗаменить(ТекстРабочий, "</p>", Символы.ПС);

	Результат = "";
	ВнутриТега = Ложь;
	Для Индекс = 1 По СтрДлина(ТекстРабочий) Цикл
		Символ = Сред(ТекстРабочий, Индекс, 1);
		Если Символ = "<" Тогда
			ВнутриТега = Истина;
		ИначеЕсли Символ = ">" Тогда
			ВнутриТега = Ложь;
		ИначеЕсли НЕ ВнутриТега Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;

	Результат = СтрЗаменить(Результат, "&nbsp;", " ");
	Результат = СтрЗаменить(Результат, "&quot;", """");
	Результат = СтрЗаменить(Результат, "&lt;", "<");
	Результат = СтрЗаменить(Результат, "&gt;", ">");
	Результат = СтрЗаменить(Результат, "&amp;", "&");

	Возврат СокрЛП(Результат);

КонецФункции


// Формирует HTML-представление комментария: разметка, картинки и вложения.
//
// Картинки, уже загруженные в архив, получают относительный адрес файла архива,
// поэтому документ не зависит от срока действия подписанных ссылок Kaiten.
// Ссылки на файлы не переписываются.
//
// Параметры:
//  Текст - Строка - текст комментария (разметка).
//  ФайлыJSON - Массив из Структура, Неопределено - вложения комментария из JSON API.
//
// Возвращаемое значение:
//  Строка - HTML-документ комментария.
//
Функция HTMLКомментария(Текст, ФайлыJSON = Неопределено) Экспорт

	Настройки = КТ_ЗагрузкаKaitenСервер.ПрочитатьНастройки();

	Документ = РазметкаВHTML(Текст) + БлокВложений(ФайлыJSON);

	Возврат АдресаКартинокВАрхиве(Документ, Настройки);

КонецФункции

