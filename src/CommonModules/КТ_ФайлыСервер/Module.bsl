#Область ПрограммныйИнтерфейс

// Регистрирует файл карточки.
//
// Параметры:
//  Карточка - СправочникСсылка.КТ_Карточки - карточка файла.
//  JSON - Структура - объект JSON файла.
//  Контекст - Структура - контекст загрузки.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_Файлы - ссылка на зарегистрированный файл.
//
Функция ЗарегистрироватьФайлКарточки(Карточка, JSON, Контекст) Экспорт

	Родитель = Новый Структура;
	Родитель.Вставить("ВидРодителя", Перечисления.КТ_ВидРодителяФайла.Карточка);
	Родитель.Вставить("Карточка", Карточка);

	Возврат ЗаписатьФайл(JSON, Родитель, Контекст);

КонецФункции

// Регистрирует все файлы карточки.
//
// Параметры:
//  Карточка - СправочникСсылка.КТ_Карточки - карточка.
//  МассивJSON - Массив из Структура - массив файлов из JSON.
//  Контекст - Структура - контекст загрузки.
//
Процедура ЗарегистрироватьФайлыКарточки(Карточка, МассивJSON, Контекст) Экспорт

	Для Каждого ФайлJSON Из МассивJSON Цикл
		ЗарегистрироватьФайлКарточки(Карточка, ФайлJSON, Контекст);
	КонецЦикла;

КонецПроцедуры

// Регистрирует файл комментария.
//
// Параметры:
//  Карточка - СправочникСсылка.КТ_Карточки - карточка комментария.
//  Комментарий - СправочникСсылка.КТ_Комментарии - комментарий файла.
//  JSON - Структура - объект JSON файла.
//  Контекст - Структура - контекст загрузки.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_Файлы - ссылка на зарегистрированный файл.
//
Функция ЗарегистрироватьФайлКомментария(Карточка, Комментарий, JSON, Контекст) Экспорт

	Родитель = Новый Структура;
	Родитель.Вставить("ВидРодителя", Перечисления.КТ_ВидРодителяФайла.Комментарий);
	Родитель.Вставить("Карточка", Карточка);
	Родитель.Вставить("Комментарий", Комментарий);

	Возврат ЗаписатьФайл(JSON, Родитель, Контекст);

КонецФункции

// Регистрирует файл пользовательского поля.
//
// Параметры:
//  Поле - СправочникСсылка.КТ_ПользовательскиеПоля - пользовательское поле.
//  JSON - Структура - объект JSON файла.
//  Контекст - Структура - контекст загрузки.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_Файлы - ссылка на зарегистрированный файл.
//
Функция ЗарегистрироватьФайлПользовательскогоПоля(Поле, JSON, Контекст) Экспорт

	Родитель = Новый Структура;
	Родитель.Вставить("ВидРодителя", Перечисления.КТ_ВидРодителяФайла.ПользовательскоеПоле);
	Родитель.Вставить("ПользовательскоеПоле", Поле);

	Возврат ЗаписатьФайл(JSON, Родитель, Контекст);

КонецФункции

