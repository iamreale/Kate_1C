Функция НайтиОписаниеФайла(Массив, UID, ИдентификаторСтрокой)

	ИскомыйUID = НРег(СокрЛП(UID));
	ИскомыйИдентификатор = СокрЛП(ИдентификаторСтрокой);

	Для Каждого Элемент Из Массив Цикл

		UIDЭлемента = НРег(КТ_JSONСервер.ПолучитьСтроку(Элемент, "uid"));
		Если ПустаяСтрока(UIDЭлемента) Тогда
			UIDЭлемента = UIDИзАдреса(КТ_JSONСервер.ПолучитьСтроку(Элемент, "url"));
		КонецЕсли;

		Если НЕ ПустаяСтрока(ИскомыйUID) И UIDЭлемента = ИскомыйUID Тогда
			Возврат Элемент;
		КонецЕсли;

		Если НЕ ПустаяСтрока(ИскомыйИдентификатор)
			И ИдентификаторФайлаСтрокой(Элемент) = ИскомыйИдентификатор Тогда
			Возврат Элемент;
		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Возвращает идентификатор карточки файла.
//
// Карточка определяется по реквизиту файла, по карточке комментария или по полю
// card_id в сохраненных сырых данных.
//
// Параметры:
//  ФайлОбъект - СправочникОбъект.КТ_Файлы - файл архива.
//
// Возвращаемое значение:
//  Число - идентификатор карточки Kaiten; 0, если карточка не определена.
//
Функция ИдентификаторКарточкиФайла(ФайлОбъект)

	Если ЗначениеЗаполнено(ФайлОбъект.Карточка) Тогда
		Возврат ИдентификаторKaitenСсылки(ФайлОбъект.Карточка);
	КонецЕсли;

	Если ЗначениеЗаполнено(ФайлОбъект.Комментарий) Тогда
		ИдентификаторКарточки = ИдентификаторКарточкиКомментария(ФайлОбъект.Комментарий);
		Если ЗначениеЗаполнено(ИдентификаторКарточки) Тогда
			Возврат ИдентификаторКарточки;
		КонецЕсли;
	КонецЕсли;

	Возврат КТ_JSONСервер.ПолучитьЧисло(ХранилищеЗначенияJSON(ФайлОбъект.СыройJSON), "card_id");

КонецФункции

// Возвращает идентификатор карточки комментария без загрузки объекта из базы данных.
//
// Параметры:
//  Комментарий - СправочникСсылка.КТ_Комментарии - комментарий.
//
// Возвращаемое значение:
//  Число - идентификатор карточки Kaiten; 0, если карточка не определена.
//
Функция ИдентификаторКарточкиКомментария(Комментарий)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Комментарии.Карточка.ИдентификаторKaiten КАК ИдентификаторKaiten
	|ИЗ
	|	Справочник.КТ_Комментарии КАК Комментарии
	|ГДЕ
	|	Комментарии.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Комментарий);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ИдентификаторKaiten;
	КонецЕсли;

	Возврат 0;

КонецФункции

