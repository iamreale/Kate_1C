//исправлено
Функция ИсточникКартинки(Адрес, Настройки) Экспорт

	Если ПустаяСтрока(Адрес) Или СтрНачинаетсяС(НРег(Адрес), "data:") Тогда
		Возврат Адрес;
	КонецЕсли;

	ФайлСсылка = Справочники.КТ_Файлы.ПустаяСсылка();
	UID = UIDИзАдреса(Адрес);
	Если НЕ ПустаяСтрока(UID) Тогда
		ФайлСсылка = КТ_ПоискОбъектовСервер.НайтиФайл(UID, UID);
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ФайлСсылка) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Файлы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КТ_Файлы КАК Файлы
		|ГДЕ
		|	НЕ Файлы.ПометкаУдаления
		|	И Файлы.ИсходныйURL = &Адрес";
		Запрос.УстановитьПараметр("Адрес", Лев(СокрЛП(Адрес), 1000));
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ФайлСсылка = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ФайлСсылка) Тогда
		Возврат Адрес;
	КонецЕсли;

	ФайлОбъект = ФайлСсылка.ПолучитьОбъект();
	Если ФайлОбъект = Неопределено Тогда
		Возврат Адрес;
	КонецЕсли;

	MIMEТип = ФайлОбъект.MIMEТип;
	Если ПустаяСтрока(MIMEТип) Тогда
		MIMEТип = MIMEТипПоРасширению(ФайлОбъект.Расширение);
	КонецЕсли;

	Если НЕ СтрНачинаетсяС(НРег(MIMEТип), "image/") Тогда
		Возврат Адрес;
	КонецЕсли;

	Данные = ДанныеФайла(ФайлОбъект, Настройки);
	Если Данные = Неопределено Или Данные.Размер() > МаксимальныйРазмерВстраивания() Тогда
		Возврат Адрес;
	КонецЕсли;

	Возврат "data:" + MIMEТип + ";base64," + Base64БезПереводовСтрок(Данные);

КонецФункции


// Возвращает относительный адрес файла архива для подстановки в HTML.
//
// Адрес строится из относительного пути файла в каталоге архива, поэтому документ
// не зависит от срока действия подписанных ссылок Kaiten.
//
// Параметры:
//  Адрес - Строка - адрес картинки из разметки или из JSON Kaiten.
//  Настройки - Структура - параметры подключения.
//
// Возвращаемое значение:
//  Строка - относительный адрес вида /media/files/ab/ab34...ef.png или исходный адрес.
//
Функция ОтносительныйАдресФайла(Адрес, Настройки) Экспорт

	Если ПустаяСтрока(Адрес) Или СтрНачинаетсяС(НРег(Адрес), "data:") Тогда
		Возврат Адрес;
	КонецЕсли;

	UID = UIDИзАдреса(Адрес);
	Если ПустаяСтрока(UID) Тогда
		Возврат Адрес;
	КонецЕсли;

	ФайлСсылка = КТ_ПоискОбъектовСервер.НайтиФайл(UID, "");
	Если НЕ ЗначениеЗаполнено(ФайлСсылка) Тогда
		Возврат Адрес;
	КонецЕсли;

	ФайлОбъект = ФайлСсылка.ПолучитьОбъект();
	Если ФайлОбъект = Неопределено Тогда
		Возврат Адрес;
	КонецЕсли;

	MIMEТип = ФайлОбъект.MIMEТип;
	Если ПустаяСтрока(MIMEТип) Тогда
		MIMEТип = MIMEТипПоРасширению(ФайлОбъект.Расширение);
	КонецЕсли;

	Если НЕ СтрНачинаетсяС(НРег(MIMEТип), "image/") Тогда
		Возврат Адрес;
	КонецЕсли;

	Путь = СтрЗаменить(СокрЛП(ФайлОбъект.ОтносительныйПуть), "\", "/");
	Если ПустаяСтрока(Путь) Тогда
		// Файл хранится в информационной базе - относительного адреса у него нет.
		Возврат Адрес;
	КонецЕсли;

	Если НЕ СтрНачинаетсяС(Путь, "/") Тогда
		Путь = "/" + Путь;
	КонецЕсли;

	Возврат "/media" + Путь;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Скачивает содержимое файла по ссылке и размещает его в хранилище архива.
//
// Параметры:
//  ФайлОбъект - СправочникОбъект.КТ_Файлы - файл архива.
//  СсылкаНаСкачивание - Строка - подписанная ссылка на содержимое файла.
//  Контекст - Структура - контекст загрузки.
//
Процедура ЗагрузитьСодержимоеФайла(ФайлОбъект, СсылкаНаСкачивание, Контекст)

	ВременныйФайл = ПолучитьИмяВременногоФайла(ФайлОбъект.Расширение);

	Попытка

		КТ_HTTPКлиентСервер.СкачатьПоПодписанномуURL(СсылкаНаСкачивание, ВременныйФайл,
			ТаймаутФайла(Контекст.Настройки));

		ВременныйФайлОбъект = Новый Файл(ВременныйФайл);
		РазмерФактический = ВременныйФайлОбъект.Размер();
		Если ФайлОбъект.РазмерБайт > 0 И РазмерФактический <> ФайлОбъект.РазмерБайт Тогда
			// ВызватьИсключение "Размер загруженного файла не совпадает с метаданными";
			//надо просто сообщать об этом и продолжать загрузку
		КонецЕсли;

		SHA256 = ВычислитьSHA256Файла(ВременныйФайл);
		ФайлОбъект.SHA256 = SHA256;

		Если ХранитьВИнформационнойБазе(Контекст.Настройки) Тогда
			ФайлОбъект.ДвоичныеДанные = Новый ХранилищеЗначения(Новый ДвоичныеДанные(ВременныйФайл), Новый СжатиеДанных(9));
			ФайлОбъект.СпособХранения = Перечисления.КТ_СпособХраненияФайла.ВнутриИнформационнойБазы;
			ФайлОбъект.ОтносительныйПуть = "";
		Иначе
			КореньАрхива = КаталогАрхива(Контекст.Настройки);
			
			//todo временная заплатка если не определилось расширение
//			Если ПустаяСтрока(ФайлОбъект.Расширение) тогда
//				ИмяИзСыройJSON =  ФайлОбъект.СыройJSON.получить().получить("name");
//				ФайлОбъект.Расширение = ВыделитьРасширениеИзСтроки( ИмяИзСыройJSON);
//			КонецЕсли;
			// Безопасное получение расширения через КТ_JSONСервер (работает и со Структурой, и с Соответствием)
			Если ПустаяСтрока(ФайлОбъект.Расширение) Тогда
				ДанныеСырогоJSON = ХранилищеЗначенияJSON(ФайлОбъект.СыройJSON);
				ИмяИзСыройJSON = КТ_JSONСервер.ПолучитьСтроку(ДанныеСырогоJSON, "name");
				ФайлОбъект.Расширение = РасширениеФайлаИзJSON(ДанныеСырогоJSON, ИмяИзСыройJSON);
			КонецЕсли;
			
			ПостоянныйПуть = ПолучитьПутьФайлаПоХешу(SHA256, ФайлОбъект.Расширение, КореньАрхива);
			АтомарноПереместитьФайл(ВременныйФайл, ПостоянныйПуть);
			ФайлОбъект.СпособХранения = Перечисления.КТ_СпособХраненияФайла.ВоВнешнемКаталоге;
			ФайлОбъект.ОтносительныйПуть = Лев(ПолучитьОтносительныйПуть(ПостоянныйПуть, КореньАрхива), 500);
		КонецЕсли;

	Исключение

		УдалитьВременныйФайл(ВременныйФайл);

		ВызватьИсключение;

	КонецПопытки;

	УдалитьВременныйФайл(ВременныйФайл);

КонецПроцедуры



// Определяет расширение файла без ведущей точки из поля extension, имени файла или URL.
//
// Параметры:
//  JSON - Структура, Соответствие из КлючИЗначение - объект JSON файла.
//  ИмяФайла - Строка - имя файла.
//
// Возвращаемое значение:
//  Строка - расширение файла в нижнем регистре (до 20 символов).
//
Функция РасширениеФайлаИзJSON(JSON, ИмяФайла)

	Расширение = СокрЛП(КТ_JSONСервер.ПолучитьСтроку(JSON, "extension"));

	// Если поле extension в JSON пустое — извлекаем расширение из имени файла (например, "отчет.xlsx")
	Если ПустаяСтрока(Расширение) Тогда
		Расширение = ВыделитьРасширениеИзСтроки(ИмяФайла);
	КонецЕсли;

	// Если в имени файла точки не было — пробуем извлечь из пути URL (до параметров "?")
	Если ПустаяСтрока(Расширение) Тогда
		Адрес = КТ_JSONСервер.ПолучитьСтроку(JSON, "url");
		ПозицияВопроса = СтрНайти(Адрес, "?");
		Если ПозицияВопроса > 0 Тогда
			Адрес = Лев(Адрес, ПозицияВопроса - 1);
		КонецЕсли;
		Расширение = ВыделитьРасширениеИзСтроки(Адрес);
	КонецЕсли;

	// Убираем ведущую точку, если она была (чтобы не получилось "..png")
	Пока СтрНачинаетсяС(Расширение, ".") Цикл
		Расширение = Сред(Расширение, 2);
	КонецЦикла;

	Возврат Лев(НРег(СокрЛП(Расширение)), 20);

КонецФункции

// Извлекает расширение после последней точки в имени файла или пути.
//
Функция ВыделитьРасширениеИзСтроки(ИсходнаяСтрока)

	СтрокаПоиска = СтрЗаменить(СокрЛП(ИсходнаяСтрока), "\", "/");

	// Берем только само имя файла после последнего слэша
	ПозицияСлэша = СтрНайти(СтрокаПоиска, "/", НаправлениеПоиска.СКонца);
	Если ПозицияСлэша > 0 Тогда
		СтрокаПоиска = Сред(СтрокаПоиска, ПозицияСлэша + 1);
	КонецЕсли;

	ПозицияТочки = СтрНайти(СтрокаПоиска, ".", НаправлениеПоиска.СКонца);
	Если ПозицияТочки <= 1 Или ПозицияТочки = СтрДлина(СтрокаПоиска) Тогда
		Возврат "";
	КонецЕсли;

	Кандидат = Сред(СтрокаПоиска, ПозицияТочки + 1);

	// Защита от недопустимых символов файловой системы в расширении
	НедопустимыеСимволы = "\/:*?""<>|&#%";
	Для Индекс = 1 По СтрДлина(НедопустимыеСимволы) Цикл
		Если СтрНайти(Кандидат, Сред(НедопустимыеСимволы, Индекс, 1)) > 0 Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;

	Возврат Кандидат;

КонецФункции

// Перечитывает описание файла из общего списка файлов карточки.
//
// Параметры:
//  ФайлОбъект - СправочникОбъект.КТ_Файлы - файл архива.
//  Контекст - Структура - контекст загрузки.
//
// Возвращаемое значение:
//  Строка - обновленная ссылка на скачивание файла.
//
Функция ОбновитьОписаниеФайла(ФайлОбъект, Контекст)

	ИдентификаторКарточки = ИдентификаторКарточкиФайла(ФайлОбъект);
	Если НЕ ЗначениеЗаполнено(ИдентификаторКарточки) Тогда
		ВызватьИсключение "Не удалось определить карточку файла: " + ФайлОбъект.Наименование;
	КонецЕсли;

	Путь = "/cards/" + Формат(ИдентификаторКарточки, "ЧГ=0") + "/files";
	Массив = КТ_ЗагрузкаKaitenСервер.ПолучитьСтраницы(Путь, Контекст,
		Перечисления.КТ_ВидСущностиKaiten.Файл, Истина);

	Описание = НайтиОписаниеФайла(Массив, ФайлОбъект.UIDKaiten,
		ФайлОбъект.ИдентификаторKaitenСтрокой);
	Если Описание = Неопределено Тогда
		ВызватьИсключение "Файл не найден в списке файлов карточки " + ИдентификаторКарточки;
	КонецЕсли;

	ФайлОбъект.СыройJSON = Новый ХранилищеЗначения(Описание, Новый СжатиеДанных(9));
	ФайлОбъект.ИсходныйURL = Лев(КТ_JSONСервер.ПолучитьСтроку(Описание, "url"), 1000);
	ФайлОбъект.СыройОбъектМетаданных = СохранитьОписаниеФайла(ФайлОбъект, Описание, Контекст);
	ФайлОбъект.ОбменДанными.Загрузка = Истина;
	ФайлОбъект.Записать();

	Возврат ФайлОбъект.ИсходныйURL;

КонецФункции

