Процедура СкачатьФайл(ФайлСсылка, Контекст) Экспорт

	ФайлОбъект = ФайлСсылка.ПолучитьОбъект();
	Если ФайлОбъект = Неопределено Тогда
		ВызватьИсключение "Файл не найден в архиве";
	КонецЕсли;

	СсылкаНаСкачивание = БезРазделителейРазрядов(ФайлОбъект.ИсходныйURL);
	Если ПустаяСтрока(СсылкаНаСкачивание) Тогда
		СсылкаНаСкачивание = ОбновитьОписаниеФайла(ФайлОбъект, Контекст);
	КонецЕсли;

	Попытка

		ЗагрузитьСодержимоеФайла(ФайлОбъект, СсылкаНаСкачивание, Контекст);

	Исключение

		ПервичнаяОшибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());

		// Перечитывать список /cards/{id}/files имеет смысл только для файлов,
		// которые имеют числовой id в Kaiten. Картинки из текста комментариев (email-replies
		// и внешние ссылки) в маршрут /cards/{id}/files не входят.
		Если ЭтоВложениеИзСпискаKaiten(ФайлОбъект) Тогда
			Попытка
				СсылкаНаСкачивание = ОбновитьОписаниеФайла(ФайлОбъект, Контекст);
				ЗагрузитьСодержимоеФайла(ФайлОбъект, СсылкаНаСкачивание, Контекст);
			Исключение
				ВызватьИсключение "Не удалось скачать файл """ + ФайлОбъект.ИмяФайла
					+ """ (" + СсылкаНаСкачивание + "). Причина: " + ПервичнаяОшибка;
			КонецПопытки;
		Иначе
			ВызватьИсключение "Не удалось скачать картинку из комментария """ + ФайлОбъект.ИмяФайла
				+ """ (" + СсылкаНаСкачивание + "). Причина: " + ПервичнаяОшибка;
		КонецЕсли;

	КонецПопытки;

	ФайлОбъект.ФайлПроверен = Истина;
	ФайлОбъект.ДатаЗагрузки = ТекущаяУниверсальнаяДата();
	ФайлОбъект.ОшибкаЗагрузки = "";
	ФайлОбъект.ОбменДанными.Загрузка = Истина;
	ФайлОбъект.Записать();

	// Картинки вложения становятся видимыми в HTML-представлении комментария.
	Если ЗначениеЗаполнено(ФайлОбъект.Комментарий) Тогда
		КТ_РазметкаСервер.ОбновитьHTMLКомментария(ФайлОбъект.Комментарий);
	КонецЕсли;

КонецПроцедуры

// Проверяет, является ли файл объектом из списка /cards/{id}/files (имеет числовой id в Kaiten).
//
Функция ЭтоВложениеИзСпискаKaiten(ФайлОбъект)

	ИдСтрокой = СокрЛП(ФайлОбъект.ИдентификаторKaitenСтрокой);
	Если ПустаяСтрока(ИдСтрокой) Тогда
		Возврат Ложь;
	КонецЕсли;

	// Если ИдентификаторKaitenСтрокой состоит только из цифр — это реальный id файла Kaiten
	Для Индекс = 1 По СтрДлина(ИдСтрокой) Цикл
		Код = КодСимвола(ИдСтрокой, Индекс);
		Если Код < 48 Или Код > 57 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции


// Сохраняет очищенное описание файла в архив сырых объектов API.
//
// Временная подписанная ссылка не сохраняется: вместо нее записывается заглушка.
//
// Параметры:
//  ФайлОбъект - СправочникОбъект.КТ_Файлы - файл архива.
//  ОписаниеJSON - Структура - элемент общего списка файлов карточки.
//  Контекст - Структура - контекст загрузки.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_СырыеОбъектыAPI - ссылка на сохраненный объект.
//
Функция СохранитьОписаниеФайла(ФайлОбъект, ОписаниеJSON, Контекст) Экспорт

	ТелоИсходное = КТ_JSONСервер.ЗаписатьJSONВСтроку(ОписаниеJSON);
	ТелоДляХранения = ТелоИсходное;
	ТекстОшибкиРазбора = "";

	Попытка
		ОписаниеБезСсылки = КТ_JSONСервер.ПрочитатьJSONИзСтроки(ТелоИсходное);
		Если КТ_JSONСервер.ЭтоОбъектJSON(ОписаниеБезСсылки)
			И КТ_JSONСервер.ПолучитьЗначениеПоля(ОписаниеБезСсылки, "url") <> Неопределено Тогда
			ОписаниеБезСсылки.Вставить("url", "<temporary-signed-url-removed>");
		КонецЕсли;
		ТелоДляХранения = КТ_JSONСервер.ЗаписатьJSONВСтроку(ОписаниеБезСсылки);
	Исключение
		ТекстОшибкиРазбора =
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ПутьМетаданных = ПолучитьПутьМетаданныхФайла(ФайлОбъект);

	Объект = НайтиСыройОбъектМетаданныхФайла(Контекст, ФайлОбъект);
	Если Объект = Неопределено Тогда
		Объект = Справочники.КТ_СырыеОбъектыAPI.СоздатьЭлемент();
		Объект.УстановитьНовыйКод();
		Объект.СеансЗагрузки = Контекст.СеансЗагрузки;
		Объект.ВидСущности = Перечисления.КТ_ВидСущностиKaiten.Файл;
		Объект.ВидОперацииAPI = "ПолучениеМетаданныхФайла";
		Объект.UIDKaiten = ФайлОбъект.UIDKaiten;
		Объект.ИдентификаторKaiten = ФайлОбъект.ИдентификаторKaitenСтрокой;
	КонецЕсли;

	Объект.Наименование = Лев("Метаданные файла " + ФайлОбъект.ИмяФайла, 150);
	Объект.HTTPМетод = "GET";
	Объект.ПутьЗапроса = Лев(ПутьМетаданных, 1000);
	Объект.ПараметрыЗапроса = "";
	Объект.КодHTTP = 200;
	Объект.ДатаПолучения = ТекущаяУниверсальнаяДата();
	Объект.ContentType = "application/json";
	Объект.РазмерОтвета = ПолучитьДвоичныеДанныеИзСтроки(ТелоИсходное,
		КодировкаТекста.UTF8, Ложь).Размер();
	Объект.SHA256 = КТ_JSONСервер.ВычислитьSHA256(ТелоДляХранения);
	Объект.SHA256ИсходногоОтвета = КТ_JSONСервер.ВычислитьSHA256(ТелоИсходное);
	Объект.JSON = Новый ХранилищеЗначения(ТелоДляХранения, Новый СжатиеДанных(9));
	Объект.ОтносительныйПуть = Лев(ПутьМетаданных, 500);
	Объект.УспешноРазобран = ПустаяСтрока(ТекстОшибкиРазбора);
	Объект.ТекстОшибкиРазбора = ТекстОшибкиРазбора;
	Объект.Записать();

	Возврат Объект.Ссылка;

КонецФункции

// Помечает ошибку загрузки файла.
//
// Параметры:
//  ФайлСсылка - СправочникСсылка.КТ_Файлы - файл архива.
//  ТекстОшибки - Строка - описание ошибки.
//
Процедура ЗафиксироватьОшибкуФайла(ФайлСсылка, ТекстОшибки) Экспорт

	ФайлОбъект = ФайлСсылка.ПолучитьОбъект();
	Если ФайлОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ФайлОбъект.ФайлПроверен = Ложь;
	ФайлОбъект.ОшибкаЗагрузки = ТекстОшибки;
	ФайлОбъект.ДатаЗагрузки = ТекущаяУниверсальнаяДата();
	ФайлОбъект.ОбменДанными.Загрузка = Истина;
	ФайлОбъект.Записать();

КонецПроцедуры

// Возвращает путь API общего списка файлов карточки.
//
// Одиночные маршруты файлов (/cards/{id}/files/{file_id} и /comments/{id}/files/{file_id})
// доступны только на изолированных инсталляциях Kaiten, поэтому метаданные файла
// берутся из общего списка файлов карточки.
//
// Параметры:
//  ФайлОбъект - СправочникОбъект.КТ_Файлы - файл архива.
//
// Возвращаемое значение:
//  Строка - путь запроса метаданных файла; пустая строка, если карточка не определена.
//
Функция ПолучитьПутьМетаданныхФайла(ФайлОбъект) Экспорт

	ИдентификаторКарточки = ИдентификаторКарточкиФайла(ФайлОбъект);
	Если НЕ ЗначениеЗаполнено(ИдентификаторКарточки) Тогда
		Возврат "";
	КонецЕсли;

	Возврат "/cards/" + Формат(ИдентификаторКарточки, "ЧГ=0") + "/files";

КонецФункции

// Вычисляет контрольную сумму SHA-256 файла.
//
// Параметры:
//  ПутьФайла - Строка - путь к файлу.
//
// Возвращаемое значение:
//  Строка - хеш в нижнем регистре.
//
Функция ВычислитьSHA256Файла(ПутьФайла) Экспорт

	Возврат КТ_JSONСервер.ВычислитьSHA256(Новый ДвоичныеДанные(ПутьФайла));

КонецФункции

// Формирует постоянный путь хранения файла по его хешу.
//
// Параметры:
//  SHA256 - Строка - хеш файла.
//  Расширение - Строка - расширение файла.
//  КореньАрхива - Строка - корневой каталог архива.
//
// Возвращаемое значение:
//  Строка - полный путь постоянного хранения.
//
Функция ПолучитьПутьФайлаПоХешу(SHA256, Расширение, КореньАрхива) Экспорт

	Корень = СокрЛП(КореньАрхива);
	Если ПустаяСтрока(Корень) Тогда
		ВызватьИсключение "Не заполнен каталог архива для хранения файлов";
	КонецЕсли;

	Подкаталог = Корень + "\files\" + Лев(SHA256, 2);

	КаталогПодкаталога = Новый Файл(Подкаталог);
	Если НЕ КаталогПодкаталога.Существует() Тогда
		СоздатьКаталог(Подкаталог);
	КонецЕсли;

	ИмяФайла = SHA256;
	Если НЕ ПустаяСтрока(Расширение) Тогда
		ИмяФайла = ИмяФайла + "." + Расширение;
	КонецЕсли;

	Возврат Подкаталог + "\" + ИмяФайла;

КонецФункции

// Возвращает путь файла относительно корня архива.
//
// Параметры:
//  ПолныйПуть - Строка - полный путь файла.
//  КореньАрхива - Строка - корневой каталог архива.
//
// Возвращаемое значение:
//  Строка - относительный путь.
//
Функция ПолучитьОтносительныйПуть(ПолныйПуть, КореньАрхива) Экспорт

	Корень = СокрЛП(КореньАрхива);
	Если НЕ ПустаяСтрока(Корень)
		И СтрНайти(НРег(ПолныйПуть), НРег(Корень)) = 1 Тогда
		Возврат Сред(ПолныйПуть, СтрДлина(Корень) + 1);
	КонецЕсли;

	Возврат ПолныйПуть;

КонецФункции

// Копирует файл в постоянное хранилище и удаляет временный.
//
// Параметры:
//  Источник - Строка - временный файл.
//  Назначение - Строка - постоянный путь.
//
Процедура АтомарноПереместитьФайл(Источник, Назначение) Экспорт

	КопироватьФайл(Источник, Назначение);

	УдалитьВременныйФайл(Источник);

КонецПроцедуры

