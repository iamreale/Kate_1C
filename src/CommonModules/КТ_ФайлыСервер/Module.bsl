Функция ЗаписатьФайл(JSON, Родитель, Контекст) Экспорт

	ИдентификаторСтрокой = ИдентификаторФайлаСтрокой(JSON);
	ИсходныйURL = СокрЛП(КТ_JSONСервер.ПолучитьСтроку(JSON, "url"));

	UID = НРег(СокрЛП(КТ_JSONСервер.ПолучитьСтроку(JSON, "uid")));
	Если ПустаяСтрока(UID) И НЕ ПустаяСтрока(ИсходныйURL) Тогда
		UID = UIDИзАдреса(ИсходныйURL);
	КонецЕсли;

	Если ПустаяСтрока(ИдентификаторСтрокой) И ПустаяСтрока(UID) И ПустаяСтрока(ИсходныйURL) Тогда
		Возврат Справочники.КТ_Файлы.ПустаяСсылка();
	КонецЕсли;

	// Если файл получен из Markdown-текста комментария и не содержит ни id, ни UUID в URL —
	// вычисляем детерминированный идентификатор от URL без query-параметров
	Если ПустаяСтрока(UID) И ПустаяСтрока(ИдентификаторСтрокой) Тогда
		БазовыйURL = ИсходныйURL;
		ПозВопроса = СтрНайти(БазовыйURL, "?");
		Если ПозВопроса > 0 Тогда
			БазовыйURL = Лев(БазовыйURL, ПозВопроса - 1);
		КонецЕсли;
		UID = Лев(КТ_JSONСервер.ВычислитьSHA256(БазовыйURL), 36);
	КонецЕсли;

	Если ПустаяСтрока(ИдентификаторСтрокой) Тогда
		ИдентификаторСтрокой = UID;
	КонецЕсли;
	Если ПустаяСтрока(UID) Тогда
		UID = Лев(НРег(ИдентификаторСтрокой), 36);
	КонецЕсли;

	Ссылка = КТ_ПоискОбъектовСервер.НайтиФайл(UID, ИдентификаторСтрокой);
	Объект = ОбъектИлиНовый(Ссылка);

	ИмяФайла = КТ_JSONСервер.ПолучитьСтроку(JSON, "name");
	Если ПустаяСтрока(ИмяФайла) Тогда
		ИмяФайла = КТ_JSONСервер.ПолучитьСтроку(JSON, "name_original");
	КонецЕсли;
	Если ПустаяСтрока(ИмяФайла) Тогда
		ИмяФайла = ИмяФайлаИзURL(ИсходныйURL, UID);
	КонецЕсли;

	Объект.Наименование = Лев(ИмяФайла, 150);
	Объект.ИдентификаторKaitenСтрокой = ИдентификаторСтрокой;
	Объект.UIDKaiten = НРег(UID);
	Объект.ИмяФайла = Лев(ИмяФайла, 500);
	Объект.Расширение = РасширениеФайлаИзJSON(JSON, ИмяФайла);

	MIME = MIMEТипФайла(JSON);
	Если ПустаяСтрока(MIME) Тогда
		MIME = MIMEТипПоРасширению(Объект.Расширение);
	КонецЕсли;
	Объект.MIMEТип = Лев(MIME, 150);

	Объект.РазмерБайт = КТ_JSONСервер.ПолучитьЧисло(JSON, "size");
	Объект.ТипФайлаKaiten = КТ_JSONСервер.ПолучитьЧисло(JSON, "file_type_id");
	Объект.Внешний = КТ_JSONСервер.ПолучитьБулево(JSON, "external");
	Объект.ОбложкаКарточки = КТ_JSONСервер.ПолучитьБулево(JSON, "cover");
	Объект.УдаленВKaiten = КТ_JSONСервер.ПолучитьБулево(JSON, "deleted");
	Объект.Порядок = КТ_JSONСервер.ПолучитьЧисло(JSON, "sort_order");
	Если НЕ ПустаяСтрока(ИсходныйURL) Тогда
		Объект.ИсходныйURL = Лев(ИсходныйURL, 1000);
	КонецЕсли;
	Объект.ДатаСозданияKaiten = КТ_JSONСервер.ПолучитьДатуUTC(JSON, "created");
	Объект.ДатаИзмененияKaiten = КТ_JSONСервер.ПолучитьДатуUTC(JSON, "updated");
	Объект.СыройJSON = Новый ХранилищеЗначения(JSON, Новый СжатиеДанных(9));

	ЗаполнитьРодителя(Объект, JSON, Родитель, Контекст);

	Если НЕ ЗначениеЗаполнено(Объект.СпособХранения) Тогда
		Объект.СпособХранения = Перечисления.КТ_СпособХраненияФайла.НеЗагружен;
	КонецЕсли;

	Объект.СыройОбъектМетаданных = СохранитьОписаниеФайла(Объект, JSON, Контекст);

	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();

	Возврат Объект.Ссылка;

КонецФункции

// Извлекает имя файла из URL, если поле name в JSON не задано.
//
Функция ИмяФайлаИзURL(ИсходныйURL, UIDПоУмолчанию)
	ЧистыйАдрес = СтрЗаменить(СокрЛП(ИсходныйURL), "\", "/");
	ПозВопроса = СтрНайти(ЧистыйАдрес, "?");
	Если ПозВопроса > 0 Тогда
		ЧистыйАдрес = Лев(ЧистыйАдрес, ПозВопроса - 1);
	КонецЕсли;
	ПозСлеша = СтрНайти(ЧистыйАдрес, "/", НаправлениеПоиска.СКонца);
	Имя = ?(ПозСлеша > 0, Сред(ЧистыйАдрес, ПозСлеша + 1), ЧистыйАдрес);
	Возврат ?(ПустаяСтрока(Имя), UIDПоУмолчанию, Имя);
КонецФункции


// Скачивает содержимое файла и сохраняет его в хранилище.
//
