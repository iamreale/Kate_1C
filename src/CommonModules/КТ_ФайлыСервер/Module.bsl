// Возвращает уникальный 36-символьный идентификатор файла из его адреса.
//
// Если само имя файла (последний сегмент URL без расширения) является UUID — возвращает его.
// Если имя файла обычное (например, image002.png и image004.png в одной папке письма
// /email-replies/{folder_uid}/), нельзя брать UUID папки: возвращается детерминированный
// идентификатор по SHA-256 от полного пути файла.
//
Функция UIDИзАдреса(Адрес) Экспорт

	БезПараметров = СокрЛП(Адрес);
	Если ПустаяСтрока(БезПараметров) Тогда
		Возврат "";
	КонецЕсли;

	ПозицияПараметров = СтрНайти(БезПараметров, "?");
	Если ПозицияПараметров > 0 Тогда
		БезПараметров = Лев(БезПараметров, ПозицияПараметров - 1);
	КонецЕсли;

	ПозицияЯкоря = СтрНайти(БезПараметров, "#");
	Если ПозицияЯкоря > 0 Тогда
		БезПараметров = Лев(БезПараметров, ПозицияЯкоря - 1);
	КонецЕсли;

	// Проверяем ТОЛЬКО последний сегмент URL (само имя файла), а не родительские папки
	Части = СтрРазделить(БезПараметров, "/", Ложь);
	Если Части.Количество() > 0 Тогда
		ИмяФайлаВПути = СокрЛП(Части[Части.ВГраница()]);
		ПозицияТочки = СтрНайти(ИмяФайлаВПути, ".");
		Если ПозицияТочки > 1 Тогда
			ИмяБезРасширения = Лев(ИмяФайлаВПути, ПозицияТочки - 1);
		Иначе
			ИмяБезРасширения = ИмяФайлаВПути;
		КонецЕсли;

		Если СтрДлина(ИмяБезРасширения) = 36 И СтрЧислоВхождений(ИмяБезРасширения, "-") = 4 Тогда
			Возврат НРег(ИмяБезРасширения);
		КонецЕсли;
	КонецЕсли;

	// Если имя файла не UUID (например, .../667c9e56-.../image002.png),
	// формируем детерминированный 36-символьный UID из SHA-256 полного адреса без параметров
	Хеш = КТ_JSONСервер.ВычислитьSHA256(НРег(БезПараметров));

	Возврат Лев(Хеш, 8) + "-"
		+ Сред(Хеш, 9, 4) + "-"
		+ Сред(Хеш, 13, 4) + "-"
		+ Сред(Хеш, 17, 4) + "-"
		+ Сред(Хеш, 21, 12);

КонецФункции




// Возвращает содержимое файла архива.
//
// Параметры:
//  ФайлОбъект - СправочникОбъект.КТ_Файлы - файл архива.
//  Настройки - Структура - параметры подключения.
//
// Возвращаемое значение:
//  ДвоичныеДанные, Неопределено - содержимое файла.
//
Функция ДанныеФайла(ФайлОбъект, Настройки)

	Если ФайлОбъект.СпособХранения = Перечисления.КТ_СпособХраненияФайла.ВнутриИнформационнойБазы Тогда
		Хранилище = ФайлОбъект.ДвоичныеДанные;
		Если Хранилище = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Хранилище.Получить();
	КонецЕсли;

	Если ФайлОбъект.СпособХранения = Перечисления.КТ_СпособХраненияФайла.ВоВнешнемКаталоге
		И НЕ ПустаяСтрока(ФайлОбъект.ОтносительныйПуть) Тогда
		Путь = КаталогАрхива(Настройки) + ФайлОбъект.ОтносительныйПуть;
		ФайлНаДиске = Новый Файл(Путь);
		Если ФайлНаДиске.Существует() Тогда
			Возврат Новый ДвоичныеДанные(Путь);
		КонецЕсли;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Возвращает MIME-тип по расширению файла.
//
// Параметры:
//  Расширение - Строка - расширение файла.
//
// Возвращаемое значение:
//  Строка - MIME-тип или пустая строка.
//
Функция MIMEТипПоРасширению(Расширение)

	Расширение = НРег(СокрЛП(Расширение));

	Если Расширение = "png" Тогда
		Возврат "image/png";
	ИначеЕсли Расширение = "jpg" Или Расширение = "jpeg" Тогда
		Возврат "image/jpeg";
	ИначеЕсли Расширение = "gif" Тогда
		Возврат "image/gif";
	ИначеЕсли Расширение = "bmp" Тогда
		Возврат "image/bmp";
	ИначеЕсли Расширение = "webp" Тогда
		Возврат "image/webp";
	ИначеЕсли Расширение = "svg" Тогда
		Возврат "image/svg+xml";
	КонецЕсли;

	Возврат "";

КонецФункции

// Возвращает предельный размер картинки, встраиваемой в HTML.
//
// Возвращаемое значение:
//  Число - размер в байтах.
//
Функция МаксимальныйРазмерВстраивания()

	Возврат 10 * 1024 * 1024;

КонецФункции

// Кодирует двоичные данные в Base64 без переводов строк.
//
// Параметры:
//  Данные - ДвоичныеДанные - данные файла.
//
// Возвращаемое значение:
//  Строка - строка Base64.
//
Функция Base64БезПереводовСтрок(Данные)

	Результат = ПолучитьBase64СтрокуИзДвоичныхДанных(Данные);
	Результат = СтрЗаменить(Результат, Символы.ВК, "");

	Возврат СтрЗаменить(Результат, Символы.ПС, "");

КонецФункции

// Находит сохраненный сырой объект метаданных файла.
//
// Параметры:
//  Контекст - Структура - контекст загрузки.
//  ФайлОбъект - СправочникОбъект.КТ_Файлы - файл архива.
//
// Возвращаемое значение:
//  СправочникОбъект.КТ_СырыеОбъектыAPI, Неопределено - найденный объект.
//
Функция НайтиСыройОбъектМетаданныхФайла(Контекст, ФайлОбъект)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Сырые.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КТ_СырыеОбъектыAPI КАК Сырые
	|ГДЕ
	|	Сырые.СеансЗагрузки = &Сеанс
	|	И Сырые.ВидСущности = &ВидСущности
	|	И Сырые.ВидОперацииAPI = &ВидОперацииAPI
	|	И (Сырые.UIDKaiten = &UIDKaiten
	|		ИЛИ Сырые.ИдентификаторKaiten = &Идентификатор)";
	Запрос.УстановитьПараметр("Сеанс", Контекст.СеансЗагрузки);
	Запрос.УстановитьПараметр("ВидСущности", Перечисления.КТ_ВидСущностиKaiten.Файл);
	Запрос.УстановитьПараметр("ВидОперацииAPI", "ПолучениеМетаданныхФайла");
	Запрос.УстановитьПараметр("UIDKaiten", ФайлОбъект.UIDKaiten);
	Запрос.УстановитьПараметр("Идентификатор", ФайлОбъект.ИдентификаторKaitenСтрокой);

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Выборка.Ссылка.ПолучитьОбъект();

КонецФункции

// Удаляет временный файл, не прерывая загрузку при ошибке удаления.
//
// Параметры:
//  ПутьФайла - Строка - путь временного файла.
//
Процедура УдалитьВременныйФайл(ПутьФайла)

	Если ПустаяСтрока(ПутьФайла) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		УдалитьФайлы(ПутьФайла);
	Исключение
		ДанныеОшибки = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации("КТ_АрхивKaiten.ВременныйФайл",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"Не удалось удалить временный файл: "
				+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ДанныеОшибки));
	КонецПопытки;

КонецПроцедуры

// Заполняет владельца файла в объекте.
//
// Параметры:
//  Объект - СправочникОбъект.КТ_Файлы - файл архива.
//  JSON - Структура - объект JSON файла.
//  Родитель - Структура - описание владельца.
//  Контекст - Структура - контекст загрузки.
//
Процедура ЗаполнитьРодителя(Объект, JSON, Родитель, Контекст)

	Объект.ВидРодителя = Родитель.ВидРодителя;

	Если Родитель.Свойство("Карточка") И ЗначениеЗаполнено(Родитель.Карточка) Тогда
		Объект.Карточка = Родитель.Карточка;
	КонецЕсли;

	Если Родитель.Свойство("Комментарий") И ЗначениеЗаполнено(Родитель.Комментарий) Тогда
		Объект.Комментарий = Родитель.Комментарий;
	КонецЕсли;

	Если Родитель.Свойство("ПользовательскоеПоле")
		И ЗначениеЗаполнено(Родитель.ПользовательскоеПоле) Тогда
		Объект.ПользовательскоеПоле = Родитель.ПользовательскоеПоле;
	КонецЕсли;

	// Общий список файлов карточки возвращает и вложения комментариев, поэтому
	// привязка к комментарию восстанавливается по полю comment_id.
	ЗаполнитьРодителяКомментарий(Объект, JSON);

	Объект.Автор = КТ_ЗаписьОбъектовСервер.РазрешитьПользователя(
		JSON, "user_id", Контекст);
	Если НЕ ЗначениеЗаполнено(Объект.Автор) Тогда
		Объект.Автор = КТ_ЗаписьОбъектовСервер.РазрешитьПользователя(
			JSON, "author_id", Контекст);
	КонецЕсли;

КонецПроцедуры

// Восстанавливает привязку файла к комментарию по полю comment_id.
//
// Общий список файлов карточки (GET /cards/{id}/files) возвращает и вложения
// комментариев: у таких файлов заполнено поле comment_id. Привязка не должна
// теряться при обработке общего списка, поэтому она восстанавливается по этому полю.
//
// Параметры:
//  Объект - СправочникОбъект.КТ_Файлы - файл архива.
//  JSON - Структура - объект JSON файла.
//
Процедура ЗаполнитьРодителяКомментарий(Объект, JSON)

	ИдентификаторКомментария = КТ_JSONСервер.ПолучитьЧисло(JSON, "comment_id");

	Если ЗначениеЗаполнено(Объект.Комментарий) Тогда
		// Привязка уже установлена (файл пришел в списке комментариев) - не затираем ее.
		Если ЗначениеЗаполнено(ИдентификаторКомментария) Тогда
			Объект.ВидРодителя = Перечисления.КТ_ВидРодителяФайла.Комментарий;
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ИдентификаторКомментария) Тогда
		Возврат;
	КонецЕсли;

	Карточка = КарточкаФайла(Объект, JSON);
	Если НЕ ЗначениеЗаполнено(Карточка) Тогда
		Возврат;
	КонецЕсли;

	Комментарий = КТ_ПоискОбъектовСервер.НайтиКомментарий(Карточка, "",
		ИдентификаторКомментария);
	Если НЕ ЗначениеЗаполнено(Комментарий) Тогда
		Возврат;
	КонецЕсли;

	Объект.Комментарий = Комментарий;
	Объект.ВидРодителя = Перечисления.КТ_ВидРодителяФайла.Комментарий;

КонецПроцедуры

// Возвращает карточку файла, определяя ее по реквизиту, владельцу или сырым данным.
//
// Параметры:
//  Объект - СправочникОбъект.КТ_Файлы - файл архива.
//  JSON - Структура - объект JSON файла.
//
// Возвращаемое значение:
//  СправочникСсылка.КТ_Карточки - карточка файла или пустая ссылка.
//
Функция КарточкаФайла(Объект, JSON)

	Если ЗначениеЗаполнено(Объект.Карточка) Тогда
		Возврат Объект.Карточка;
	КонецЕсли;

	ИдентификаторКарточки = КТ_JSONСервер.ПолучитьЧисло(JSON, "card_id");
	Если НЕ ЗначениеЗаполнено(ИдентификаторКарточки) Тогда
		Возврат КТ_ПоискОбъектовСервер.НайтиКарточку(Неопределено, "",
			ИдентификаторКарточки);
	КонецЕсли;

	Возврат Справочники.КТ_Карточки.ПустаяСсылка();

КонецФункции

// Возвращает объект файла по ссылке или создает новый.
//
// Параметры:
//  Ссылка - СправочникСсылка.КТ_Файлы - найденная ссылка.
//
// Возвращаемое значение:
//  СправочникОбъект.КТ_Файлы - объект файла.
//
Функция ОбъектИлиНовый(Ссылка)

	Если ЗначениеЗаполнено(Ссылка) Тогда
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект <> Неопределено Тогда
			Возврат Объект;
		КонецЕсли;
	КонецЕсли;

	Возврат Справочники.КТ_Файлы.СоздатьЭлемент();

КонецФункции

// Возвращает строковый идентификатор файла из JSON.
//
// Числовой идентификатор приводится к строке без разделителей разрядов, чтобы
// значение не зависело от региональных установок (без неразрывного пробела).
//
// Параметры:
//  JSON - Структура - объект JSON файла.
//
// Возвращаемое значение:
//  Строка - идентификатор файла.
//
Функция ИдентификаторФайлаСтрокой(JSON)

	Значение = КТ_JSONСервер.ПолучитьЗначениеПоля(JSON, "id");

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0");
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Лев(БезРазделителейРазрядов(Значение), 64);
	КонецЕсли;

	Возврат "";

КонецФункции

// Удаляет из строкового идентификатора разделители разрядов и пробелы.
//
// Параметры:
//  Значение - Строка - исходное значение идентификатора.
//
// Возвращаемое значение:
//  Строка - значение без пробелов.
//
Функция БезРазделителейРазрядов(Значение)

	Результат = СтрЗаменить(Значение, Символы.НПП, "");
	Результат = СтрЗаменить(Результат, " ", "");
	Результат = СтрЗаменить(Результат, Символы.Таб, "");

	Возврат Результат;

КонецФункции

// Возвращает MIME-тип файла из JSON.
//
// Параметры:
//  JSON - Структура - объект JSON файла.
//
// Возвращаемое значение:
//  Строка - MIME-тип.
//
Функция MIMEТипФайла(JSON)

	Значение = КТ_JSONСервер.ПолучитьСтроку(JSON, "mime_type");
	Если НЕ ПустаяСтрока(Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	Значение = КТ_JSONСервер.ПолучитьСтроку(JSON, "content_type");
	Если НЕ ПустаяСтрока(Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат КТ_JSONСервер.ПолучитьСтроку(JSON, "type");

КонецФункции

// Возвращает разобранный сырой JSON файла.
//
// Параметры:
//  СыройJSON - ХранилищеЗначения - сохраненный JSON.
//
// Возвращаемое значение:
//  Произвольный - структура JSON или Неопределено.
//
Функция ХранилищеЗначенияJSON(СыройJSON)

	Если СыройJSON = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат СыройJSON.Получить();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Возвращает значение таймаута загрузки файла.
//
// Параметры:
//  Настройки - Структура - параметры подключения.
//
// Возвращаемое значение:
//  Число - таймаут в секундах.
//
Функция ТаймаутФайла(Настройки)

	Если Настройки.Свойство("ТаймаутФайлаСекунд")
		И ЗначениеЗаполнено(Настройки.ТаймаутФайлаСекунд) Тогда
		Возврат Настройки.ТаймаутФайлаСекунд;
	КонецЕсли;

	Возврат 300;

КонецФункции

// Определяет необходимость хранения содержимого файлов в информационной базе.
//
// Параметры:
//  Настройки - Структура - параметры подключения.
//
// Возвращаемое значение:
//  Булево - Истина, если файлы хранятся в информационной базе.
//
Функция ХранитьВИнформационнойБазе(Настройки)

	Если Настройки.Свойство("ХранитьФайлыВИБ") Тогда
		Возврат Настройки.ХранитьФайлыВИБ = Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Возвращает идентификатор Kaiten ссылки без загрузки объекта из базы данных.
//
// Параметры:
//  Ссылка - СправочникСсылка - ссылка на объект архива.
//
// Возвращаемое значение:
//  Число - идентификатор Kaiten.
//
Функция ИдентификаторKaitenСсылки(Ссылка)

	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат 0;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Источник.ИдентификаторKaiten КАК ИдентификаторKaiten
	|ИЗ
	|	Справочник." + Ссылка.Метаданные().Имя + " КАК Источник
	|ГДЕ
	|	Источник.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ИдентификаторKaiten;
	КонецЕсли;

	Возврат 0;

КонецФункции

// Возвращает корневой каталог архива.
//
// Параметры:
//  Настройки - Структура - параметры подключения.
//
// Возвращаемое значение:
//  Строка - путь каталога архива.
//
Функция КаталогАрхива(Настройки)

	Если Настройки.Свойство("КаталогАрхива") Тогда
		Возврат СокрЛП(Настройки.КаталогАрхива);
	КонецЕсли;

	Возврат "";

КонецФункции

#КонецОбласти
